#!/usr/bin/env bash
# kel — keybinding cheatsheet. Shown by `prefix k`, piped through less by kel.conf.
cat <<'EOF'

  kel — keys                                    prefix = Ctrl+b
  ────────────────────────────────────────────────────────────────
  Press prefix (Ctrl+b), let go, then the key.

  WINDOWS   — each window is one agent
    prefix c            new window (start another agent in it)
    prefix 0 .. 9       jump to window N
    prefix n / p        next / previous window
    prefix w            choose a window from a list
    prefix `            jump to the next agent WAITING on you
    prefix ,            rename window  → the name on the status bar
    prefix &            close the window (asks to confirm)

  SCROLLING an agent's output
    prefix [            enter scroll mode
      ↑ ↓  PageUp  PageDn   move
      /                    search back,  n = next match
      q                    leave scroll mode
    prefix ]            paste what you copied in scroll mode

  PANES     — split one window (agent + editor, agent + tests)
    prefix %            split into left | right
    prefix "            split into top / bottom
    prefix ← → ↑ ↓      move between panes
    prefix z            zoom the current pane (toggle fullscreen)
    prefix x            close the current pane
    prefix { / }        move the current pane left / right

  SESSION
    prefix d            detach — every agent keeps running
    tmux attach         (from a plain shell) reattach to everything
    prefix $            rename the session

  STATUS BAR
    N:name*   working          N:name?   waiting on you
    N:name!   done             N:name    idle
    [N:name]  the window you are on

  prefix ?   tmux's own full key list
  prefix k   this cheatsheet

  Want mouse scroll + click-to-select a pane?
  add   set -g mouse on   to ~/.tmux.conf

EOF
