#!/usr/bin/env bash
# kel — a terminal workspace for running several coding agents at once.
# tmux does the multiplexing; kel does the bookkeeping.
#
#   kel                        enter the workspace — in a repo, go to (or start)
#                              that repo's agent, like `claude` for a directory
#   kel new [name] [dir] [-w]  window + agent, inplace or in a git worktree
#                              (no name: <repo>-<n>; kel rename later)
#         [--group G] [--agent CMD] [--no-agent]
#   kel kill <name> [-f]       close the window; remove the worktree; -f overrides
#                              the uncommitted / unpushed check
#   kel ls [--json]            list agents, grouped by repo
#   kel rename <newname>       rename the current window (keeps metadata in sync)
#   kel restore [<n>]          bring back a previous workspace, conversations
#         [--list] [--no-resume]  resumed (--list: choose among the last five)
#   kel relaunch [name] [-f]   relaunch a crashed agent in its existing window
#                              (one agent — `kel restore` rebuilds the workspace)
#   kel sidebar on|off         the sidebar pane in every window (default on)
#   kel shell [dir]            a plain shell window, no agent (sidebar: t)
#   kel quit [-f]              save the workspace, then close all of it; refuses
#                              while a worktree holds unsaved work (sidebar: Q)
#   kel url [dir|agent]        the dev-server URLs of a worktree, one per line
#                              (exit 1 for none) — for scripts and agents
#   kel sweep [-n] [-f] [path] close every finished agent whose work has merged,
#                              and landed worktrees nothing stands in; or one
#                              worktree (closes windows; -n shows the plan first)
#   kel shot [agent]           the pane as an SVG, with freeze (~/Pictures/kel)
#   kel prune [-f]             forget dead agent records (closes nothing)
#   kel doctor                 capability probe, cached
#   kel config                 edit config.toml (seeds it from the shipped
#                              example the first time — every key is
#                              commented out with its default)
#   kel update                 fast-forward the clone kel runs from, then
#                              re-run install.sh (refuses on a dirty tree)
#
# internal (wired by install.sh; some are fine to type, none are the point):
#   kel status-line [group]    render tmux status-left
#   kel jump                   jump to the next waiting agent, any group (prefix `)
#   kel snapshot               save the workspace shape (hooks call this)
#   kel hook <EVENT>           Claude Code state hook
#   kel statusline             Claude Code statusLine — context % / cost
#   kel substatus              Claude Code subagentStatusLine — records, prints nothing
#   kel _panel <what> ...      the sidebar's popups: files, git, diff, edit, editor, plan, browse
#   kel _prompt '<args>'       prefix k: run `kel <args>`, answer in a message or a popup
#   kel _notify [title] [body] fire kel's notification (bell + desktop) — to try it
#   kel _click <range> ...     a click on a status line: close a popup, jump
#   kel _copy                  stdin to the system clipboard (copy-mode pipes here)
set -uo pipefail

# --------------------------------------------------------------------------
# config  —  ~/.config/kel/config.toml, and a per-repo .kel/config.toml
# --------------------------------------------------------------------------
# Deliberately a flat `key = value` subset of TOML, not a parser: every knob
# kel has is a scalar, and a real parser would be a dependency for nothing.
# Sections are ignored, so `[ui]` above a key is decoration.
#
# Precedence: an exported KEL_* env var  >  repo .kel/config.toml  >  user
# config.toml  >  built-in default. Env wins because it is the more explicit
# statement — you typed it for this shell, on purpose.
#
# This runs on EVERY invocation including each status-bar redraw, so it forks
# nothing unless a config file actually exists: the search is bash builtins,
# and awk is spawned only for a file that is really there. A first cut used
# `git rev-parse` to find the repo root and cost 5ms on every single call.
kel_config_read() {   # file
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    # trim leading whitespace FIRST: an indented key would otherwise parse as
    # empty, and an indented comment would not be recognised as one
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ''|\#*|\[*) continue ;; esac
    [ -n "${line##*=*}" ] && continue
    local key="${line%%=*}" val="${line#*=}"
    key="${key%%[[:space:]]*}"
    val="${val%%#*}"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
    val="${val%\"}"; val="${val#\"}"
    val="${val%\'}"; val="${val#\'}"
    case "$key" in ''|*[!a-z0-9_]*) continue ;; esac
    local up=''
    case "$key" in *) up="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')" ;; esac
    local envname="KEL_$up"
    [ -n "${!envname:-}" ] && continue        # never override an exported var
    export "$envname=$val"
  done < "$1"
}

kel_config_load() {
  local user="${XDG_CONFIG_HOME:-$HOME/.config}/kel/config.toml"
  # walk up for a repo config using builtins only — no git, no forks
  local d="$PWD" repo=''
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != "$HOME" ]; do
    [ -f "$d/.kel/config.toml" ] && { repo="$d/.kel/config.toml"; break; }
    d="${d%/*}"
  done
  # Highest precedence first: the "already set" guard makes this first-write-
  # wins, so the repo config has to be read BEFORE the user one, not after.
  [ -n "$repo" ] && kel_config_read "$repo"
  [ -f "$user" ] && kel_config_read "$user"
}
kel_config_load

KEL_PREFIX="${KEL_SESSION:-kel}"          # the one tmux session (v0.9: <prefix>/<group>)
KEL_AGENT="${KEL_AGENT:-claude}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
SESSIONS_DIR="$STATE_DIR/sessions"
STASH_DIR="$STATE_DIR/.stash"
WAITING_DIR="$STATE_DIR/.waiting"
DOCTOR_CACHE="$STATE_DIR/doctor.json"
SNAPSHOT="$STATE_DIR/snapshot.json"
RESTORE_LOCK="$STATE_DIR/.restoring"
KEL_FLEET_BIN="${KEL_FLEET_BIN:-$HOME/.local/bin/kel-fleet}"   # the Go seam (v0.6)
KEL_SIDEBAR_BIN="${KEL_SIDEBAR_BIN:-$HOME/.local/bin/kel-sidebar}"
SNAPSHOT_ARCHIVE="$STATE_DIR/snapshots"           # workspaces kel started fresh over
STATUSLINE_PREV="$HOME/.claude/statusline-prev"   # a statusLine kel displaced
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"   # plans/ and tasks/ live here
KEL_CTX_WARN="${KEL_CTX_WARN:-70}"                # show context on the bar from here up
KEL_NOTIFY="${KEL_NOTIFY:-waiting}"               # states worth interrupting you for
# The running script's own absolute path, preferred over a PATH lookup: kel
# re-invokes itself (sweep, tmux bindings) and resolving that
# through PATH breaks whenever kel is not installed — a fresh clone, or CI.
# That failed silently, because the re-invocation just did nothing.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")"
[ -x "$SELF" ] || SELF="$(command -v kel 2>/dev/null || printf '%s' "$HOME/.local/bin/kel")"
# commands worth re-running per pane on restore (agents handled separately)
KEL_RESTORE_CMDS="${KEL_RESTORE_CMDS:-nvim vim hx nano lazygit lazydocker htop btop k9s}"
KEL_SIDEBAR_WIDTH="${KEL_SIDEBAR_WIDTH:-32}"      # identical in every window (spec.md §5c)
# the sidebar's own background, so it reads as chrome rather than a pane in a
# box (spec.md §5a, §5d) — true black, by RGB. Not ANSI black, which themes
# often lighten to a grey; not colour234, which the author found too grey; and
# not colour16, which base16-style schemes repurpose as an accent (WezTerm's
# Catppuccin Mocha makes it peach, and the sidebar came out orange on WSL).
# tmux maps #000000 to the nearest palette entry on a terminal without RGB.
# "default" gives it the terminal's background like any other pane.
KEL_SIDEBAR_STYLE="${KEL_SIDEBAR_STYLE:-bg=#000000}"
SIDEBAR_OFF="$STATE_DIR/sidebar-off"              # `kel sidebar off`, persisted

# guarded: an unconditional mkdir -p of three existing dirs measured ~10ms,
# and every kel invocation — including each status-bar redraw — paid it
#
# 0700, like ~/.ssh: the records carry repo paths, branch names and Claude
# session ids, and <wid>.state carries Claude Code's notification text, which
# is the agent quoting a command back at you — file paths and greps included.
# None of that should be readable by another account on a shared or managed
# machine.  The DIRECTORY mode is what does the work: no traverse, no reads,
# whatever the modes inside.
#
# Deliberately not a global `umask 077`, which would also apply to the files
# `git worktree add` creates in cmd_new — kel would silently start writing
# your source at 0600, which is not its business.
[ -d "$SESSIONS_DIR" ] && [ -d "$STASH_DIR" ] \
  || { mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$STASH_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null; }

humanize_secs() {   # 45 -> 45s   400 -> 6m   3900 -> 1h05m
  local s="${1:-0}"
  case "$s" in ''|*[!0-9]*) s=0 ;; esac
  if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%dm' $(( s / 60 ))
  else                         printf '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 )); fi
}

say()  { printf '\033[1;32mkel\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mkel\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mkel\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --------------------------------------------------------------------------
# groups & sessions
# --------------------------------------------------------------------------
# tmux session name for a group.  The bare prefix is the pre-v0.2 flat session.

slug_ok() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
git_root() { git rev-parse --show-toplevel 2>/dev/null; }
in_tmux()  { [ -n "${TMUX:-}" ]; }
has_remote() { [ -n "$(git -C "$1" remote 2>/dev/null)" ]; }

# owner/repo of a GitHub remote, or nothing
repo_slug() { # dir
  local u; u="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 0
  case "$u" in *github.com*) ;; *) return 0 ;; esac
  u="${u#*github.com}"; u="${u#[:/]}"; u="${u%.git}"
  printf '%s\n' "$u"
}

# derive the group for a new agent:
#   --group flag  >  $KEL_GROUP (force everything into one group)  >  repo basename  >  misc
# --group flag > $KEL_GROUP > .kel/group > repo basename > misc
group_for_cwd() {
  [ -n "${KEL_GROUP:-}" ] && { printf '%s' "$KEL_GROUP"; return; }
  local g; g="$(dir_group "$PWD")"
  [ -n "$g" ] && { printf '%s' "$g"; return; }
  local gr; gr="$(git_root 2>/dev/null || true)"
  if [ -n "$gr" ]; then basename "$gr"; else printf 'misc'; fi
}

# The name a nameless agent gets: <group>-<n>, the first n no record or
# window in the group holds — Claude Code numbers its own sessions alike.
# Given a repo (-w), no branch either: `worktree add` would check out a
# leftover branch of that name, old commits and all.
next_name() { # group [repo]
  local taken n=1
  taken="$( { ls "$SESSIONS_DIR/$1" 2>/dev/null | sed 's/\.json$//'
              kel_windows | awk -F'\t' -v g="$1" '$5 == g {print $4}'
              [ -n "${2:-}" ] && git -C "$2" branch --format='%(refname:short)' 2>/dev/null; } )"
  while printf '%s\n' "$taken" | grep -qxF "$1-$n"; do n=$((n + 1)); done
  printf '%s-%s' "$1" "$n"
}

# A `.kel/group` file pins a directory (and everything under it) to a group,
# for a monorepo that does not split cleanly on git root.  Searched upward from
# $1, stopping at the repo root so it cannot escape into a parent project.
dir_group() {   # dir -> group name, or empty
  local d="$1" root g
  root="$(cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
  while [ -n "$d" ] && [ "$d" != / ]; do
    if [ -f "$d/.kel/group" ]; then
      read -r g < "$d/.kel/group" 2>/dev/null || g=''
      g="${g%$'\r'}"                      # tolerate a CRLF checkout
      g="${g#"${g%%[![:space:]]*}"}"      # trim, but do NOT truncate: a file
      g="${g%"${g##*[![:space:]]}"}"      # saying "not a slug" is an error,
      if slug_ok "$g"; then                # not a request for the group "not"
        printf '%s' "$g"; return 0
      fi
      warn ".kel/group in $d is not a slug ('$g') — ignoring it"
      return 0
    fi
    [ "$d" = "$root" ] && break
    d="$(dirname "$d")"
  done
}

# ---- the one session ----------------------------------------------------
# Since v0.10 every kel window lives in ONE tmux session, named exactly
# $KEL_PREFIX.  The sidebar groups by repo itself; a session per repo only made
# navigation two-level.  A window's group therefore cannot come from its
# session any more: kel stamps it on the window as the @kel-group option,
# which the hot paths can read in the same format string they already run.
# v0.9 put each repo in its own `<prefix>/<group>` session; the readers that
# recognised a pre-upgrade server's sessions went once every machine ran v0.10.

# kel's live session, if it is up
kel_sessions() {
  tmux has-session -t "=$KEL_PREFIX" 2>/dev/null && printf '%s\n' "$KEL_PREFIX"
}

# every window kel owns:  session<TAB>index<TAB>wid<TAB>name<TAB>group
# group is @kel-group, or empty (a hand-made window — kel-fleet derives its
# group from the pane's repo)
kel_windows() {
  tmux list-windows -t "=$KEL_PREFIX" -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}	#{@kel-group}' 2>/dev/null
}

# the group of the window the client is looking at, or empty outside kel
current_group() {
  # '|', not a tab: an empty @kel-group is a leading empty field, which
  # IFS=$'\t' read silently drops (CLAUDE.md, traps) — and slugs have no '|'
  # Only from inside tmux, and about THIS pane.  Outside a client, #{@kel-group}
  # still resolves against tmux's default window — a guess that silently
  # disarmed `kel kill`'s ambiguity check.  #{client_session} used to be empty
  # there, which is what kept the old version honest.
  [ -n "${TMUX:-}" ] || return 0
  tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{@kel-group}' 2>/dev/null || true
}

state_of() { # wid | pane -> raw state from the hook, or empty
  local f; f="$(state_file "$1" state)"
  [ -f "$f" ] || return 0
  local s; read -r s _ < "$f" || return 0
  printf '%s' "$s"
}

# effective_state: raw hook state, but "dead" if the agent process is gone
# (a crash/OOM fires no Stop/SessionEnd hook — the window just drops to a shell)
effective_state() { # wid
  local s; s="$(state_of "$1")"
  case "$s" in
    # idle is a real signal, not "no signal yet" — SessionStart already fired
    # and set it. That is NOT the launch race this dead-check has to dodge:
    # during the launch race there is no state FILE at all yet (state_of
    # returns empty, matching neither branch here), because kel new sends the
    # agent command with send-keys and the shell briefly still shows before
    # claude execs. Once idle is on record that race is over, so a shell in
    # the pane at that point means the agent process actually died — found by
    # walking through the tool as a fresh user: an agent that crashes between
    # SessionStart and its first prompt used to sit reading "idle" forever,
    # with no glyph, no colour, nothing to tell you it was gone.
    idle|working|waiting|throttled)
      agent_alive "$1" || { printf 'dead'; return; } ;;
  esac
  printf '%s' "$s"
}

# create the window in the one session (making it if needed); prints wid.
# "bare" skips the sidebar — restore adds it itself, ordered against the saved
# layout (see restore_from_snapshot).  -d: made in the background, so the
# sidebar is in before any client shows the window — without it you saw the
# window full width, then the sidebar split in (the "flash").  Callers go to
# the window themselves (goto_window).
open_window() { # name cwd group [bare]
  local name="$1" cwd="$2" group="$3" bare="${4:-}" wid
  if tmux has-session -t "=$KEL_PREFIX" 2>/dev/null; then
    wid="$(tmux new-window -d -t "=$KEL_PREFIX:" -n "$name" -c "$cwd" -P -F '#{window_id}')"
  else
    wid="$(tmux new-session -d -s "$KEL_PREFIX" -n "$name" -c "$cwd" -x 220 -y 50 -P -F '#{window_id}')"
  fi
  [ -n "$wid" ] || return 1
  tmux set-option -w -t "$wid" @kel-group "$group" 2>/dev/null || true
  [ -n "$bare" ] || sidebar_ensure "$wid"
  printf '%s' "$wid"
}

# ---- the sidebar pane (v0.10 M2) -----------------------------------------
# Every kel window carries a fixed-width pane on its left running
# `kel-sidebar`, so the sidebar reads as one persistent thing
# (spec.md §5).  The pane is marked @kel-sidebar; anything looking for "the
# user's pane" must skip it — see agent_pane.

sidebar_enabled() {
  case "${KEL_SIDEBAR:-on}" in 0|off|no|false) return 1 ;; esac
  [ ! -e "$SIDEBAR_OFF" ] && [ -x "$KEL_SIDEBAR_BIN" ]
}

# A window's panes split by @kel-sidebar.  The flag is "1" on the sidebar and
# EMPTY on the user's panes, so every filter keys on that empty field: never
# `grep -v 1`, which matches the empty lines and prints nothing (CLAUDE.md).

# the user's panes, in order, as  id|command
user_panes() { # wid
  tmux list-panes -t "$1" -F '#{@kel-sidebar}|#{pane_id}|#{pane_current_command}' 2>/dev/null \
    | awk -F'|' '$1 == "" {print $2"|"$3}'
}

# the window's sidebar pane, or nothing
sidebar_pane() { # wid
  tmux list-panes -t "$1" -F '#{@kel-sidebar}|#{pane_id}' 2>/dev/null \
    | awk -F'|' '$1 == "1" {print $2; exit}'
}

# the first pane of a window that is not the sidebar — where an agent runs,
# where send-keys must go, what a restore replays into
agent_pane() { # wid
  user_panes "$1" | head -1 | cut -d'|' -f1
}

# does a user pane run anything but a shell?  The sidebar runs kel-sidebar, a
# non-shell, so it must not count: it would keep a crashed agent alive forever
# (invariant 3) and let relaunch type into a live one (invariant 4).
agent_alive() { # wid | pane
  case "$1" in
    %*) local c; c="$(tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null)"
        [ -n "$c" ] && ! printf '%s\n' "$c" | grep -qxE 'bash|zsh|fish|sh|dash|tmux' ;;
    *)  user_panes "$1" | cut -d'|' -f2 | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' ;;
  esac
}

record_pane() { # wid meta
  local p
  p="$(jq -r '.pane_id // ""' "$2" 2>/dev/null)"
  if [ -n "$p" ] && [ "$(tmux display-message -p -t "$p" '#{window_id}' 2>/dev/null)" = "$1" ]; then
    printf '%s' "$p"
  else
    agent_pane "$1"
  fi
}

other_agents() { # wid pane -> the names of the window's other agents, one a line
  tmux list-panes -t "$1" -F '#{pane_id}|#{@kel-sidebar}|#{@kel-agent}|#{pane_current_command}' 2>/dev/null \
    | awk -F'|' -v p="$2" '$1 != p && $2 == "" && ($3 != "" || $4 == "claude") { n = $3; sub(/.*\//, "", n); print (n == "" ? $1 : n) }'
}

own_window() { # pane
  local pane="$1" wid stamp name g nw m
  wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)" || die "no pane $pane"
  [ -n "$(other_agents "$wid" "$pane")" ] || [ "$(user_panes "$wid" | grep -c .)" -gt 1 ] \
    || die "it has its window to itself already"
  stamp="$(tmux display-message -p -t "$pane" '#{@kel-agent}' 2>/dev/null)"
  name="${stamp##*/}"; g="${stamp%/*}"
  [ -n "$name" ] || name="$(tmux display-message -p -t "$wid" '#{window_name}')-$(tmux display-message -p -t "$pane" '#{pane_index}')"
  [ -n "$stamp" ] || g="$(tmux display-message -p -t "$wid" '#{@kel-group}' 2>/dev/null)"
  nw="$(tmux break-pane -d -s "$pane" -n "$name" -P -F '#{window_id}')" || die "could not move it"
  tmux set-option -w -t "$nw" @kel-group "$g" 2>/dev/null || true
  sidebar_ensure "$nw"
  m="$(meta_path "$g" "$name")"
  [ -n "$stamp" ] && [ -f "$m" ] && meta_update "$m" '.window_id=$w' --arg w "$nw"
  if [ "$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)" = "$name" ]; then
    local next; next="$(other_agents "$wid" "")"
    [ -n "$next" ] && tmux rename-window -t "$wid" "${next%%$'\n'*}" 2>/dev/null
  fi
  goto_window "$nw"
  snapshot
  say "$name has a window of its own"
}

window_state() { # wid -> the most urgent state among its agents
  local p best='' r br=9 st
  for p in $(tmux list-panes -t "$1" -F '#{@kel-sidebar}|#{pane_id}' 2>/dev/null | awk -F'|' '$1 == "" {print $2}') "$1"; do
    [ -f "$(state_file "$p" state)" ] || continue
    st="$(effective_state "$p")"
    case "$st" in waiting) r=0 ;; dead) r=1 ;; throttled) r=2 ;; *) r=3 ;; esac
    [ "$r" -lt "$br" ] && { br="$r"; best="$st"; }
  done
  printf '%s' "$best"
}

rm_agent_state() { # key...
  local k
  for k in "$@"; do
    [ -n "$k" ] && rm -f "$STATE_DIR/$k.state" "$STATE_DIR/$k.ctx" "$STATE_DIR/$k.edit" \
      "$STATE_DIR/$k.plan" "$STATE_DIR/$k.view" "$STATE_DIR/$k.subs"
  done
  return 0
}

state_file() { # key ext
  local f="$STATE_DIR/$1.$2" w
  if [ ! -f "$f" ]; then
    case "$1" in
      %*) w="$(tmux display-message -p -t "$1" '#{window_id}' 2>/dev/null)"
          [ -n "$w" ] && [ "$(agent_pane "$w")" = "$1" ] && f="$STATE_DIR/$w.$2" ;;
      @*) w="$(agent_pane "$1")"
          [ -n "$w" ] && f="$STATE_DIR/$w.$2" ;;
    esac
  fi
  printf '%s' "$f"
}

# Add the sidebar to a window that has none.  The test and the add are ONE
# tmux command list, so two callers cannot both add one — kel new and the
# after-new-window hook ensure every new window, so they always overlap.  The
# test is the pane itself (a pane loop, in tmux since 3.0), not a window flag:
# a flag set beside a split that came to nothing claimed a sidebar that was not
# there, and every later ensure believed it (backlog #41).
# -b left, -d focus stays where it was, -f the window's full height, which also
# makes it the {top-left} pane whatever pane-base-index is.
sidebar_ensure() { # wid
  local wid="$1"
  sidebar_enabled || return 0
  [ "$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null)" = "$KEL_PREFIX" ] || return 0
  [ -n "$(sidebar_pane "$wid")" ] && return 0
  sidebar_width_opts
  # No else-branch, and the condition inverted, ON PURPOSE: an empty branch
  # ('') is an error tmux shows in view-mode on the window's active pane — the
  # agent's — which then swallowed every key, C-c included.  Found because the
  # suite's dead-agent check could not kill its agent.
  # stderr goes to sidebar-fail.log: four sidebars split cleanly and then died
  # (2026-10-20), and tmux reports nothing about a pane whose process exits.
  tmux if-shell -F -t "$wid" '#{?#{P:#{?@kel-sidebar,1,}},,1}' \
    "split-window -hbdf -l $KEL_SIDEBAR_WIDTH -t '$wid' -c '#{pane_current_path}' -e 'KEL_BIN=$SELF' \"exec '$KEL_SIDEBAR_BIN' 2>>'$STATE_DIR/sidebar-fail.log'\" ; set-option -p -t '$wid.{top-left}' @kel-sidebar 1" \
    2>/dev/null || true
  sidebar_style "$wid"
  banner_apply
}

sidebar_width_opts() {
  local w="$KEL_SIDEBAR_WIDTH"
  tmux set-option -g @kel-sidebar-width "$w" \; \
       set-option -g @kel-hint-out "$(printf '%-*.*s' "$w" "$w" "click, or $(prefix_words) then space")" \; \
       set-option -g @kel-hint-in "$(printf '%-*.*s' "$w" "$w" "esc back to your pane")" 2>/dev/null
}

# per-pane styles are tmux 3.1+; below that the sidebar just wears the
# terminal's background, so a failure here is ignored, not reported
sidebar_style() { # wid
  local id
  id="$(sidebar_pane "$1")"
  [ -n "$id" ] || return 0
  tmux set-option -p -t "$id" window-style "$KEL_SIDEBAR_STYLE" \; \
       set-option -p -t "$id" window-active-style "$KEL_SIDEBAR_STYLE" 2>/dev/null || true
}

# nudge every sidebar to look again (SIGUSR1); each decides for itself, with
# one cheap tmux call, whether it is the visible one.  On every state hook too,
# so it must stay one listing (invariant 5).  Only a sidebar marked @kel-ready:
# the signal kills one still starting (backlog #41).
sidebar_wake() {
  local ready pid
  tmux list-panes -a -F '#{@kel-ready} #{pane_pid}' 2>/dev/null \
  | while read -r ready pid; do
      [ "$ready" = 1 ] && kill -USR1 "$pid" 2>/dev/null
    done
  return 0
}

# Give back a sidebar any kel window has lost.  `ensure` runs on creation
# events, for the window being created, so a window whose sidebar died stayed
# without one until some other window was made — the user saw it as "my shells
# vanished", their agent's pane just full width (2026-10-19).  Run on a window
# switch, when you would notice, and not on the state hook, which would put
# it on the agent's own path.  Only kel's session: a popup's _kelpop_* session
# or a window of yours elsewhere is not missing anything.
sidebar_heal() {
  local wid
  sidebar_enabled || return 0
  sidebar_width_opts
  sidebar_reap
  tmux list-panes -s -t "=$KEL_PREFIX" -F '#{window_id} #{@kel-sidebar}' 2>/dev/null \
  | awk '{ seen[$1]; if ($2 == 1) has[$1] } END { for (w in seen) if (!(w in has)) print w }' \
  | while read -r wid; do
      [ -n "$wid" ] && sidebar_ensure "$wid"
    done
  return 0
}

sidebar_fit() {
  local flag id w wid pos
  sidebar_width_opts
  tmux list-panes -a -F '#{@kel-sidebar} #{pane_id} #{pane_width} #{window_id} #{?window_zoomed_flag,zoomed,#{?#{&&:#{pane_at_left},#{&&:#{pane_at_top},#{pane_at_bottom}}},docked,moved}}' 2>/dev/null \
  | while read -r flag id w wid pos; do
      [ "$flag" = 1 ] || continue
      case "$pos" in
        moved)  tmux kill-pane -t "$id" 2>/dev/null; sidebar_ensure "$wid" ;;
        docked) [ "$w" != "$KEL_SIDEBAR_WIDTH" ] \
                  && tmux resize-pane -t "$id" -x "$KEL_SIDEBAR_WIDTH" 2>/dev/null ;;
      esac
    done
  return 0
}

# prefix Space: put the keyboard in the sidebar of the window you are in,
# making one first if the window has none. esc in the sidebar goes back
# (tmux last-pane). The binding passes its window (#{window_id}, expanded from
# the client that pressed the key): asked with no target, tmux's idea of "the
# current window" differs between versions — CI's macOS tmux named another
# window than Linux's did, and focus went to the wrong sidebar.
sidebar_focus() { # [wid]
  local wid="${1:-}" id
  [ -n "$wid" ] || wid="$(tmux display-message -p '#{window_id}' 2>/dev/null)" || return 0
  sidebar_ensure "$wid"
  id="$(sidebar_pane "$wid")"
  [ -n "$id" ] && tmux set-option -w -t "$wid" @kel-via 1 \; select-pane -t "$id" 2>/dev/null
  return 0
}

# a kel window left holding only its sidebar — the user's last pane exited —
# is closed, not left as an orphan column
sidebar_reap() {
  local wid
  for wid in $(kel_windows | cut -f3); do
    [ -n "$(user_panes "$wid")" ] && continue
    [ -n "$(sidebar_pane "$wid")" ] || continue   # a dying window has neither
    tmux kill-window -t "$wid" 2>/dev/null
  done
  return 0
}

cmd_sidebar() { # on | off
  need tmux
  local wid id flag
  case "${1:-}" in
    off)
      : > "$SIDEBAR_OFF"
      tmux list-panes -a -F '#{@kel-sidebar} #{pane_id}' 2>/dev/null \
        | while read -r flag id; do [ "$flag" = 1 ] && tmux kill-pane -t "$id" 2>/dev/null; done
      # the bar comes back, with where the focused pane stands (--here)
      tmux set-option -u -t "=$KEL_PREFIX:" status 2>/dev/null
      say "sidebar off — kel sidebar on brings it back" ;;
    on)
      rm -f "$SIDEBAR_OFF"
      sidebar_enabled || die "the sidebar is disabled by sidebar = off in config.toml (or KEL_SIDEBAR)"
      for wid in $(kel_windows | cut -f3); do sidebar_ensure "$wid"; done
      say "sidebar on" ;;
    *) die "usage: kel sidebar on|off" ;;
  esac
}

# move the caller to a window, in whichever kel session holds it
goto_window() { # wid
  local wid="$1" s
  s="$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null || true)"
  if in_tmux; then
    [ -n "$s" ] && tmux switch-client -t "=$s" 2>/dev/null || true
    tmux select-window -t "$wid" 2>/dev/null || true
  elif [ -t 1 ]; then
    tmux attach -t "=${s:-$KEL_PREFIX}" \; select-window -t "$wid"
  fi
  return 0
}

# --------------------------------------------------------------------------
# metadata
# --------------------------------------------------------------------------
# Records live at $SESSIONS_DIR/<group>/<name>.json — keyed by group *and*
# name, so two repos can each have an agent called "docs".
meta_path() { printf '%s/%s/%s.json' "$SESSIONS_DIR" "$1" "$2"; }   # group name

# every record on disk, as  group<TAB>name<TAB>path
all_metas() {
  local d g f nm
  for d in "$SESSIONS_DIR"/*/; do
    [ -d "$d" ] || continue
    g="$(basename "$d")"
    for f in "$d"*.json; do
      [ -e "$f" ] || continue
      nm="$(basename "$f" .json)"
      printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
    done
  done
}

# the record owning a tmux window id, as  group<TAB>name<TAB>path
# By window id AND name, as meta_is_live and kel-fleet match: tmux reuses
# window ids after a server restart and dead records keep theirs, so the id
# alone found whichever record sorted first.  The hook then wrote a live
# agent's Claude session into a dead record, and restore resumed the wrong
# conversation (2026-10-20).  "renamed": the window was renamed by hand, so
# its name no longer says which record it is — the only callers that look a
# record up for exactly that reason (kill, rename) pass it.
stamp_pane() { # pane group name
  tmux set-option -p -t "$1" @kel-agent "$2/$3" \; set-option -p -t "$1" @kel-name "$3" 2>/dev/null || true
}

meta_by_pane() { # pane
  local g nm f wid stamp
  stamp="$(tmux display-message -p -t "$1" '#{@kel-agent}' 2>/dev/null)"
  if [ -n "$stamp" ]; then
    while IFS=$'\t' read -r g nm f; do
      [ "$g/$nm" = "$stamp" ] || continue
      [ "$(jq -r '.pane_id // ""' "$f" 2>/dev/null)" = "$1" ] || continue
      printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0
    done < <(all_metas)
  fi
  wid="$(tmux display-message -p -t "$1" '#{window_id}' 2>/dev/null)" || return 1
  [ -n "$wid" ] && [ "$(agent_pane "$wid")" = "$1" ] || return 1
  local rr; rr="$(meta_by_wid "$wid")" || return 1
  [ -z "$(jq -r '.pane_id // ""' "${rr##*$'\t'}" 2>/dev/null)" ] || return 1
  printf '%s\n' "$rr"
}

meta_by_wid() { # wid [renamed]
  local g nm f wn=''
  if [ "${2:-}" != renamed ]; then
    wn="$(tmux display-message -p -t "$1" '#{window_name}' 2>/dev/null)" || return 1
  fi
  while IFS=$'\t' read -r g nm f; do
    [ "$(jq -r '.window_id // ""' "$f" 2>/dev/null)" = "$1" ] || continue
    [ -z "$wn" ] || [ "$(jq -r '.name // ""' "$f" 2>/dev/null)" = "$wn" ] || continue
    printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0
  done < <(all_metas)
  return 1
}

# rewrite a record through jq, atomically.  A private temp file: two writers
# sharing "$f.t" (the hook, PreCompact, restore) could each move the other's
# half-written copy into place.
meta_update() { # path jq-filter [jq args...]
  local f="$1" filter="$2" tmp; shift 2
  tmp="$(mktemp "$f.XXXXXX" 2>/dev/null)" || return 1
  if jq "$@" "$filter" "$f" > "$tmp" 2>/dev/null; then mv -f "$tmp" "$f"; else rm -f "$tmp"; return 1; fi
}

# resolve a user-typed agent to  group<TAB>name<TAB>path.
# accepts "name" or "group/name".  A bare name prefers the group you are
# standing in, then a unique match anywhere; exit 2 (candidates on stderr) when
# the same name exists in several groups.
resolve_agent() { # name [preferred-group]
  local want="$1" pref="${2:-}" g nm f hits
  case "$want" in
    */*) g="${want%%/*}"; nm="${want##*/}"; f="$(meta_path "$g" "$nm")"
         [ -f "$f" ] || return 1
         printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0 ;;
  esac
  [ -z "$pref" ] && pref="$(current_group)"
  if [ -n "$pref" ] && [ -f "$(meta_path "$pref" "$want")" ]; then
    printf '%s\t%s\t%s\n' "$pref" "$want" "$(meta_path "$pref" "$want")"; return 0
  fi
  hits="$(all_metas | awk -F'\t' -v n="$want" '$2==n')"
  case "$(printf '%s' "$hits" | grep -c .)" in
    0) return 1 ;;
    1) printf '%s\n' "$hits"; return 0 ;;
    *) printf '%s' "$hits" | awk -F'\t' '{printf "  %s/%s\n", $1, $2}' >&2; return 2 ;;
  esac
}

meta_write() { # name wid repo cwd isolation branch agent group pane
  mkdir -p "$SESSIONS_DIR/$8"
  jq -n \
    --arg name "$1" --arg wid "$2" --arg repo "$3" --arg cwd "$4" \
    --arg iso "$5" --arg branch "$6" --arg agent "$7" --arg group "$8" \
    --arg pane "${9:-}" --arg created "$(date -u +%FT%TZ)" \
    '{name:$name, window_id:$wid, pane_id:$pane, repo:$repo, cwd:$cwd, isolation:$iso,
      branch:(if $branch=="" then null else $branch end),
      agent:$agent, group:$group, created_at:$created}' \
    > "$(meta_path "$8" "$1")"
}

# pre-v0.2 records have no .group (derive it from .repo); pre-v0.4.1 records
# sit flat in sessions/ (file them under sessions/<group>/).
migrate_meta() {
  local f nm repo grp dest
  # Existing installs were created before the 0700 rule, so fixing it only in
  # the mkdir branch above would never reach them.  This runs on every
  # non-hot-path command; a chmod on an already-correct dir is one cheap
  # syscall, and doing it here keeps the hot paths free of it.
  chmod 700 "$STATE_DIR" 2>/dev/null
  # v0.10: one session has no "last group" to return to, and kel no longer
  # asks about snapshots, so there is no refusal to remember
  rm -f "$STATE_DIR/last-group" "$STATE_DIR/snapshot-declined"
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    nm="$(basename "$f" .json)"
    grp="$(jq -r '.group // ""' "$f" 2>/dev/null)"
    if [ -z "$grp" ] || [ "$grp" = null ]; then
      repo="$(jq -r '.repo // ""' "$f" 2>/dev/null)"
      if [ -n "$repo" ]; then grp="$(basename "$repo")"; else grp="misc"; fi
      jq --arg g "$grp" '.group = $g' "$f" > "$f.m" 2>/dev/null && mv "$f.m" "$f"
    fi
    slug_ok "$grp" || grp=misc
    mkdir -p "$SESSIONS_DIR/$grp"
    dest="$(meta_path "$grp" "$nm")"
    if [ -e "$dest" ]; then
      warn "two records for '$grp/$nm' — keeping the newer"
      if [ "$f" -nt "$dest" ]; then mv -f "$f" "$dest"; else rm -f "$f"; fi
    else
      mv -f "$f" "$dest"
    fi
  done
  migrate_state
}

migrate_state() {
  tmux has-session -t "=$KEL_PREFIX" 2>/dev/null || return 0
  local f base wid ext pane g nm m
  for f in "$STATE_DIR"/@*.state "$STATE_DIR"/@*.ctx "$STATE_DIR"/@*.edit "$STATE_DIR"/@*.plan "$STATE_DIR"/@*.view "$STATE_DIR"/@*.subs; do
    [ -e "$f" ] || continue
    base="${f##*/}"; wid="${base%.*}"; ext="${base##*.}"
    pane="$(agent_pane "$wid")"
    [ -n "$pane" ] || continue
    [ -e "$STATE_DIR/$pane.$ext" ] && rm -f "$f" || mv -f "$f" "$STATE_DIR/$pane.$ext"
  done
  local st
  for f in "$STATE_DIR"/%*.state; do
    [ -e "$f" ] || continue
    pane="${f##*/}"; pane="${pane%.state}"
    [ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || continue
    [ -n "$(tmux display-message -p -t "$pane" '#{@kel-state}' 2>/dev/null)" ] && continue
    read -r st _ < "$f" && [ -n "$st" ] && tmux set-option -p -t "$pane" @kel-state "$st" 2>/dev/null
  done
  while IFS=$'\t' read -r g nm m; do
    pane="$(jq -r '.pane_id // ""' "$m" 2>/dev/null)"
    if [ -n "$pane" ]; then
      [ "$(tmux display-message -p -t "$pane" '#{@kel-agent}' 2>/dev/null)" = "$g/$nm" ] && stamp_pane "$pane" "$g" "$nm"
      continue
    fi
    wid="$(jq -r '.window_id // ""' "$m" 2>/dev/null)"
    meta_is_live "$m" "$nm" || continue
    pane="$(agent_pane "$wid")"
    [ -n "$pane" ] && meta_update "$m" '.pane_id=$p' --arg p "$pane" && stamp_pane "$pane" "$g" "$nm"
  done < <(all_metas)
  return 0
}

# is a metadata record backed by a live window (same id + name) in any kel session?
meta_is_live() { # path name
  local wid pane; [ -f "$1" ] || return 1
  pane="$(jq -r '.pane_id // ""' "$1")"
  [ -n "$pane" ] && [ "$(tmux display-message -p -t "$pane" '#{session_name} #{@kel-agent}' 2>/dev/null)" \
    = "$KEL_PREFIX $(jq -r '.group // ""' "$1")/$2" ] && return 0
  wid="$(jq -r '.window_id' "$1")"
  kel_windows | awk -F'\t' -v w="$wid" -v n="$2" '$3==w && $4==n {found=1} END{exit !found}'
}

# records with no live window, as  group<TAB>name<TAB>path
dead_sessions() {
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    meta_is_live "$f" "$nm" || printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
  done < <(all_metas)
}

prune_state() {
  local live f wid panes pane
  live="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null; tmux list-panes -a -F '#{pane_id}' 2>/dev/null)"
  [ -n "$live" ] || return 0
  for f in "$STATE_DIR"/*.state "$STATE_DIR"/*.ctx "$STATE_DIR"/*.seen "$STATE_DIR"/*.edit "$STATE_DIR"/*.plan "$STATE_DIR"/*.view "$STATE_DIR"/*.subs; do
    [ -e "$f" ] || continue
    wid="${f##*/}"; wid="${wid%.*}"
    printf '%s\n' "$live" | grep -qxF "$wid" || rm -f "$f"
  done
  # SessionEnd removes a session's own stash entry, including on /clear, which
  # fires it with reason "clear". Nothing fires when a session dies with its
  # terminal — SIGKILL, a closed window, a reboot — and SessionEnd gets a 1.5s
  # budget besides. Those entries name a pane, so a pane that is gone marks an
  # entry that can go with it.
  panes="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)"
  [ -n "$panes" ] || return 0
  for f in "$STASH_DIR"/*; do
    [ -e "$f" ] || continue
    pane="$(cat "$f" 2>/dev/null || true)"
    [ -n "$pane" ] || { rm -f "$f"; continue; }
    printf '%s\n' "$panes" | grep -qxF "$pane" || rm -f "$f"
  done
}

# unpushed commits on HEAD (or target ref), excluding commits on any remote and commits in merged PR heads
worktree_unpushed() { # cwd [ref]
  local extra=()
  local slug; slug="$(repo_slug "$1")"
  if [ -n "$slug" ] && [ -f "$STATE_DIR/pr-cache/${slug//\//__}.sha.json" ]; then
    local m; m="$(jq -r '.[] | select(.merged == true) | .sha' "$STATE_DIR/pr-cache/${slug//\//__}.sha.json" 2>/dev/null || true)"
    if [ -n "$m" ]; then
      local l; l="$(printf '%s\n' "$m" | git -C "$1" cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2 == "commit" { print $1 }')"
      if [ -n "$l" ]; then
        while IFS= read -r sha; do [ -n "$sha" ] && extra+=("$sha"); done <<< "$l"
      fi
    fi
  fi
  local target="${2:-HEAD}"
  if has_remote "$1"; then
    git -C "$1" log --oneline "$target" --not --remotes ${extra[@]+"${extra[@]}"} 2>/dev/null || true
  else
    local base=''
    for b in main master; do
      if git -C "$1" rev-parse --verify --quiet "$b" >/dev/null 2>&1; then base="$b"; break; fi
    done
    [ -n "$base" ] && git -C "$1" log --oneline "$target" --not "$base" ${extra[@]+"${extra[@]}"} 2>/dev/null || true
  fi
}

# 0 (true) if the worktree has uncommitted changes or commits on no remote
worktree_unsafe() { # cwd
  [ -d "$1" ] || return 1
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null || true)" ] && return 0
  if has_remote "$1"; then
    [ -n "$(worktree_unpushed "$1")" ] && return 0
  fi
  return 1
}

# what worktree_unsafe found, on stderr: the files, then the unpushed commits
worktree_report() { # cwd
  local d u=''
  d="$(git -C "$1" status --short 2>/dev/null || true)"
  [ -n "$d" ] && { echo "  uncommitted changes:" >&2; echo "$d" | sed 's/^/    /' >&2; }
  has_remote "$1" && u="$(worktree_unpushed "$1")"
  [ -n "$u" ] && { echo "  commits not on any remote:" >&2; echo "$u" | sed 's/^/    /' >&2; }
  return 0
}

# Remove a worktree after the caller has decided it is safe.  Deliberately NOT
# gated on [ -d "$cwd" ]: that skipped a hand-deleted worktree, leaving git's
# record behind and the branch locked ("used by worktree") until someone ran
# `git worktree prune`.  `git worktree remove` handles a missing directory on
# its own (exits 0, clears the entry — checked, not assumed).  `prune` is the
# fallback when remove fails otherwise: it only touches entries whose directory
# is already gone, so it can never be what deletes work.  Prints what it did.
worktree_remove() { # repo cwd force(1|0)
  local f=(); [ "${3:-0}" = 1 ] && f=(--force)
  if git -C "$1" worktree remove ${f[@]+"${f[@]}"} "$2" 2>/dev/null; then
    printf 'removed'
  elif git -C "$1" worktree prune 2>/dev/null; then
    printf 'pruned'
  else
    return 1
  fi
}

# --------------------------------------------------------------------------
# kel new
# --------------------------------------------------------------------------
cmd_new() {
  need tmux; need jq
  local name='' dir='' worktree=0 agent="$KEL_AGENT" start_agent=1 group_override='' extra='' split='' at=''
  while [ $# -gt 0 ]; do
    case "$1" in
      # everything after -- goes to the agent: `kel new fix -- --model sonnet`
      # (the author could not pass Claude a flag from the sidebar). Quoted one
      # by one, since the command is typed into the pane
      --)            shift; while [ $# -gt 0 ]; do extra="$extra $(printf '%q' "$1")"; shift; done; break ;;
      -w|--worktree) worktree=1 ;;
      --group)       shift; group_override="${1:-}"; [ -n "$group_override" ] || die "--group needs a name" ;;
      --agent)       shift; agent="${1:-}"; [ -n "$agent" ] || die "--agent needs a command" ;;
      --no-agent)    start_agent=0 ;;
      --split)       shift; split="${1:-}"
                     case "$split" in right|down) ;; *) die "--split takes right or down" ;; esac ;;
      --at)          shift; at="${1:-}"; [ -n "$at" ] || die "--at needs a pane" ;;
      -*)            die "kel new: unknown flag $1" ;;
      *)             if [ -z "$name" ]; then name="$1"
                     elif [ -z "$dir" ]; then dir="$1"
                     else die "kel new: unexpected argument '$1'"; fi ;;
    esac
    shift
  done
  agent="$agent$extra"
  # a directory instead of a name, so an agent can start anywhere without a
  # shell to cd in first (2026-10-16)
  if [ -z "$dir" ] && [ -d "$name" ] && { ! slug_ok "$name" || [ "$name" = . ] || [ "$name" = .. ]; }; then
    dir="$name"; name=''
  fi
  if [ -n "$dir" ]; then
    [ -d "$dir" ] || die "no such directory: $dir"
    cd "$dir" || die "cannot enter $dir"
  fi

  local repo cwd branch='' isolation='inplace' group
  repo="$(git_root || true)"
  group="${group_override:-$(group_for_cwd)}"
  slug_ok "$group" || die "group '$group' is not a slug — pass --group"
  if [ -z "$name" ]; then
    if [ "$worktree" = 1 ]; then name="$(next_name "$group" "$repo")"; else name="$(next_name "$group")"; fi
  fi
  slug_ok "$name" || die "name must be a slug (A-Z a-z 0-9 . _ -)"

  # names only have to be unique within their group
  if [ -f "$(meta_path "$group" "$name")" ]; then
    if meta_is_live "$(meta_path "$group" "$name")" "$name"; then
      die "agent '$group/$name' already exists (kel kill $group/$name first)"
    fi
    warn "reclaiming the record for '$group/$name' (its window is gone)"
    rm -f "$(meta_path "$group" "$name")"
  fi
  [ -z "$group_override" ] && [ -z "${KEL_GROUP:-}" ] && [ -z "$repo" ] && \
    warn "no git repo here → group 'misc'  (use --group NAME to name it)"

  if [ "$worktree" = 1 ]; then
    [ -n "$repo" ] || die "--worktree must be run inside a git repo"
    branch="$name"
    isolation='worktree'
    local wt_root="${KEL_WORKTREES:-$(dirname "$repo")/.kel-worktrees}"
    mkdir -p "$wt_root"
    cwd="$wt_root/$(basename "$repo")-$name"
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $cwd"; then
      say "reusing existing worktree  $cwd"
    elif [ -e "$cwd" ]; then
      die "path exists but isn't a registered worktree: $cwd"
    else
      say "creating worktree  $cwd  (branch $branch)"
      git -C "$repo" worktree add -b "$branch" "$cwd" >/dev/null \
        || git -C "$repo" worktree add "$cwd" "$branch" >/dev/null \
        || die "git worktree add failed"
      if [ -x "$repo/.kel/setup" ]; then
        say "running .kel/setup"
        if ! ( cd "$cwd" && KEL_REPO="$repo" KEL_WORKTREE="$cwd" "$repo/.kel/setup" ); then
          warn ".kel/setup exited non-zero — the worktree may be incomplete"
        fi
      fi
    fi
  else
    cwd="${repo:-$PWD}"
  fi

  # F: give Claude Code the name YOU chose, so /list-agents, @mentions and
  # kel ls all agree. Claude's own name is auto-generated unless set, so kel's
  # is the more meaningful one. Only for claude — another agent may not take
  # the flag, and guessing would break it.
  case "${agent%% *}" in
    claude|*/claude) agent="$agent --name $name" ;;
  esac

  local wid pane
  if [ -n "$split" ]; then
    at="${at:-${TMUX_PANE:-}}"
    [ -n "$at" ] || die "--split needs --at <pane>, or run it inside the window"
    [ "$(tmux display-message -p -t "$at" '#{session_name} #{@kel-sidebar}' 2>/dev/null)" = "$KEL_PREFIX " ] \
      || die "can only split a pane of yours in kel's session"
    wid="$(tmux display-message -p -t "$at" '#{window_id}')"
    pane="$(tmux split-window "$([ "$split" = right ] && echo -h || echo -v)" -t "$at" -c "$cwd" -P -F '#{pane_id}')"
    [ -n "$pane" ] || die "failed to split $at"
  else
    wid="$(open_window "$name" "$cwd" "$group")"
    [ -n "$wid" ] || die "failed to create tmux window"
    pane="$(agent_pane "$wid")"
  fi

  meta_write "$name" "$wid" "$repo" "$cwd" "$isolation" "$branch" "$agent" "$group" "$pane"
  stamp_pane "$pane" "$group" "$name"
  [ "$start_agent" = 1 ] && tmux send-keys -t "$pane" "$agent" Enter

  say "new agent  $name  [$group]  ($isolation${branch:+, branch $branch}${split:+, split $split})"
  goto_window "$wid"
  [ -n "$split" ] && tmux select-pane -t "$pane" 2>/dev/null
  snapshot
}

# --------------------------------------------------------------------------
# kel kill
# --------------------------------------------------------------------------
cmd_kill() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel kill: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel kill <name> [--force]"
  local orig_name="$name"

  local meta='' wid iso='inplace' cwd='' branch='' repo='' group=''
  local bare="${orig_name##*/}" rr rc=0
  rr="$(resolve_agent "$name")" || rc=$?
  [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel kill <group>/<name>"
  if [ -n "$rr" ]; then
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    # no record under that name — the window may have been renamed since
    # `kel new`.  Find the record owning the window currently named $bare.
    local bw; bw="$(kel_windows | awk -F'\t' -v n="$bare" '$4==n {print $3; exit}')"
    if [ -n "$bw" ]; then
      rr="$(meta_by_wid "$bw" renamed || true)"
      [ -n "$rr" ] && IFS=$'\t' read -r group name meta <<< "$rr"
    fi
  fi
  if [ -n "$meta" ] && [ -f "$meta" ]; then
    wid="$(jq -r '.window_id' "$meta")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    branch="$(jq -r '.branch // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    name="$(jq -r '.name // empty' "$meta")"; name="${name:-$orig_name}"
  else
    wid="$(kel_windows | awk -F'\t' -v n="$bare" '$4==n {print $3; exit}')"
    [ -n "$wid" ] || die "no agent '$orig_name'"
    name="$bare"
    warn "'$name' is an unmanaged window — closing it, no metadata to clean up"
  fi

  if [ "$iso" = "worktree" ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
    warn "refusing to kill '$name' — the worktree has work that isn't safe to lose:"
    worktree_report "$cwd"
    die "commit & push, or run: kel kill $name --force"
  fi

  local kpane='' others=''
  [ -n "$meta" ] && [ -n "$wid" ] && kpane="$(record_pane "$wid" "$meta")"
  [ -n "$kpane" ] && others="$(other_agents "$wid" "$kpane")"
  if [ -n "$others" ]; then
    tmux kill-pane -t "$kpane" 2>/dev/null || true
    [ "$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)" = "$name" ] \
      && tmux rename-window -t "$wid" "${others%%$'\n'*}" 2>/dev/null
  else
    [ -n "$wid" ] && tmux kill-window -t "$wid" 2>/dev/null || true
  fi

  if [ "$iso" = "worktree" ] && [ -n "$repo" ] && [ -n "$cwd" ]; then
    # prune is repo-wide, so "pruned" can undersell (nothing left to prune)
    # but never overclaim removing something still live
    case "$(worktree_remove "$repo" "$cwd" "$force")" in
      removed) say "removed worktree $cwd  (branch $branch kept)" ;;
      pruned)  say "ran git worktree prune on $repo  (branch $branch kept)" ;;
      *)       warn "couldn't remove worktree — do it manually: git -C $repo worktree remove $([ "$force" = 1 ] && printf -- '--force ')$cwd" ;;
    esac
  fi

  rm_agent_state "$kpane" "$wid"
  rm -f "$meta"
  say "killed $name"
  snapshot
}

# --------------------------------------------------------------------------
# kel rename <newname>  — rename the current window and keep metadata in sync
# --------------------------------------------------------------------------
# rename a specific window by id + move its metadata record along with it
rename_agent() { # wid new
  local wid="$1" new="$2" old grp=''
  old="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)"
  [ -n "$old" ] || { warn "kel rename: window $wid is gone"; return 1; }
  [ "$old" = "$new" ] && return 0
  # the group is the window's @kel-group (one session names none)
  grp="$(tmux display-message -p -t "$wid" '#{@kel-group}' 2>/dev/null || true)"
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$new")" ] && \
    { warn "an agent named '$new' already exists in [$grp]"; return 1; }

  tmux rename-window -t "$wid" "$new"

  # move the metadata record if this is a managed agent (by name, or by window id)
  local om='' rr
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$old")" ] && om="$(meta_path "$grp" "$old")"
  if [ -z "$om" ]; then
    rr="$(meta_by_wid "$wid" renamed || true)"
    [ -n "$rr" ] && { grp="${rr%%$'\t'*}"; om="${rr##*$'\t'}"; }
  fi
  if [ -n "$om" ] && [ -f "$om" ]; then
    mkdir -p "$SESSIONS_DIR/$grp"
    local rp; rp="$(jq -r '.pane_id // ""' "$om" 2>/dev/null)"
    jq --arg n "$new" '.name=$n' "$om" > "$(meta_path "$grp" "$new")" && rm -f "$om"
    [ -n "$rp" ] && stamp_pane "$rp" "$grp" "$new"
  fi
  say "renamed '$old' -> '$new'"
  snapshot
}

cmd_rename() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel rename: run this from inside kel"
  local new="${1:-}"
  [ -n "$new" ] || die "usage: kel rename <newname>"
  slug_ok "$new" || die "name must be a slug (A-Z a-z 0-9 . _ -)"
  # the window this pane is in, not "the current window": with one session
  # (v0.10) tmux's notion of current is whichever window was selected last,
  # which renamed the wrong agent the moment two shared a session
  rename_agent "$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}')" "$new"
}

# --------------------------------------------------------------------------
# kel prune
# --------------------------------------------------------------------------
cmd_prune() {
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "kel prune: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "no dead agents"; return 0; }

  local g n meta iso cwd repo removed=0 kept=0
  while IFS=$'\t' read -r g n meta; do
    [ -z "$n" ] && continue
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    if [ "$iso" = worktree ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
      warn "kept '$g/$n' — worktree has unsaved work  (kel kill $g/$n -f)"
      kept=$((kept + 1)); continue
    fi
    if [ "$iso" = worktree ] && [ -n "$repo" ] && [ -n "$cwd" ]; then
      worktree_remove "$repo" "$cwd" "$force" >/dev/null || warn "left worktree $cwd (remove by hand)"
    fi
    rm -f "$meta"
    removed=$((removed + 1))
  done <<< "$names"

  say "pruned $removed dead agent(s)$([ "$kept" -gt 0 ] && printf ', kept %s' "$kept")"
}

# --------------------------------------------------------------------------
# kel ls
# --------------------------------------------------------------------------
# The fleet document comes from the Go kel-fleet; there is no bash fallback
# any more (v0.10 dropped it — keeping two implementations byte-identical cost
# more than the fallback ever saved).  Missing or failing, it fails LOUDLY: an
# empty fleet would read as "no agents", which is a guess reported as a fact.
#
# Deliberately a stat of one known path, NOT `command -v`.  Looking up a binary
# that does not exist walks all of $PATH, and on WSL2 $PATH carries the Windows
# directories under /mnt/c — that miss measured 62ms.
fleet_json() {
  [ -x "$KEL_FLEET_BIN" ] || die "kel-fleet is not built — run ./install.sh (needs Go)"
  "$KEL_FLEET_BIN" "$@" || die "kel-fleet failed — a stale binary? re-run ./install.sh"
}

cmd_ls() {
  need tmux; need jq
  prune_state
  local doc
  if [ "${1:-}" = "--json" ]; then doc="$(fleet_json --dirty)" || exit 1; else doc="$(fleet_json)" || exit 1; fi
  [ "${1:-}" = "--json" ] || repaint_all "$doc"

  # --json is answered BEFORE the empty check: a consumer asked for JSON and
  # must get JSON, even when the fleet is empty (`agents: []`).  The completion
  # scripts are that consumer, and an English sentence here broke them silently.
  if [ "${1:-}" = "--json" ]; then
    # v0.6: the whole document, not a bare array — .agents is the list
    printf '%s\n' "$doc" | jq .
    return 0
  fi

  if [ "$(printf '%s' "$doc" | jq '.agents | length')" = 0 ]; then
    echo "no agents yet — 'kel new' to start one"
    return 0
  fi

  # dim the header only on a terminal: `kel ls` is piped by scripts and by the
  # suite, and escapes in that stream are noise at best.
  local hdim='' hoff=''
  [ -t 1 ] && { hdim=$'\033[2m'; hoff=$'\033[0m'; }
  printf '%s' "$doc" | jq -r --arg home "$HOME" --arg hd "$hdim" --arg ho "$hoff" '
    def money: (. * 100 | round) as $c | "\($c / 100 | floor).\((($c % 100) | tostring) | if length == 1 then "0" + . else . end)";
    def pad($n): (. // "-") | tostring | . + (" " * ($n - length)) | .[0:$n];
    # WHERE is the on-disk `isolation` field renamed at RENDER time only:
    # "inplace" is the kel term for "the agent edits your checkout", which tells
    # a reader nothing next to "worktree".  Deliberately not migrated on disk —
    # a column unwinds in one commit, a format change needs a migration.
    def where: if . == "inplace" then "repo" else (. // "-") end;
    ( $hd + "  " + ("IDX" | pad(4)) + " " + ("NAME" | pad(24)) + " "
      + ("STATE" | pad(10)) + " " + ("CTX" | pad(5)) + " " + ("WHERE" | pad(11))
      + " " + ("BRANCH" | pad(12)) + "  PATH" + $ho ),
    ( .agents
    | sort_by(.group, (.index // 9999))
    | group_by(.group)[]
    | (.[0].group), ( .[] |
        ( (if .current then "\(.index)*" else (.index // "-" | tostring) end) | pad(4) ) as $ix
      | ( .name + (if (.panes | length) > 1 then " (" + (.panes | join("|")) + ")" else "" end) | pad(24) ) as $nm
      | ( (.state // "-") | pad(10) ) as $st
      | ( (if .context.pct == null then "-" else "\(.context.pct)%" end) | pad(5) ) as $cx
      # 11, not 10: "(unmanaged)" is exactly 11 characters and pad() truncates
      | ( (if .managed then (.isolation | where) else "(unmanaged)" end) | pad(11) ) as $iso
      | ( (.branch // "-") | pad(12) ) as $br
      | ( (.cwd // "") | sub("^" + $home; "~") ) as $cw
      | ( if (.context.cost_usd // 0) > 0 then "  $" + (.context.cost_usd | money) else "" end ) as $cost
      | "  \($ix) \($nm) \($st) \($cx) \($iso) \($br)  \($cw)\($cost)" ),
      "" )' | sed '$d'

  if [ -n "$(printf '%s' "$doc" | jq -r '.agents[] | select(.window_id == null) | .name')" ]; then
    echo "  dead = window gone.  kel restore rebuilds  ·  kel prune discards"
  fi
  return 0
}

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
# the shell string that resumes a record's agent, or starts it fresh.
# By session id when a hook recorded one; else by the session's NAME, which
# `kel new` gives it (`claude --name <name>`) and `--resume` also accepts.
# Never `--continue`: it resumes "the most recent conversation in the current
# directory", so two agents sharing one resumed the same conversation.
agent_resume_cmd() { # record
  local agent cid name
  agent="$(jq -r '.agent // "claude"' "$1" 2>/dev/null)"; agent="${agent:-claude}"
  cid="$(jq -r '.claude_session // ""' "$1" 2>/dev/null)"
  name="$(jq -r '.name // ""' "$1" 2>/dev/null)"
  case "$agent" in
    *" --name $name"|*" --name $name "*) ;;   # named: --resume <name> finds it
    *) name='' ;;                              # not ours to name: start fresh
  esac
  if [ -n "$cid" ]; then printf '%s --resume %s || %s' "$agent" "$cid" "$agent"
  elif [ -n "$name" ]; then printf '%s --resume %s || %s' "$agent" "$name" "$agent"
  else printf '%s' "$agent"; fi
}

# --------------------------------------------------------------------------
# kel snapshot  — save the whole workspace shape (windows/panes/layouts)
# --------------------------------------------------------------------------
# Format v2 (v0.10):  {version:2, saved_at, saved_epoch, last,
#                      windows:[{name, group, layout, panes:[{cwd,cmd}]}]}
# in window order.  v1 keyed windows by group — one tmux session per repo —
# which lost the order across groups; restore still reads v1 (see below).
# saved_epoch is written here rather than derived later: parsing saved_at
# back needs GNU `date -d` or BSD `date -j`, which disagree (CLAUDE.md,
# portability).  `last` is the index of the window you were looking at.
snapshot() {   # silent; called by hooks and state-changing commands
  # A restore owns snapshot.json while it runs (see restore_from_snapshot).
  # This has to be a lockfile, not an env var: the tmux hooks that call us
  # spawn a fresh `kel` from the server, which inherits nothing.  A lock left
  # behind by a killed restore goes stale after five minutes.
  if [ -e "$RESTORE_LOCK" ]; then
    # the lock carries the epoch the restore started — no stat(1), whose flag
    # for mtime differs between GNU (-c %Y) and BSD (-f %m)
    local lock_ts=''; read -r lock_ts < "$RESTORE_LOCK" 2>/dev/null || true
    case "${lock_ts:-}" in ''|*[!0-9]*) lock_ts=0 ;; esac
    [ $(( $(date +%s) - lock_ts )) -lt 300 ] && return 0
    rm -f "$RESTORE_LOCK"
  fi
  command -v tmux >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0

  # Two tmux calls (every window, every pane), one awk to join them, ONE jq
  # to assemble — the v1 writer forked a jq per pane.  tmux emits tabs (it
  # escapes control characters in format output, so it cannot emit \037
  # itself); awk splits on tabs, which keeps empty fields, and re-joins on
  # \037 for jq.  An empty group is why: it is exactly the field
  # IFS=$'\t' read would silently drop (CLAUDE.md, traps).
  local US=$'\037' TAB=$'\t' cur lines
  cur="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  lines="$(awk -F'\t' -v US="$US" -v cur="$cur" '
      NR == FNR { n[$1]++; pc[$1, n[$1]] = $3; pm[$1, n[$1]] = $4; ps[$1, n[$1]] = $5; pa[$1, n[$1]] = $6; next }
      { print "W" US $5 US $6 US $7 US ($4 == cur ? "1" : "")
        for (i = 1; i <= n[$4]; i++) print "P" US pc[$4, i] US pm[$4, i] US ps[$4, i] US pa[$4, i] }' \
    <(tmux list-panes -a -F '#{window_id}	#{pane_index}	#{pane_current_path}	#{pane_current_command}	#{@kel-sidebar}	#{@kel-agent}' 2>/dev/null) \
    <(tmux list-windows -t "=$KEL_PREFIX" -F '0	#{session_name}	#{window_index}	#{window_id}	#{window_name}	#{window_layout}	#{@kel-group}' 2>/dev/null \
      | sort -t"$TAB" -k3,3n))"
  [ -n "$lines" ] || return 0

  local snap
  snap="$(printf '%s\n' "$lines" \
    | jq -Rn --arg t "$(date -u +%FT%TZ)" --argjson e "$(date +%s)" --arg us "$US" '
        reduce (inputs | split($us)) as $r ({windows: [], last: -1};
          if $r[0] == "W" then
            (if $r[4] == "1" then .last = (.windows | length) else . end)
            | .windows += [{name: $r[1], layout: $r[2], group: $r[3], panes: []}]
          else .windows[-1].panes += [{cwd: $r[1], cmd: $r[2]}
                                     + (if $r[3] == "1" then {sidebar: true} else {} end)
                                     + (if ($r[4] // "") != "" then {agent: $r[4]} else {} end)] end)
        | {version: 2, saved_at: $t, saved_epoch: $e, last: .last, windows: .windows}')" || return 0
  [ "$(printf '%s' "$snap" | jq '.windows | length' 2>/dev/null)" -gt 0 ] 2>/dev/null || return 0

  local tmp; tmp="$(mktemp "$STATE_DIR/.snap.XXXXXX" 2>/dev/null)" || return 0
  [ -f "$SNAPSHOT" ] && cp -f "$SNAPSHOT" "$SNAPSHOT.prev" 2>/dev/null
  printf '%s' "$snap" > "$tmp" && mv -f "$tmp" "$SNAPSHOT"
}

cmd_snapshot() { need tmux; need jq; snapshot; say "snapshot -> ${SNAPSHOT/#$HOME/\~}"; }

# --------------------------------------------------------------------------
# the archive  —  restore by choice (v0.10)
# --------------------------------------------------------------------------
# Until v0.10, `kel` stopped on a rebuild prompt whenever a snapshot existed
# and the server was down — every first `kel` after a reboot, whatever you
# came to do.  The author never understood what it was asking and just wanted
# to move on.  Now `kel` always just opens, and `kel restore` brings a previous
# workspace back, the way `claude --resume` does.
#
# The catch that makes this more than deleting a prompt: the snapshot hooks
# rewrite snapshot.json within seconds of anything changing, so starting fresh
# would silently destroy the old workspace.  So before a fresh start, kel moves
# it here.  Newest five kept.  File names are the archive epoch, so a numeric
# sort on the name is a sort by age — no stat(1), no sort -V.
archive_snapshot() {
  [ -f "$SNAPSHOT" ] || return 1
  mkdir -p "$SNAPSHOT_ARCHIVE" || return 1
  local t; t="$(date +%s)"
  while [ -e "$SNAPSHOT_ARCHIVE/$t.json" ]; do t=$((t + 1)); done
  mv -f "$SNAPSHOT" "$SNAPSHOT_ARCHIVE/$t.json" || return 1
  local f
  archived_snapshots | tail -n +6 | while read -r f; do rm -f "$f"; done
  return 0
}

# archived snapshots, newest first, one path per line
archived_snapshots() {
  [ -d "$SNAPSHOT_ARCHIVE" ] || return 0
  local f n
  for f in "$SNAPSHOT_ARCHIVE"/*.json; do
    [ -e "$f" ] || continue
    n="${f##*/}"; n="${n%.json}"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    printf '%s\n' "$f"
  done | awk -F/ '{n=$NF; sub(/\.json$/,"",n); print n"\t"$0}' | sort -t"$(printf '\t')" -k1,1nr | cut -f2-
}

# what `kel restore` can bring back, newest first: the last workspace's own
# snapshot.json while no kel session is running (nothing has replaced it
# yet), then the archive
restore_candidates() {
  [ -f "$SNAPSHOT" ] && [ -z "$(kel_sessions)" ] && printf '%s\n' "$SNAPSHOT"
  archived_snapshots
}

# window count and names of a v1 or v2 snapshot, tab-separated
snapshot_summary() { # file
  jq -r '(if .version == 2 then [.windows[].name]
          else [.groups[][].name] end) as $n
         | "\($n | length)\t\($n | join(" "))"' "$1" 2>/dev/null
}

restore_list() {
  local i=0 f n names ep age now; now="$(date +%s)"
  while read -r f; do
    [ -n "$f" ] || continue
    i=$((i + 1))
    IFS=$'\t' read -r n names < <(snapshot_summary "$f")
    ep="$(jq -r '.saved_epoch // empty' "$f" 2>/dev/null)"
    case "$ep" in
      ''|*[!0-9]*) age="$(jq -r '.saved_at // "?"' "$f" 2>/dev/null)" ;;
      *)           age="$(humanize_secs $((now - ep))) ago" ;;
    esac
    printf '  %d  %-10s %2s window(s)  %s\n' "$i" "$age" "${n:-?}" "${names:-}"
  done < <(restore_candidates)
  [ "$i" -gt 0 ] || { say "no saved workspace to restore"; return 0; }
  echo "  kel restore [<n>]   bring one back (newest is 1)"
}

# Close the shell a fresh `kel` opened, if it was never used — otherwise every
# "start fresh, then kel restore" leaves an empty window beside the restored
# agents.  Conservative on purpose: only a window kel marked (@kel-welcome),
# with one pane of the user's, still at a bare shell, whose prompt appears
# exactly once in its whole history: after any command, an earlier line starts
# with the same prompt ("me@host:~$ ls").  Not a line count — a login banner
# (Ubuntu's sudo hint, a MOTD) makes a fresh shell three lines or thirty.  Not
# "no scrollback" either: adding the sidebar narrows the pane, and a wrapped
# banner line spills into history.  -J joins wrapped lines, -S - reads it all.
#
# Not window_activity, which the first version used: a visible sidebar
# redraws every two seconds, so with the sidebar (M2) every window looks used.
close_untouched_welcome() {
  local wid born cmd p lines prompt
  tmux list-windows -t "=$KEL_PREFIX" -F '#{window_id}|#{@kel-welcome}|#{pane_current_command}' 2>/dev/null \
  | while IFS='|' read -r wid born cmd; do
      case "$born" in ''|*[!0-9]*) continue ;; esac
      [ "$(user_panes "$wid" | grep -c .)" = 1 ] || continue
      IFS='|' read -r p cmd <<< "$(user_panes "$wid")"
      case "$cmd" in bash|zsh|fish|sh|dash) ;; *) continue ;; esac
      lines="$(tmux capture-pane -p -J -S - -t "$p" 2>/dev/null)"
      prompt="$(printf '%s\n' "$lines" | grep . | tail -1)"
      [ -n "$prompt" ] || continue
      [ "$(printf '%s\n' "$lines" | awk -v p="$prompt" 'index($0, p) == 1' | grep -c .)" = 1 ] || continue
      tmux kill-window -t "$wid" 2>/dev/null || true
    done
}

# rebuild a workspace from a v1 or v2 snapshot (windows, splits, layout, agents)
restore_from_snapshot() {   # file resume(1|0)
  need tmux; need jq
  local src="$1" resume="${2:-1}"
  [ -f "$src" ] || { warn "no snapshot to restore"; return 1; }

  # Rebuilding the workspace fires tmux's own after-split-window / pane-exited
  # hooks, which run `kel snapshot` in the background — that would write the
  # half-rebuilt workspace over snapshot.json while we are still reading it,
  # truncating the restore and destroying the record of everything not yet
  # rebuilt.  Hold the lock so those writes stand down, and read from a private
  # copy so nothing can move underneath us either way.
  date +%s > "$RESTORE_LOCK"
  local snap
  snap="$(mktemp "$STATE_DIR/.snapin.XXXXXX" 2>/dev/null)" \
    || { rm -f "$RESTORE_LOCK"; warn "no scratch space to restore from"; return 1; }
  cp -f "$src" "$snap"

  # One jq pass flattens v1 or v2 into lines:  W name group layout last
  # followed by  P cwd cmd  per pane.  \037-separated for the same reason as
  # the writer: group may be empty.  A v1 snapshot is a v0.9 one, a session
  # per group; flattening it is what restores it into the one session.
  local US=$'\037' plan
  plan="$(jq -r --arg us "$US" '
      . as $s
      | ( if (.version // 1) == 2 then
            [ .windows | to_entries[] | .value + {last: (.key == ($s.last // -1))} ]
          else
            [ .groups | to_entries[] | .key as $g | .value[]
              | . + {group: $g,
                     last: ($g == ($s.last_group // "") and .name == ($s.last_window // ""))} ]
          end )[]
      | (["W", .name, (.group // ""), (.layout // ""), (if .last then "1" else "" end)] | join($us)),
        (.panes[] | ["P", (.cwd // ""), (.cmd // ""), (if .sidebar then "1" else "" end), (.agent // "")] | join($us))' "$snap" 2>/dev/null)"

  local first_wid='' dest_wid='' wid='' wname='' wg='' wlayout='' wlast='' meta='' wsb=''
  local -a cwds=() cmds=() ags=()
  # build one window from what has been collected for it
  _restore_window() {
    [ -n "$wname" ] || return 0
    # already live in kel? leave it — a restore into a running workspace only
    # adds what is missing
    if kel_windows | awk -F'\t' -v n="$wname" -v g="$wg" '$4==n && $5==g {f=1} END{exit !f}'; then
      return 0
    fi
    local p0="${cwds[0]:-$HOME}"; [ -d "$p0" ] || p0="$HOME"
    # bare: the sidebar goes in at a point chosen against the saved layout,
    # whose pane count has to match.  Saved WITH a sidebar: add it first, as
    # the top-left pane it was.  Saved WITHOUT one (a v0.9 / M0 / M1 snapshot):
    # rebuild that layout exactly, then add the sidebar beside it.
    wid="$(open_window "$wname" "$p0" "$wg" bare)" || return 0
    [ -n "$first_wid" ] || first_wid="$wid"
    [ "$wlast" = 1 ] && dest_wid="$wid"
    [ "$wsb" = 1 ] && sidebar_ensure "$wid"
    local -a pids; pids=( "$(agent_pane "$wid")" )
    local j pc
    for ((j = 1; j < ${#cwds[@]}; j++)); do
      pc="${cwds[$j]}"; [ -d "$pc" ] || pc="$HOME"
      pids+=( "$(tmux split-window -t "${pids[$((j - 1))]}" -c "$pc" -P -F '#{pane_id}')" )
    done
    # (saved with a sidebar but sidebars now off: one cell too many, so tmux
    # refuses the layout — the panes are all there, only the geometry is lost)
    [ -n "$wlayout" ] && tmux select-layout -t "$wid" "$wlayout" 2>/dev/null || true
    [ "$wsb" = 1 ] || sidebar_ensure "$wid"

    local ag ag_g ag_n
    for ((j = 0; j < ${#cmds[@]}; j++)); do
      ag="${ags[$j]:-}"
      [ -z "$ag" ] && [ "$j" = 0 ] && [ -n "$wg" ] && ag="$wg/$wname"
      meta=''
      if [ -n "$ag" ]; then
        ag_g="${ag%/*}"; ag_n="${ag##*/}"
        [ -f "$(meta_path "$ag_g" "$ag_n")" ] && meta="$(meta_path "$ag_g" "$ag_n")"
      fi
      if [ -n "$meta" ]; then
        meta_update "$meta" '.window_id=$w | .pane_id=$p' --arg w "$wid" --arg p "${pids[$j]}"
        stamp_pane "${pids[$j]}" "$ag_g" "$ag_n"
        # resuming is why you restore, so it is the default (v0.10); invariant 4's
        # one sanctioned send-keys besides launch
        [ "$resume" = 1 ] && tmux send-keys -t "${pids[$j]}" "$(agent_resume_cmd "$meta")" Enter
        continue
      fi
      case " $KEL_RESTORE_CMDS " in *" ${cmds[$j]} "*) tmux send-keys -t "${pids[$j]}" "${cmds[$j]}" Enter ;; esac
    done
  }

  local kind a b c d
  while IFS="$US" read -r kind a b c d; do
    case "$kind" in
      W) _restore_window
         wname="$a"; wg="$b"; wlayout="$c"; wlast="$d"; wsb=''; cwds=(); cmds=(); ags=() ;;
      P) if [ "$c" = 1 ]; then wsb=1        # the sidebar: relaunched, never replayed
         else cwds+=( "$a" ); cmds+=( "$b" ); ags+=( "$d" ); fi ;;
    esac
  done <<< "$plan"
  _restore_window
  unset -f _restore_window

  # only once something was actually rebuilt — never leave the session empty
  [ -n "$first_wid" ] && close_untouched_welcome
  local dest="${dest_wid:-$first_wid}"
  [ -n "$dest" ] && goto_window "$dest"

  rm -f "$snap" "$RESTORE_LOCK"
  snapshot                     # release the lock, then record what we rebuilt
  say "workspace restored"
}

# --------------------------------------------------------------------------
# kel restore [--list] [<n>] [--no-resume]
# --------------------------------------------------------------------------
cmd_restore() {
  need tmux; need jq
  local resume=1 list=0 pick=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-resume)  resume=0 ;;
      --list|-l)    list=1 ;;
      ''|*[!0-9]*)  die "kel restore: unknown arg $1   (kel restore [--list] [<n>] [--no-resume])" ;;
      *)            pick="$1" ;;
    esac
    shift
  done
  [ "$list" = 1 ] && { restore_list; return; }

  local src
  src="$(restore_candidates | sed -n "${pick:-1}p")"
  if [ -n "$src" ]; then
    restore_from_snapshot "$src" "$resume" || return 1
    # an archived workspace that is live again is not "previous" any more;
    # the running one is snapshotted to snapshot.json as usual
    case "$src" in "$SNAPSHOT_ARCHIVE"/*) rm -f "$src" "$STATE_DIR/restore-offer" ;; esac
    return 0
  fi
  [ -n "$pick" ] && die "no saved workspace #$pick — see kel restore --list"

  # no snapshot anywhere: rebuild the dead records, one window each
  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "nothing to restore"; return 0; }

  local n meta cwd grp wid='' restored=0
  while IFS=$'\t' read -r grp n meta; do
    [ -z "$n" ] && continue
    cwd="$(jq -r '.cwd // ""' "$meta")"
    [ -d "$cwd" ] || { warn "skip $n — its directory is gone ($cwd)"; continue; }
    wid="$(open_window "$n" "$cwd" "$grp")" || { warn "skip $n — couldn't open a window"; continue; }
    meta_update "$meta" '.window_id=$w | .pane_id=$p' --arg w "$wid" --arg p "$(agent_pane "$wid")"
    stamp_pane "$(agent_pane "$wid")" "$grp" "$n"
    [ "$resume" = 1 ] && tmux send-keys -t "$(agent_pane "$wid")" "$(agent_resume_cmd "$meta")" Enter
    restored=$((restored+1))
  done <<< "$names"

  [ "$resume" = 1 ] && say "restored $restored agent(s) — resuming" \
                    || say "restored $restored agent(s) — not started"
  [ -n "$wid" ] && goto_window "$wid"
  snapshot
}

# --------------------------------------------------------------------------
# kel relaunch [name] [-f]  — relaunch a crashed agent in its existing window
# --------------------------------------------------------------------------
# Named `restart` until v0.9. Two letters from `restore`, and both are about
# recovery, so the pair had to be read carefully every time to tell "this one
# agent, its existing window" from "the whole workspace, from the snapshot".
# `kel res<TAB>` completed to neither; now `kel rel<TAB>` and `kel res<TAB>`
# each resolve uniquely.
# --------------------------------------------------------------------------
# v0.4 made a crashed agent visible (`dead`) but gave no way out of it short of
# a workspace-wide `kel restore`.  This is the exit: same window, same worktree,
# same branch, same conversation — nothing else touched.
cmd_relaunch() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel relaunch: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done

  local group meta wid rr rc=0
  if [ -z "$name" ]; then
    [ -n "${TMUX:-}" ] || die "usage: kel relaunch <name>   (or run it from inside the agent's window)"
    wid="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}' 2>/dev/null)"   # this pane's window — see cmd_rename
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] || die "this window isn't a managed agent"
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    rr="$(resolve_agent "$name")" || rc=$?
    [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel relaunch <group>/<name>"
    [ -n "$rr" ] || die "no agent '$name'"
    IFS=$'\t' read -r group name meta <<< "$rr"
    wid="$(jq -r '.window_id' "$meta")"
  fi

  tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qxF "$wid" \
    || die "'$group/$name' has no live window — 'kel restore' rebuilds it"

  # Relaunching a live agent would leave two of them fighting over one pane.
  # Ask the pane, not the state file: a freshly-started agent has no .state
  # yet, and trusting that would double-launch it.
  local st pane
  pane="$(record_pane "$wid" "$meta")"
  [ -n "$pane" ] || die "'$group/$name' has no pane to relaunch in"
  st="$(effective_state "$pane")"
  if agent_alive "$pane" && [ "$force" != 1 ]; then
    die "'$group/$name' still has a live process (state: ${st:-unknown}) — kel relaunch $name -f to force it"
  fi

  local cid
  cid="$(jq -r '.claude_session // ""' "$meta")"

  # drop the stale reading; the relaunched agent's SessionStart sets it again
  rm -f "$STATE_DIR/$pane.state" "$STATE_DIR/$pane.ctx" "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
  tmux set-option -pu -t "$pane" @kel-state 2>/dev/null
  tmux send-keys -t "$pane" "$(agent_resume_cmd "$meta")" Enter
  tmux refresh-client -S 2>/dev/null || true
  say "relaunching $group/$name${cid:+  (resuming $cid)}"
}

# --------------------------------------------------------------------------
# kel sweep [-n] [-f]   — close out everything that has actually landed
# --------------------------------------------------------------------------
# kel kill and kel prune are one-at-a-time.  Finish five worktree agents and
# the sidebar becomes a graveyard you clear one command at a time.
#
# Sweeps an agent only when it is finished AND its work is somewhere other than
# that worktree — `land` already computes exactly that, so `merged` IS the
# predicate.  Everything else is REPORTED, never touched: the rule from kel
# kill holds, and deleting an agent's only copy of real work is the one
# unforgivable bug in this category of tool.
# why a finished agent or worktree is kept, in words: one table for both
land_why() { # land code
  case "$1" in
    dirty)    printf 'uncommitted work' ;;
    unpushed) printf 'commits that are only here' ;;
    review)   printf 'its PR is still open' ;;
    no_pr)    printf 'no PR — nothing has merged it' ;;
    behind)   printf 'behind its base, not merged' ;;
    unknown)  printf 'gh could not say whether it merged' ;;
    *)        printf 'not merged' ;;
  esac
}

# real_dir PATH — the path with symlinks resolved (macOS's /var is
# /private/var, and git prints the resolved one); as given when it is gone
real_dir() { ( cd "$1" 2>/dev/null && pwd -P ) || printf '%s' "$1"; }

# sweep_worktree DOC PATH DRY — close out one linked worktree that has landed
# (phase 2: worktrees are listed whether a window is open there or not, so
# cleaning one must not need a window either). Never forces: the land check
# says merged, and `git worktree remove` without --force refuses a worktree
# with changes or untracked files in it — invariant 1, enforced by git. The
# branch goes only if `git branch -d` agrees it is merged; a squash-merged one
# is kept, and said. A worktree whose directory is already gone is pruned.
sweep_worktree() { # doc path dry
  local doc="$1" path dry="$3" info main branch code missing busy rec label
  path="$(real_dir "$2")"
  info="$(printf '%s' "$doc" | jq -r --arg p "$path" '
    [ .repos[]? | . as $r | .worktrees[] | select(.path == $p)
      | $r.root, (.branch // ""), (.land.code // "-"), (.missing | tostring), (.sessions | tostring) ] | .[]')"
  [ -n "$info" ] || { warn "not a worktree of a repo kel can see: $path"; return 1; }
  main="$(printf '%s\n' "$info" | sed -n 1p)";   branch="$(printf '%s\n' "$info" | sed -n 2p)"
  code="$(printf '%s\n' "$info" | sed -n 3p)";   missing="$(printf '%s\n' "$info" | sed -n 4p)"
  label="${branch:-$(basename "$path")}"
  case "$(printf '%s\n' "$info" | sed -n 5p)" in
    0) ;;
    -1) warn "kept  $label  — Claude Code could not say whether a session is using it"; return 1 ;;
    *)  warn "kept  $label  — a Claude Code session is working there"; return 1 ;;
  esac
  if [ "$missing" = true ]; then
    [ "$dry" = 1 ] && { say "would prune  $label  (its directory is gone)"; return 0; }
    git -C "$main" worktree prune && say "pruned  $label  (its directory was gone)"
    return 0
  fi
  if [ "$code" != merged ]; then
    warn "kept  $label  — $(land_why "$code")"
    return 1
  fi
  # a kel agent there: finished, it is closed with its window by kel kill
  # (which checks again); still running, the worktree stays
  rec="$(printf '%s' "$doc" | jq -r --arg p "$path" '
    .agents[] | select(.managed and .window_id != null and .cwd != null)
    | select(.cwd as $c | $c == $p or ($p | endswith($c | sub("^/private"; ""))))
    | "\(.group)/\(.name)\t\(.state // "-")"' | head -1)"
  if [ -n "$rec" ]; then
    case "${rec#*$'\t'}" in
      done|dead|idle) ;;
      *) warn "kept  $label  — ${rec%%$'\t'*} is ${rec#*$'\t'} there"; return 1 ;;
    esac
  fi
  busy="$(printf '%s' "$doc" | jq -r --arg p "$path" --arg rec "${rec%%$'\t'*}" '
    [ .panes[]? | select(.cwd == $p or (.cwd | startswith($p + "/"))) ] as $ps
    | [ .agents[] | select("\(.group)/\(.name)" == $rec) | .window_id ] as $own
    | [ $ps[] | select(.window_id as $w | $own | index($w) | not) | .window_name ] | unique | join(", ")')"
  if [ -n "$busy" ]; then
    warn "kept  $label  — a window is open there ($busy)"
    return 1
  fi
  if [ "$dry" = 1 ]; then say "would sweep  $label  (merged)"; return 0; fi
  if [ -n "$rec" ]; then
    "$SELF" kill "${rec%%$'\t'*}" >/dev/null 2>&1 || { warn "kept  $label  — kel kill refused"; return 1; }
  fi
  if [ -d "$path" ]; then
    local err; err="$(git -C "$main" worktree remove "$path" 2>&1)" \
      || { warn "kept  $label  — git: ${err##*: }"; return 1; }
  fi
  if [ -n "$branch" ] && git -C "$main" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    if git -C "$main" branch -d "$branch" >/dev/null 2>&1; then
      say "swept  $label  (worktree and branch)"
    elif [ -z "$(worktree_unpushed "$main" "refs/heads/$branch")" ] && git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
      say "swept  $label  (worktree and branch)"
    else
      say "swept  $label  (worktree; branch kept — git does not see it merged, e.g. a squash merge)"
    fi
  else
    say "swept  $label"
  fi
}

cmd_sweep() {
  need tmux; need jq
  local dry=0 force=0 one=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -f|--force)   force=1 ;;
      -*)           die "kel sweep: unknown flag $1" ;;
      *)            [ -z "$one" ] || die "kel sweep takes one worktree at most"; one="$1" ;;
    esac
    shift
  done

  # --worktrees: every repo's worktrees, asked fresh — sweep acts on it
  local doc; doc="$(fleet_json --land --pr --worktrees)" || exit 1
  if [ -n "$one" ]; then
    sweep_worktree "$doc" "$one" "$dry"
    return
  fi
  local swept=0 kept=0 ok g nm code st

  # every finished agent, once: "1" to sweep — merged, or with -f any code
  # but the ones that mean work is here (dirty, unpushed) or that cannot be
  # told (unknown, behind) — else "0" and kept, with why.  kel kill still
  # checks again before it closes anything (invariant 1).
  while IFS=$'\t' read -r ok g nm st code; do
    [ -n "$nm" ] || continue
    if [ "$ok" != 1 ]; then
      warn "kept  $g/$nm  — $(land_why "$code")"; kept=$((kept+1)); continue
    fi
    if [ "$dry" = 1 ]; then
      say "would sweep  $g/$nm  ($st, $code)"
    else
      "$SELF" kill "$g/$nm" >/dev/null 2>&1 \
        && { say "swept  $g/$nm  ($code)"; } \
        || { warn "could not sweep $g/$nm"; kept=$((kept+1)); continue; }
    fi
    swept=$((swept+1))
  done < <(printf '%s' "$doc" | jq -r --argjson force "$([ "$force" = 1 ] && echo true || echo false)" '
    .agents[]
    | select(.managed)
    | select(.state == "done" or .state == "dead")
    | (.land.code // "") as $c
    | (if $c == "merged" or ($force and ($c == "clean" or $c == "no_pr" or $c == "review")) then "1" else "0" end) as $ok
    | [$ok, .group, .name, (.state // "-"), (.land.code // "-")] | @tsv')

  # then worktrees no window stands in — kel's, Claude Code's, or made by
  # hand — that have landed, or whose directory is gone. Anything else is
  # left alone without a word: an unmerged worktree nobody has open is
  # normal, not something to be warned about on every sweep
  local wt
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    if sweep_worktree "$doc" "$wt" "$dry"; then swept=$((swept+1)); else kept=$((kept+1)); fi
  done < <(printf '%s' "$doc" | jq -r '
    [ .panes[]?.cwd ] as $open
    | .repos[]?.worktrees[]
    | select(.missing or (.land.code // "") == "merged")
    | select(.path as $p | [ $open[] | select(. == $p or startswith($p + "/")) ] | length == 0)
    | .path')

  if [ "$swept" = 0 ] && [ "$kept" = 0 ]; then
    say "nothing finished to sweep"
  elif [ "$dry" = 1 ]; then
    say "$swept would be swept, $kept kept  (drop -n to do it)"
  else
    say "swept $swept, kept $kept"
  fi
}

# --------------------------------------------------------------------------
# kel doctor
# --------------------------------------------------------------------------
cmd_doctor() {
  need jq
  # A failed probe used to name the problem and stop there, which on a fresh
  # machine is the least useful moment to withhold the fix.  Each probe now
  # carries a remediation, printed only when it fails.  The package manager is
  # resolved once: kel runs on Linux, WSL2 and macOS, and `apt install jq` is
  # actively wrong advice on the Mac.
  # node and gh get their own hints rather than "$pm <name>": the Debian
  # package for node is `nodejs`, and stock Ubuntu has no `gh` at all until you
  # add the GitHub CLI apt repo (install/10-system-tools.sh does).  A hint that
  # does not work is worse than no hint — same rule as the status bar.
  local pm h_node h_gh
  case "$(uname -s)" in
    Darwin) pm="brew install"
            h_node="brew install node"
            h_gh="brew install gh, then gh auth login" ;;
    *)      pm="sudo apt install"
            h_node="fnm, or docs/setup.md §3b"
            h_gh="gh auth login  (gh itself: docs/setup.md §3a, needs its own apt repo)" ;;
  esac

  probe() {   # LABEL HINT CMD...
    local label="$1" hint="$2"; shift 2
    if "$@" >/dev/null 2>&1; then
      printf '  \033[1;32m✓\033[0m %s\n' "$label" >&2; printf 'true'
    else
      printf '  \033[1;31m✗\033[0m %s\n' "$label" >&2
      [ -n "$hint" ] && printf '      \033[2m%s\033[0m\n' "$hint" >&2
      printf 'false'
    fi
  }
  echo "kel doctor" >&2
  local r_tmux r_ver r_popup r_wt r_jq r_node r_claude r_hooks r_sl r_pass r_go r_sb r_gh
  r_tmux=$(probe   "tmux present"                     "$pm tmux" command -v tmux)
  r_ver=$(probe    "tmux >= 3.0"                      "$pm tmux   (kel needs display-popup)" bash -c 'v=$(tmux -V | grep -oE "[0-9]+\.[0-9]+" | head -1); [ -n "$v" ] || exit 1; [ "${v%%.*}" -gt 3 ] || { [ "${v%%.*}" -eq 3 ] && [ "${v#*.}" -ge 0 ]; }')
  r_popup=$(probe  "display-popup available"          "needs tmux 3.0+ — $pm tmux" bash -c 'tmux list-commands 2>/dev/null | grep -q display-popup')
  r_wt=$(probe     "git worktree available"           "$pm git" bash -c 'git worktree -h 2>&1 | grep -q "add"')
  r_jq=$(probe     "jq present"                       "$pm jq" command -v jq)
  r_node=$(probe   "node on PATH"                     "$h_node" command -v node)
  r_claude=$(probe "claude on PATH"                   "install Claude Code — docs/setup.md" command -v claude)
  r_gh=$(probe     "gh authenticated (PR state for sweep, the sidebar)" "$h_gh" gh auth status)
  r_hooks=$(probe  "kel hooks wired in settings.json" "./install.sh   (from the kelsier repo)" bash -c 'jq -e "[.hooks[]?[]?.hooks[]?.command // empty] | any(test(\"kel hook|kel-hook\"))" "$HOME/.claude/settings.json" >/dev/null')
  r_sl=$(probe     "kel statusLine wired (context %)" "./install.sh   (from the kelsier repo)" bash -c 'jq -e ".statusLine.command // \"\" | test(\"kel statusline\")" "$HOME/.claude/settings.json" >/dev/null')
  r_go=$(probe     "kel-fleet built (required)"       "./install.sh   (needs Go — install/20-user-tools.sh)" test -x "$KEL_FLEET_BIN")
  r_sb=$(probe     "kel-sidebar built (required)"     "./install.sh   (needs Go — install/20-user-tools.sh)" test -x "$KEL_SIDEBAR_BIN")
  r_pass=$(probe   "tmux allow-passthrough on"        "tmux/kel.conf sets it — tmux source-file ~/.tmux.conf" bash -c 'tmux start-server \; show -gv allow-passthrough 2>/dev/null | grep -qx on')

  # optional: what the sidebar's popups open. Missing is not a failure — the
  # key says so when pressed — so these are listed, not counted
  local t
  for t in yazi lazygit delta nvim; do
    if command -v "$t" >/dev/null 2>&1; then printf '  \033[1;32m✓\033[0m %s\n' "$t (optional, for the sidebar)" >&2
    else printf '  \033[2m·\033[0m %s\n' "$t not installed (optional — $pm $t)" >&2; fi
  done
  # phase 3's: install/30-extras.sh (or Homebrew on the Mac) installs them all
  for t in glow ccusage freeze; do
    if command -v "$t" >/dev/null 2>&1; then printf '  \033[1;32m✓\033[0m %s\n' "$t (optional)" >&2
    else printf '  \033[2m·\033[0m %s\n' "$t not installed (optional — install/30-extras.sh)" >&2; fi
  done
  if gh extension list 2>/dev/null | grep -q gh-dash; then printf '  \033[1;32m✓\033[0m %s\n' "gh-dash (optional, for G)" >&2
  else printf '  \033[2m·\033[0m %s\n' "gh-dash not installed (optional — gh extension install dlvhdr/gh-dash)" >&2; fi

  # install.sh writes the absolute path of the clone it ran from into
  # settings.json. Move or rename that clone and every hook plus the statusLine
  # silently stops firing, with settings.json still naming the old path.
  r_path=$(probe   "the wired kel path still resolves" "re-run ./install.sh from the clone's current location" \
    bash -c 'p="$(jq -r ".statusLine.command // \"\"" "$HOME/.claude/settings.json" 2>/dev/null | sed "s/ statusline$//")"; [ -n "$p" ] && [ -x "$p" ]')

  # `settings.json` naming a hook is not the same as the hook being allowed to
  # run: managed settings can switch every one of them off while leaving the
  # entries in place, so hooks_wired above would still read true.
  r_managed=$(probe "hooks not disabled by managed settings" "an administrator set allowManagedHooksOnly or disableAllHooks — kel's hooks cannot fire" \
    bash -c 'for m in "/Library/Application Support/ClaudeCode/managed-settings.json" "/etc/claude-code/managed-settings.json"; do
               [ -f "$m" ] || continue
               jq -e "(.disableAllHooks == true) or (.allowManagedHooksOnly == true)" "$m" >/dev/null 2>&1 && exit 1
             done; exit 0')

  # No fetch: doctor must not need the network to answer, and a probe that
  # fetches on every run is a probe people stop running. This reports the gap
  # against the last fetch, and says which that is.
  r_behind=true
  local _kelroot _behind
  _kelroot="$(dirname "$(dirname "$(_real_self)")")"
  if [ -d "$_kelroot/.git" ]; then
    _behind="$(git -C "$_kelroot" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || printf '')"
    if [ -n "$_behind" ] && [ "$_behind" -gt 0 ] 2>/dev/null; then
      printf '  \033[1;33m!\033[0m %s\n' "clone is $_behind commit(s) behind its upstream as of the last fetch" >&2
      printf '      \033[2m%s\033[0m\n' "kel update" >&2
      r_behind=false
    else
      printf '  \033[1;32m✓\033[0m %s\n' "clone is level with its upstream as of the last fetch" >&2
    fi
  else
    printf '  \033[2m·\033[0m %s\n' "not a git clone — kel update does not apply" >&2
  fi

  jq -n --arg d "$(date -u +%FT%TZ)" \
    --argjson tmux "$r_tmux" --argjson ver "$r_ver" --argjson popup "$r_popup" \
    --argjson wt "$r_wt" --argjson jq "$r_jq" --argjson node "$r_node" \
    --argjson claude "$r_claude" --argjson hooks "$r_hooks" --argjson sl "$r_sl" \
    --argjson go "$r_go" --argjson sb "$r_sb" --argjson gh "$r_gh" --argjson pass "$r_pass" \
    --argjson path "$r_path" --argjson managed "$r_managed" --argjson behind "$r_behind" \
    '{checked_at:$d, tmux:$tmux, "tmux>=3.0":$ver, display_popup:$popup,
      git_worktree:$wt, jq:$jq, node:$node, claude:$claude,
      hooks_wired:$hooks, statusline_wired:$sl, go_fleet:$go, go_sidebar:$sb, gh_auth:$gh,
      allow_passthrough:$pass, kel_path:$path, hooks_permitted:$managed,
      up_to_date:$behind}' \
    > "$DOCTOR_CACHE"
  printf '  cached -> %s\n' "${DOCTOR_CACHE/#$HOME/~}" >&2
  case "$r_tmux$r_ver$r_jq$r_go" in *false*) exit 1 ;; esac
}

# --------------------------------------------------------------------------
# kel shell   — a plain window, no agent
# --------------------------------------------------------------------------
# For a server, a test run, or a look around: a window in kel's session at DIR,
# with its sidebar and its repo's group, but no record — it is not an agent,
# so kel kill / sweep / restore's agent replay never treat it as one. The
# sidebar lists it under its space.
cmd_shell() { # [dir]
  need tmux
  local dir="${1:-$PWD}" group wid
  [ -d "$dir" ] || die "no such directory: $dir"
  dir="$(cd "$dir" && pwd -P)"
  group="$(cd "$dir" && group_for_cwd)"
  # in a linked worktree, the repo it belongs to — not the worktree folder's
  # own name, which group_for_cwd (git root's basename) would give
  local common
  common="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null)" && [ -z "${KEL_GROUP:-}" ] \
    && [ "$(cd "$dir" && git rev-parse --absolute-git-dir 2>/dev/null)" != "$(cd "$dir" && cd "$common" 2>/dev/null && pwd)" ] \
    && group="$(basename "$(dirname "$(cd "$dir" && cd "$common" && pwd -P)")")"
  wid="$(open_window "$(basename "$dir")" "$dir" "$group")" || die "failed to create tmux window"
  goto_window "$wid"
}

# --------------------------------------------------------------------------
# kel quit   — close the whole workspace, never the only copy of work
# --------------------------------------------------------------------------
# There was no way to end kel: prefix d leaves every agent running, and
# killing the session by hand skips every check. This is the one command that
# can end several agents at once, so it takes kill's care for all of them
# (invariant 1): any worktree with uncommitted or unpushed work stops it, and
# the refusal names what is at risk. The workspace is snapshotted first, so
# the next `kel` archives it and `kel restore` brings it back — windows,
# splits and conversations.
cmd_quit() { # [-f]
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "usage: kel quit [-f]" ;; esac
  [ -n "$(kel_sessions)" ] || die "kel is not running"
  if [ "$force" != 1 ]; then
    local g n f iso cwd risk=''
    while IFS=$'\t' read -r g n f; do
      iso="$(jq -r '.isolation // ""' "$f" 2>/dev/null)"; cwd="$(jq -r '.cwd // ""' "$f" 2>/dev/null)"
      [ "$iso" = worktree ] && [ -d "$cwd" ] && worktree_unsafe "$cwd" || continue
      risk="$risk $g/$n"
      warn "$g/$n has work that isn't safe to lose:"
      worktree_report "$cwd"
    done < <(all_metas)
    [ -z "$risk" ] || die "refusing to quit —${risk} — commit & push, or: kel quit -f"
  fi
  snapshot
  # the popups' hosted sessions are kel's too, though no filter counts them
  tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^_kelpop_' \
    | while read -r s; do tmux kill-session -t "=$s" 2>/dev/null; done
  local s
  for s in $(kel_sessions); do tmux kill-session -t "=$s" 2>/dev/null; done
  say "kel closed — the workspace is saved: kel, then kel restore"
}

# --------------------------------------------------------------------------
# kel _prompt   — prefix k: kel commands without leaving the agent you are in
# --------------------------------------------------------------------------
# The author types into Claude all day; a kel command needed a shell pane to
# type it in. prefix k opens tmux's prompt as `kel`, and this runs what was
# typed: a one-line answer is a message, anything longer opens in a popup
# rather than view-mode on the pane you are in, which would swallow your keys
# (CLAUDE.md, traps). Words split on spaces; quoting is not supported.
cmd_prompt() { # 'args'
  # split as a shell would split words — quotes kept together, nothing
  # expanded or run: xargs does exactly that, on GNU and BSD alike.
  # `new x --agent "claude --model sonnet"` broke on `read -ra`
  local -a args=()
  local a
  while IFS= read -r -d '' a; do args+=( "$a" ); done \
    < <(printf '%s' "${1:-}" | xargs printf '%s\0' 2>/dev/null)
  [ "${#args[@]}" -gt 0 ] || exit 0
  local out rc
  out="$("$SELF" "${args[@]}" 2>&1)"; rc=$?
  out="$(printf '%s' "$out" | sed 's/\x1b\[[0-9;]*m//g')"
  # KEL_PROMPT_PRINT: the sidebar asked (its `;`), and shows a one-line
  # answer in its own footer — tmux's message line is where the author did
  # not look. A longer one is a popup either way
  if [ "$(printf '%s\n' "$out" | grep -c .)" -le 1 ]; then
    if [ -n "${KEL_PROMPT_PRINT:-}" ]; then printf '%s\n' "${out:-done}"
    else tmux display-message "kel ${args[*]}: ${out:-done}$( [ $rc = 0 ] || printf ' (failed)')"; fi
  else
    local f="$STATE_DIR/prompt.out"
    printf '%s\n' "$out" > "$f"
    popup "$PWD" "kel ${args[*]} · prefix q closes" less -R "$f"
    [ -n "${KEL_PROMPT_PRINT:-}" ] && printf 'shown in a popup\n'
  fi
  return "$rc"
}

# --------------------------------------------------------------------------
# kel url   — where a worktree's dev server is, for scripts and agents
# --------------------------------------------------------------------------
# Read-only and asked for, never told (spec.md §5f, backlog R2): an agent's own
# browser tooling can run `kel url` instead of guessing :3000.  The ports are
# the fleet document's, from the panes standing in that worktree.
cmd_url() { # [dir|agent]
  need jq
  local want="${1:-$PWD}" dir root
  if [ -d "$want" ]; then dir="$want"
  else
    dir="$(fleet_json | jq -r --arg n "$want" '[.agents[] | select(.name == $n) | .cwd // empty] | first // empty')"
    [ -n "$dir" ] && [ -d "$dir" ] || die "no directory or agent called '$want'"
  fi
  # physical paths: tmux reports them, and macOS's /tmp is a symlink
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$dir")"
  root="$(cd "$root" 2>/dev/null && pwd -P)" || die "cannot read $dir"
  local urls
  urls="$(fleet_json --panes | jq -r --arg r "$root" '
    [ .panes[]? | select((.git.root // .cwd) == $r) | (.ports // [])[] ] | unique | .[]
    | "http://localhost:\(.)"')"
  [ -n "$urls" ] || { warn "no server listening in ${root/#$HOME/~}"; return 1; }
  printf '%s\n' "$urls"
}

# --------------------------------------------------------------------------
# kel _panel   — the sidebar's popups (spec.md §5f, invariant 7)
# --------------------------------------------------------------------------
# kel decides where a tool opens and at which directory; the tool does the
# rest.  Every action is here rather than in the sidebar so it is one bash
# function a test can drive, and so a refusal (a missing tool, no base) comes
# back on stderr, which the sidebar shows in its footer.
#
#   _panel files  <dir> <title>          yazi
#   _panel git    <dir> <title>          lazygit
#   _panel diff   <dir> <title> <base>   what changed against the land base
#   _panel edit   <dir> <title> <wid>    the file the agent last touched
#   _panel plan   <dir> <title> <wid>    the agent's plan, then its tasks
#   _panel editor <dir> <title>          nvim at the space, kept between opens
#   _panel attach <dir> <name> <id>      a background agent, `claude attach <id>`
#   _panel browse <url>                  the real browser
cmd_panel() {
  local what="${1:-}"
  [ -n "$what" ] || die "usage: kel _panel files|git|diff|edit|browse ..."
  shift
  [ "$what" = browse ] && { open_url "${1:-}"; return; }
  local dir="${1:-}" title="${2:-}" arg="${3:-}"
  [ -d "$dir" ] || die "no such directory: $dir"
  case "$what" in
    files) need_tool yazi;    KEL_POPUP_KEEP=1 popup "$dir" "yazi · $title · ? its keys · prefix q closes" yazi ;;
    git)   need_tool lazygit; panel_lazygit "$dir" "$title" ;;
    diff)  panel_diff "$dir" "$title" "$arg" ;;
    edit)  panel_edit "$dir" "$title" "$arg" ;;
    plan)  panel_plan "$dir" "$title" "$arg" ;;
    attach) need_tool claude
           # a background agent (`claude --bg`) has no pane: open it here.
           # Kept like yazi — prefix q closes the popup, the agent runs on
           KEL_POPUP_KEEP=1 popup "$dir" "$title · bg · prefix q closes" claude attach "$arg" ;;
    editor) need_tool nvim
           # nvim at the space, kept between opens like yazi and lazygit: your
           # buffers are still there when you come back. `nvim .` opens the
           # directory (oil, or netrw), so there is somewhere to start
           KEL_POPUP_KEEP=1 popup "$dir" "nvim · $title · prefix q closes" nvim . ;;
    usage) panel_usage "$dir" ;;
    dash)  panel_prs "$dir" ;;
    claude) panel_claude "$dir" "$title" ;;
    *)     die "kel _panel: unknown panel '$what'" ;;
  esac
}

need_tool() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }

# u: Claude Code usage, from ccusage — which reads Claude Code's own local
# transcripts, so kel keeps no history of its own (the author wanted none
# stored). The current 5-hour block, then the last two weeks by day, made at
# the popup's width; fresh each time.
panel_usage() { # dir
  need_tool ccusage
  local since
  since="$(date -d '13 days ago' +%Y%m%d 2>/dev/null || date -v-13d +%Y%m%d)"
  # then a prompt for any other report: the two weeks were all you could see
  # (the author). Words only, split as words — nothing is run but ccusage
  popup "$1" "usage · ccusage · q, then another report · prefix q closes" sh -c '
    { ccusage blocks --active --color; echo; ccusage daily --since "$1" --color; } 2>&1 | less -R
    while :; do
      printf "\nanother report — monthly · weekly · session · blocks · daily --since 20261001\nenter on its own closes: "
      read -r r || break
      [ -n "$r" ] || break
      # shellcheck disable=SC2086
      set -f; ccusage $r --color 2>&1 | less -R; set +f
    done' sh "$since"
}

# v: PRs and issues in gh dash, across every repo a space is open in — the
# author wanted all of them, not one at a time — with the selected space's
# repo first when there is one. kel writes the config into its state dir
# each time (gh dash takes one --config, so the user's own is not merged);
# within it, / edits a search and t drops the repo filter, as gh dash does.
panel_prs() { # dir
  need_tool gh
  gh extension list 2>/dev/null | grep -q 'gh-dash' || die "gh-dash is not installed (gh extension install dlvhdr/gh-dash)"
  local here='' slugs r cfg="$STATE_DIR/gh-dash.yml" q
  slugs="$(fleet_json --panes | jq -r '.repos[]?.root' | while read -r r; do repo_slug "$r"; done | sort -u | tr '\n' ' ')"
  [ -n "${1:-}" ] && here="$(repo_slug "$1")"
  [ -n "$slugs$here" ] || die "no GitHub repo is open in a space"
  q="$(for r in $slugs; do printf 'repo:%s ' "$r"; done)"
  {
    printf '# written by kel for its v popup, each time — not your gh-dash config\n'
    printf 'smartFilteringAtLaunch: false\nprSections:\n'
    [ -n "$here" ] && printf '  - title: %s\n    filters: is:open author:@me repo:%s\n' "${here#*/}" "$here"
    printf '  - title: mine, every space\n    filters: is:open author:@me %s\n' "$q"
    printf '  - title: needs my review\n    filters: is:open review-requested:@me %s\n' "$q"
    printf '  - title: all open, every space\n    filters: is:open %s\n' "$q"
    printf 'issuesSections:\n  - title: open, every space\n    filters: is:open %s\n' "$q"
    printf '  - title: assigned to me\n    filters: is:open assignee:@me %s\n' "$q"
  } > "$cfg"
  popup "$HOME" "PRs · every open space · / search · ? its keys · prefix q closes" gh dash --config "$cfg"
}

# c: the Claude Code configuration that applies here, to look at and open —
# never written by kel. yazi, one tab per place: this repo's CLAUDE.md, its
# .claude/ (settings, rules, skills, worktrees), the global ~/.claude with its
# CLAUDE.md, and the project's memory. Each tab exists only if the place does.
panel_claude() { # dir title
  local dir="$1" root mem
  need_tool yazi
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$dir")"
  local -a tabs=()
  if [ -f "$root/CLAUDE.md" ]; then tabs+=( "$root/CLAUDE.md" ); fi
  if [ -d "$root/.claude" ]; then tabs+=( "$root/.claude" ); fi
  if [ -f "$CLAUDE_HOME/CLAUDE.md" ]; then tabs+=( "$CLAUDE_HOME/CLAUDE.md" )
  elif [ -d "$CLAUDE_HOME" ]; then tabs+=( "$CLAUDE_HOME" ); fi
  # Claude Code keys a project's memory by its path, every / and . a -
  mem="$CLAUDE_HOME/projects/$(printf '%s' "$root" | sed 's/[^A-Za-z0-9]/-/g')/memory"
  if [ -d "$mem" ]; then tabs+=( "$mem" ); fi
  [ "${#tabs[@]}" -gt 0 ] || die "no CLAUDE.md, .claude or ~/.claude to show"
  KEL_POPUP_KEEP=1 popup "$root" "claude config · $2 · tabs: 1-${#tabs[@]} · prefix q closes" yazi "${tabs[@]}"
}

# kel shot [agent] — the pane as an image, with freeze. SVG: freeze's PNG
# path crashed (a Go stack overflow) on the author's WSL2, from both a Go
# build and the release, and its .webp came out as SVG under another name —
# so kel asks for what works and names it for what it is.
cmd_shot() { # [agent]
  need tmux; need_tool freeze
  local pane out dir name
  if [ -n "${1:-}" ]; then
    local m; m="$(resolve_agent "$1")" || die "no single agent named '$1' — try group/name"
    pane="$(agent_pane "$(jq -r .window_id "${m##*$'\t'}")")"
  else
    pane="${TMUX_PANE:-}"
  fi
  [ -n "$pane" ] || die "which pane? run it inside kel, or name an agent"
  name="$(tmux display-message -p -t "$pane" '#{window_name}' 2>/dev/null | tr -c 'A-Za-z0-9._\n-' '-')"
  dir="${KEL_SHOT_DIR:-$HOME/Pictures/kel}"; mkdir -p "$dir"
  out="$dir/${name:-pane}-$(date +%Y%m%d-%H%M%S).svg"
  tmux capture-pane -p -e -t "$pane" | freeze -l ansi -o "$out" >/dev/null 2>&1 \
    || die "freeze could not draw the pane"
  [ -s "$out" ] || die "freeze wrote nothing"
  say "$out"
}

# lazygit: esc means "back" everywhere in kel, so in kel's popup it also
# closes lazygit — its quitOnTopLevelReturn, laid over the user's own config
# (lazygit merges a comma-separated list, later files winning), never written
# into it. Without this, esc at lazygit's top level only printed a hint and the
# author could not find the way out.
panel_lazygit() { # dir title
  local own over="$STATE_DIR/lazygit-overlay.yml"
  own="$(lazygit --print-config-dir 2>/dev/null)/config.yml"
  [ -f "$over" ] || printf '# written by kel: esc at the top level closes its popup\nquitOnTopLevelReturn: true\n' > "$over"
  # "? its keys": a tool's own keys are behind its own ?, which the author
  # did not know — gh dash's search looked uneditable until it was named
  if [ -f "$own" ]; then KEL_POPUP_KEEP=1 popup "$1" "lazygit · $2 · ? its keys · prefix q closes" lazygit --use-config-file "$own,$over"
  else KEL_POPUP_KEEP=1 popup "$1" "lazygit · $2 · ? its keys · prefix q closes" lazygit --use-config-file "$over"; fi
}

# tmux_at_least MAJOR MINOR — compared arithmetically: BSD sort has no -V
tmux_at_least() {
  local v; v="$(tmux -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)"
  [ -n "$v" ] || return 1
  [ "${v%%.*}" -gt "$1" ] || { [ "${v%%.*}" -eq "$1" ] && [ "${v#*.}" -ge "$2" ]; }
}

# prefix_words: tmux's prefix as a person says it — C-b is Ctrl-b, M-a Alt-a.
# The author did not know "prefix" meant Ctrl-b; kel never shows either word.
prefix_words() {
  local k; k="$(tmux show-options -gv prefix 2>/dev/null)"
  case "$k" in
    C-*) printf 'Ctrl-%s' "${k#C-}" ;;
    M-*) printf 'Alt-%s' "${k#M-}" ;;
    '')  printf 'Ctrl-b' ;;
    *)   printf '%s' "$k" ;;
  esac
}

# kel _click RANGE POPUP CLIENT — a click on a status line (kel.conf binds
# MouseDown1Status). A popup's bar has `✕ close`; kel's own bar has the
# waiting count, which jumps there. Anything else does what tmux would.
cmd_click() { # range popup client
  case "${1:-}" in
    close) [ "${2:-}" = 1 ] && tmux detach-client -t "${3:-}" 2>/dev/null ;;
    jump)  KEL_CLIENT="${3:-}" "$SELF" jump ;;
    bgo)   banner_go "${3:-}" ;;
    bx)    banner_clear ;;
    unzoom) tmux resize-pane -Z -t "$(tmux display-message -c "${3:-}" -p '#{pane_id}' 2>/dev/null)" 2>/dev/null ;;
  esac
  return 0
}

# ---- the banner ------------------------------------------------------------
# A line above tmux's bar, there only while something needs
# you: `● pr52 is waiting — allow Bash?   ↵ go  ✕`. The author liked how
# Claude Code's desktop app says which agent is blocked, in the app. It
# leaves when you visit that agent, when the agent stops waiting, or on ✕.
# One line per agent in $BANNER: <wid> TAB <state> TAB <name> TAB <text>.
BANNER="$STATE_DIR/banner"

banner_add() { # pane state name text
  local f; f="$(mktemp "$STATE_DIR/.banner.XXXXXX" 2>/dev/null)" || return 0
  { [ -f "$BANNER" ] && awk -F'\t' -v w="$1" '$1 != w' "$BANNER"
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; } > "$f"
  mv -f "$f" "$BANNER"
  banner_apply
}

banner_drop() { # pane | wid ...
  [ -s "$BANNER" ] || return 0
  local f w keep="$BANNER"
  f="$(mktemp "$STATE_DIR/.banner.XXXXXX" 2>/dev/null)" || return 0
  cp "$BANNER" "$f"
  local k wins
  wins="$(tmux list-panes -a -F '#{pane_id} #{window_id}' 2>/dev/null)"
  for w in "$@"; do
    while IFS=$'\t' read -r k _; do
      [ "$k" = "$w" ] && continue
      [ "$(printf '%s\n' "$wins" | awk -v k="$k" '$1 == k {print $2}')" = "$w" ] && continue
      printf '%s\n' "$k"
    done < "$f" > "$f.k"
    awk -F'\t' 'NR == FNR {keep[$0]; next} $1 in keep' "$f.k" "$f" > "$f.t" && mv -f "$f.t" "$f"
    rm -f "$f.k"
  done
  if cmp -s "$f" "$keep"; then rm -f "$f"; return 0; fi
  mv -f "$f" "$BANNER"
  banner_apply
}

banner_clear() { rm -f "$BANNER"; banner_apply; }

# the windows any attached client is looking at: visiting one clears its line
banner_seen() {
  [ -s "$BANNER" ] || return 0
  # shellcheck disable=SC2046
  banner_drop $(tmux list-clients -F '#{window_id}' 2>/dev/null)
}

# ↵ go: to the newest line's agent, on the client that clicked
banner_go() { # client
  [ -s "$BANNER" ] || return 0
  local key wid; key="$(tail -1 "$BANNER" | cut -f1)"
  wid="$(tmux display-message -p -t "$key" '#{window_id}' 2>/dev/null)"; [ -n "$wid" ] || wid="$key"
  if [ -n "${1:-}" ]; then tmux switch-client -c "$1" -t "$wid" 2>/dev/null || tmux select-window -t "$wid" 2>/dev/null
  else tmux select-window -t "$wid" 2>/dev/null; fi
  case "$key" in %*) tmux select-pane -t "$key" 2>/dev/null ;; esac
  banner_drop "$key"
}

# draw it: the newest line, and how many more; or nothing, and tmux's bar
# back to its one line
banner_apply() {
  tmux has-session -t "=$KEL_PREFIX" 2>/dev/null || return 0
  local t="=$KEL_PREFIX:" n line wid st name text more='' word
  # grep -c prints 0 AND exits 1 on an empty file, so `|| echo 0` made n
  # "0\n0": the -eq test below errored, fell through, and drew "● is" from an
  # empty line. `|| true` keeps grep's own 0. Pinned by "...and takes it down
  # when the agent moves on".
  n="$(grep -c . "$BANNER" 2>/dev/null || true)"
  if [ "${n:-0}" -eq 0 ]; then
    tmux set-option -u -t "$t" status-position \; set-option -u -t "$t" status-format[0] \; \
         set-option -u -t "$t" status-format[1] \; set-option -u -t "$t" status 2>/dev/null
    return 0
  fi
  line="$(tail -1 "$BANNER")"
  IFS=$'\t' read -r wid st name text <<< "$line"
  case "$st" in waiting) word="is waiting" ;; done) word="finished" ;; *) word="is $st" ;; esac
  [ "$n" -gt 1 ] && more="#[fg=colour245]  +$((n - 1)) more"
  # the text is Claude Code's — the agent quoting a command back — so every
  # # is doubled: tmux must print it, never read it as a format
  name="${name//#/##}"; text="${text//#/##}"
  [ "${#text}" -gt 80 ] && text="${text:0:79}…"
  # `↵ go` is what a click does; the key is named beside it so the banner
  # teaches it too (the sidebar's footer says the same).  ` is a prefix key:
  # two presses, so "then" — `Ctrl-b \`` read as one chord (2026-10-16).
  local bar; bar="$(tmux show-options -gv 'status-format[0]' 2>/dev/null)"
  tmux set-option -t "$t" status 2 \; \
       set-option -u -t "$t" status-position \; \
       set-option -t "$t" status-format[1] "$bar" \; \
       set-option -t "$t" status-format[0] "#[align=left,bg=default]#{E:@kel-bar-lead}#[range=user|bgo]#[fg=colour214,bold] ● $name#[nobold,fg=colour252] $word${text:+#[fg=colour245] — $text}$more #[norange]#[align=right]#[range=user|bgo]#[fg=colour255,bold] ↵ go #[nobold,fg=colour240]or $(prefix_words) then \` #[norange]#[range=user|bx]#[fg=colour245] ✕ #[norange]" \
       2>/dev/null
}

# popup DIR TITLE CMD... — a titled popup at DIR running CMD.
#
# The popup hosts a small tmux session of its own, `_kelpop_<n>`, and attaches
# to it, instead of running CMD directly. A popup takes every key, prefix
# included, so a tool that hands you to another (yazi opening vim) could trap
# you — `q` then meant vim's `q`. Inside the hosted session tmux's keys work
# again, and `prefix q` (kel.conf) detaches, which closes the popup whatever is
# running. The name starts with `_`, so no kel filter (`kel` or `kel/<group>`)
# ever counts it: not the sidebar, the fleet, a snapshot or a restore.
#
# KEL_POPUP_KEEP=1: reuse the session if the tool is still running, so lazygit
# and yazi reopen where you left them; the tool's own quit ends it. Views of
# something that changes (diff, plan, edit) are made fresh each time.
#
# KEL_POPUP_TRACE records instead of drawing: a popup needs a client with a
# terminal, and the suite has only control-mode clients, which cannot show
# one. Everything up to the draw still runs for real.
popup() {
  local dir="$1" title="$2"; shift 2
  if [ -n "${KEL_POPUP_TRACE:-}" ]; then
    printf '%s\t%s\t%s\n' "$dir" "$title" "$*" >> "$KEL_POPUP_TRACE"
    return 0
  fi
  local cmd='' a name sock="${TMUX%%,*}"
  for a in "$@"; do cmd="$cmd $(printf '%q' "$a")"; done
  cmd="${cmd# }"
  name="_kelpop_$(printf '%s|%s' "$dir" "$1" | cksum | cut -d' ' -f1)"
  [ -n "${KEL_POPUP_KEEP:-}" ] || tmux kill-session -t "=$name" 2>/dev/null
  # `=name:` with the colon where a pane is the target (set-option): without
  # it tmux reads `=name` as a pane and finds no such session
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$dir" "$cmd" \; \
         set-option -t "=$name:" status on \; \
         set-option -t "=$name:" status-style "bg=default,fg=colour245" \; \
         set-option -t "=$name:" status-left-length 60 \; \
         set-option -t "=$name:" status-left "#[range=user|close]#[fg=colour255,bold] ✕ close #[norange]#[fg=colour240] or $(prefix_words) then q" \; \
         set-option -t "=$name:" status-right "" \; \
         set-option -t "=$name:" window-status-format "" \; \
         set-option -t "=$name:" window-status-current-format "" \; \
         set-option -w -t "=$name:" pane-border-status off \; \
         set-option -t "=$name:" @kel-popup 1 >/dev/null 2>&1 \
      || die "could not start $1"
  fi
  # Two E flags, not one: a lone one closes the popup the moment its command
  # exits, a failure included, so its error would never be read ("errors
  # cannot be swallowed" in the suite counts these)
  # KEL_POPUP_NODRAW: everything but the draw — the suite's seam for the
  # hosted session, whose clients are control-mode (one cannot show a popup,
  # and is hung up trying)
  [ -n "${KEL_POPUP_NODRAW:-}" ] && return 0
  # "prefix q" told the author nothing: inside a Claude popup esc and q are
  # Claude's, and the title must name the key that actually closes it
  local pk; pk="$(prefix_words)"
  title="${title//prefix q/$pk then q}"
  local -a opt=( -EE -w "${KEL_POPUP_W:-90%}" -h "${KEL_POPUP_H:-85%}" -d "$dir" -T " $title " )
  tmux_at_least 3 3 && opt+=( -b rounded )            # border styles are 3.3+
  [ -n "${TMUX_PANE:-}" ] && opt+=( -t "$TMUX_PANE" )
  # the inner client is this same server's; $TMUX unset, or tmux refuses to
  # nest. `env -u` is in both GNU and BSD env
  tmux display-popup "${opt[@]}" "env -u TMUX tmux -S $(printf '%q' "$sock") attach -t $(printf '%q' "=$name")"
}

# diff: what the agent changed — committed and uncommitted — against the base
# it is landing on.  No base is said, never shown as an empty diff (invariant 3).
panel_diff() { # dir title base
  local dir="$1" title="$2" base="$3"
  [ -n "$base" ] || die "no base branch — can't diff"
  git -C "$dir" rev-parse --verify --quiet "$base" >/dev/null || die "base $base is not in this repo"
  if git -C "$dir" diff --quiet --merge-base "$base" 2>/dev/null; then
    die "no changes against $base"
  fi
  if command -v nvim >/dev/null 2>&1 && nvim --headless -c 'lua io.write(pcall(require, "diffview") and "y" or "n")' -c 'qa!' 2>/dev/null | grep -q y; then
    popup "$dir" "diff · $title · $base · prefix q closes" nvim -c "DiffviewOpen $base"
  elif command -v delta >/dev/null 2>&1; then
    popup "$dir" "diff · $title · $base · prefix q closes" sh -c 'git diff --merge-base "$1" | delta --paging=always' sh "$base"
  else
    popup "$dir" "diff · $title · $base · prefix q closes" git diff --merge-base "$base"
  fi
}

# edit: the file this window's agent last touched, at its line.  Into an nvim
# already open in that worktree, over the socket every nvim 0.9+ listens on —
# its RPC, not keys typed into a pane (invariant 4) — else a popup.  kel owns
# no editor, so nothing here ever closes one (spec.md §5f).
panel_edit() { # dir title wid
  local dir="$1" title="$2" wid="$3" f path line
  f="$(state_file "$3" edit)"
  [ -n "$wid" ] && [ -f "$f" ] || die "nothing edited yet in this window"
  { read -r path; read -r line; } < "$f"
  case "${line:-}" in ''|*[!0-9]*) line=1 ;; esac
  [ -f "$path" ] || die "$path is gone"
  need_tool nvim
  local root pane sock
  root="$(cd "$dir" 2>/dev/null && pwd -P)"
  if pane="$(nvim_pane_in "$root")" && [ -n "$pane" ] && sock="$(nvim_socket "${pane#* }")" && [ -n "$sock" ]; then
    local q="${path//\'/\'\'}"
    nvim --server "$sock" --remote-expr "execute('edit +$line ' . fnameescape('$q'))" >/dev/null 2>&1 \
      || die "the nvim in that worktree did not answer"
    tmux select-window -t "${pane%% *}" \; select-pane -t "${pane%% *}" 2>/dev/null
    say "opened in your nvim"
  else
    popup "$dir" "nvim · $title · prefix q closes" nvim "+$line" "$path"
  fi
}

# plan: what the agent means to do, then where it is (spec.md §9, "Plan and
# tasks").  The plan is the file its plan-mode Write named (<wid>.plan).
# Tasks are Claude Code's own list for the session, ~/.claude/tasks/<session
# id>/<n>.json, read as they stand rather than rebuilt from hook events.
# Undocumented, so a file that does not parse makes the list read unreadable —
# never a shorter list that looks complete (invariant 3).
panel_plan() { # dir title wid
  local dir="$1" title="$2" wid="$3" plan='' sid tdir view have=0
  local pf; pf="$(state_file "$wid" plan)"
  [ -f "$pf" ] && read -r plan < "$pf"
  sid="$(session_of "$wid")"
  tdir="$CLAUDE_HOME/tasks/$sid"
  [ -n "$plan" ] && have=1
  [ -n "$sid" ] && [ -d "$tdir" ] && have=1
  [ "$have" = 1 ] || die "no plan or task list for this agent"
  view="$(state_file "$wid" view)"
  {
    if [ -z "$plan" ]; then printf '# plan\n\nnone — this session has not written one\n'
    elif [ -f "$plan" ]; then cat "$plan"
    else printf '# plan\n\n%s is gone\n' "$plan"; fi
    printf '\n---\n\n'
    plan_tasks "$sid" "$tdir"
  } > "$view.$$" && mv -f "$view.$$" "$view"
  if command -v glow >/dev/null 2>&1; then popup "$dir" "plan · $title · prefix q closes" glow -p "$view"
  elif command -v bat >/dev/null 2>&1; then popup "$dir" "plan · $title · prefix q closes" bat --paging=always -l md "$view"
  else popup "$dir" "plan · $title · prefix q closes" less -R "$view"; fi
}

# the task list as markdown: ✓ done, ▸ in progress, · pending, and what blocks
# what. Deleted tasks are gone. Each file is checked before the one jq over
# them all: one bad file must not silently drop the rest, nor hide itself.
plan_tasks() { # sid dir
  local sid="$1" tdir="$2" f bad=''
  if [ -z "$sid" ] || [ ! -d "$tdir" ]; then printf '# tasks\n\nno task list — this session keeps none\n'; return; fi
  for f in "$tdir"/*.json; do
    [ -e "$f" ] || continue
    jq -e 'type == "object" and has("status")' "$f" >/dev/null 2>&1 || bad="$bad ${f##*/}"
  done
  if [ -n "$bad" ]; then printf '# tasks\n\nunreadable — has Claude Code changed its format? (%s)\n' "${bad# }"; return; fi
  set -- "$tdir"/*.json
  [ -e "$1" ] || { printf '# tasks\n\nnone yet\n'; return; }
  jq -rs '
    map(select(.status != "deleted")) | sort_by(.id | tonumber? // 0)
    | ([.[] | select(.status == "completed")] | length) as $done
    | "# tasks · \($done) of \(length) done\n",
      ( .[] | (if .status == "completed" then "✓" elif .status == "in_progress" then "▸" else "·" end)
              + " " + (if .status == "in_progress" and (.activeForm // "") != "" then .activeForm else .subject end)
              + (if ((.blockedBy // []) | length) > 0 then "  _(blocked by \(.blockedBy | join(", ")))_" else "" end)
              + "  " )' "$@"
}

# the Claude session in window WID: its record's, else the one SessionStart
# stashed for a pane there (an unmanaged window has no record)
session_of() { # wid | pane
  local m sid f pane panes
  case "$1" in
    %*) m="$(meta_by_pane "$1")" || m='' ;;
    *)  m="$(meta_by_wid "$1")" || m='' ;;
  esac
  if [ -n "$m" ]; then
    sid="$(jq -r '.claude_session // ""' "${m##*$'\t'}" 2>/dev/null)"
    [ -n "$sid" ] && { printf '%s' "$sid"; return; }
  fi
  case "$1" in
    %*) panes="$1" ;;
    *)  panes="$(tmux list-panes -t "$1" -F '#{pane_id}' 2>/dev/null)" ;;
  esac
  for f in "$STASH_DIR"/*; do
    [ -e "$f" ] || continue
    pane="$(cat "$f" 2>/dev/null)"
    printf '%s\n' "$panes" | grep -qxF "$pane" && { printf '%s' "${f##*/}"; return; }
  done
}

# the first pane of kel's session running nvim at or under ROOT, as
# "<pane id> <nvim pid>"
nvim_pane_in() { # root
  local id ppid cmd path pid
  while IFS='|' read -r id ppid cmd path; do
    [ "$cmd" = nvim ] || continue
    case "$path/" in "$1"/*) ;; *) continue ;; esac
    # nvim is the pane's process when the pane was started on it, else the
    # shell's child
    if [ "$(ps -o comm= -p "$ppid" 2>/dev/null | sed 's#.*/##')" = nvim ]; then pid="$ppid"
    else pid="$(pgrep -P "$ppid" -x nvim 2>/dev/null | head -1)"; fi
    [ -n "$pid" ] && { printf '%s %s' "$id" "$pid"; return 0; }
  done < <(tmux list-panes -s -t "=$KEL_PREFIX" -F '#{pane_id}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null)
  return 1
}

# where nvim <pid> listens: nvim.<pid>.0 under stdpath("run") — $XDG_RUNTIME_DIR,
# else a per-user directory in the temp dir
nvim_socket() { # pid
  local c
  for c in "${XDG_RUNTIME_DIR:-/nonexistent}/nvim.$1.0" "${TMPDIR:-/tmp}"/nvim.*/*/"nvim.$1.0" /tmp/nvim.*/*/"nvim.$1.0"; do
    [ -S "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# open_url: the user's real browser.  WSL2 forwards localhost to Windows, so
# its last resort is Windows' own `start`.
open_url() { # url
  local url="$1"
  [ -n "$url" ] || die "usage: kel _panel browse <url>"
  if [ -n "${BROWSER:-}" ]; then ( "$BROWSER" "$url" >/dev/null 2>&1 & ); return 0; fi
  if [ "$(uname -s)" = Darwin ]; then ( open "$url" >/dev/null 2>&1 & ); return 0; fi
  local c
  for c in xdg-open wslview; do
    command -v "$c" >/dev/null 2>&1 && { ( "$c" "$url" >/dev/null 2>&1 & ); return 0; }
  done
  # cmd.exe from a Linux cwd prints a UNC warning; run it from C:
  command -v cmd.exe >/dev/null 2>&1 \
    && { ( cd /mnt/c 2>/dev/null; cmd.exe /c start "" "$url" >/dev/null 2>&1 & ); return 0; }
  die "no browser found — set \$BROWSER"
}

# kel _copy — stdin to the system clipboard, wired to copy-mode's drag-end
#
# tmux's own `set-clipboard external` sends OSC 52 and trusts the terminal to
# act on it, and it decides the terminal can from TERM: xterm-256color matches
# its `xterm*:clipboard` feature list. Apple Terminal sets that TERM and does
# NOT implement OSC 52, so a drag-selection went nowhere and the clipboard
# stayed empty — measured, not assumed (2026-10-19). Piping to a real command
# is the only mechanism that does not depend on the terminal.
#
# Same shape as open_url: an override, Darwin, then probe. KEL_COPY_CMD so a
# terminal kel has not met can be told what to use.
copy_stdin() {
  if [ -n "${KEL_COPY_CMD:-}" ]; then sh -c "$KEL_COPY_CMD" >/dev/null 2>&1; return $?; fi
  [ "$(uname -s)" = Darwin ] && { pbcopy >/dev/null 2>&1; return $?; }
  # WSL: one known path, not a PATH walk — each `command -v` miss costs ~76 ms
  # there (CLAUDE.md), and three misses ran before reaching clip.exe
  local clip=/mnt/c/Windows/System32/clip.exe
  if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -x "$clip" ]; then "$clip" >/dev/null 2>&1; return $?; fi
  local c
  # wl-copy before xclip/xsel: a Wayland session often still has an X one
  for c in wl-copy xclip xsel; do
    command -v "$c" >/dev/null 2>&1 || continue
    case "$c" in
      xclip) xclip -selection clipboard >/dev/null 2>&1 ;;
      xsel)  xsel --clipboard --input    >/dev/null 2>&1 ;;
      *)     "$c"                        >/dev/null 2>&1 ;;
    esac
    return $?
  done
  # nothing to copy with: tmux still has the text in its own buffer, so this
  # is a quiet no-op rather than an error on a hot path
  cat >/dev/null 2>&1
  return 0
}

# --------------------------------------------------------------------------
# kel config   — edit config.toml, seeded from the shipped example
# --------------------------------------------------------------------------
# config.toml (v0.8) had no path INTO it from inside the tool at all — no
# --help line, no cheat mention, no menu item, no subcommand. It existed only
# as examples/config.toml and prose in usage.md. Found the same way as the
# idle/dead bug: by trying to actually use the tool as a fresh person, not by
# reading it.
#
# $SELF stays a SYMLINK (kel is always symlinked, never copied — see the SELF
# comment near the top), so a naive `$(dirname "$SELF")/../examples` looks in
# ~/.local/bin/../examples, which does not exist. Resolve it for real, without
# `readlink -f`: that flag is GNU-only and macOS's built-in readlink lacks it.
_real_self() {
  local p="$SELF" seen=0 t
  while [ -L "$p" ] && [ "$seen" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    seen=$((seen + 1))
  done
  printf '%s/%s' "$(cd "$(dirname "$p")" 2>/dev/null && pwd)" "$(basename "$p")"
}

# ---------------------------------------------------------------------------
# kel update  —  pull the clone this kel runs from, then re-wire
# ---------------------------------------------------------------------------
# install.sh symlinks bin/kel, the completions and tmux/kel.conf out of the
# clone, so a pull updates all three in place. Only kel-fleet and kel-sidebar are
# copies, and install.sh rebuilds them; re-running it is how they refresh. It is
# idempotent by design, so there is nothing to undo first.
#
# No release artifacts are involved. The working tree IS the installed thing,
# which is also why this refuses rather than merges: on the author's machines
# that clone is the development checkout too, and a pull that rebased over local
# work would be the one unrecoverable outcome here.
cmd_update() {
  need git
  local root; root="$(dirname "$(dirname "$(_real_self)")")"
  [ -d "$root/.git" ] || die "kel update: $root is not a git clone — update it however you installed it"

  local branch; branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ "$branch" = HEAD ] && die "kel update: $root is on a detached HEAD — check out a branch first"
  git -C "$root" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 \
    || die "kel update: '$branch' has no upstream — git -C $root branch -u origin/$branch"
  [ -z "$(git -C "$root" status --porcelain 2>/dev/null || true)" ] \
    || die "kel update: $root has uncommitted changes — commit or stash them first"

  say "fetching $branch"
  git -C "$root" fetch --quiet || die "kel update: fetch failed — no changes made"

  local behind; behind="$(git -C "$root" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || printf 0)"
  case "${behind:-0}" in
    ''|0) say "already up to date  ($branch at $(git -C "$root" rev-parse --short HEAD))"; exit 0 ;;
  esac
  say "applying $behind commit(s)"
  git -C "$root" merge --ff-only '@{upstream}' --quiet \
    || die "kel update: '$branch' has diverged from its upstream — resolve it by hand"

  say "re-wiring"
  ( cd "$root" && ./install.sh ) \
    || die "kel update: the pull landed but install.sh failed — run ./install.sh in $root"

  say "now at $(git -C "$root" rev-parse --short HEAD)"
  printf '  %s\n' "tmux source-file ~/.tmux.conf   # if kel.conf changed" >&2
  # Explicit, because the pull rewrote this very file. bash reads a script
  # incrementally and would otherwise read the next command from the old byte
  # offset into new content. Every function is already parsed — a definition is
  # one command — so only the return to `main` at the bottom is exposed.
  exit 0
}

cmd_config() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/kel/config.toml"
  mkdir -p "$(dirname "$cfg")"
  if [ ! -f "$cfg" ]; then
    local example; example="$(dirname "$(_real_self)")/../examples/config.toml"
    if [ -f "$example" ]; then
      cp "$example" "$cfg"
      say "created $cfg from the shipped example — every key is commented out with its default"
    else
      # not a total dead end: an installed-elsewhere kel (copied, not
      # symlinked, or examples/ pruned) still gets a file to open, just not
      # the annotated one — invariant 3: say what actually happened
      printf '# kelsier config — see docs/usage.md for the full key list\n' > "$cfg"
      warn "could not find the shipped example — started $cfg empty"
    fi
  fi

  local ed="${VISUAL:-${EDITOR:-}}" c
  if [ -z "$ed" ]; then
    for c in nvim vim vi nano; do command -v "$c" >/dev/null 2>&1 && { ed="$c"; break; }; done
  fi
  [ -n "$ed" ] || die "no editor found — set \$EDITOR, or open $cfg yourself"

  # in tmux, open in a popup; outside, run inline.
  if [ -n "${TMUX:-}" ] && [ -z "${KEL_IN_POPUP:-}" ]; then
    exec tmux display-popup -e KEL_IN_POPUP=1 \
      -w "${KEL_CONFIG_W:-90%}" -h "${KEL_CONFIG_H:-85%}" -T ' kel config ' \
      -EE "'$SELF' config"
  fi
  exec "$ed" "$cfg"
}

# --------------------------------------------------------------------------
# kel status-line   (tmux status-left)
# --------------------------------------------------------------------------
cmd_status_line() {
  [ -n "${TMUX:-}" ] || exit 0
  # The bar is the one surface where a missing kel-fleet would otherwise just
  # go blank — and a blank bar reads as "no agents".  Say so instead.
  [ -x "$KEL_FLEET_BIN" ] || { printf '#[fg=colour196]kel-fleet missing — run install.sh#[default]'; exit 0; }
  # The workspace footer (spec.md §7b): only what belongs to no pane — the
  # account's quota, the waiting alarm, the cost of live sessions — because the
  # sidebar holds everything per pane.  While the sidebar is hidden, where the
  # focused pane stands comes back here (--here: one `git status`, of one repo,
  # and only then).  One fleet_json, one jq.  --dirty is NOT passed: `git
  # status` per worktree is the expensive part and the bar never shows it.
  local here='' sb=1
  [ -e "$SIDEBAR_OFF" ] && here='--here'
  sidebar_enabled || sb=0
  fleet_json $here | jq -r --argjson sb "$sb" '
    def dur: floor | if . < 60 then "\(.)s"
                     elif . < 3600 then "\(. / 60 | floor)m"
                     else "\(. / 3600 | floor)h\((. % 3600) / 60 | floor | tostring | if length < 2 then "0" + . else . end)m" end;
    # full blocks, not ▓: in the author'"'"'s terminal font ▓ and ░ were the same
    # grey, so 23% read as a solid bar. Claude'"'"'s row already used █/░.
    def heat: if . >= 90 then "#[fg=colour167,bold]" elif . >= 70 then "#[fg=colour179]" else "" end;
    def sep: "#[fg=colour240]  │  #[default]";
    def dot: "#[fg=colour240] · #[default]";
    now as $now
    | (.quota // null) as $q
    | ( if $q == null then null else
          [ ( $q.five_hour // null | if . == null then empty
              elif .pct == null then "#[fg=colour238]█████#[default] ?"
              else (.pct | floor) as $p | ((($p + 19) / 20) | floor | if . > 5 then 5 else . end) as $f
                # a solid grey track, not ░: in the authors font ░ is a
                # checkerboard, busy beside the filled part
                | ($p | heat) + ([range(0; $f)] | map("█") | join(""))
                  + "#[fg=colour238]" + ([range($f; 5)] | map("█") | join("")) + "#[default]"
                  + ($p | heat) + " \($p)%#[default]"
                  + (if (.resets_at // 0) > $now then "#[fg=colour245] (\(.resets_at - $now | dur))#[default]" else "" end)
              end ),
            ( $q.seven_day // null | if . == null then empty
              elif .pct == null then "wk ?"
              else (.pct | floor) as $p | ($p | heat) + "wk \($p)%#[default]" end ),
            ( $q.spend // null | if . == null or .pct == null or .pct < 50 then empty
              else (.pct | floor) as $p | ($p | heat) + "spend \($p)%#[default]" end ) ]
          | if length == 0 then null else "#[fg=colour245]claude#[default] " + join(dot) end
        end ) as $quota
    | [ .agents[] | select(.window_id != null and .state != "dead") ] as $live
    | [ $live[] | select(.state == "waiting") ] as $wait
    | ( [ $live[] | .context.cost_usd // empty ] | add // 0 ) as $cost
    | ( if ($live | length) == 0 then "#[fg=colour245]no agents#[default]"
        else
          [ ( if ($wait | length) == 0 or $sb == 1 then empty
              else "#[range=user|jump]#[fg=colour214,bold]\($wait | length) waiting"
                   + ( [ $wait[] | .state_since // empty ] | min
                       | if . == null then "" else " \($now - . | dur)" end )
                   + "#[default]#[norange]" end ),
            ( if $cost > 0 then "$" + ($cost * 100 | round / 100 | tostring
                                       | if test("\\.") then (if test("\\.[0-9]$") then . + "0" else . end) else . + ".00" end)
              else empty end ) ]
          | if length == 0 then (if $sb == 1 then null else "#[fg=colour245]nothing waiting#[default]" end) else join(dot) end
        end ) as $fleet
    | ( .here // null | if . == null then null else
          .group + ( .git // null | if . == null then ""
                     else dot + (.branch // "detached")
                          + (if (.ahead // 0) > 0 then " ↑\(.ahead)" else "" end)
                          + (if (.dirty // 0) > 0 then " ●\(.dirty)" else "" end) end )
        end ) as $here
    | [ $quota, $fleet, $here ] | map(select(. != null and . != "")) | join(sep)
  ' 2>/dev/null | tr -d '\n'
}

# --------------------------------------------------------------------------
# kel jump   (prefix `)   — global, cycles across all groups
# --------------------------------------------------------------------------
cmd_jump() {
  [ -n "${TMUX:-}" ] || exit 0
  local cw
  # a click on the bar runs this with no client of its own; KEL_CLIENT names it
  local -a c=(); [ -n "${KEL_CLIENT:-}" ] && c=(-c "$KEL_CLIENT")
  cw="$(tmux display-message ${c[@]+"${c[@]}"} -p '#{window_index}' 2>/dev/null || echo '')"

  # the waiting agents, by window index, from the fleet document — the same
  # dead check and state the sidebar reads, not a second copy of them
  local doc w
  doc="$(fleet_json)" || exit 1
  w="$(printf '%s' "$doc" | jq -r '
    [ .agents[] | select(.state == "waiting" and .window_id != null and .index != null) ]
    | sort_by(.index)[] | "\(.index)\t\(.window_id)\t\(.group)/\(.name)\t\(.state_since // "")\t\(.pane_id // "")"')"
  [ -n "$w" ] || { tmux display-message "kel: nothing waiting"; exit 0; }

  # the next one after the window you are in, wrapping round
  local tgt
  tgt="$(printf '%s\n' "$w" | awk -F'\t' -v cw="${cw:-0}" '
    NR == 1 { first = $0 } $1 > cw && !found { print; found = 1 } END { if (!found) print first }')"
  local ti tw label ep tp
  IFS=$'\t' read -r ti tw label ep tp <<< "$tgt"
  tmux switch-client ${c[@]+"${c[@]}"} -t "=$KEL_PREFIX" \; select-window -t "$tw"
  [ -n "$tp" ] && tmux select-pane -t "$tp" 2>/dev/null

  # say where you landed and how long it has been sitting — the jump is
  # otherwise silent, and "which one was that?" is the next question
  case "${ep:-}" in ''|*[!0-9]*) tmux display-message "→ $label" ;;
    *) tmux display-message "→ $label  (waiting $(humanize_secs $(( $(date +%s) - ${ep%.*} ))))" ;;
  esac
}

# --------------------------------------------------------------------------
# paint_state  —  put the state where you can see it without looking (v0.9a)
# --------------------------------------------------------------------------
# The status bar is one line at the bottom. With a full-screen agent that is a
# place you have to look AT; a coloured pane border is peripheral vision, and
# the window name carries the same colour so it reads from the bar too.
#
# Set per-window (-w), so windows keep their own colour rather than the last
# hook to fire repainting the whole server. Calm states clear back to the
# default, so a workspace at rest is not a christmas tree.
paint_state() {   # wid state
  local wid="$1" col=''
  case "${2:-}" in
    waiting)   col=colour214 ;;   # blocked on you — the one that matters
    throttled) col=colour141 ;;
    dead)      col=colour167 ;;
    *)         col='' ;;          # working / idle / done: stay quiet
  esac
  if [ -n "$col" ]; then
    tmux set-option -w -t "$wid" pane-border-style        "fg=$col" 2>/dev/null || true
    tmux set-option -w -t "$wid" pane-active-border-style "fg=$col" 2>/dev/null || true
  else
    tmux set-option -wu -t "$wid" pane-border-style        2>/dev/null || true
    tmux set-option -wu -t "$wid" pane-active-border-style 2>/dev/null || true
  fi
}

# Repaint every window from the fleet document. `dead` is computed at read
# time rather than reported by a hook, so a crashed agent has nothing to paint
# its border — this catches it. Called from `kel ls`, never from the bar: the
# bar redraws constantly and this is N tmux calls.
repaint_all() {   # fleet-json
  local wid st
  while IFS=$'\t' read -r wid st; do
    [ -n "$wid" ] && paint_state "$wid" "$st"
  done < <(printf '%s' "$1" | jq -r '[.agents[] | select(.window_id != null)]
      | group_by(.window_id)[]
      | min_by({waiting: 0, dead: 1, throttled: 2}[.state // ""] // 3)
                                      | [.window_id, (.state // "")] | @tsv')
}

# --------------------------------------------------------------------------
# notifications  (#1)
# --------------------------------------------------------------------------
# The status line is a *pull* surface — it only helps while you are looking at
# it.  This is the push half, fired from the state hook.  It is never polled:
# a poller would be a background daemon, which is a hard non-goal.
#
# `notify` is the ONLY place delivery lives. Until 2026-10-15 kel shipped no
# platform detection and left recipes in setup.md for $KEL_NOTIFY_CMD — and so,
# in practice, nothing reached the author outside the terminal. Both tools kel
# was measured against tell you when an agent needs you; this is the push half
# of "go to whoever needs me". Now, by default:
#
#   the bell   BEL to every terminal attached to kel — the terminal decides:
#              a screen flash on the Mac, a taskbar flash or sound in Windows
#              Terminal. What Claude Code's own "flash" is.
#   a desktop notification   WSL: a Windows toast through powershell.exe
#              (built-in WinRT, no module to install); macOS: osascript;
#              Linux: notify-send.
#
# $KEL_NOTIFY_CMD still overrides the desktop half; notify_bell / notify_desktop
# = off silence either. Paths are stat'ed, never `command -v`'d, on WSL: a
# lookup walks every /mnt/c dir on PATH (CLAUDE.md, traps).
notify() {   # title body
  tmux display-message "$1 — $2" 2>/dev/null || true
  case "${KEL_NOTIFY_BELL:-on}" in off|0|no|false) ;; *) notify_bell ;; esac
  # Backgrounded, and deliberately not with setsid — macOS has no setsid.  A
  # hook is synchronous: Claude Code waits for it, and a PowerShell toast
  # costs half a second before it has done anything useful.
  if [ -n "${KEL_NOTIFY_CMD:-}" ]; then
    ( "$KEL_NOTIFY_CMD" "$1" "$2" >/dev/null 2>&1 & ) 2>/dev/null || true
    return 0
  fi
  case "${KEL_NOTIFY_DESKTOP:-on}" in off|0|no|false) return 0 ;; esac
  ( notify_desktop "$1" "$2" >/dev/null 2>&1 & ) 2>/dev/null || true
}

# BEL to each terminal attached to kel's session: written to the client's tty,
# so it reaches the terminal itself rather than a pane
notify_bell() {
  local tty
  tmux list-clients -t "=$KEL_PREFIX" -F '#{client_tty}' 2>/dev/null \
    | while read -r tty; do [ -w "$tty" ] && printf '\a' > "$tty"; done
  return 0
}

notify_desktop() { # title body
  local ps=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
  if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -x "$ps" ]; then
    # The body is Claude Code's notification text — the agent quoting a
    # command back at you — so it is untrusted. It crosses into PowerShell as
    # base64, which has no character a script could be built from, and is
    # decoded there; nothing from it is ever parsed as code. cd /mnt/c: a
    # Windows process started from a Linux directory warns about UNC paths.
    local t b
    t="$(printf '%s' "$1" | base64 | tr -d '\n')"; b="$(printf '%s' "$2" | base64 | tr -d '\n')"
    ( cd /mnt/c 2>/dev/null; "$ps" -NoProfile -NonInteractive -Command "
\$d={param(\$s)[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(\$s))}
[Windows.UI.Notifications.ToastNotificationManager,Windows.UI.Notifications,ContentType=WindowsRuntime]>\$null
\$x=[Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
\$e=\$x.GetElementsByTagName('text')
[void]\$e.Item(0).AppendChild(\$x.CreateTextNode((& \$d '$t')))
[void]\$e.Item(1).AppendChild(\$x.CreateTextNode((& \$d '$b')))
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\WindowsPowerShell\\v1.0\\powershell.exe').Show([Windows.UI.Notifications.ToastNotification]::new(\$x))" )
  elif [ "$(uname -s)" = Darwin ]; then
    # arguments, not a script built from the text: AppleScript never parses it
    osascript - "$1" "$2" <<'APPLESCRIPT'
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$1" "$2"
  fi
}

# Is the user actually looking at this window?  Active in its session AND that
# session has a client attached.  Detached tmux => nobody is looking => notify.
window_focused() {   # wid
  local act att
  act="$(tmux display-message -p -t "$1" '#{window_active}'    2>/dev/null || echo 0)"
  att="$(tmux display-message -p -t "$1" '#{session_attached}' 2>/dev/null || echo 0)"
  case "${att:-0}" in ''|*[!0-9]*) att=0 ;; esac
  [ "${act:-0}" = 1 ] && [ "$att" -gt 0 ]
}

# --------------------------------------------------------------------------
# Claude Code -> kel:  which tmux pane is this session talking from?
# $TMUX_PANE when the agent passes it (it does), else the pane stashed by this
# session's SessionStart, else the one pane whose cwd matches the payload.
# --------------------------------------------------------------------------
resolve_pane() { # session-id cwd
  local sid="${1:-}" cwd="${2:-}" pane="${TMUX_PANE:-}" match
  if [ -z "$pane" ] && [ -n "$sid" ] && [ -f "$STASH_DIR/$sid" ]; then
    pane="$(cat "$STASH_DIR/$sid" 2>/dev/null || true)"
  fi
  if [ -z "$pane" ] && [ -n "$cwd" ]; then
    # the sidebar shares its window's directory: counting it would make every
    # match ambiguous and the lookup give up
    match="$(tmux list-panes -a -F '#{@kel-sidebar}|#{pane_id}|#{pane_current_path}' 2>/dev/null \
      | awk -F'|' -v c="$cwd" '$1 == "" && $3 == c {print $2}')"
    [ "$(printf '%s\n' "$match" | grep -c .)" = 1 ] && pane="$match"
  fi
  printf '%s' "$pane"
}

# --------------------------------------------------------------------------
# context / cost, per agent      $STATE_DIR/<wid>.ctx
#   pct <T> cost_usd <T> in_tokens <T> ctx_size <T> rate5h <T> epoch <T> model
# Written by `kel statusline`; read by the bar, ls, --json and the sidebar.
# --------------------------------------------------------------------------
ctx_field() { # wid n  -> field n of the .ctx line, or empty
  [ -f "$STATE_DIR/$1.ctx" ] || return 0
  cut -f"$2" "$STATE_DIR/$1.ctx" 2>/dev/null | head -1
}

# 250000 -> 250k, 1000000 -> 1M.  Integer arithmetic only: this runs on the
# statusLine path, and printf %f would round 999999 up to a wrong 1.0M.
si_units() { # n
  local n="${1:-0}"
  if [ "$n" -ge 1000000 ]; then
    if [ $((n % 1000000)) -eq 0 ]; then printf '%dM' "$((n / 1000000))"
    else printf '%d.%dM' "$((n / 1000000))" "$(( (n % 1000000) / 100000 ))"; fi
  elif [ "$n" -ge 1000 ]; then printf '%dk' "$((n / 1000))"
  else printf '%d' "$n"; fi
}

# epoch -> "40m" / "3h10m", empty once it is in the past.  Takes `now` rather
# than calling date: the statusLine path already has it.
time_until() { # epoch now
  local d=$(( ${1:-0} - ${2:-0} ))
  [ "$d" -gt 0 ] || return 0
  if [ "$d" -ge 3600 ]; then printf '%dh%dm' "$((d / 3600))" "$(( (d % 3600) / 60 ))"
  else printf '%dm' "$((d / 60))"; fi
}

# one quota chip per rate limit; gated at 50%.
quota_chip() { # label pct resets_at now [from — default 50]
  [ "${2:--1}" -ge "${5:-50}" ] 2>/dev/null || return 0
  local r; r="$(time_until "${3:-0}" "${4:-0}")"
  printf ' \033[2m·\033[0m \033[33m%s %s%%%s\033[0m' "$1" "$2" "${r:+ ($r)}"
}

# --------------------------------------------------------------------------
# kel statusline   —   Claude Code's own status row (wired by install.sh)
# --------------------------------------------------------------------------
# Claude Code pipes a JSON blob in on every conversation update: context window,
# cost, rate limits.  Updates are debounced to 300ms and an in-flight script is
# CANCELLED when the next one lands, so this stays cheap: one jq pass, one
# atomic write, and a tmux redraw only when the number the bar shows changed.
cmd_statusline() {
  local payload; payload="$(cat 2>/dev/null || true)"
  [ -n "$payload" ] || exit 0
  command -v jq >/dev/null 2>&1 || exit 0

  # One field per line, not @tsv: bash folds runs of tab (an IFS whitespace
  # character) into one delimiter, so a single empty field — an unset model
  # name, say — would silently shift every value after it.
  #
  # used_percentage comes through as empty rather than 0. It is null before the
  # first API call and again right after /compact, and an empty context is a
  # different fact from an unmeasured one.
  local sid cwd pct cost intok ctxsz rl5 model
  local rl5at rl7d rl7dat spend spendat effort fastmode thinking agent repo wt
  {
    read -r sid;    read -r cwd;      read -r pct;      read -r cost
    read -r intok;  read -r ctxsz;    read -r rl5;      read -r model
    read -r rl5at;  read -r rl7d;     read -r rl7dat
    read -r spend;  read -r spendat
    read -r effort; read -r fastmode; read -r thinking
    read -r agent;  read -r repo;     read -r wt
  } < <(printf '%s' "$payload" | jq -r '[
      (.session_id // ""),
      (.workspace.current_dir // .cwd // ""),
      (if .context_window.used_percentage == null then ""
       else (.context_window.used_percentage | floor) end),
      (.cost.total_cost_usd // 0),
      (.context_window.total_input_tokens // 0),
      (.context_window.context_window_size // 0),
      (.rate_limits.five_hour.used_percentage // -1 | floor),
      (.model.display_name // ""),
      (.rate_limits.five_hour.resets_at // 0),
      (.rate_limits.seven_day.used_percentage // -1 | floor),
      (.rate_limits.seven_day.resets_at // 0),
      (.rate_limits.spend_limit.used_percentage // -1 | floor),
      (.rate_limits.spend_limit.resets_at // 0),
      (.effort.level // ""),
      (if .fast_mode then 1 else 0 end),
      (if .thinking.enabled == false then 0 else 1 end),
      (.agent.name // ""),
      (if (.workspace.repo | type) == "object"
       then ((.workspace.repo.owner // "") + "/" + (.workspace.repo.name // ""))
       else "" end),
      (.worktree.name // "")
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)

  # never let a surprising payload reach arithmetic or a %f conversion
  case "${pct:-}"   in ''|*[!0-9]*)  pct='' ;;  esac
  case "${intok:-}" in ''|*[!0-9]*)  intok=0 ;; esac
  case "${ctxsz:-}" in ''|*[!0-9]*)  ctxsz=0 ;; esac
  case "${rl5:-}"   in ''|-1|*[!0-9]*) rl5=-1 ;; esac
  case "${rl7d:-}"  in ''|-1|*[!0-9]*) rl7d=-1 ;; esac
  case "${spend:-}" in ''|-1|*[!0-9]*) spend=-1 ;; esac
  case "${rl5at:-}"   in ''|*[!0-9]*) rl5at=0 ;; esac
  case "${rl7dat:-}"  in ''|*[!0-9]*) rl7dat=0 ;; esac
  case "${spendat:-}" in ''|*[!0-9]*) spendat=0 ;; esac
  case "${cost:-}"  in ''|*[!0-9.]*) cost=0 ;;  esac
  case "${fastmode:-}" in 1) ;; *) fastmode=0 ;; esac
  case "${thinking:-}" in 0) ;; *) thinking=1 ;; esac

  local now; now="$(date +%s)"

  # record it against this agent's window, if we are inside one
  local wid=''
  if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}${TMUX_PANE:-}" ]; then
    wid="$(resolve_pane "$sid" "$cwd")"
  fi
  # An unknown pct writes nothing. Overwriting a real 25% with a placeholder 0
  # would make every other surface — the bar, `kel ls`, the sidebar —
  # report an empty context window for an agent that has a full one. The stale
  # record keeps its own epoch in field 6, so a reader can see its age.
  if [ -n "$wid" ] && [ "$ctxsz" -gt 0 ] && [ -n "$pct" ]; then
    local old; old="$(ctx_field "$wid" 1)"
    local tmp; tmp="$(mktemp "$STATE_DIR/.${wid#%}.ctx.XXXXXX" 2>/dev/null)"
    if [ -n "${tmp:-}" ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$pct" "$cost" "$intok" "$ctxsz" "$rl5" "$now" "$model" > "$tmp"
      mv -f "$tmp" "$STATE_DIR/$wid.ctx"
    fi
    # only redraw the tmux bar when the figure it renders actually moved —
    # #(kel status-line) is not free and this runs several times a second
    [ "$pct" != "$old" ] && tmux refresh-client -S 2>/dev/null
  fi

  # The account's quota, for the bar (spec.md §7b): one small file, written
  # only from a payload that carries rate limits — an API-key session never
  # writes one, so the bar never shows a 0% that was never measured.  The bar
  # is redrawn only when a figure it shows moved (invariant 5); `read` is a
  # builtin, so comparing costs no fork.
  if { [ "$rl5" -ge 0 ] || [ "$rl7d" -ge 0 ] || [ "$spend" -ge 0 ]; } && [ -d "$STATE_DIR" ]; then
    local q="$STATE_DIR/quota" o5='' o7='' os=''
    [ -f "$q" ] && read -r o5 _ o7 _ os _ < "$q" 2>/dev/null
    printf '%s %s %s %s %s %s %s\n' "$rl5" "$rl5at" "$rl7d" "$rl7dat" "$spend" "$spendat" "$now" > "$q.$$" \
      && mv -f "$q.$$" "$q"
    if [ "$rl5" != "$o5" ] || [ "$rl7d" != "$o7" ] || [ "$spend" != "$os" ]; then
      [ -n "${TMUX:-}" ] && tmux refresh-client -S 2>/dev/null
    fi
  fi

  # ---- render Claude Code's row ----
  local label=''
  if [ -n "$wid" ]; then
    # one display-message, not two: this is a hot path. '|' separates because
    # an empty @kel-group would be a leading empty field to IFS-tab read
    local v kg sn wn
    v="$(tmux display-message -p -t "$wid" '#{@kel-group}|#{session_name}|#{window_name}' 2>/dev/null || true)"
    kg="${v%%|*}"; v="${v#*|}"; sn="${v%%|*}"; wn="${v#*|}"
    if [ -n "$kg" ]; then label="$kg/$wn"
    elif [ "$sn" = "$KEL_PREFIX" ]; then label="$wn"
    fi
  fi

  # Outside a kel window there is no label, so the payload's own repo and
  # worktree identity takes that slot. It arrives in the JSON, so this costs no
  # git subprocess — a `git` call here would run on every redraw.
  local ident=''
  if [ -z "$label" ] && [ -n "$repo" ] && [ "$repo" != "/" ]; then
    ident="$repo"
    [ -n "$wt" ] && ident="$ident@$wt"
  fi

  local bar='' i filled=$(( (${pct:-0} + 9) / 10 ))
  [ "$filled" -gt 10 ] && filled=10
  # ${bar}, not $bar, immediately before the literal block character: bash on
  # the macOS CI runner (non-UTF-8 locale) mis-tokenizes "$bar█" — it reads
  # part of the multi-byte character's bytes as if they extended the variable
  # name, then reports THAT as an unbound variable. Braces make the name
  # boundary explicit regardless of what bytes follow. Found from a real CI
  # failure, not by inspection — this predates the board-hub work.
  # the empty part is a grey track of the same block, not ░ — a checkerboard
  # in the author's font, and the tmux bar's quota uses the same pair
  local track=''
  for ((i=0; i<10; i++)); do
    if [ "$i" -lt "$filled" ]; then bar="${bar}█"; else track="${track}█"; fi
  done
  local cc='\033[32m'                                  # green
  [ "${pct:-0}" -ge "$KEL_CTX_WARN" ] && cc='\033[33m'  # yellow
  [ "${pct:-0}" -ge 90 ]              && cc='\033[31m'  # red

  # non-default modes only: the defaults are the common case and naming them
  # every redraw costs width without telling you anything
  local modes=''
  [ "$fastmode" = 1 ] && modes="fast"
  case "$effort" in ''|medium) ;; *) modes="${modes:+$modes }$effort" ;; esac
  [ "$thinking" = 0 ] && modes="${modes:+$modes }no-think"

  # Inside a kel window the row is the session only (spec.md §7a): where it
  # stands is the sidebar's, the quota the bar's.  Outside kel neither exists,
  # so there the row keeps the repo identity and the quota chips.
  [ -n "$ident" ] && printf '\033[36m%s\033[0m \033[2m·\033[0m ' "$ident"
  [ -n "$model" ] && printf '%s' "$model"
  [ -n "$modes" ] && printf ' \033[2m%s\033[0m' "$modes"
  [ -n "$model" ] && printf ' \033[2m·\033[0m '
  if [ -n "$pct" ]; then
    printf '%b%s\033[0m\033[90m%s\033[0m%b %s%%\033[0m \033[2mctx\033[0m' "$cc" "$bar" "$track" "$cc" "$pct"
    # absolute figures only once the percentage is worth acting on — that is
    # when "how much room is left" stops being idle curiosity
    if [ "$pct" -ge "$KEL_CTX_WARN" ] && [ "$ctxsz" -gt 0 ]; then
      printf ' \033[2m%s/%s\033[0m' "$(si_units "$intok")" "$(si_units "$ctxsz")"
    fi
  else
    # No bar at all. A dim empty bar still reads as "0% used", and this state is
    # "not measured yet" — null before the first call, and again after /compact.
    printf '\033[2mctx ?\033[0m'
  fi
  [ -n "$cost" ] && [ "$cost" != "0" ] && printf ' \033[2m·\033[0m $%.2f' "$cost" 2>/dev/null
  if [ -z "$label" ]; then
    # the 5-hour window always, when reported — the author needs the smallest
    # limit in view, and gating it at 50% showed only the week. The week from
    # 75% (the author's call), spend from 50%: rarely what you are about to hit
    quota_chip 5h    "$rl5"   "$rl5at"   "$now" 0
    quota_chip 7d    "$rl7d"  "$rl7dat"  "$now" 75
    quota_chip spend "$spend" "$spendat" "$now"
  fi
  # agent.name marks a `claude --agent` session, not a Task-tool subagent.
  [ -n "$agent" ] && printf ' \033[2m·\033[0m \033[35m%s\033[0m' "$agent"
  printf '\n'

  # a statusLine kel displaced at install time still gets its say
  if [ -x "$STATUSLINE_PREV" ] || [ -s "$STATUSLINE_PREV" ]; then
    printf '%s' "$payload" | sh "$STATUSLINE_PREV" 2>/dev/null || true
  fi
}

# --------------------------------------------------------------------------
# kel substatus   —   Claude Code's subagentStatusLine (wired by install.sh)
# --------------------------------------------------------------------------
# The agent panel's subagents, for the sidebar to nest under their agent. Run
# once per refresh tick while subagent rows are visible, with every row in one
# payload (measured 2026-10-16: id, label, agentType, status, startTime). It
# prints NOTHING: per the docs a row with no output line keeps Claude Code's
# own rendering, so kel changes nothing on Claude's screen. One jq, and a write
# only when what it would write changed — this is a hot path (invariant 5).
cmd_substatus() {
  local payload sid cwd tasks pane wid f old
  payload="$(cat 2>/dev/null || true)"
  [ -n "$payload" ] || exit 0
  { read -r sid; read -r cwd; read -r tasks; } < <(printf '%s' "$payload" | jq -r '
      (.session_id // ""), (.cwd // ""),
      ([.tasks[]? | {id, name, agentType, status, label: (.label // .description), startTime}] | tojson)' 2>/dev/null)
  [ -n "${tasks:-}" ] || exit 0
  pane="$(resolve_pane "$sid" "$cwd")"; [ -n "$pane" ] || exit 0
  f="$STATE_DIR/$pane.subs"
  # the epoch on its own line: the panel stops calling once it has no rows, so
  # a reader treats an old file as "no subagents now", not as still running
  old="$(sed -n 2p "$f" 2>/dev/null)"
  if [ "$old" != "$tasks" ] || [ "$(( $(date +%s) - $(sed -n 1p "$f" 2>/dev/null || echo 0) ))" -gt 10 ]; then
    printf '%s\n%s\n' "$(date +%s)" "$tasks" > "$f.$$" && mv -f "$f.$$" "$f"
  fi
}

# --------------------------------------------------------------------------
# kel hook <EVENT>
# --------------------------------------------------------------------------
# PostToolUse, matched to Edit|Write|MultiEdit by install.sh: remember the
# file this window's agent last touched, and its first changed line, for the
# sidebar's `e` (spec.md §9).  State is untouched.  This runs after every
# edit, so it is one jq and one write — and the path and the line arrive in
# the payload, so nothing is read from a transcript.
hook_edit() { # payload sid cwd
  local path line pane wid
  { read -r path; read -r line; } < <(printf '%s' "$1" | jq -r '
      (.tool_input.file_path // ""),
      ((.tool_response.structuredPatch // [])[0].newStart // 1)' 2>/dev/null)
  [ -n "$path" ] || return 0
  pane="$(resolve_pane "$2" "$3")"; [ -n "$pane" ] || return 0
  case "$path" in /*) ;; *) path="$3/$path" ;; esac
  # In plan mode Claude writes its plan with Write, under its plans directory
  # (measured on 2.1.300): that write is the session's plan, not "the file
  # the agent last touched" — `p` shows it, and `e` must not open it
  local kind=edit
  case "$path" in "$CLAUDE_HOME/plans/"*) kind=plan ;; esac
  printf '%s\n%s\n' "$path" "$line" > "$STATE_DIR/$pane.$kind.$$" && mv -f "$STATE_DIR/$pane.$kind.$$" "$STATE_DIR/$pane.$kind"
}

cmd_hook() {
  local event="${1:-}"
  command -v tmux >/dev/null 2>&1 || exit 0
  # one jq pass, one field per line — never `IFS=$'\t' read`, which folds runs
  # of tab into a single delimiter and shifts everything after an empty field
  local payload evt sid cwd tool ntype ntext
  payload="$(cat 2>/dev/null || true)"
  {
    read -r evt; read -r sid; read -r cwd; read -r tool; read -r ntype; read -r ntext
  } < <(printf '%s' "$payload" | jq -r '[
      (.hook_event_name  // ""), (.session_id       // ""), (.cwd // ""),
      (.tool_name // ""), (.notification_type // ""),
      # Claude Code sends the words as .message (hooks docs, Notification);
      # kel read .notification_text, which it never sends — so no real agent
      # ever showed why it waited, only the test fixtures (2026-10-17)
      (if .hook_event_name == "Notification" then (.message // .notification_text // "") else "" end)
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)
  [ -n "$event" ] || event="$evt"
  if [ "$event" = PostToolUse ]; then
    case "$tool" in Edit|Write|MultiEdit) hook_edit "$payload" "$sid" "$cwd" ;; esac
    [ -n "$sid" ] && [ -e "$WAITING_DIR/$sid" ] || exit 0
  fi

  local pane; pane="$(resolve_pane "$sid" "$cwd")"
  if [ "$event" = "SessionStart" ] && [ -n "$pane" ] && [ -n "$sid" ]; then
    printf '%s' "$pane" > "$STASH_DIR/$sid"
  fi
  [ -z "$pane" ] && exit 0

  local wid; wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  [ -z "$wid" ] && exit 0
  local prev; prev="$(state_of "$pane")"   # for the transition test below

  if [ -n "$sid" ] && [ "$event" != SessionEnd ]; then
    local mr m mg mn
    if mr="$(meta_by_pane "$pane")"; then
      m="${mr##*$'\t'}"
      if [ "$(jq -r '(.claude_session // "") + " " + (.pane_id // "")' "$m" 2>/dev/null)" != "$sid $pane" ]; then
        meta_update "$m" '.claude_session=$s | .pane_id=$p' --arg s "$sid" --arg p "$pane"
        IFS=$'\t' read -r mg mn _ <<< "$mr"
        stamp_pane "$pane" "$mg" "$mn"
      fi
    fi
  fi

  local state
  case "$event" in
    SessionStart)     state=idle ;;
    UserPromptSubmit) state=working ;;
    Notification)
      # Not every notification means "blocked on you".  Mapping all of them to
      # `waiting` made `prefix \`` jump to agents that were merely sitting idle
      # or already finished — the one keystroke the tool exists for, lying.
      case "$ntype" in
        # idle_prompt is Claude Code waiting at its prompt for ~60 s. It says
        # nothing about the agent — unless kel still has it `working`: an
        # interrupt (esc, C-c) fires no Stop, and the author saw an agent read
        # "working 13h29m" while it sat at its prompt. Then it is idle.
        idle_prompt)
          [ "$prev" = working ] || exit 0
          state=idle ;;
        auth_success|elicitation_complete|elicitation_response)
          exit 0 ;;                       # says something about you, not the agent
        agent_completed)      state=done ;;
        quota_auto_resume_*)  state=throttled ;;
        # permission_prompt, agent_needs_input, elicitation_*dialog, and any
        # notification type added after this was written
        *)                    state=waiting ;;
      esac ;;
    Stop)             state=done ;;
    PostToolUse)      state=working ;;
    PreCompact)
      # Compaction happens mid-turn: the agent is still working, so do NOT
      # touch .state.  Just count it.  "This one has been squeezed three
      # times" is the signal context% cannot give you, because context% drops
      # back down after every compaction and looks healthy again.
      local rr mp
      rr="$(meta_by_pane "$pane" || true)"
      if [ -n "$rr" ]; then
        mp="${rr##*$'\t'}"
        meta_update "$mp" '.compactions = ((.compactions // 0) + 1)'
      fi
      exit 0 ;;
    PostCompact)
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    SessionEnd)
      rm -f "$STATE_DIR/$pane.state" "$STATE_DIR/$pane.ctx"
      [ "$(agent_pane "$wid")" = "$pane" ] && rm -f "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
      tmux set-option -pu -t "$pane" @kel-state 2>/dev/null
      paint_state "$wid" ''
      [ -n "$sid" ] && rm -f "$STASH_DIR/$sid" "$WAITING_DIR/$sid"
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    *) exit 0 ;;
  esac
  local tmp
  tmp="$(mktemp "$STATE_DIR/.${pane#%}.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s %s %s\n' "$state" "$(date +%s)" "$ntext" > "$tmp"
  mv -f "$tmp" "$STATE_DIR/$pane.state"
  tmux set-option -p -t "$pane" @kel-state "$state" 2>/dev/null
  [ "$(agent_pane "$wid")" = "$pane" ] && rm -f "$STATE_DIR/$wid.state"
  if [ -n "$sid" ]; then
    if [ "$state" = waiting ]; then
      mkdir -p "$WAITING_DIR" 2>/dev/null && : > "$WAITING_DIR/$sid"
    else
      rm -f "$WAITING_DIR/$sid"
    fi
  fi
  paint_state "$wid" "$(window_state "$wid")"
  tmux refresh-client -S 2>/dev/null || true
  sidebar_wake                 # the visible sidebar shows the change now, not in 2s

  # Only on a transition *into* a notifying state, and only when you are not
  # already looking at it.  Without the transition test every repeat hook of
  # the same state re-notifies, which is how people learn to ignore them.
  [ "$state" = "$prev" ] && exit 0
  # an agent that moved on takes its banner line with it
  banner_drop "$pane"
  case " $KEL_NOTIFY " in
    *" $state "*)
      window_focused "$wid" && exit 0
      local wn; wn="$(tmux display-message -p -t "$pane" '#{@kel-agent}' 2>/dev/null)"; wn="${wn##*/}"
      [ -n "$wn" ] || wn="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null || echo "$wid")"
      case "${KEL_NOTIFY_BANNER:-on}" in off|0|no|false) ;; *) banner_add "$pane" "$state" "$wn" "$ntext" ;; esac
      notify "kel: $wn" "${ntext:-$state}" ;;
  esac
}

# --------------------------------------------------------------------------
# kel  (no args)  — enter the workspace
# --------------------------------------------------------------------------
quickstart() {
  cat <<'EOF'

  kel new [name]     start an agent in the current repo
  kel restore        bring back a previous workspace (--list to choose)
  prefix `           jump to whichever agent is waiting on you
  prefix Space       the sidebar — every agent, its state, context and cost

EOF
}

# attach to the workspace — or, with no terminal (scripts, the test suite),
# say how to and return, rather than fail on "open terminal failed"
attach_workspace() { # [wid]
  local s="$KEL_PREFIX"
  kel_sessions | grep -qxF "$KEL_PREFIX" || s="$(kel_sessions | head -1)"
  if [ -t 0 ] && [ -t 1 ]; then
    if [ -n "${1:-}" ]; then exec tmux attach -t "=$s" \; select-window -t "$1"
    else exec tmux attach -t "=$s"; fi
  fi
  say "workspace running — tmux attach -t $s"
}

cmd_attach() {
  need tmux
  prune_state
  if in_tmux; then
    [ -z "$(kel_windows)" ] && { echo "no agents yet."; quickstart; return 0; }
    cmd_ls; return
  fi

  # dir target, the way `claude` keys off the current directory:
  # KEL_GROUP, else .kel/group or the repo we're standing in.
  local want=''
  if [ -n "${KEL_GROUP:-}" ]; then want="$KEL_GROUP"
  elif git_root >/dev/null 2>&1; then want="$(group_for_cwd)"
  fi
  slug_ok "$want" || want=''

  # 1. a live workspace: go to it — at this repo's agent if it has one, or
  #    start one for this repo if it does not
  if [ -n "$(kel_sessions)" ]; then
    local wid=''
    [ -n "$want" ] && wid="$(kel_windows | awk -F'\t' -v g="$want" '$5==g {print $3; exit}')"
    if [ -n "$want" ] && [ -z "$wid" ]; then
      say "no agent for '$want' yet — starting one"
      exec "$SELF" new
    fi
    attach_workspace "$wid"
    return
  fi

  # 2. no live workspace.  Never ask (v0.10): until then this stopped on a
  #    rebuild prompt, every first `kel` after a reboot, whatever you came to
  #    do.  Put the old workspace somewhere a fresh start cannot overwrite it,
  #    say so in one line, and carry on.  `kel restore` brings it back.
  if [ -f "$SNAPSHOT" ]; then
    local n; n="$(snapshot_summary "$SNAPSHOT" | cut -f1)"
    # the sidebar offers it too (`b`) until it is used
    archive_snapshot && say "previous workspace: ${n:-?} window(s) · kel restore" \
      && : > "$STATE_DIR/restore-offer"
  elif [ -n "$(dead_sessions)" ]; then
    say "agents from before can be brought back: kel restore   (kel prune discards them)"
  fi

  # 3. fresh start — dir-aware if we're in a repo
  if [ -n "$want" ]; then
    say "starting an agent for '$want'"
    exec "$SELF" new
  fi
  say "welcome to kel."
  quickstart
  # @kel-welcome marks the shell kel opened for you, with when, so that a
  # `kel restore` straight after can close it if you never used it
  local born; born="$(date +%s)"
  if [ -t 0 ] && [ -t 1 ]; then
    exec tmux new-session -s "$KEL_PREFIX" -c "$HOME" \; set-option -w @kel-welcome "$born" \
      \; run-shell -b "'$SELF' _sidebar ensure '#{window_id}'"
  fi
  tmux new-session -d -s "$KEL_PREFIX" -c "$HOME" \; set-option -w @kel-welcome "$born"
  sidebar_ensure "$(tmux display-message -p -t "=$KEL_PREFIX:" '#{window_id}' 2>/dev/null)"
  say "workspace started — tmux attach -t $KEL_PREFIX"
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    hook)         cmd_hook "$@" ;;                 # hot path — skip migrate
    new)          migrate_meta; cmd_new "$@" ;;
    kill)         migrate_meta; cmd_kill "$@" ;;
    ls|list)      migrate_meta; cmd_ls "$@" ;;
    rename)       migrate_meta; cmd_rename "$@" ;;
    restore)      migrate_meta; cmd_restore "$@" ;;
    relaunch)     migrate_meta; cmd_relaunch "$@" ;;
    sweep)        migrate_meta; cmd_sweep "$@" ;;
    prune)        migrate_meta; cmd_prune "$@" ;;
    snapshot)     cmd_snapshot ;;
    sidebar)      cmd_sidebar "$@" ;;
    url)          cmd_url "$@" ;;
    shot)         cmd_shot "$@" ;;
    shell)        cmd_shell "$@" ;;
    quit)         cmd_quit "$@" ;;
    _prompt)      cmd_prompt "$@" ;;
    _notify)      notify "${1:-kel}" "${2:-test notification}" ;;
    _click)       cmd_click "$@" ;;
    substatus)    cmd_substatus "$@" ;;
    _panel)       cmd_panel "$@" ;;
    _banner)      case "${1:-}" in
                    seen)  banner_seen ;;
                    *)     die "usage: kel _banner seen|clear" ;;
                  esac ;;
    _own)         own_window "${1:-}" ;;
    _sidebar)     case "${1:-}" in
                    ensure) sidebar_ensure "${2:-}" ;;
                    wake)   sidebar_wake ;;
                    heal)   sidebar_heal ;;
                    fit)    sidebar_fit ;;
                    reap)   sidebar_reap ;;
                    focus)  sidebar_focus "${2:-}" ;;
                    *)      die "kel _sidebar ensure|wake|heal|fit|reap|focus" ;;
                  esac ;;
    doctor)       cmd_doctor "$@" ;;
    config)       cmd_config ;;
    update)       cmd_update "$@" ;;
    status-line)  cmd_status_line "$@" ;;
    _fleet)       fleet_json "$@" ;;
    _copy)        copy_stdin ;;
    _cfgdump)     printf 'ctx_warn=%s notify=%s group=%s\n' "${KEL_CTX_WARN:-}" "${KEL_NOTIFY:-}" "${KEL_GROUP:-}" ;;
    statusline)   cmd_statusline ;;                # hot path — skip migrate
    jump)         cmd_jump ;;
    ''|attach)    migrate_meta; cmd_attach ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd  (try: kel --help)" ;;
  esac
}
main "$@"
