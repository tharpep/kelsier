#!/usr/bin/env bash
# kel — a terminal workspace for running several coding agents at once.
# tmux does the multiplexing; kel does the bookkeeping.
#
#   kel                     enter the workspace (attach the `kel` tmux session)
#   kel new <name>          new window + agent in the current repo (inplace)
#   kel new <name> -w       ...in a fresh git worktree on branch <name>
#   kel kill <name>         close the window; remove the worktree if it was one
#   kel ls [--json]         list sessions with state / isolation / branch / dirty
#   kel restore [-c]        rebuild windows for sessions whose window is gone
#                           (-c runs `<agent> --continue` in each to resume)
#   kel prune [-f]          discard dead session records (and their worktrees)
#   kel doctor              probe the machine, cache the result
#
# internal (wired by install.sh):
#   kel status-line         render tmux status-left
#   kel jump                jump to the next waiting session   (prefix `)
#   kel cheat               keybinding popup                   (prefix k)
#   kel hook <EVENT>        Claude Code state hook
set -uo pipefail

KEL_SESSION="${KEL_SESSION:-kel}"
KEL_AGENT="${KEL_AGENT:-claude}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
SESSIONS_DIR="$STATE_DIR/sessions"
STASH_DIR="$STATE_DIR/.stash"
DOCTOR_CACHE="$STATE_DIR/doctor.json"

mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$STASH_DIR"

say()  { printf '\033[1;32mkel\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mkel\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mkel\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --------------------------------------------------------------------------
# session metadata: one JSON file per kel-managed session
# --------------------------------------------------------------------------
meta_path() { printf '%s/%s.json' "$SESSIONS_DIR" "$1"; }

meta_write() { # name wid repo cwd isolation branch agent
  jq -n \
    --arg name "$1" --arg wid "$2" --arg repo "$3" --arg cwd "$4" \
    --arg iso "$5" --arg branch "$6" --arg agent "$7" \
    --arg created "$(date -u +%FT%TZ)" \
    '{name:$name, window_id:$wid, repo:$repo, cwd:$cwd, isolation:$iso,
      branch:(if $branch=="" then null else $branch end),
      agent:$agent, created_at:$created}' \
    > "$(meta_path "$1")"
}

slug_ok() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }

git_root() { git rev-parse --show-toplevel 2>/dev/null; }

in_tmux() { [ -n "${TMUX:-}" ]; }

session_exists() { tmux has-session -t "$KEL_SESSION" 2>/dev/null; }

has_remote() { [ -n "$(git -C "$1" remote 2>/dev/null)" ]; }

# 0 (true) if the worktree has uncommitted changes or commits on no remote
worktree_unsafe() { # cwd
  [ -d "$1" ] || return 1
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null || true)" ] && return 0
  if has_remote "$1"; then
    [ -n "$(git -C "$1" log --oneline HEAD --not --remotes 2>/dev/null || true)" ] && return 0
  fi
  return 1
}

# create the named window in the kel session (making the session if needed);
# prints the new window id
open_window() { # name cwd
  local name="$1" cwd="$2"
  if session_exists; then
    tmux new-window -t "$KEL_SESSION" -n "$name" -c "$cwd" -P -F '#{window_id}'
  else
    tmux new-session -d -s "$KEL_SESSION" -n "$name" -c "$cwd" -x 220 -y 50 \
      -P -F '#{window_id}'
  fi
}

# window id of a kel-session window by name, or empty
wid_by_name() {
  tmux list-windows -t "$KEL_SESSION" -F '#{window_id}	#{window_name}' 2>/dev/null \
    | awk -F'\t' -v n="$1" '$2==n {print $1; exit}'
}

# is a metadata record backed by a live window of the same name?
meta_is_live() { # name
  local meta wid; meta="$(meta_path "$1")"; [ -f "$meta" ] || return 1
  wid="$(jq -r '.window_id' "$meta")"
  tmux list-windows -t "$KEL_SESSION" -F '#{window_id} #{window_name}' 2>/dev/null \
    | grep -qxF "$wid $1"
}

# names of metadata records with no live window (killed / crashed / rebooted)
dead_sessions() {
  local f name
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    name="$(basename "$f" .json)"
    meta_is_live "$name" || printf '%s\n' "$name"
  done
}

# drop *.state files whose window id is no longer live anywhere
prune_state() {
  local live f wid
  live="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)"
  [ -n "$live" ] || return 0
  for f in "$STATE_DIR"/*.state; do
    [ -e "$f" ] || continue
    wid="$(basename "$f" .state)"    # e.g. @3
    printf '%s\n' "$live" | grep -qxF "$wid" || rm -f "$f"
  done
}

# --------------------------------------------------------------------------
# kel new
# --------------------------------------------------------------------------
cmd_new() {
  need tmux; need jq
  local name='' worktree=0 agent="$KEL_AGENT" start_agent=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -w|--worktree) worktree=1 ;;
      --agent)       shift; agent="${1:-}"; [ -n "$agent" ] || die "--agent needs a command" ;;
      --no-agent)    start_agent=0 ;;
      -*)            die "kel new: unknown flag $1" ;;
      *)             [ -z "$name" ] || die "kel new: unexpected argument '$1'"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel new <name> [--worktree] [--agent CMD] [--no-agent]"
  slug_ok "$name" || die "name must be a slug (A-Z a-z 0-9 . _ -)"
  if [ -f "$(meta_path "$name")" ]; then
    if meta_is_live "$name"; then
      die "session '$name' already exists (kel kill $name first)"
    fi
    warn "reclaiming the record for '$name' (its window is gone)"
    rm -f "$(meta_path "$name")"
  fi

  local repo cwd branch='' isolation='inplace'
  repo="$(git_root || true)"

  if [ "$worktree" = 1 ]; then
    [ -n "$repo" ] || die "--worktree must be run inside a git repo"
    branch="$name"
    isolation='worktree'
    local wt_root="${KEL_WORKTREES:-$(dirname "$repo")/.kel-worktrees}"
    mkdir -p "$wt_root"
    cwd="$wt_root/$(basename "$repo")-$name"
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $cwd"; then
      say "reusing existing worktree  $cwd"
    elif [ -e "$cwd" ]; then
      die "path exists but isn't a registered worktree: $cwd"
    else
      say "creating worktree  $cwd  (branch $branch)"
      git -C "$repo" worktree add -b "$branch" "$cwd" >/dev/null \
        || git -C "$repo" worktree add "$cwd" "$branch" >/dev/null \
        || die "git worktree add failed"
      if [ -x "$repo/.kel/setup" ]; then
        say "running .kel/setup"
        if ! ( cd "$cwd" && KEL_REPO="$repo" KEL_WORKTREE="$cwd" "$repo/.kel/setup" ); then
          warn ".kel/setup exited non-zero — the worktree may be incomplete"
        fi
      fi
    fi
  else
    cwd="${repo:-$PWD}"
  fi

  local wid
  wid="$(open_window "$name" "$cwd")"
  [ -n "$wid" ] || die "failed to create tmux window"

  meta_write "$name" "$wid" "$repo" "$cwd" "$isolation" "$branch" "$agent"
  [ "$start_agent" = 1 ] && tmux send-keys -t "$wid" "$agent" Enter

  say "new session  $name  ($isolation${branch:+, branch $branch})"
  goto_window "$wid"
}

# move the caller to a window in the kel session, however they're attached
goto_window() { # window-id
  if in_tmux; then
    tmux switch-client -t "$KEL_SESSION" 2>/dev/null \
      && tmux select-window -t "$1" 2>/dev/null
  elif [ -t 1 ]; then
    tmux attach -t "$KEL_SESSION" \; select-window -t "$1"
  fi
  return 0
}

# --------------------------------------------------------------------------
# kel kill
# --------------------------------------------------------------------------
cmd_kill() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel kill: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel kill <name> [--force]"

  local meta wid iso='inplace' cwd='' branch='' repo=''
  meta="$(meta_path "$name")"
  if [ -f "$meta" ]; then
    wid="$(jq -r '.window_id' "$meta")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    branch="$(jq -r '.branch // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
  else
    wid="$(wid_by_name "$name")"
    [ -n "$wid" ] || die "no session '$name'"
    warn "'$name' is an unmanaged window — closing it, no metadata to clean up"
  fi

  if [ "$iso" = "worktree" ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
    warn "refusing to kill '$name' — the worktree has work that isn't safe to lose:"
    local d; d="$(git -C "$cwd" status --short 2>/dev/null || true)"
    [ -n "$d" ] && { echo "  uncommitted changes:" >&2; echo "$d" | sed 's/^/    /' >&2; }
    local u; has_remote "$cwd" && u="$(git -C "$cwd" log --oneline HEAD --not --remotes 2>/dev/null || true)"
    [ -n "${u:-}" ] && { echo "  commits not on any remote:" >&2; echo "$u" | sed 's/^/    /' >&2; }
    die "commit & push, or run: kel kill $name --force"
  fi

  [ -n "$wid" ] && tmux kill-window -t "$wid" 2>/dev/null || true

  if [ "$iso" = "worktree" ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
    if git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null; then
      say "removed worktree $cwd  (branch $branch kept)"
    else
      warn "couldn't remove worktree — do it manually: git -C $repo worktree remove ${force:+--force} $cwd"
    fi
  fi

  rm -f "$meta" "$STATE_DIR/$wid.state"
  say "killed $name"
}

# --------------------------------------------------------------------------
# kel prune  — discard every dead session record at once
# --------------------------------------------------------------------------
cmd_prune() {
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "kel prune: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "no dead sessions"; return 0; }

  local n meta iso cwd repo removed=0 kept=0
  while read -r n; do
    [ -z "$n" ] && continue
    meta="$(meta_path "$n")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    if [ "$iso" = worktree ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
      warn "kept '$n' — worktree has unsaved work  (kel kill $n -f)"
      kept=$((kept + 1)); continue
    fi
    if [ "$iso" = worktree ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
      git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null \
        || warn "left worktree $cwd (remove by hand)"
    fi
    rm -f "$meta"
    removed=$((removed + 1))
  done <<< "$names"

  say "pruned $removed dead session(s)$([ "$kept" -gt 0 ] && printf ', kept %s' "$kept")"
}

# --------------------------------------------------------------------------
# kel ls
# --------------------------------------------------------------------------
gather_rows() { # emits TSV: idx wid name state iso branch dirty cwd
  local cur; cur="$(tmux display-message -p -t "$KEL_SESSION" '#{window_id}' 2>/dev/null || true)"
  local row_meta='' idx wid name state iso branch dirty cwd

  # live windows
  while IFS=$'\t' read -r idx wid name; do
    [ -z "${idx:-}" ] && continue
    state='-'; iso='(unmanaged)'; branch='-'; dirty='-'; cwd=''
    [ -f "$STATE_DIR/$wid.state" ] && read -r state _ < "$STATE_DIR/$wid.state"
    row_meta="$SESSIONS_DIR/$name.json"
    if [ -f "$row_meta" ]; then
      iso="$(jq -r '.isolation' "$row_meta")"
      branch="$(jq -r '.branch // "-"' "$row_meta")"
      cwd="$(jq -r '.cwd // ""' "$row_meta")"
    fi
    if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      dirty="$(git -C "$cwd" status --porcelain 2>/dev/null | grep -c . || true)"
    fi
    [ "$wid" = "$cur" ] && idx="${idx}*"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$wid" "$name" "$state" "$iso" "$branch" "$dirty" "$cwd"
  done < <(tmux list-windows -t "$KEL_SESSION" -F '#{window_index}	#{window_id}	#{window_name}' 2>/dev/null)

  # metadata records with no live window
  while read -r name; do
    [ -z "$name" ] && continue
    row_meta="$SESSIONS_DIR/$name.json"
    iso="$(jq -r '.isolation' "$row_meta")"
    branch="$(jq -r '.branch // "-"' "$row_meta")"
    cwd="$(jq -r '.cwd // ""' "$row_meta")"
    dirty='-'
    if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      dirty="$(git -C "$cwd" status --porcelain 2>/dev/null | grep -c . || true)"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "-" "" "$name" "dead" "$iso" "$branch" "$dirty" "$cwd"
  done < <(dead_sessions)
}

cmd_ls() {
  need tmux; need jq
  prune_state
  if ! session_exists && [ -z "$(dead_sessions)" ]; then
    echo "no kel session — 'kel new <name>' to start one"
    return 0
  fi

  if [ "${1:-}" = "--json" ]; then
    printf '['
    local first=1
    gather_rows | while IFS=$'\t' read -r idx wid name state iso branch dirty cwd; do
      [ "$first" = 1 ] || printf ','
      first=0
      jq -nc --arg idx "${idx%\*}" --arg wid "$wid" --arg name "$name" \
             --arg state "$state" --arg iso "$iso" --arg branch "$branch" \
             --arg dirty "$dirty" --arg cwd "$cwd" \
        '{index:($idx|tonumber?), window_id:$wid, name:$name, state:$state,
          isolation:$iso, branch:(if $branch=="-" then null else $branch end),
          dirty:($dirty|tonumber?), cwd:$cwd}'
    done
    printf ']\n'
    return 0
  fi

  printf '%-4s %-16s %-9s %-12s %-14s %5s  %s\n' '#' 'NAME' 'STATE' 'ISOLATION' 'BRANCH' 'DIRTY' 'PATH'
  local any_dead=0
  gather_rows | while IFS=$'\t' read -r idx wid name state iso branch dirty cwd; do
    printf '%-4s %-16s %-9s %-12s %-14s %5s  %s\n' \
      "$idx" "$name" "$state" "$iso" "$branch" "$dirty" "${cwd/#$HOME/\~}"
  done
  [ -n "$(dead_sessions)" ] && echo "  dead = window gone.  kel restore [-c] rebuilds them  ·  kel prune discards them"
  return 0
}

# --------------------------------------------------------------------------
# kel restore  — rebuild windows for sessions whose window is gone
# --------------------------------------------------------------------------
cmd_restore() {
  need tmux; need jq
  local continue_agent=0
  case "${1:-}" in --continue|-c) continue_agent=1 ;; '') ;; *) die "kel restore: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "nothing to restore"; return 0; }

  local n meta cwd agent cid wid restored=0
  while read -r n; do
    [ -z "$n" ] && continue
    meta="$(meta_path "$n")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    agent="$(jq -r '.agent // "claude"' "$meta")"
    cid="$(jq -r '.claude_session // ""' "$meta")"
    [ -d "$cwd" ] || { warn "skip $n — its directory is gone ($cwd)"; continue; }
    wid="$(open_window "$n" "$cwd")"
    [ -n "$wid" ] || { warn "skip $n — couldn't open a window"; continue; }
    jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
    if [ "$continue_agent" = 1 ]; then
      # exact conversation if we recorded its id, else most-recent, else fresh
      if [ -n "$cid" ]; then
        tmux send-keys -t "$wid" "$agent --resume $cid || $agent --continue || $agent" Enter
      else
        tmux send-keys -t "$wid" "$agent --continue || $agent" Enter
      fi
    fi
    restored=$((restored+1))
  done <<< "$names"

  [ "$continue_agent" = 1 ] && say "restored $restored session(s) — agents resuming" \
                            || say "restored $restored session(s) — agents not started"
  goto_window "$wid"
}

# --------------------------------------------------------------------------
# kel doctor
# --------------------------------------------------------------------------
cmd_doctor() {
  need jq
  # probe LABEL CMD...  -> prints "true"/"false" to stdout, "  ✓/✗ label" to stderr
  probe() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf '  \033[1;32m✓\033[0m %s\n' "$label" >&2; printf 'true'
    else
      printf '  \033[1;31m✗\033[0m %s\n' "$label" >&2; printf 'false'
    fi
  }
  echo "kel doctor" >&2

  local r_tmux r_ver r_popup r_wt r_jq r_node r_claude r_hooks r_pass
  r_tmux=$(probe   "tmux present"                     command -v tmux)
  r_ver=$(probe    "tmux >= 3.0"                      bash -c 't=$(tmux -V | grep -oE "[0-9]+\.[0-9]+"); [ -n "$t" ] && [ "$(printf "3.0\n%s\n" "$t" | sort -V | head -1)" = "3.0" ]')
  r_popup=$(probe  "display-popup available"          bash -c 'tmux list-commands 2>/dev/null | grep -q display-popup')
  r_wt=$(probe     "git worktree available"           bash -c 'git worktree -h 2>&1 | grep -q "add"')
  r_jq=$(probe     "jq present"                       command -v jq)
  r_node=$(probe   "node on PATH"                     command -v node)
  r_claude=$(probe "claude on PATH"                   command -v claude)
  r_hooks=$(probe  "kel hooks wired in settings.json" bash -c 'jq -e "[.hooks[]?[]?.hooks[]?.command // empty] | any(test(\"kel hook|kel-hook\"))" "$HOME/.claude/settings.json" >/dev/null')
  r_pass=$(probe   "tmux allow-passthrough on"        bash -c 'tmux start-server \; show -gv allow-passthrough 2>/dev/null | grep -qx on')

  jq -n --arg d "$(date -u +%FT%TZ)" \
    --argjson tmux "$r_tmux" --argjson ver "$r_ver" --argjson popup "$r_popup" \
    --argjson wt "$r_wt" --argjson jq "$r_jq" --argjson node "$r_node" \
    --argjson claude "$r_claude" --argjson hooks "$r_hooks" --argjson pass "$r_pass" \
    '{checked_at:$d, tmux:$tmux, "tmux>=3.0":$ver, display_popup:$popup,
      git_worktree:$wt, jq:$jq, node:$node, claude:$claude,
      hooks_wired:$hooks, allow_passthrough:$pass}' \
    > "$DOCTOR_CACHE"
  printf '  cached -> %s\n' "${DOCTOR_CACHE/#$HOME/\~}" >&2

  # fail only if something load-bearing is missing
  case "$r_tmux$r_ver$r_jq" in *false*) exit 1 ;; esac
}

# --------------------------------------------------------------------------
# kel status-line   (tmux status-left)
# --------------------------------------------------------------------------
cmd_status_line() {
  [ -n "${TMUX:-}" ] || exit 0
  local cur; cur="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  local out="#[fg=colour245][kel]#[default]"
  while read -r wid idx name; do
    [ -z "$wid" ] && continue
    local suffix='' colour=''
    if [ -f "$STATE_DIR/$wid.state" ]; then
      local state; read -r state _ < "$STATE_DIR/$wid.state" || state=''
      case "$state" in
        waiting) suffix='?'; colour='#[fg=colour214,bold]' ;;
        working) suffix='*'; colour='#[fg=colour111]' ;;
        done)    suffix='!'; colour='#[fg=colour114]' ;;
      esac
    fi
    if [ "$wid" = "$cur" ]; then
      out="$out ${colour}[${idx}:${name}${suffix}]#[default]"
    else
      out="$out ${colour}${idx}:${name}${suffix}#[default]"
    fi
  done < <(tmux list-windows -F '#{window_id} #{window_index} #{window_name}' 2>/dev/null)
  printf '%s ' "$out"
}

# --------------------------------------------------------------------------
# kel jump   (prefix `)
# --------------------------------------------------------------------------
cmd_jump() {
  [ -n "${TMUX:-}" ] || exit 0
  local current; current="$(tmux display-message -p '#{window_index}' 2>/dev/null || echo 0)"
  local waiting=()
  while read -r wid idx; do
    [ -z "$wid" ] && continue
    [ -f "$STATE_DIR/$wid.state" ] || continue
    local state; read -r state _ < "$STATE_DIR/$wid.state" || continue
    [ "$state" = waiting ] && waiting+=("$idx")
  done < <(tmux list-windows -F '#{window_id} #{window_index}' 2>/dev/null)
  [ "${#waiting[@]}" -eq 0 ] && { tmux display-message "kel: nothing waiting"; exit 0; }
  local target="${waiting[0]}"
  for idx in "${waiting[@]}"; do [ "$idx" -gt "$current" ] && { target="$idx"; break; }; done
  tmux select-window -t "$target"
}

# --------------------------------------------------------------------------
# kel cheat   (prefix k)
# --------------------------------------------------------------------------
cmd_cheat() {
cat <<'EOF'

  kel keys              prefix = Ctrl+b   (press, release, then the key)
  ─────────────────────────────────────────────────────────────────────────

  MOVE                             SCROLL an agent's output
    prefix `    next WAITING agent   prefix [    scroll mode
    prefix 0-9  jump to window N                 ↑↓ PgUp PgDn move
    prefix n/p  next / prev                      /  search   q  leave
    prefix w    pick from a list      prefix ]   paste

  WINDOWS (one per agent)          PANES (split one window)
    prefix c    blank window          prefix |    split left | right
    prefix ,    rename                 prefix -    split top / bottom
    prefix &    close (confirms)      prefix ↑↓←→ move between panes
                                       prefix z    zoom (toggle)
                                       prefix x    close pane

  SESSION
    prefix d          detach — agents keep running, round-trips (safe)
    prefix $          rename the session
    (killing the session, not detaching, ENDS the agent processes)

  FROM A SHELL
    kel               (re-)enter the workspace
    kel new <name>    new window + agent   (-w = git worktree)
    kel ls            list everything      kel kill <name>   close one
    kel restore [-c]  rebuild after a kill / reboot  (-c resumes conversations)
    kel prune         discard dead session records

  STATUS BAR   N:name*  working    N:name?  waiting     N:name!  done
               N:name   idle      [N:name] the window you're on

  prefix k   this menu        prefix ?   tmux's full key list
  Want mouse scroll / click?  add  set -g mouse on  to ~/.tmux.conf

EOF
}

# --------------------------------------------------------------------------
# kel hook <EVENT>   (Claude Code state adapter)
# --------------------------------------------------------------------------
cmd_hook() {
  local event="${1:-}"
  command -v tmux >/dev/null 2>&1 || exit 0
  local payload sid cwd
  payload="$(cat 2>/dev/null || true)"
  [ -z "$event" ] && event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
  cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"

  local pane="${TMUX_PANE:-}"
  if [ -z "$pane" ] && [ -n "$sid" ] && [ -f "$STASH_DIR/$sid" ]; then
    pane="$(cat "$STASH_DIR/$sid" 2>/dev/null || true)"
  fi
  if [ -z "$pane" ] && [ -n "$cwd" ]; then
    local match
    match="$(tmux list-panes -a -F '#{pane_id} #{pane_current_path}' 2>/dev/null | awk -v c="$cwd" '$2==c{print $1}')"
    [ "$(printf '%s\n' "$match" | grep -c .)" = 1 ] && pane="$match"
  fi
  if [ "$event" = "SessionStart" ] && [ -n "$pane" ] && [ -n "$sid" ]; then
    printf '%s' "$pane" > "$STASH_DIR/$sid"
  fi
  [ -z "$pane" ] && exit 0

  local wid; wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  [ -z "$wid" ] && exit 0

  # link this Claude conversation to the kel session record (for exact restore)
  if [ -n "$sid" ] && [ "$event" != SessionEnd ]; then
    local m
    for m in "$SESSIONS_DIR"/*.json; do
      [ -e "$m" ] || continue
      [ "$(jq -r '.window_id' "$m" 2>/dev/null)" = "$wid" ] || continue
      [ "$(jq -r '.claude_session // ""' "$m" 2>/dev/null)" = "$sid" ] && break
      jq --arg s "$sid" '.claude_session=$s' "$m" > "$m.t" 2>/dev/null && mv "$m.t" "$m"
      break
    done
  fi

  local state
  case "$event" in
    SessionStart)     state=idle ;;
    UserPromptSubmit) state=working ;;
    Notification)     state=waiting ;;
    Stop)             state=done ;;
    SessionEnd)
      rm -f "$STATE_DIR/$wid.state"
      [ -n "$sid" ] && rm -f "$STASH_DIR/$sid"
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    *) exit 0 ;;
  esac
  local tmp
  tmp="$(mktemp "$STATE_DIR/.${wid#@}.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s %s\n' "$state" "$(date +%s)" > "$tmp"
  mv -f "$tmp" "$STATE_DIR/$wid.state"
  tmux refresh-client -S 2>/dev/null || true
}

# --------------------------------------------------------------------------
# kel  (no args)  — enter the workspace
# --------------------------------------------------------------------------
cmd_attach() {
  need tmux
  prune_state
  if in_tmux; then cmd_ls; return; fi
  if session_exists; then
    tmux attach -t "$KEL_SESSION"
  elif [ -n "$(dead_sessions)" ]; then
    warn "no live workspace, but these sessions can be rebuilt:"
    cmd_ls
    echo "  kel restore [-c]  rebuild them   ·   kel prune  discard them"
  else
    say "starting a fresh workspace — 'kel new <name>' to add an agent"
    tmux new-session -s "$KEL_SESSION" -c "$HOME"
  fi
}

usage() {
  awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
}

# --------------------------------------------------------------------------
main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    new)          cmd_new "$@" ;;
    kill)         cmd_kill "$@" ;;
    ls|list)      cmd_ls "$@" ;;
    restore)      cmd_restore "$@" ;;
    prune)        cmd_prune "$@" ;;
    doctor)       cmd_doctor "$@" ;;
    status-line)  cmd_status_line ;;
    jump)         cmd_jump ;;
    cheat)        cmd_cheat ;;
    hook)         cmd_hook "$@" ;;
    ''|attach)    cmd_attach ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd  (try: kel --help)" ;;
  esac
}
main "$@"
