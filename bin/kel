#!/usr/bin/env bash
# kel — a terminal workspace for running several coding agents at once.
# tmux does the multiplexing; kel does the bookkeeping.
#
#   kel                        enter the workspace — in a repo, go to (or start)
#                              that repo's agent, like `claude` for a directory
#   kel new <name> [-w]        window + agent, inplace or in a git worktree
#         [--group G] [--agent CMD] [--no-agent]
#   kel kill <name> [-f]       close the window; remove the worktree; -f overrides
#                              the uncommitted / unpushed check
#   kel ls [--json]            list agents, grouped by repo
#   kel rename <newname>       rename the current window (keeps metadata in sync)
#   kel restore [<n>]          bring back a previous workspace, conversations
#         [--list] [--no-resume]  resumed (--list: choose among the last five)
#   kel relaunch [name] [-f]   relaunch a crashed agent in its existing window
#                              (one agent — `kel restore` rebuilds the workspace)
#   kel top                    the fleet dashboard (prefix t)
#   kel sweep [-n] [-f]        close every finished agent whose work has merged
#                              (closes windows; -n shows the plan first)
#   kel prune [-f]             forget dead agent records (closes nothing)
#   kel doctor                 capability probe, cached
#   kel config                 edit config.toml (seeds it from the shipped
#                              example the first time — every key is
#                              commented out with its default)
#   kel update                 fast-forward the clone kel runs from, then
#                              re-run install.sh (refuses on a dirty tree)
#
# internal (wired by install.sh; some are fine to type, none are the point):
#   kel status-line [group]    render tmux status-left
#   kel jump                   jump to the next waiting agent, any group (prefix `)
#   kel snapshot               save the workspace shape (hooks call this)
#   kel hook <EVENT>           Claude Code state hook
#   kel statusline             Claude Code statusLine — context % / cost
set -uo pipefail

# --------------------------------------------------------------------------
# config  —  ~/.config/kel/config.toml, and a per-repo .kel/config.toml
# --------------------------------------------------------------------------
# Deliberately a flat `key = value` subset of TOML, not a parser: every knob
# kel has is a scalar, and a real parser would be a dependency for nothing.
# Sections are ignored, so `[ui]` above a key is decoration.
#
# Precedence: an exported KEL_* env var  >  repo .kel/config.toml  >  user
# config.toml  >  built-in default. Env wins because it is the more explicit
# statement — you typed it for this shell, on purpose.
#
# This runs on EVERY invocation including each status-bar redraw, so it forks
# nothing unless a config file actually exists: the search is bash builtins,
# and awk is spawned only for a file that is really there. A first cut used
# `git rev-parse` to find the repo root and cost 5ms on every single call.
kel_config_read() {   # file
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    # trim leading whitespace FIRST: an indented key would otherwise parse as
    # empty, and an indented comment would not be recognised as one
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ''|\#*|\[*) continue ;; esac
    [ -n "${line##*=*}" ] && continue
    local key="${line%%=*}" val="${line#*=}"
    key="${key%%[[:space:]]*}"
    val="${val%%#*}"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
    val="${val%\"}"; val="${val#\"}"
    val="${val%\'}"; val="${val#\'}"
    case "$key" in ''|*[!a-z0-9_]*) continue ;; esac
    local up=''
    case "$key" in *) up="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')" ;; esac
    local envname="KEL_$up"
    [ -n "${!envname:-}" ] && continue        # never override an exported var
    export "$envname=$val"
  done < "$1"
}

kel_config_load() {
  local user="${XDG_CONFIG_HOME:-$HOME/.config}/kel/config.toml"
  # walk up for a repo config using builtins only — no git, no forks
  local d="$PWD" repo=''
  while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != "$HOME" ]; do
    [ -f "$d/.kel/config.toml" ] && { repo="$d/.kel/config.toml"; break; }
    d="${d%/*}"
  done
  # Highest precedence first: the "already set" guard makes this first-write-
  # wins, so the repo config has to be read BEFORE the user one, not after.
  [ -n "$repo" ] && kel_config_read "$repo"
  [ -f "$user" ] && kel_config_read "$user"
}
kel_config_load

KEL_PREFIX="${KEL_SESSION:-kel}"          # the one tmux session (v0.9: <prefix>/<group>)
KEL_AGENT="${KEL_AGENT:-claude}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
SESSIONS_DIR="$STATE_DIR/sessions"
STASH_DIR="$STATE_DIR/.stash"
DOCTOR_CACHE="$STATE_DIR/doctor.json"
SNAPSHOT="$STATE_DIR/snapshot.json"
RESTORE_LOCK="$STATE_DIR/.restoring"
KEL_FLEET_BIN="${KEL_FLEET_BIN:-$HOME/.local/bin/kel-fleet}"   # the Go seam (v0.6)
KEL_TOP_BIN="${KEL_TOP_BIN:-$HOME/.local/bin/kel-top}"
SNAPSHOT_ARCHIVE="$STATE_DIR/snapshots"           # workspaces kel started fresh over
STATUSLINE_PREV="$HOME/.claude/statusline-prev"   # a statusLine kel displaced
KEL_CTX_WARN="${KEL_CTX_WARN:-70}"                # show context on the bar from here up
KEL_NOTIFY="${KEL_NOTIFY:-waiting}"               # states worth interrupting you for
# The running script's own absolute path, preferred over a PATH lookup: kel
# re-invokes itself (sweep, tmux bindings) and resolving that
# through PATH breaks whenever kel is not installed — a fresh clone, or CI.
# That failed silently, because the re-invocation just did nothing.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")"
[ -x "$SELF" ] || SELF="$(command -v kel 2>/dev/null || printf '%s' "$HOME/.local/bin/kel")"
# commands worth re-running per pane on restore (agents handled separately)
KEL_RESTORE_CMDS="${KEL_RESTORE_CMDS:-nvim vim hx nano lazygit lazydocker htop btop k9s}"

# guarded: an unconditional mkdir -p of three existing dirs measured ~10ms,
# and every kel invocation — including each status-bar redraw — paid it
#
# 0700, like ~/.ssh: the records carry repo paths, branch names and Claude
# session ids, and <wid>.state carries Claude Code's notification text, which
# is the agent quoting a command back at you — file paths and greps included.
# None of that should be readable by another account on a shared or managed
# machine.  The DIRECTORY mode is what does the work: no traverse, no reads,
# whatever the modes inside.
#
# Deliberately not a global `umask 077`, which would also apply to the files
# `git worktree add` creates in cmd_new — kel would silently start writing
# your source at 0600, which is not its business.
[ -d "$SESSIONS_DIR" ] && [ -d "$STASH_DIR" ] \
  || { mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$STASH_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null; }

humanize_secs() {   # 45 -> 45s   400 -> 6m   3900 -> 1h05m
  local s="${1:-0}"
  case "$s" in ''|*[!0-9]*) s=0 ;; esac
  if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%dm' $(( s / 60 ))
  else                         printf '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 )); fi
}

say()  { printf '\033[1;32mkel\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mkel\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mkel\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --------------------------------------------------------------------------
# groups & sessions
# --------------------------------------------------------------------------
# tmux session name for a group.  The bare prefix is the pre-v0.2 flat session.

slug_ok() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
git_root() { git rev-parse --show-toplevel 2>/dev/null; }
in_tmux()  { [ -n "${TMUX:-}" ]; }
has_remote() { [ -n "$(git -C "$1" remote 2>/dev/null)" ]; }

# derive the group for a new agent:
#   --group flag  >  $KEL_GROUP (force everything into one group)  >  repo basename  >  misc
# --group flag > $KEL_GROUP > .kel/group > repo basename > misc
group_for_cwd() {
  [ -n "${KEL_GROUP:-}" ] && { printf '%s' "$KEL_GROUP"; return; }
  local g; g="$(dir_group "$PWD")"
  [ -n "$g" ] && { printf '%s' "$g"; return; }
  local gr; gr="$(git_root 2>/dev/null || true)"
  if [ -n "$gr" ]; then basename "$gr"; else printf 'misc'; fi
}

# A `.kel/group` file pins a directory (and everything under it) to a group,
# for a monorepo that does not split cleanly on git root.  Searched upward from
# $1, stopping at the repo root so it cannot escape into a parent project.
dir_group() {   # dir -> group name, or empty
  local d="$1" root g
  root="$(cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
  while [ -n "$d" ] && [ "$d" != / ]; do
    if [ -f "$d/.kel/group" ]; then
      read -r g < "$d/.kel/group" 2>/dev/null || g=''
      g="${g%$'\r'}"                      # tolerate a CRLF checkout
      g="${g#"${g%%[![:space:]]*}"}"      # trim, but do NOT truncate: a file
      g="${g%"${g##*[![:space:]]}"}"      # saying "not a slug" is an error,
      if slug_ok "$g"; then                # not a request for the group "not"
        printf '%s' "$g"; return 0
      fi
      warn ".kel/group in $d is not a slug ('$g') — ignoring it"
      return 0
    fi
    [ "$d" = "$root" ] && break
    d="$(dirname "$d")"
  done
}

# ---- the one session ----------------------------------------------------
# Since v0.10 every kel window lives in ONE tmux session, named exactly
# $KEL_PREFIX.  The sidebar groups by repo itself; a session per repo only made
# navigation two-level.  A window's group therefore cannot come from its
# session any more: kel stamps it on the window as the @kel-group option,
# which the hot paths can read in the same format string they already run.
#
# v0.9 put each repo in its own `<prefix>/<group>` session.  A server started
# before the upgrade still has those, so everything that READS recognises them
# (their name still carries the group); nothing creates them, and they drain as
# their windows close — the way v0.2 drained the flat session before them.

# kel's live sessions: the one session, plus any legacy per-repo ones
kel_sessions() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null \
    | awk -v p="$KEL_PREFIX" '$0==p || index($0,p"/")==1'
}

# every window kel owns:  session<TAB>index<TAB>wid<TAB>name<TAB>group
# group is @kel-group, else the legacy session's name, else empty (a hand-made
# window in the one session — kel-fleet derives its group from the pane's repo)
kel_windows() {
  tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}	#{@kel-group}' 2>/dev/null \
  | awk -F'\t' -v p="$KEL_PREFIX" '
      $1==p || index($1,p"/")==1 {
        g = $5
        if (g == "" && index($1,p"/")==1) g = substr($1, length(p)+2)
        print $1"\t"$2"\t"$3"\t"$4"\t"g
      }'
}

# the group of the window the client is looking at, or empty outside kel
current_group() {
  # '|', not a tab: an empty @kel-group is a leading empty field, which
  # IFS=$'\t' read silently drops (CLAUDE.md, traps) — and slugs have no '|'
  # Only from inside tmux, and about THIS pane.  Outside a client, #{@kel-group}
  # still resolves against tmux's default window — a guess that silently
  # disarmed `kel kill`'s ambiguity check.  #{client_session} used to be empty
  # there, which is what kept the old version honest.
  [ -n "${TMUX:-}" ] || return 0
  local v g s
  v="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{@kel-group}|#{client_session}' 2>/dev/null || true)"
  g="${v%%|*}"; s="${v#*|}"
  if [ -n "$g" ]; then printf '%s' "$g"; return; fi
  case "$s" in "$KEL_PREFIX"/*) printf '%s' "${s#"$KEL_PREFIX"/}" ;; esac
}

state_note() { # wid -> the notification text the hook recorded, if any
  [ -f "$STATE_DIR/$1.state" ] || return 0
  local st ep rest
  read -r st ep rest < "$STATE_DIR/$1.state" 2>/dev/null || return 0
  printf '%s' "${rest:-}"
}

state_of() { # wid -> raw state from the hook, or empty
  [ -f "$STATE_DIR/$1.state" ] || return 0
  local s; read -r s _ < "$STATE_DIR/$1.state" || return 0
  printf '%s' "$s"
}

# effective_state: raw hook state, but "dead" if the agent process is gone
# (a crash/OOM fires no Stop/SessionEnd hook — the window just drops to a shell)
effective_state() { # wid
  local s; s="$(state_of "$1")"
  case "$s" in
    # idle is a real signal, not "no signal yet" — SessionStart already fired
    # and set it. That is NOT the launch race this dead-check has to dodge:
    # during the launch race there is no state FILE at all yet (state_of
    # returns empty, matching neither branch here), because kel new sends the
    # agent command with send-keys and the shell briefly still shows before
    # claude execs. Once idle is on record that race is over, so a shell in
    # the pane at that point means the agent process actually died — found by
    # walking through the tool as a fresh user: an agent that crashes between
    # SessionStart and its first prompt used to sit reading "idle" forever,
    # with no glyph, no colour, nothing to tell you it was gone.
    idle|working|waiting|throttled)
      tmux list-panes -t "$1" -F '#{pane_current_command}' 2>/dev/null \
        | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' || { printf 'dead'; return; } ;;
  esac
  printf '%s' "$s"
}

# create the window in the one session (making it if needed); prints wid
open_window() { # name cwd group
  local name="$1" cwd="$2" group="$3" wid
  if tmux has-session -t "=$KEL_PREFIX" 2>/dev/null; then
    wid="$(tmux new-window -t "=$KEL_PREFIX:" -n "$name" -c "$cwd" -P -F '#{window_id}')"
  else
    wid="$(tmux new-session -d -s "$KEL_PREFIX" -n "$name" -c "$cwd" -x 220 -y 50 -P -F '#{window_id}')"
  fi
  [ -n "$wid" ] || return 1
  tmux set-option -w -t "$wid" @kel-group "$group" 2>/dev/null || true
  printf '%s' "$wid"
}

# move the caller to a window, in whichever kel session holds it
goto_window() { # wid
  local wid="$1" s
  s="$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null || true)"
  if in_tmux; then
    [ -n "$s" ] && tmux switch-client -t "=$s" 2>/dev/null || true
    tmux select-window -t "$wid" 2>/dev/null || true
  elif [ -t 1 ]; then
    tmux attach -t "=${s:-$KEL_PREFIX}" \; select-window -t "$wid"
  fi
  return 0
}

# --------------------------------------------------------------------------
# metadata
# --------------------------------------------------------------------------
# Records live at $SESSIONS_DIR/<group>/<name>.json — keyed by group *and*
# name, so two repos can each have an agent called "docs".
meta_path() { printf '%s/%s/%s.json' "$SESSIONS_DIR" "$1" "$2"; }   # group name

# every record on disk, as  group<TAB>name<TAB>path
all_metas() {
  local d g f nm
  for d in "$SESSIONS_DIR"/*/; do
    [ -d "$d" ] || continue
    g="$(basename "$d")"
    for f in "$d"*.json; do
      [ -e "$f" ] || continue
      nm="$(basename "$f" .json)"
      printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
    done
  done
}

# the record owning a tmux window id, as  group<TAB>name<TAB>path
meta_by_wid() { # wid
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    [ "$(jq -r '.window_id // ""' "$f" 2>/dev/null)" = "$1" ] || continue
    printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0
  done < <(all_metas)
  return 1
}

# resolve a user-typed agent to  group<TAB>name<TAB>path.
# accepts "name" or "group/name".  A bare name prefers the group you are
# standing in, then a unique match anywhere; exit 2 (candidates on stderr) when
# the same name exists in several groups.
resolve_agent() { # name [preferred-group]
  local want="$1" pref="${2:-}" g nm f hits
  case "$want" in
    */*) g="${want%%/*}"; nm="${want##*/}"; f="$(meta_path "$g" "$nm")"
         [ -f "$f" ] || return 1
         printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0 ;;
  esac
  [ -z "$pref" ] && pref="$(current_group)"
  if [ -n "$pref" ] && [ -f "$(meta_path "$pref" "$want")" ]; then
    printf '%s\t%s\t%s\n' "$pref" "$want" "$(meta_path "$pref" "$want")"; return 0
  fi
  hits="$(all_metas | awk -F'\t' -v n="$want" '$2==n')"
  case "$(printf '%s' "$hits" | grep -c .)" in
    0) return 1 ;;
    1) printf '%s\n' "$hits"; return 0 ;;
    *) printf '%s' "$hits" | awk -F'\t' '{printf "  %s/%s\n", $1, $2}' >&2; return 2 ;;
  esac
}

meta_write() { # name wid repo cwd isolation branch agent group
  mkdir -p "$SESSIONS_DIR/$8"
  jq -n \
    --arg name "$1" --arg wid "$2" --arg repo "$3" --arg cwd "$4" \
    --arg iso "$5" --arg branch "$6" --arg agent "$7" --arg group "$8" \
    --arg created "$(date -u +%FT%TZ)" \
    '{name:$name, window_id:$wid, repo:$repo, cwd:$cwd, isolation:$iso,
      branch:(if $branch=="" then null else $branch end),
      agent:$agent, group:$group, created_at:$created}' \
    > "$(meta_path "$8" "$1")"
}

# pre-v0.2 records have no .group (derive it from .repo); pre-v0.4.1 records
# sit flat in sessions/ (file them under sessions/<group>/).
migrate_meta() {
  local f nm repo grp dest
  # Existing installs were created before the 0700 rule, so fixing it only in
  # the mkdir branch above would never reach them.  This runs on every
  # non-hot-path command; a chmod on an already-correct dir is one cheap
  # syscall, and doing it here keeps the hot paths free of it.
  chmod 700 "$STATE_DIR" 2>/dev/null
  # v0.10: one session has no "last group" to return to, and kel no longer
  # asks about snapshots, so there is no refusal to remember
  rm -f "$STATE_DIR/last-group" "$STATE_DIR/snapshot-declined"
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    nm="$(basename "$f" .json)"
    grp="$(jq -r '.group // ""' "$f" 2>/dev/null)"
    if [ -z "$grp" ] || [ "$grp" = null ]; then
      repo="$(jq -r '.repo // ""' "$f" 2>/dev/null)"
      if [ -n "$repo" ]; then grp="$(basename "$repo")"; else grp="misc"; fi
      jq --arg g "$grp" '.group = $g' "$f" > "$f.m" 2>/dev/null && mv "$f.m" "$f"
    fi
    slug_ok "$grp" || grp=misc
    mkdir -p "$SESSIONS_DIR/$grp"
    dest="$(meta_path "$grp" "$nm")"
    if [ -e "$dest" ]; then
      warn "two records for '$grp/$nm' — keeping the newer"
      if [ "$f" -nt "$dest" ]; then mv -f "$f" "$dest"; else rm -f "$f"; fi
    else
      mv -f "$f" "$dest"
    fi
  done
}

# is a metadata record backed by a live window (same id + name) in any kel session?
meta_is_live() { # path name
  local wid; [ -f "$1" ] || return 1
  wid="$(jq -r '.window_id' "$1")"
  kel_windows | awk -F'\t' -v w="$wid" -v n="$2" '$3==w && $4==n {found=1} END{exit !found}'
}

# records with no live window, as  group<TAB>name<TAB>path
dead_sessions() {
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    meta_is_live "$f" "$nm" || printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
  done < <(all_metas)
}

prune_state() {
  local live f wid panes pane
  live="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)"
  [ -n "$live" ] || return 0
  for f in "$STATE_DIR"/*.state "$STATE_DIR"/*.ctx; do
    [ -e "$f" ] || continue
    wid="${f##*/}"; wid="${wid%.state}"; wid="${wid%.ctx}"
    printf '%s\n' "$live" | grep -qxF "$wid" || rm -f "$f"
  done
  # SessionEnd removes a session's own stash entry, including on /clear, which
  # fires it with reason "clear". Nothing fires when a session dies with its
  # terminal — SIGKILL, a closed window, a reboot — and SessionEnd gets a 1.5s
  # budget besides. Those entries name a pane, so a pane that is gone marks an
  # entry that can go with it.
  panes="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)"
  [ -n "$panes" ] || return 0
  for f in "$STASH_DIR"/*; do
    [ -e "$f" ] || continue
    pane="$(cat "$f" 2>/dev/null || true)"
    [ -n "$pane" ] || { rm -f "$f"; continue; }
    printf '%s\n' "$panes" | grep -qxF "$pane" || rm -f "$f"
  done
}

# 0 (true) if the worktree has uncommitted changes or commits on no remote
worktree_unsafe() { # cwd
  [ -d "$1" ] || return 1
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null || true)" ] && return 0
  if has_remote "$1"; then
    [ -n "$(git -C "$1" log --oneline HEAD --not --remotes 2>/dev/null || true)" ] && return 0
  fi
  return 1
}

# --------------------------------------------------------------------------
# kel new
# --------------------------------------------------------------------------
cmd_new() {
  need tmux; need jq
  local name='' worktree=0 agent="$KEL_AGENT" start_agent=1 group_override=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -w|--worktree) worktree=1 ;;
      --group)       shift; group_override="${1:-}"; [ -n "$group_override" ] || die "--group needs a name" ;;
      --agent)       shift; agent="${1:-}"; [ -n "$agent" ] || die "--agent needs a command" ;;
      --no-agent)    start_agent=0 ;;
      -*)            die "kel new: unknown flag $1" ;;
      *)             [ -z "$name" ] || die "kel new: unexpected argument '$1'"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel new <name> [-w] [--group G] [--agent CMD] [--no-agent]"
  slug_ok "$name" || die "name must be a slug (A-Z a-z 0-9 . _ -)"

  local repo cwd branch='' isolation='inplace' group
  repo="$(git_root || true)"
  group="${group_override:-$(group_for_cwd)}"
  slug_ok "$group" || die "group '$group' is not a slug — pass --group"

  # names only have to be unique within their group
  if [ -f "$(meta_path "$group" "$name")" ]; then
    if meta_is_live "$(meta_path "$group" "$name")" "$name"; then
      die "agent '$group/$name' already exists (kel kill $group/$name first)"
    fi
    warn "reclaiming the record for '$group/$name' (its window is gone)"
    rm -f "$(meta_path "$group" "$name")"
  fi
  [ -z "$group_override" ] && [ -z "${KEL_GROUP:-}" ] && [ -z "$repo" ] && \
    warn "no git repo here → group 'misc'  (use --group NAME to name it)"

  if [ "$worktree" = 1 ]; then
    [ -n "$repo" ] || die "--worktree must be run inside a git repo"
    branch="$name"
    isolation='worktree'
    local wt_root="${KEL_WORKTREES:-$(dirname "$repo")/.kel-worktrees}"
    mkdir -p "$wt_root"
    cwd="$wt_root/$(basename "$repo")-$name"
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $cwd"; then
      say "reusing existing worktree  $cwd"
    elif [ -e "$cwd" ]; then
      die "path exists but isn't a registered worktree: $cwd"
    else
      say "creating worktree  $cwd  (branch $branch)"
      git -C "$repo" worktree add -b "$branch" "$cwd" >/dev/null \
        || git -C "$repo" worktree add "$cwd" "$branch" >/dev/null \
        || die "git worktree add failed"
      if [ -x "$repo/.kel/setup" ]; then
        say "running .kel/setup"
        if ! ( cd "$cwd" && KEL_REPO="$repo" KEL_WORKTREE="$cwd" "$repo/.kel/setup" ); then
          warn ".kel/setup exited non-zero — the worktree may be incomplete"
        fi
      fi
    fi
  else
    cwd="${repo:-$PWD}"
  fi

  # F: give Claude Code the name YOU chose, so /list-agents, @mentions and
  # kel ls all agree. Claude's own name is auto-generated unless set, so kel's
  # is the more meaningful one. Only for claude — another agent may not take
  # the flag, and guessing would break it.
  case "${agent%% *}" in
    claude|*/claude) agent="$agent --name $name" ;;
  esac

  local wid
  wid="$(open_window "$name" "$cwd" "$group")"
  [ -n "$wid" ] || die "failed to create tmux window"

  meta_write "$name" "$wid" "$repo" "$cwd" "$isolation" "$branch" "$agent" "$group"
  [ "$start_agent" = 1 ] && tmux send-keys -t "$wid" "$agent" Enter

  say "new agent  $name  [$group]  ($isolation${branch:+, branch $branch})"
  goto_window "$wid"
  snapshot
}

# --------------------------------------------------------------------------
# kel kill
# --------------------------------------------------------------------------
cmd_kill() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel kill: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel kill <name> [--force]"
  local orig_name="$name"

  local meta='' wid iso='inplace' cwd='' branch='' repo='' group=''
  local bare="${orig_name##*/}" rr rc=0
  rr="$(resolve_agent "$name")" || rc=$?
  [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel kill <group>/<name>"
  if [ -n "$rr" ]; then
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    # no record under that name — the window may have been renamed since
    # `kel new`.  Find the record owning the window currently named $bare.
    local bw; bw="$(kel_windows | awk -F'\t' -v n="$bare" '$4==n {print $3; exit}')"
    if [ -n "$bw" ]; then
      rr="$(meta_by_wid "$bw" || true)"
      [ -n "$rr" ] && IFS=$'\t' read -r group name meta <<< "$rr"
    fi
  fi
  if [ -n "$meta" ] && [ -f "$meta" ]; then
    wid="$(jq -r '.window_id' "$meta")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    branch="$(jq -r '.branch // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    name="$(jq -r '.name // empty' "$meta")"; name="${name:-$orig_name}"
  else
    wid="$(kel_windows | awk -F'\t' -v n="$bare" '$4==n {print $3; exit}')"
    [ -n "$wid" ] || die "no agent '$orig_name'"
    name="$bare"
    warn "'$name' is an unmanaged window — closing it, no metadata to clean up"
  fi

  if [ "$iso" = "worktree" ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
    warn "refusing to kill '$name' — the worktree has work that isn't safe to lose:"
    local d; d="$(git -C "$cwd" status --short 2>/dev/null || true)"
    [ -n "$d" ] && { echo "  uncommitted changes:" >&2; echo "$d" | sed 's/^/    /' >&2; }
    local u; has_remote "$cwd" && u="$(git -C "$cwd" log --oneline HEAD --not --remotes 2>/dev/null || true)"
    [ -n "${u:-}" ] && { echo "  commits not on any remote:" >&2; echo "$u" | sed 's/^/    /' >&2; }
    die "commit & push, or run: kel kill $name --force"
  fi

  [ -n "$wid" ] && tmux kill-window -t "$wid" 2>/dev/null || true

  # deliberately NOT gated on [ -d "$cwd" ]: that used to skip this whole
  # block whenever the worktree directory was gone (rm -rf'd by hand, or a
  # file manager), which left git's own worktree record behind — pointing at
  # a directory that no longer exists — permanently locking the branch
  # ("used by worktree") until someone ran `git worktree prune` by hand.
  # `git worktree remove` handles a missing directory fine on its own,
  # confirmed directly rather than assumed: it exits 0 and cleans the
  # phantom entry, force or not. `git worktree prune` is a fallback for
  # remove failing for some other reason — it only touches entries whose
  # directory is already gone, never a live one, so it cannot be the thing
  # that deletes work.
  if [ "$iso" = "worktree" ] && [ -n "$repo" ] && [ -n "$cwd" ]; then
    if git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null; then
      say "removed worktree $cwd  (branch $branch kept)"
    elif git -C "$repo" worktree prune 2>/dev/null; then
      # prune is repo-wide, not targeted at $cwd -- it only removes entries
      # whose directory is already gone, so this can undersell (nothing left
      # to prune) but never overclaim removing something still live
      say "ran git worktree prune on $repo  (branch $branch kept)"
    else
      warn "couldn't remove worktree — do it manually: git -C $repo worktree remove ${force:+--force} $cwd"
    fi
  fi

  rm -f "$meta" "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
  say "killed $name"
  snapshot
}

# --------------------------------------------------------------------------
# kel rename <newname>  — rename the current window and keep metadata in sync
# --------------------------------------------------------------------------
# rename a specific window by id + move its metadata record along with it
rename_agent() { # wid new
  local wid="$1" new="$2" old grp='' sn v
  old="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)"
  [ -n "$old" ] || { warn "kel rename: window $wid is gone"; return 1; }
  [ "$old" = "$new" ] && return 0
  # the group is the window's @kel-group since v0.10 (one session names none);
  # a legacy v0.9 kel/<group> session still names it
  v="$(tmux display-message -p -t "$wid" '#{@kel-group}|#{session_name}' 2>/dev/null || true)"
  grp="${v%%|*}"; sn="${v#*|}"
  [ -z "$grp" ] && case "$sn" in "$KEL_PREFIX"/*) grp="${sn#"$KEL_PREFIX"/}" ;; esac
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$new")" ] && \
    { warn "an agent named '$new' already exists in [$grp]"; return 1; }

  tmux rename-window -t "$wid" "$new"

  # move the metadata record if this is a managed agent (by name, or by window id)
  local om='' rr
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$old")" ] && om="$(meta_path "$grp" "$old")"
  if [ -z "$om" ]; then
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] && { grp="${rr%%$'\t'*}"; om="${rr##*$'\t'}"; }
  fi
  if [ -n "$om" ] && [ -f "$om" ]; then
    mkdir -p "$SESSIONS_DIR/$grp"
    jq --arg n "$new" '.name=$n' "$om" > "$(meta_path "$grp" "$new")" && rm -f "$om"
  fi
  say "renamed '$old' -> '$new'"
  snapshot
}

cmd_rename() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel rename: run this from inside kel"
  local new="${1:-}"
  [ -n "$new" ] || die "usage: kel rename <newname>"
  slug_ok "$new" || die "name must be a slug (A-Z a-z 0-9 . _ -)"
  # the window this pane is in, not "the current window": with one session
  # (v0.10) tmux's notion of current is whichever window was selected last,
  # which renamed the wrong agent the moment two shared a session
  rename_agent "$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}')" "$new"
}

# --------------------------------------------------------------------------
# kel prune
# --------------------------------------------------------------------------
cmd_prune() {
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "kel prune: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "no dead agents"; return 0; }

  local g n meta iso cwd repo removed=0 kept=0
  while IFS=$'\t' read -r g n meta; do
    [ -z "$n" ] && continue
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    if [ "$iso" = worktree ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
      warn "kept '$g/$n' — worktree has unsaved work  (kel kill $g/$n -f)"
      kept=$((kept + 1)); continue
    fi
    # same fix as cmd_kill, and the same reason: NOT gated on [ -d "$cwd" ].
    # git worktree remove handles a missing directory fine on its own; the
    # -d gate was what let a hand-deleted worktree directory leave git's own
    # record behind, permanently locking the branch until someone ran
    # git worktree prune by hand. prune here is the same belt-and-suspenders
    # fallback — repo-wide, only ever touches entries already gone.
    if [ "$iso" = worktree ] && [ -n "$repo" ] && [ -n "$cwd" ]; then
      git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null \
        || git -C "$repo" worktree prune 2>/dev/null \
        || warn "left worktree $cwd (remove by hand)"
    fi
    rm -f "$meta"
    removed=$((removed + 1))
  done <<< "$names"

  say "pruned $removed dead agent(s)$([ "$kept" -gt 0 ] && printf ', kept %s' "$kept")"
}

# --------------------------------------------------------------------------
# kel ls
# --------------------------------------------------------------------------
# The fleet document comes from the Go kel-fleet; there is no bash fallback
# any more (v0.10 dropped it — keeping two implementations byte-identical cost
# more than the fallback ever saved).  Missing or failing, it fails LOUDLY: an
# empty fleet would read as "no agents", which is a guess reported as a fact.
#
# Deliberately a stat of one known path, NOT `command -v`.  Looking up a binary
# that does not exist walks all of $PATH, and on WSL2 $PATH carries the Windows
# directories under /mnt/c — that miss measured 62ms.
fleet_json() {
  [ -x "$KEL_FLEET_BIN" ] || die "kel-fleet is not built — run ./install.sh (needs Go)"
  "$KEL_FLEET_BIN" "$@" || die "kel-fleet failed — a stale binary? re-run ./install.sh"
}

cmd_ls() {
  need tmux; need jq
  prune_state
  local doc
  if [ "${1:-}" = "--json" ]; then doc="$(fleet_json --dirty)" || exit 1; else doc="$(fleet_json)" || exit 1; fi
  [ "${1:-}" = "--json" ] || repaint_all "$doc"

  # --json is answered BEFORE the empty check: a consumer asked for JSON and
  # must get JSON, even when the fleet is empty (`agents: []`).  The completion
  # scripts are that consumer, and an English sentence here broke them silently.
  if [ "${1:-}" = "--json" ]; then
    # v0.6: the whole document, not a bare array — .agents is the list
    printf '%s\n' "$doc" | jq .
    return 0
  fi

  if [ "$(printf '%s' "$doc" | jq '.agents | length')" = 0 ]; then
    echo "no agents yet — 'kel new <name>' to start one"
    return 0
  fi

  # dim the header only on a terminal: `kel ls` is piped by scripts and by the
  # suite, and escapes in that stream are noise at best.
  local hdim='' hoff=''
  [ -t 1 ] && { hdim=$'\033[2m'; hoff=$'\033[0m'; }
  printf '%s' "$doc" | jq -r --arg home "$HOME" --arg hd "$hdim" --arg ho "$hoff" '
    def money: (. * 100 | round) as $c | "\($c / 100 | floor).\((($c % 100) | tostring) | if length == 1 then "0" + . else . end)";
    def pad($n): (. // "-") | tostring | . + (" " * ($n - length)) | .[0:$n];
    # WHERE is the on-disk `isolation` field renamed at RENDER time only:
    # "inplace" is the kel term for "the agent edits your checkout", which tells
    # a reader nothing next to "worktree".  Deliberately not migrated on disk —
    # a column unwinds in one commit, a format change needs a migration.
    def where: if . == "inplace" then "repo" else (. // "-") end;
    ( $hd + "  " + ("IDX" | pad(4)) + " " + ("NAME" | pad(24)) + " "
      + ("STATE" | pad(10)) + " " + ("CTX" | pad(5)) + " " + ("WHERE" | pad(11))
      + " " + ("BRANCH" | pad(12)) + "  PATH" + $ho ),
    ( .agents
    | sort_by(.group, (.index // 9999))
    | group_by(.group)[]
    | (.[0].group), ( .[] |
        ( (if .current then "\(.index)*" else (.index // "-" | tostring) end) | pad(4) ) as $ix
      | ( .name + (if (.panes | length) > 1 then " (" + (.panes | join("|")) + ")" else "" end) | pad(24) ) as $nm
      | ( (.state // "-") | pad(10) ) as $st
      | ( (if .context.pct == null then "-" else "\(.context.pct)%" end) | pad(5) ) as $cx
      # 11, not 10: "(unmanaged)" is exactly 11 characters and pad() truncates
      | ( (if .managed then (.isolation | where) else "(unmanaged)" end) | pad(11) ) as $iso
      | ( (.branch // "-") | pad(12) ) as $br
      | ( (.cwd // "") | sub("^" + $home; "~") ) as $cw
      | ( if (.context.cost_usd // 0) > 0 then "  $" + (.context.cost_usd | money) else "" end ) as $cost
      | "  \($ix) \($nm) \($st) \($cx) \($iso) \($br)  \($cw)\($cost)" ),
      "" )' | sed '$d'

  if [ -n "$(printf '%s' "$doc" | jq -r '.agents[] | select(.window_id == null) | .name')" ]; then
    echo "  dead = window gone.  kel restore rebuilds  ·  kel prune discards"
  fi
  return 0
}

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
agent_resume_cmd() { # agent cid  -> the shell string to resume/start an agent
  if [ -n "$2" ]; then printf '%s --resume %s || %s --continue || %s' "$1" "$2" "$1" "$1"
  else printf '%s --continue || %s' "$1" "$1"; fi
}

# --------------------------------------------------------------------------
# kel snapshot  — save the whole workspace shape (windows/panes/layouts)
# --------------------------------------------------------------------------
# Format v2 (v0.10):  {version:2, saved_at, saved_epoch, last,
#                      windows:[{name, group, layout, panes:[{cwd,cmd}]}]}
# in window order.  v1 keyed windows by group — one tmux session per repo —
# which lost the order across groups; restore still reads v1 (see below).
# saved_epoch is written here rather than derived later: parsing saved_at
# back needs GNU `date -d` or BSD `date -j`, which disagree (CLAUDE.md,
# portability).  `last` is the index of the window you were looking at.
snapshot() {   # silent; called by hooks and state-changing commands
  # A restore owns snapshot.json while it runs (see restore_from_snapshot).
  # This has to be a lockfile, not an env var: the tmux hooks that call us
  # spawn a fresh `kel` from the server, which inherits nothing.  A lock left
  # behind by a killed restore goes stale after five minutes.
  if [ -e "$RESTORE_LOCK" ]; then
    # the lock carries the epoch the restore started — no stat(1), whose flag
    # for mtime differs between GNU (-c %Y) and BSD (-f %m)
    local lock_ts=''; read -r lock_ts < "$RESTORE_LOCK" 2>/dev/null || true
    case "${lock_ts:-}" in ''|*[!0-9]*) lock_ts=0 ;; esac
    [ $(( $(date +%s) - lock_ts )) -lt 300 ] && return 0
    rm -f "$RESTORE_LOCK"
  fi
  command -v tmux >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0

  # Two tmux calls (every window, every pane), one awk to join them, ONE jq
  # to assemble — the v1 writer forked a jq per pane.  tmux emits tabs (it
  # escapes control characters in format output, so it cannot emit \037
  # itself); awk splits on tabs, which keeps empty fields, and re-joins on
  # \037 for jq.  An empty group is why: it is exactly the field
  # IFS=$'\t' read would silently drop (CLAUDE.md, traps).  The one session
  # sorts before any legacy kel/<group> session.
  local US=$'\037' TAB=$'\t' cur lines
  cur="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  lines="$(awk -F'\t' -v US="$US" -v cur="$cur" '
      NR == FNR { n[$1]++; pc[$1, n[$1]] = $3; pm[$1, n[$1]] = $4; next }
      { print "W" US $5 US $6 US $7 US ($4 == cur ? "1" : "")
        for (i = 1; i <= n[$4]; i++) print "P" US pc[$4, i] US pm[$4, i] }' \
    <(tmux list-panes -a -F '#{window_id}	#{pane_index}	#{pane_current_path}	#{pane_current_command}' 2>/dev/null) \
    <(tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}	#{window_layout}	#{@kel-group}' 2>/dev/null \
      | awk -F'\t' -v p="$KEL_PREFIX" '
          $1 == p || index($1, p"/") == 1 {
            g = $6
            if (g == "" && index($1, p"/") == 1) g = substr($1, length(p) + 2)
            print ($1 == p ? "0" : "1") "\t" $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" g
          }' \
      | sort -t"$TAB" -k1,1 -k2,2 -k3,3n))"
  [ -n "$lines" ] || return 0

  local snap
  snap="$(printf '%s\n' "$lines" \
    | jq -Rn --arg t "$(date -u +%FT%TZ)" --argjson e "$(date +%s)" --arg us "$US" '
        reduce (inputs | split($us)) as $r ({windows: [], last: -1};
          if $r[0] == "W" then
            (if $r[4] == "1" then .last = (.windows | length) else . end)
            | .windows += [{name: $r[1], layout: $r[2], group: $r[3], panes: []}]
          else .windows[-1].panes += [{cwd: $r[1], cmd: $r[2]}] end)
        | {version: 2, saved_at: $t, saved_epoch: $e, last: .last, windows: .windows}')" || return 0
  [ "$(printf '%s' "$snap" | jq '.windows | length' 2>/dev/null)" -gt 0 ] 2>/dev/null || return 0

  local tmp; tmp="$(mktemp "$STATE_DIR/.snap.XXXXXX" 2>/dev/null)" || return 0
  [ -f "$SNAPSHOT" ] && cp -f "$SNAPSHOT" "$SNAPSHOT.prev" 2>/dev/null
  printf '%s' "$snap" > "$tmp" && mv -f "$tmp" "$SNAPSHOT"
}

cmd_snapshot() { need tmux; need jq; snapshot; say "snapshot -> ${SNAPSHOT/#$HOME/\~}"; }

# --------------------------------------------------------------------------
# the archive  —  restore by choice (v0.10)
# --------------------------------------------------------------------------
# Until v0.10, `kel` stopped on a rebuild prompt whenever a snapshot existed
# and the server was down — every first `kel` after a reboot, whatever you
# came to do.  The author never understood what it was asking and just wanted
# to move on.  Now `kel` always just opens, and `kel restore` brings a previous
# workspace back, the way `claude --resume` does.
#
# The catch that makes this more than deleting a prompt: the snapshot hooks
# rewrite snapshot.json within seconds of anything changing, so starting fresh
# would silently destroy the old workspace.  So before a fresh start, kel moves
# it here.  Newest five kept.  File names are the archive epoch, so a numeric
# sort on the name is a sort by age — no stat(1), no sort -V.
archive_snapshot() {
  [ -f "$SNAPSHOT" ] || return 1
  mkdir -p "$SNAPSHOT_ARCHIVE" || return 1
  local t; t="$(date +%s)"
  while [ -e "$SNAPSHOT_ARCHIVE/$t.json" ]; do t=$((t + 1)); done
  mv -f "$SNAPSHOT" "$SNAPSHOT_ARCHIVE/$t.json" || return 1
  local f
  archived_snapshots | tail -n +6 | while read -r f; do rm -f "$f"; done
  return 0
}

# archived snapshots, newest first, one path per line
archived_snapshots() {
  [ -d "$SNAPSHOT_ARCHIVE" ] || return 0
  local f n
  for f in "$SNAPSHOT_ARCHIVE"/*.json; do
    [ -e "$f" ] || continue
    n="${f##*/}"; n="${n%.json}"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    printf '%s\n' "$f"
  done | awk -F/ '{n=$NF; sub(/\.json$/,"",n); print n"\t"$0}' | sort -t"$(printf '\t')" -k1,1nr | cut -f2-
}

# what `kel restore` can bring back, newest first: the last workspace's own
# snapshot.json while no kel session is running (nothing has replaced it
# yet), then the archive
restore_candidates() {
  [ -f "$SNAPSHOT" ] && [ -z "$(kel_sessions)" ] && printf '%s\n' "$SNAPSHOT"
  archived_snapshots
}

# window count and names of a v1 or v2 snapshot, tab-separated
snapshot_summary() { # file
  jq -r '(if .version == 2 then [.windows[].name]
          else [.groups[][].name] end) as $n
         | "\($n | length)\t\($n | join(" "))"' "$1" 2>/dev/null
}

restore_list() {
  local i=0 f n names ep age now; now="$(date +%s)"
  while read -r f; do
    [ -n "$f" ] || continue
    i=$((i + 1))
    IFS=$'\t' read -r n names < <(snapshot_summary "$f")
    ep="$(jq -r '.saved_epoch // empty' "$f" 2>/dev/null)"
    case "$ep" in
      ''|*[!0-9]*) age="$(jq -r '.saved_at // "?"' "$f" 2>/dev/null)" ;;
      *)           age="$(humanize_secs $((now - ep))) ago" ;;
    esac
    printf '  %d  %-10s %2s window(s)  %s\n' "$i" "$age" "${n:-?}" "${names:-}"
  done < <(restore_candidates)
  [ "$i" -gt 0 ] || { say "no saved workspace to restore"; return 0; }
  echo "  kel restore [<n>]   bring one back (newest is 1)"
}

# rebuild a workspace from a v1 or v2 snapshot (windows, splits, layout, agents)
restore_from_snapshot() {   # file resume(1|0)
  need tmux; need jq
  local src="$1" resume="${2:-1}"
  [ -f "$src" ] || { warn "no snapshot to restore"; return 1; }

  # Rebuilding the workspace fires tmux's own after-split-window / pane-exited
  # hooks, which run `kel snapshot` in the background — that would write the
  # half-rebuilt workspace over snapshot.json while we are still reading it,
  # truncating the restore and destroying the record of everything not yet
  # rebuilt.  Hold the lock so those writes stand down, and read from a private
  # copy so nothing can move underneath us either way.
  date +%s > "$RESTORE_LOCK"
  local snap
  snap="$(mktemp "$STATE_DIR/.snapin.XXXXXX" 2>/dev/null)" \
    || { rm -f "$RESTORE_LOCK"; warn "no scratch space to restore from"; return 1; }
  cp -f "$src" "$snap"

  # One jq pass flattens v1 or v2 into lines:  W name group layout last
  # followed by  P cwd cmd  per pane.  \037-separated for the same reason as
  # the writer: group may be empty.  A v1 snapshot is a v0.9 one, a session
  # per group; flattening it is what restores it into the one session.
  local US=$'\037' plan
  plan="$(jq -r --arg us "$US" '
      . as $s
      | ( if (.version // 1) == 2 then
            [ .windows | to_entries[] | .value + {last: (.key == ($s.last // -1))} ]
          else
            [ .groups | to_entries[] | .key as $g | .value[]
              | . + {group: $g,
                     last: ($g == ($s.last_group // "") and .name == ($s.last_window // ""))} ]
          end )[]
      | (["W", .name, (.group // ""), (.layout // ""), (if .last then "1" else "" end)] | join($us)),
        (.panes[] | ["P", (.cwd // ""), (.cmd // "")] | join($us))' "$snap" 2>/dev/null)"

  local first_wid='' dest_wid='' wid='' wname='' wg='' wlayout='' wlast='' meta=''
  local -a cwds=() cmds=()
  # build one window from what has been collected for it
  _restore_window() {
    [ -n "$wname" ] || return 0
    # already live in kel? leave it — a restore into a running workspace only
    # adds what is missing
    if kel_windows | awk -F'\t' -v n="$wname" -v g="$wg" '$4==n && $5==g {f=1} END{exit !f}'; then
      return 0
    fi
    local p0="${cwds[0]:-$HOME}"; [ -d "$p0" ] || p0="$HOME"
    wid="$(open_window "$wname" "$p0" "$wg")" || return 0
    [ -n "$first_wid" ] || first_wid="$wid"
    [ "$wlast" = 1 ] && dest_wid="$wid"
    local -a pids; pids=( "$(tmux list-panes -t "$wid" -F '#{pane_id}' | head -1)" )
    local j pc
    for ((j = 1; j < ${#cwds[@]}; j++)); do
      pc="${cwds[$j]}"; [ -d "$pc" ] || pc="$HOME"
      pids+=( "$(tmux split-window -t "$wid" -c "$pc" -P -F '#{pane_id}')" )
    done
    [ -n "$wlayout" ] && tmux select-layout -t "$wid" "$wlayout" 2>/dev/null || true

    meta=''; [ -n "$wg" ] && [ -f "$(meta_path "$wg" "$wname")" ] && meta="$(meta_path "$wg" "$wname")"
    if [ -n "$meta" ]; then
      jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.t" && mv "$meta.t" "$meta"
      # resuming is why you restore, so it is the default (v0.10); invariant 4's
      # one sanctioned send-keys besides launch
      [ "$resume" = 1 ] && tmux send-keys -t "${pids[0]}" \
        "$(agent_resume_cmd "$(jq -r '.agent // "claude"' "$meta")" "$(jq -r '.claude_session // ""' "$meta")")" Enter
    fi
    for ((j = 0; j < ${#cmds[@]}; j++)); do
      [ "$j" = 0 ] && [ -n "$meta" ] && continue
      case " $KEL_RESTORE_CMDS " in *" ${cmds[$j]} "*) tmux send-keys -t "${pids[$j]}" "${cmds[$j]}" Enter ;; esac
    done
  }

  local kind a b c d
  while IFS="$US" read -r kind a b c d; do
    case "$kind" in
      W) _restore_window
         wname="$a"; wg="$b"; wlayout="$c"; wlast="$d"; cwds=(); cmds=() ;;
      P) cwds+=( "$a" ); cmds+=( "$b" ) ;;
    esac
  done <<< "$plan"
  _restore_window
  unset -f _restore_window

  local dest="${dest_wid:-$first_wid}"
  [ -n "$dest" ] && goto_window "$dest"

  rm -f "$snap" "$RESTORE_LOCK"
  snapshot                     # release the lock, then record what we rebuilt
  say "workspace restored"
}

# --------------------------------------------------------------------------
# kel restore [--list] [<n>] [--no-resume]
# --------------------------------------------------------------------------
cmd_restore() {
  need tmux; need jq
  local resume=1 list=0 pick=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-resume)  resume=0 ;;
      --list|-l)    list=1 ;;
      ''|*[!0-9]*)  die "kel restore: unknown arg $1   (kel restore [--list] [<n>] [--no-resume])" ;;
      *)            pick="$1" ;;
    esac
    shift
  done
  [ "$list" = 1 ] && { restore_list; return; }

  local src
  src="$(restore_candidates | sed -n "${pick:-1}p")"
  if [ -n "$src" ]; then
    restore_from_snapshot "$src" "$resume" || return 1
    # an archived workspace that is live again is not "previous" any more;
    # the running one is snapshotted to snapshot.json as usual
    case "$src" in "$SNAPSHOT_ARCHIVE"/*) rm -f "$src" ;; esac
    return 0
  fi
  [ -n "$pick" ] && die "no saved workspace #$pick — see kel restore --list"

  # no snapshot anywhere: rebuild the dead records, one window each
  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "nothing to restore"; return 0; }

  local n meta cwd agent cid grp wid='' restored=0
  while IFS=$'\t' read -r grp n meta; do
    [ -z "$n" ] && continue
    cwd="$(jq -r '.cwd // ""' "$meta")"
    agent="$(jq -r '.agent // "claude"' "$meta")"
    cid="$(jq -r '.claude_session // ""' "$meta")"
    [ -d "$cwd" ] || { warn "skip $n — its directory is gone ($cwd)"; continue; }
    wid="$(open_window "$n" "$cwd" "$grp")" || { warn "skip $n — couldn't open a window"; continue; }
    jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
    [ "$resume" = 1 ] && tmux send-keys -t "$wid" "$(agent_resume_cmd "$agent" "$cid")" Enter
    restored=$((restored+1))
  done <<< "$names"

  [ "$resume" = 1 ] && say "restored $restored agent(s) — resuming" \
                    || say "restored $restored agent(s) — not started"
  [ -n "$wid" ] && goto_window "$wid"
  snapshot
}

# --------------------------------------------------------------------------
# kel relaunch [name] [-f]  — relaunch a crashed agent in its existing window
# --------------------------------------------------------------------------
# Named `restart` until v0.9. Two letters from `restore`, and both are about
# recovery, so the pair had to be read carefully every time to tell "this one
# agent, its existing window" from "the whole workspace, from the snapshot".
# `kel res<TAB>` completed to neither; now `kel rel<TAB>` and `kel res<TAB>`
# each resolve uniquely.
# --------------------------------------------------------------------------
# v0.4 made a crashed agent visible (`dead`) but gave no way out of it short of
# a workspace-wide `kel restore`.  This is the exit: same window, same worktree,
# same branch, same conversation — nothing else touched.
cmd_relaunch() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel relaunch: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done

  local group meta wid rr rc=0
  if [ -z "$name" ]; then
    [ -n "${TMUX:-}" ] || die "usage: kel relaunch <name>   (or run it from inside the agent's window)"
    wid="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{window_id}' 2>/dev/null)"   # this pane's window — see cmd_rename
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] || die "this window isn't a managed agent"
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    rr="$(resolve_agent "$name")" || rc=$?
    [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel relaunch <group>/<name>"
    [ -n "$rr" ] || die "no agent '$name'"
    IFS=$'\t' read -r group name meta <<< "$rr"
    wid="$(jq -r '.window_id' "$meta")"
  fi

  tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qxF "$wid" \
    || die "'$group/$name' has no live window — 'kel restore' rebuilds it"

  # Relaunching a live agent would leave two of them fighting over one pane.
  # Ask the pane, not the state file: a freshly-started agent has no .state
  # yet, and trusting that would double-launch it.  Same shell list as
  # effective_state's dead check.
  local st alive=0
  st="$(effective_state "$wid")"
  tmux list-panes -t "$wid" -F '#{pane_current_command}' 2>/dev/null \
    | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' && alive=1
  if [ "$alive" = 1 ] && [ "$force" != 1 ]; then
    die "'$group/$name' still has a live process (state: ${st:-unknown}) — kel relaunch $name -f to force it"
  fi

  local agent cid pane
  agent="$(jq -r '.agent // "claude"' "$meta")"
  cid="$(jq -r '.claude_session // ""' "$meta")"
  pane="$(tmux list-panes -t "$wid" -F '#{pane_id}' 2>/dev/null | head -1)"
  [ -n "$pane" ] || die "'$group/$name' has no pane to relaunch in"

  # drop the stale reading; the relaunched agent's SessionStart sets it again
  rm -f "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
  tmux send-keys -t "$pane" "$(agent_resume_cmd "$agent" "$cid")" Enter
  tmux refresh-client -S 2>/dev/null || true
  say "relaunching $group/$name${cid:+  (resuming $cid)}"
}

# --------------------------------------------------------------------------
# kel top   (prefix t)  — the fleet dashboard
# --------------------------------------------------------------------------
# Go-only, unlike the fleet read: this is a new surface rather than a port, so
# there is no bash version to fall back to.  Say so plainly instead of dying
# with "command not found".
cmd_top() {
  if [ ! -x "$KEL_TOP_BIN" ]; then
    warn "kel top needs the Go dashboard, which isn't built"
    if command -v go >/dev/null 2>&1; then
      die "run ./install.sh to build it"
    else
      die "install Go (install/20-user-tools.sh), then re-run ./install.sh"
    fi
  fi
  # in tmux, open in a popup the way kel config does; outside, run inline
  if [ -n "${TMUX:-}" ] && [ -z "${KEL_IN_POPUP:-}" ]; then
    local -a penv=( -e KEL_IN_POPUP=1 ) v
    for v in KEL_SESSION KEL_CTX_WARN KEL_TOP_BIN XDG_STATE_HOME; do
      [ -n "${!v:-}" ] && penv+=( -e "$v=${!v}" )
    done
    exec tmux display-popup "${penv[@]}" \
      -w "${KEL_TOP_W:-90%}" -h "${KEL_TOP_H:-80%}" -T ' kel top ' -EE "'$KEL_TOP_BIN'"
  fi
  exec "$KEL_TOP_BIN" "$@"
}

# --------------------------------------------------------------------------
# kel sweep [-n] [-f]   — close out everything that has actually landed
# --------------------------------------------------------------------------
# kel kill and kel prune are one-at-a-time.  Finish five worktree agents and
# kel top becomes a graveyard you clear one command at a time.
#
# Sweeps an agent only when it is finished AND its work is somewhere other than
# that worktree — `land` already computes exactly that, so `merged` IS the
# predicate.  Everything else is REPORTED, never touched: the rule from kel
# kill holds, and deleting an agent's only copy of real work is the one
# unforgivable bug in this category of tool.
cmd_sweep() {
  need tmux; need jq
  local dry=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -f|--force)   force=1 ;;
      -*)           die "kel sweep: unknown flag $1" ;;
      *)            die "kel sweep takes no arguments" ;;
    esac
    shift
  done

  local doc; doc="$(fleet_json --land --pr)" || exit 1
  local swept=0 kept=0 g nm code st

  # eligible: finished, and its branch is merged (or -f, which still refuses
  # anything with uncommitted or unpushed work)
  while IFS=$'\t' read -r g nm st code; do
    [ -n "$nm" ] || continue
    if [ "$dry" = 1 ]; then
      say "would sweep  $g/$nm  ($st, $code)"
    else
      "$SELF" kill "$g/$nm" >/dev/null 2>&1 \
        && { say "swept  $g/$nm  ($code)"; } \
        || { warn "could not sweep $g/$nm"; kept=$((kept+1)); continue; }
    fi
    swept=$((swept+1))
  done < <(printf '%s' "$doc" | jq -r --argjson force "$([ "$force" = 1 ] && echo true || echo false)" '
    .agents[]
    | select(.managed)
    | select(.state == "done" or .state == "dead")
    | select((.land.code // "") as $c
             | $c == "merged" or ($force and ($c == "clean" or $c == "no_pr" or $c == "review")))
    | [.group, .name, (.state // "-"), (.land.code // "-")] | @tsv')

  # everything finished that is NOT safe to sweep, and why
  local why
  while IFS=$'\t' read -r g nm st code; do
    [ -n "$nm" ] || continue
    case "$code" in
      dirty)    why="uncommitted work" ;;
      unpushed) why="commits that are only here" ;;
      behind)   why="behind its base" ;;
      no_pr)    why="no PR — nothing has merged it" ;;
      review)   why="its PR is still open" ;;
      unknown)  why="gh could not say whether it merged" ;;
      *)        why="not merged" ;;
    esac
    warn "kept  $g/$nm  — $why"
    kept=$((kept+1))
  done < <(printf '%s' "$doc" | jq -r --argjson force "$([ "$force" = 1 ] && echo true || echo false)" '
    .agents[]
    | select(.managed)
    | select(.state == "done" or .state == "dead")
    | select((.land.code // "") as $c
             | ($c != "merged") and (($force | not) or ($c == "dirty" or $c == "unpushed" or $c == "unknown" or $c == "behind")))
    | [.group, .name, (.state // "-"), (.land.code // "-")] | @tsv')

  if [ "$swept" = 0 ] && [ "$kept" = 0 ]; then
    say "nothing finished to sweep"
  elif [ "$dry" = 1 ]; then
    say "$swept would be swept, $kept kept  (drop -n to do it)"
  else
    say "swept $swept, kept $kept"
  fi
}

# --------------------------------------------------------------------------
# kel doctor
# --------------------------------------------------------------------------
cmd_doctor() {
  need jq
  # A failed probe used to name the problem and stop there, which on a fresh
  # machine is the least useful moment to withhold the fix.  Each probe now
  # carries a remediation, printed only when it fails.  The package manager is
  # resolved once: kel runs on Linux, WSL2 and macOS, and `apt install jq` is
  # actively wrong advice on the Mac.
  # node and gh get their own hints rather than "$pm <name>": the Debian
  # package for node is `nodejs`, and stock Ubuntu has no `gh` at all until you
  # add the GitHub CLI apt repo (install/10-system-tools.sh does).  A hint that
  # does not work is worse than no hint — same rule as the status bar.
  local pm h_node h_gh
  case "$(uname -s)" in
    Darwin) pm="brew install"
            h_node="brew install node"
            h_gh="brew install gh, then gh auth login" ;;
    *)      pm="sudo apt install"
            h_node="fnm, or docs/setup.md §3b"
            h_gh="gh auth login  (gh itself: docs/setup.md §3a, needs its own apt repo)" ;;
  esac

  probe() {   # LABEL HINT CMD...
    local label="$1" hint="$2"; shift 2
    if "$@" >/dev/null 2>&1; then
      printf '  \033[1;32m✓\033[0m %s\n' "$label" >&2; printf 'true'
    else
      printf '  \033[1;31m✗\033[0m %s\n' "$label" >&2
      [ -n "$hint" ] && printf '      \033[2m%s\033[0m\n' "$hint" >&2
      printf 'false'
    fi
  }
  echo "kel doctor" >&2
  local r_tmux r_ver r_popup r_wt r_jq r_node r_claude r_hooks r_sl r_pass r_go r_top r_gh
  r_tmux=$(probe   "tmux present"                     "$pm tmux" command -v tmux)
  r_ver=$(probe    "tmux >= 3.0"                      "$pm tmux   (kel needs display-popup)" bash -c 'v=$(tmux -V | grep -oE "[0-9]+\.[0-9]+" | head -1); [ -n "$v" ] || exit 1; [ "${v%%.*}" -gt 3 ] || { [ "${v%%.*}" -eq 3 ] && [ "${v#*.}" -ge 0 ]; }')
  r_popup=$(probe  "display-popup available"          "needs tmux 3.0+ — $pm tmux" bash -c 'tmux list-commands 2>/dev/null | grep -q display-popup')
  r_wt=$(probe     "git worktree available"           "$pm git" bash -c 'git worktree -h 2>&1 | grep -q "add"')
  r_jq=$(probe     "jq present"                       "$pm jq" command -v jq)
  r_node=$(probe   "node on PATH"                     "$h_node" command -v node)
  r_claude=$(probe "claude on PATH"                   "install Claude Code — docs/setup.md" command -v claude)
  r_gh=$(probe     "gh authenticated (PR state for kel sweep / top)" "$h_gh" gh auth status)
  r_hooks=$(probe  "kel hooks wired in settings.json" "./install.sh   (from the kelsier repo)" bash -c 'jq -e "[.hooks[]?[]?.hooks[]?.command // empty] | any(test(\"kel hook|kel-hook\"))" "$HOME/.claude/settings.json" >/dev/null')
  r_sl=$(probe     "kel statusLine wired (context %)" "./install.sh   (from the kelsier repo)" bash -c 'jq -e ".statusLine.command // \"\" | test(\"kel statusline\")" "$HOME/.claude/settings.json" >/dev/null')
  r_go=$(probe     "kel-fleet built (required)"       "./install.sh   (needs Go — install/20-user-tools.sh)" test -x "$KEL_FLEET_BIN")
  r_top=$(probe    "kel-top built (required)"         "./install.sh   (needs Go — install/20-user-tools.sh)" test -x "$KEL_TOP_BIN")
  r_pass=$(probe   "tmux allow-passthrough on"        "tmux/kel.conf sets it — tmux source-file ~/.tmux.conf" bash -c 'tmux start-server \; show -gv allow-passthrough 2>/dev/null | grep -qx on')

  # install.sh writes the absolute path of the clone it ran from into
  # settings.json. Move or rename that clone and every hook plus the statusLine
  # silently stops firing, with settings.json still naming the old path.
  r_path=$(probe   "the wired kel path still resolves" "re-run ./install.sh from the clone's current location" \
    bash -c 'p="$(jq -r ".statusLine.command // \"\"" "$HOME/.claude/settings.json" 2>/dev/null | sed "s/ statusline$//")"; [ -n "$p" ] && [ -x "$p" ]')

  # `settings.json` naming a hook is not the same as the hook being allowed to
  # run: managed settings can switch every one of them off while leaving the
  # entries in place, so hooks_wired above would still read true.
  r_managed=$(probe "hooks not disabled by managed settings" "an administrator set allowManagedHooksOnly or disableAllHooks — kel's hooks cannot fire" \
    bash -c 'for m in "/Library/Application Support/ClaudeCode/managed-settings.json" "/etc/claude-code/managed-settings.json"; do
               [ -f "$m" ] || continue
               jq -e "(.disableAllHooks == true) or (.allowManagedHooksOnly == true)" "$m" >/dev/null 2>&1 && exit 1
             done; exit 0')

  # No fetch: doctor must not need the network to answer, and a probe that
  # fetches on every run is a probe people stop running. This reports the gap
  # against the last fetch, and says which that is.
  r_behind=true
  local _kelroot _behind
  _kelroot="$(dirname "$(dirname "$(_real_self)")")"
  if [ -d "$_kelroot/.git" ]; then
    _behind="$(git -C "$_kelroot" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || printf '')"
    if [ -n "$_behind" ] && [ "$_behind" -gt 0 ] 2>/dev/null; then
      printf '  \033[1;33m!\033[0m %s\n' "clone is $_behind commit(s) behind its upstream as of the last fetch" >&2
      printf '      \033[2m%s\033[0m\n' "kel update" >&2
      r_behind=false
    else
      printf '  \033[1;32m✓\033[0m %s\n' "clone is level with its upstream as of the last fetch" >&2
    fi
  else
    printf '  \033[2m·\033[0m %s\n' "not a git clone — kel update does not apply" >&2
  fi

  jq -n --arg d "$(date -u +%FT%TZ)" \
    --argjson tmux "$r_tmux" --argjson ver "$r_ver" --argjson popup "$r_popup" \
    --argjson wt "$r_wt" --argjson jq "$r_jq" --argjson node "$r_node" \
    --argjson claude "$r_claude" --argjson hooks "$r_hooks" --argjson sl "$r_sl" \
    --argjson go "$r_go" --argjson top "$r_top" --argjson gh "$r_gh" --argjson pass "$r_pass" \
    --argjson path "$r_path" --argjson managed "$r_managed" --argjson behind "$r_behind" \
    '{checked_at:$d, tmux:$tmux, "tmux>=3.0":$ver, display_popup:$popup,
      git_worktree:$wt, jq:$jq, node:$node, claude:$claude,
      hooks_wired:$hooks, statusline_wired:$sl, go_fleet:$go, go_top:$top, gh_auth:$gh,
      allow_passthrough:$pass, kel_path:$path, hooks_permitted:$managed,
      up_to_date:$behind}' \
    > "$DOCTOR_CACHE"
  printf '  cached -> %s\n' "${DOCTOR_CACHE/#$HOME/~}" >&2
  case "$r_tmux$r_ver$r_jq$r_go" in *false*) exit 1 ;; esac
}

# --------------------------------------------------------------------------
# kel config   — edit config.toml, seeded from the shipped example
# --------------------------------------------------------------------------
# config.toml (v0.8) had no path INTO it from inside the tool at all — no
# --help line, no cheat mention, no menu item, no subcommand. It existed only
# as examples/config.toml and prose in usage.md. Found the same way as the
# idle/dead bug: by trying to actually use the tool as a fresh person, not by
# reading it.
#
# $SELF stays a SYMLINK (kel is always symlinked, never copied — see the SELF
# comment near the top), so a naive `$(dirname "$SELF")/../examples` looks in
# ~/.local/bin/../examples, which does not exist. Resolve it for real, without
# `readlink -f`: that flag is GNU-only and macOS's built-in readlink lacks it.
_real_self() {
  local p="$SELF" seen=0 t
  while [ -L "$p" ] && [ "$seen" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    seen=$((seen + 1))
  done
  printf '%s/%s' "$(cd "$(dirname "$p")" 2>/dev/null && pwd)" "$(basename "$p")"
}

# ---------------------------------------------------------------------------
# kel update  —  pull the clone this kel runs from, then re-wire
# ---------------------------------------------------------------------------
# install.sh symlinks bin/kel, the completions and tmux/kel.conf out of the
# clone, so a pull updates all three in place. Only kel-fleet and kel-top are
# copies, and install.sh rebuilds them; re-running it is how they refresh. It is
# idempotent by design, so there is nothing to undo first.
#
# No release artifacts are involved. The working tree IS the installed thing,
# which is also why this refuses rather than merges: on the author's machines
# that clone is the development checkout too, and a pull that rebased over local
# work would be the one unrecoverable outcome here.
cmd_update() {
  need git
  local root; root="$(dirname "$(dirname "$(_real_self)")")"
  [ -d "$root/.git" ] || die "kel update: $root is not a git clone — update it however you installed it"

  local branch; branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [ "$branch" = HEAD ] && die "kel update: $root is on a detached HEAD — check out a branch first"
  git -C "$root" rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 \
    || die "kel update: '$branch' has no upstream — git -C $root branch -u origin/$branch"
  [ -z "$(git -C "$root" status --porcelain 2>/dev/null || true)" ] \
    || die "kel update: $root has uncommitted changes — commit or stash them first"

  say "fetching $branch"
  git -C "$root" fetch --quiet || die "kel update: fetch failed — no changes made"

  local behind; behind="$(git -C "$root" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || printf 0)"
  case "${behind:-0}" in
    ''|0) say "already up to date  ($branch at $(git -C "$root" rev-parse --short HEAD))"; exit 0 ;;
  esac
  say "applying $behind commit(s)"
  git -C "$root" merge --ff-only '@{upstream}' --quiet \
    || die "kel update: '$branch' has diverged from its upstream — resolve it by hand"

  say "re-wiring"
  ( cd "$root" && ./install.sh ) \
    || die "kel update: the pull landed but install.sh failed — run ./install.sh in $root"

  say "now at $(git -C "$root" rev-parse --short HEAD)"
  printf '  %s\n' "tmux source-file ~/.tmux.conf   # if kel.conf changed" >&2
  # Explicit, because the pull rewrote this very file. bash reads a script
  # incrementally and would otherwise read the next command from the old byte
  # offset into new content. Every function is already parsed — a definition is
  # one command — so only the return to `main` at the bottom is exposed.
  exit 0
}

cmd_config() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/kel/config.toml"
  mkdir -p "$(dirname "$cfg")"
  if [ ! -f "$cfg" ]; then
    local example; example="$(dirname "$(_real_self)")/../examples/config.toml"
    if [ -f "$example" ]; then
      cp "$example" "$cfg"
      say "created $cfg from the shipped example — every key is commented out with its default"
    else
      # not a total dead end: an installed-elsewhere kel (copied, not
      # symlinked, or examples/ pruned) still gets a file to open, just not
      # the annotated one — invariant 3: say what actually happened
      printf '# kelsier config — see docs/usage.md for the full key list\n' > "$cfg"
      warn "could not find the shipped example — started $cfg empty"
    fi
  fi

  local ed="${VISUAL:-${EDITOR:-}}" c
  if [ -z "$ed" ]; then
    for c in nvim vim vi nano; do command -v "$c" >/dev/null 2>&1 && { ed="$c"; break; }; done
  fi
  [ -n "$ed" ] || die "no editor found — set \$EDITOR, or open $cfg yourself"

  # in tmux, open in a popup the way kel top does; outside, run inline.
  if [ -n "${TMUX:-}" ] && [ -z "${KEL_IN_POPUP:-}" ]; then
    exec tmux display-popup -e KEL_IN_POPUP=1 \
      -w "${KEL_CONFIG_W:-90%}" -h "${KEL_CONFIG_H:-85%}" -T ' kel config ' \
      -EE "'$SELF' config"
  fi
  exec "$ed" "$cfg"
}

# --------------------------------------------------------------------------
# kel status-line   (tmux status-left)
# --------------------------------------------------------------------------
cmd_status_line() {
  [ -n "${TMUX:-}" ] || exit 0
  # The bar is the one surface where a missing kel-fleet would otherwise just
  # go blank — and a blank bar reads as "no agents".  Say so instead.
  [ -x "$KEL_FLEET_BIN" ] || { printf '#[fg=colour196]kel-fleet missing — run install.sh#[default]'; exit 0; }
  # One fleet_json, one jq.  This used to walk every window calling
  # effective_state (a tmux fork each) and then walk them all again to count
  # waiting agents elsewhere.  --dirty is deliberately NOT passed: the bar
  # never shows it and `git status` per worktree is the expensive part.
  #
  # One session since v0.10, so the bar is every live window in index order —
  # no per-group row and no ⟨other groups⟩ badge.  This is the interim bar:
  # spec.md §7b replaces it with the workspace footer in M4.  A v0.9 session
  # may still pass a group argument from its own status-left; it is ignored.
  fleet_json | jq -r --argjson warn "${KEL_CTX_WARN:-70}" '
    def glyph:
      if   . == "waiting"   then {s:"?", c:"#[fg=colour214,bold]"}
      elif . == "working"   then {s:"*", c:"#[fg=colour111]"}
      elif . == "done"      then {s:"!", c:"#[fg=colour114]"}
      elif . == "throttled" then {s:"~", c:"#[fg=colour141]"}
      elif . == "dead"      then {s:"x", c:"#[fg=colour167,bold]"}
      else {s:"", c:""} end;

    [ .agents[] | select(.window_id != null) ] | sort_by(.index)
    | if length == 0 then ""
      else
        map(
          . as $a | ($a.state // "" | glyph) as $gl
          | ($a.panes | length) as $np
          | ($a.context.pct // null) as $pct
          | ( $a.name
              + (if $np > 1 then "#[fg=colour240]·\($np)#[default]" + $gl.c else "" end)
              + (if ($pct != null and $pct >= $warn)
                 then (if $pct >= 90 then "#[fg=colour167,bold]" else "#[fg=colour179]" end)
                      + "·\($pct)%#[default]" + $gl.c
                 else "" end) ) as $nm
          | $gl.c
            + (if $a.current then "[\($a.index):\($nm)\($gl.s)]" else "\($a.index):\($nm)\($gl.s)" end)
            + "#[default]" )
        | "#[fg=colour245][kel]#[default] " + join(" ") + " "
      end'
}

# --------------------------------------------------------------------------
# kel jump   (prefix `)   — global, cycles across all groups
# --------------------------------------------------------------------------
cmd_jump() {
  [ -n "${TMUX:-}" ] || exit 0
  local cs cw
  cs="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  cw="$(tmux display-message -p '#{window_index}' 2>/dev/null || echo '')"

  # session, then index: one session since v0.10, but a legacy v0.9 server
  # can still hold kel/<group> sessions, and the cycle must cross them too
  local -a w=()
  while IFS=$'\t' read -r sname idx wid _; do
    [ -z "${wid:-}" ] && continue
    [ "$(effective_state "$wid")" = waiting ] || continue
    w+=( "$sname"$'\t'"$idx"$'\t'"$wid" )
  done < <(kel_windows | sort -t$'\t' -k1,1 -k2,2n)

  local n="${#w[@]}"
  [ "$n" -eq 0 ] && { tmux display-message "kel: nothing waiting"; exit 0; }

  local i pos=-1 es ei
  for ((i=0; i<n; i++)); do
    IFS=$'\t' read -r es ei _ <<< "${w[$i]}"
    [ "$es" = "$cs" ] && [ "$ei" = "$cw" ] && { pos=$i; break; }
  done

  local tgt
  if [ "$pos" -ge 0 ]; then
    tgt="${w[$(( (pos + 1) % n ))]}"
  else
    tgt="${w[0]}"
    for ((i=0; i<n; i++)); do
      IFS=$'\t' read -r es ei _ <<< "${w[$i]}"
      if [ "$es" \> "$cs" ] || { [ "$es" = "$cs" ] && [ -n "$cw" ] && [ "$ei" -gt "$cw" ]; }; then
        tgt="${w[$i]}"; break
      fi
    done
  fi
  local ts ti tw
  IFS=$'\t' read -r ts ti tw <<< "$tgt"
  tmux switch-client -t "=$ts" \; select-window -t "$tw"

  # say where you landed and how long it has been sitting — the jump is
  # otherwise silent, and "which one was that?" is the next question
  local grp nm ep v
  v="$(tmux display-message -p -t "$tw" '#{@kel-group}|#{window_name}' 2>/dev/null || true)"
  grp="${v%%|*}"; nm="${v#*|}"; [ -n "$nm" ] || nm="$ti"
  [ -z "$grp" ] && case "$ts" in "$KEL_PREFIX"/*) grp="${ts#"$KEL_PREFIX"/}" ;; esac
  grp="${grp:-$KEL_PREFIX}"
  ep=''; [ -f "$STATE_DIR/$tw.state" ] && read -r _ ep _ < "$STATE_DIR/$tw.state" 2>/dev/null
  case "${ep:-}" in ''|*[!0-9]*) ep='' ;; esac
  if [ -n "$ep" ]; then
    tmux display-message "→ $grp/$nm  (waiting $(humanize_secs $(( $(date +%s) - ep ))))"
  else
    tmux display-message "→ $grp/$nm"
  fi
}

# --------------------------------------------------------------------------
# paint_state  —  put the state where you can see it without looking (v0.9a)
# --------------------------------------------------------------------------
# The status bar is one line at the bottom. With a full-screen agent that is a
# place you have to look AT; a coloured pane border is peripheral vision, and
# the window name carries the same colour so it reads from the bar too.
#
# Set per-window (-w), so windows keep their own colour rather than the last
# hook to fire repainting the whole server. Calm states clear back to the
# default, so a workspace at rest is not a christmas tree.
paint_state() {   # wid state
  local wid="$1" col=''
  case "${2:-}" in
    waiting)   col=colour214 ;;   # blocked on you — the one that matters
    throttled) col=colour141 ;;
    dead)      col=colour167 ;;
    done)      col=colour114 ;;
    *)         col='' ;;          # working / idle: stay quiet
  esac
  if [ -n "$col" ]; then
    tmux set-option -w -t "$wid" pane-border-style        "fg=$col" 2>/dev/null || true
    tmux set-option -w -t "$wid" pane-active-border-style "fg=$col" 2>/dev/null || true
  else
    tmux set-option -wu -t "$wid" pane-border-style        2>/dev/null || true
    tmux set-option -wu -t "$wid" pane-active-border-style 2>/dev/null || true
  fi
}

# Repaint every window from the fleet document. `dead` is computed at read
# time rather than reported by a hook, so a crashed agent has nothing to paint
# its border — this catches it. Called from `kel ls`, never from the bar: the
# bar redraws constantly and this is N tmux calls.
repaint_all() {   # fleet-json
  local wid st
  while IFS=$'\t' read -r wid st; do
    [ -n "$wid" ] && paint_state "$wid" "$st"
  done < <(printf '%s' "$1" | jq -r '.agents[] | select(.window_id != null)
                                      | [.window_id, (.state // "")] | @tsv')
}

# --------------------------------------------------------------------------
# notifications  (#1)
# --------------------------------------------------------------------------
# The status line is a *pull* surface — it only helps while you are looking at
# it.  This is the push half, fired from the state hook.  It is never polled:
# a poller would be a background daemon, which is a hard non-goal.
#
# `notify` is the ONLY place delivery lives.  Teaching kel about
# powershell.exe (WSL), osascript (macOS) or notify-send (Linux desktop) later
# is a `command -v` ladder inside this one function and nowhere else; today it
# stays out, and setup.md carries paste-ready recipes for $KEL_NOTIFY_CMD.
notify() {   # title body
  tmux display-message "$1 — $2" 2>/dev/null || true
  [ -n "${KEL_NOTIFY_CMD:-}" ] || return 0
  # Backgrounded, and deliberately not with setsid — macOS has no setsid.  A
  # hook is synchronous: Claude Code waits for it, and a PowerShell toast
  # costs a third of a second before it has done anything useful.
  ( "$KEL_NOTIFY_CMD" "$1" "$2" >/dev/null 2>&1 & ) 2>/dev/null || true
}

# Is the user actually looking at this window?  Active in its session AND that
# session has a client attached.  Detached tmux => nobody is looking => notify.
window_focused() {   # wid
  local act att
  act="$(tmux display-message -p -t "$1" '#{window_active}'    2>/dev/null || echo 0)"
  att="$(tmux display-message -p -t "$1" '#{session_attached}' 2>/dev/null || echo 0)"
  case "${att:-0}" in ''|*[!0-9]*) att=0 ;; esac
  [ "${act:-0}" = 1 ] && [ "$att" -gt 0 ]
}

# --------------------------------------------------------------------------
# Claude Code -> kel:  which tmux pane is this session talking from?
# $TMUX_PANE when the agent passes it (it does), else the pane stashed by this
# session's SessionStart, else the one pane whose cwd matches the payload.
# --------------------------------------------------------------------------
resolve_pane() { # session-id cwd
  local sid="${1:-}" cwd="${2:-}" pane="${TMUX_PANE:-}" match
  if [ -z "$pane" ] && [ -n "$sid" ] && [ -f "$STASH_DIR/$sid" ]; then
    pane="$(cat "$STASH_DIR/$sid" 2>/dev/null || true)"
  fi
  if [ -z "$pane" ] && [ -n "$cwd" ]; then
    match="$(tmux list-panes -a -F '#{pane_id} #{pane_current_path}' 2>/dev/null | awk -v c="$cwd" '$2==c{print $1}')"
    [ "$(printf '%s\n' "$match" | grep -c .)" = 1 ] && pane="$match"
  fi
  printf '%s' "$pane"
}

# --------------------------------------------------------------------------
# context / cost, per agent      $STATE_DIR/<wid>.ctx
#   pct <T> cost_usd <T> in_tokens <T> ctx_size <T> rate5h <T> epoch <T> model
# Written by `kel statusline`; read by the bar, ls, --json and kel top.
# --------------------------------------------------------------------------
ctx_field() { # wid n  -> field n of the .ctx line, or empty
  [ -f "$STATE_DIR/$1.ctx" ] || return 0
  cut -f"$2" "$STATE_DIR/$1.ctx" 2>/dev/null | head -1
}

# 250000 -> 250k, 1000000 -> 1M.  Integer arithmetic only: this runs on the
# statusLine path, and printf %f would round 999999 up to a wrong 1.0M.
si_units() { # n
  local n="${1:-0}"
  if [ "$n" -ge 1000000 ]; then
    if [ $((n % 1000000)) -eq 0 ]; then printf '%dM' "$((n / 1000000))"
    else printf '%d.%dM' "$((n / 1000000))" "$(( (n % 1000000) / 100000 ))"; fi
  elif [ "$n" -ge 1000 ]; then printf '%dk' "$((n / 1000))"
  else printf '%d' "$n"; fi
}

# epoch -> "40m" / "3h10m", empty once it is in the past.  Takes `now` rather
# than calling date: the statusLine path already has it.
time_until() { # epoch now
  local d=$(( ${1:-0} - ${2:-0} ))
  [ "$d" -gt 0 ] || return 0
  if [ "$d" -ge 3600 ]; then printf '%dh%dm' "$((d / 3600))" "$(( (d % 3600) / 60 ))"
  else printf '%dm' "$((d / 60))"; fi
}

# one quota chip per rate limit; gated at 50%.
quota_chip() { # label pct resets_at now
  [ "${2:--1}" -ge 50 ] 2>/dev/null || return 0
  local r; r="$(time_until "${3:-0}" "${4:-0}")"
  printf ' \033[2m·\033[0m \033[33m%s %s%%%s\033[0m' "$1" "$2" "${r:+ ($r)}"
}

# --------------------------------------------------------------------------
# kel statusline   —   Claude Code's own status row (wired by install.sh)
# --------------------------------------------------------------------------
# Claude Code pipes a JSON blob in on every conversation update: context window,
# cost, rate limits.  Updates are debounced to 300ms and an in-flight script is
# CANCELLED when the next one lands, so this stays cheap: one jq pass, one
# atomic write, and a tmux redraw only when the number the bar shows changed.
cmd_statusline() {
  local payload; payload="$(cat 2>/dev/null || true)"
  [ -n "$payload" ] || exit 0
  command -v jq >/dev/null 2>&1 || exit 0

  # One field per line, not @tsv: bash folds runs of tab (an IFS whitespace
  # character) into one delimiter, so a single empty field — an unset model
  # name, say — would silently shift every value after it.
  #
  # used_percentage comes through as empty rather than 0. It is null before the
  # first API call and again right after /compact, and an empty context is a
  # different fact from an unmeasured one.
  local sid cwd pct cost intok ctxsz rl5 model
  local rl5at rl7d rl7dat spend spendat effort fastmode thinking agent repo wt
  {
    read -r sid;    read -r cwd;      read -r pct;      read -r cost
    read -r intok;  read -r ctxsz;    read -r rl5;      read -r model
    read -r rl5at;  read -r rl7d;     read -r rl7dat
    read -r spend;  read -r spendat
    read -r effort; read -r fastmode; read -r thinking
    read -r agent;  read -r repo;     read -r wt
  } < <(printf '%s' "$payload" | jq -r '[
      (.session_id // ""),
      (.workspace.current_dir // .cwd // ""),
      (if .context_window.used_percentage == null then ""
       else (.context_window.used_percentage | floor) end),
      (.cost.total_cost_usd // 0),
      (.context_window.total_input_tokens // 0),
      (.context_window.context_window_size // 0),
      (.rate_limits.five_hour.used_percentage // -1 | floor),
      (.model.display_name // ""),
      (.rate_limits.five_hour.resets_at // 0),
      (.rate_limits.seven_day.used_percentage // -1 | floor),
      (.rate_limits.seven_day.resets_at // 0),
      (.rate_limits.spend_limit.used_percentage // -1 | floor),
      (.rate_limits.spend_limit.resets_at // 0),
      (.effort.level // ""),
      (if .fast_mode then 1 else 0 end),
      (if .thinking.enabled == false then 0 else 1 end),
      (.agent.name // ""),
      (if (.workspace.repo | type) == "object"
       then ((.workspace.repo.owner // "") + "/" + (.workspace.repo.name // ""))
       else "" end),
      (.worktree.name // "")
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)

  # never let a surprising payload reach arithmetic or a %f conversion
  case "${pct:-}"   in ''|*[!0-9]*)  pct='' ;;  esac
  case "${intok:-}" in ''|*[!0-9]*)  intok=0 ;; esac
  case "${ctxsz:-}" in ''|*[!0-9]*)  ctxsz=0 ;; esac
  case "${rl5:-}"   in ''|-1|*[!0-9]*) rl5=-1 ;; esac
  case "${rl7d:-}"  in ''|-1|*[!0-9]*) rl7d=-1 ;; esac
  case "${spend:-}" in ''|-1|*[!0-9]*) spend=-1 ;; esac
  case "${rl5at:-}"   in ''|*[!0-9]*) rl5at=0 ;; esac
  case "${rl7dat:-}"  in ''|*[!0-9]*) rl7dat=0 ;; esac
  case "${spendat:-}" in ''|*[!0-9]*) spendat=0 ;; esac
  case "${cost:-}"  in ''|*[!0-9.]*) cost=0 ;;  esac
  case "${fastmode:-}" in 1) ;; *) fastmode=0 ;; esac
  case "${thinking:-}" in 0) ;; *) thinking=1 ;; esac

  local now; now="$(date +%s)"

  # record it against this agent's window, if we are inside one
  local wid=''
  if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}${TMUX_PANE:-}" ]; then
    local pane; pane="$(resolve_pane "$sid" "$cwd")"
    [ -n "$pane" ] && wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  fi
  # An unknown pct writes nothing. Overwriting a real 25% with a placeholder 0
  # would make every other surface — the bar, `kel ls`, `kel top` —
  # report an empty context window for an agent that has a full one. The stale
  # record keeps its own epoch in field 6, so a reader can see its age.
  if [ -n "$wid" ] && [ "$ctxsz" -gt 0 ] && [ -n "$pct" ]; then
    local old; old="$(ctx_field "$wid" 1)"
    local tmp; tmp="$(mktemp "$STATE_DIR/.${wid#@}.ctx.XXXXXX" 2>/dev/null)"
    if [ -n "${tmp:-}" ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$pct" "$cost" "$intok" "$ctxsz" "$rl5" "$now" "$model" > "$tmp"
      mv -f "$tmp" "$STATE_DIR/$wid.ctx"
    fi
    # only redraw the tmux bar when the figure it renders actually moved —
    # #(kel status-line) is not free and this runs several times a second
    [ "$pct" != "$old" ] && tmux refresh-client -S 2>/dev/null
  fi

  # ---- render Claude Code's row ----
  local label=''
  if [ -n "$wid" ]; then
    # one display-message, not two: this is a hot path. '|' separates because
    # an empty @kel-group would be a leading empty field to IFS-tab read
    local v kg sn wn
    v="$(tmux display-message -p -t "$wid" '#{@kel-group}|#{session_name}|#{window_name}' 2>/dev/null || true)"
    kg="${v%%|*}"; v="${v#*|}"; sn="${v%%|*}"; wn="${v#*|}"
    if [ -n "$kg" ]; then label="$kg/$wn"
    else
      case "$sn" in
        "$KEL_PREFIX")   label="$wn" ;;
        "$KEL_PREFIX"/*) label="${sn#"$KEL_PREFIX"/}/$wn" ;;
      esac
    fi
  fi

  # Outside a kel window there is no label, so the payload's own repo and
  # worktree identity takes that slot. It arrives in the JSON, so this costs no
  # git subprocess — a `git` call here would run on every redraw.
  local ident=''
  if [ -z "$label" ] && [ -n "$repo" ] && [ "$repo" != "/" ]; then
    ident="$repo"
    [ -n "$wt" ] && ident="$ident@$wt"
  fi

  local bar='' i filled=$(( (${pct:-0} + 9) / 10 ))
  [ "$filled" -gt 10 ] && filled=10
  # ${bar}, not $bar, immediately before the literal block character: bash on
  # the macOS CI runner (non-UTF-8 locale) mis-tokenizes "$bar█" — it reads
  # part of the multi-byte character's bytes as if they extended the variable
  # name, then reports THAT as an unbound variable. Braces make the name
  # boundary explicit regardless of what bytes follow. Found from a real CI
  # failure, not by inspection — this predates the board-hub work.
  for ((i=0; i<10; i++)); do
    if [ "$i" -lt "$filled" ]; then bar="${bar}█"; else bar="${bar}░"; fi
  done
  local cc='\033[32m'                                  # green
  [ "${pct:-0}" -ge "$KEL_CTX_WARN" ] && cc='\033[33m'  # yellow
  [ "${pct:-0}" -ge 90 ]              && cc='\033[31m'  # red

  # non-default modes only: the defaults are the common case and naming them
  # every redraw costs width without telling you anything
  local modes=''
  [ "$fastmode" = 1 ] && modes="fast"
  case "$effort" in ''|medium) ;; *) modes="${modes:+$modes }$effort" ;; esac
  [ "$thinking" = 0 ] && modes="${modes:+$modes }no-think"

  [ -n "$label" ] && printf '\033[2mkel\033[0m \033[36m%s\033[0m \033[2m·\033[0m ' "$label"
  [ -n "$ident" ] && printf '\033[36m%s\033[0m \033[2m·\033[0m ' "$ident"
  [ -n "$model" ] && printf '%s' "$model"
  [ -n "$modes" ] && printf ' \033[2m%s\033[0m' "$modes"
  [ -n "$model" ] && printf ' \033[2m·\033[0m '
  if [ -n "$pct" ]; then
    printf '%b%s %s%%\033[0m \033[2mctx\033[0m' "$cc" "$bar" "$pct"
    # absolute figures only once the percentage is worth acting on — that is
    # when "how much room is left" stops being idle curiosity
    if [ "$pct" -ge "$KEL_CTX_WARN" ] && [ "$ctxsz" -gt 0 ]; then
      printf ' \033[2m%s/%s\033[0m' "$(si_units "$intok")" "$(si_units "$ctxsz")"
    fi
  else
    # No bar at all. A dim empty bar still reads as "0% used", and this state is
    # "not measured yet" — null before the first call, and again after /compact.
    printf '\033[2mctx ?\033[0m'
  fi
  [ -n "$cost" ] && [ "$cost" != "0" ] && printf ' \033[2m·\033[0m $%.2f' "$cost" 2>/dev/null
  quota_chip 5h    "$rl5"   "$rl5at"   "$now"
  quota_chip 7d    "$rl7d"  "$rl7dat"  "$now"
  quota_chip spend "$spend" "$spendat" "$now"
  # agent.name marks a `claude --agent` session, not a Task-tool subagent.
  [ -n "$agent" ] && printf ' \033[2m·\033[0m \033[35m%s\033[0m' "$agent"
  printf '\n'

  # a statusLine kel displaced at install time still gets its say
  if [ -x "$STATUSLINE_PREV" ] || [ -s "$STATUSLINE_PREV" ]; then
    printf '%s' "$payload" | sh "$STATUSLINE_PREV" 2>/dev/null || true
  fi
}

# --------------------------------------------------------------------------
# kel hook <EVENT>
# --------------------------------------------------------------------------
cmd_hook() {
  local event="${1:-}"
  command -v tmux >/dev/null 2>&1 || exit 0
  # one jq pass, one field per line — never `IFS=$'\t' read`, which folds runs
  # of tab into a single delimiter and shifts everything after an empty field
  local payload evt sid cwd ntype ntext
  payload="$(cat 2>/dev/null || true)"
  {
    read -r evt; read -r sid; read -r cwd; read -r ntype; read -r ntext
  } < <(printf '%s' "$payload" | jq -r '[
      (.hook_event_name  // ""), (.session_id       // ""), (.cwd // ""),
      (.notification_type // ""), (.notification_text // "")
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)
  [ -n "$event" ] || event="$evt"

  local pane; pane="$(resolve_pane "$sid" "$cwd")"
  if [ "$event" = "SessionStart" ] && [ -n "$pane" ] && [ -n "$sid" ]; then
    printf '%s' "$pane" > "$STASH_DIR/$sid"
  fi
  [ -z "$pane" ] && exit 0

  local wid; wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  [ -z "$wid" ] && exit 0
  local prev; prev="$(state_of "$wid")"   # for the transition test below

  if [ -n "$sid" ] && [ "$event" != SessionEnd ]; then
    local m
    for m in "$SESSIONS_DIR"/*/*.json; do
      [ -e "$m" ] || continue
      [ "$(jq -r '.window_id' "$m" 2>/dev/null)" = "$wid" ] || continue
      [ "$(jq -r '.claude_session // ""' "$m" 2>/dev/null)" = "$sid" ] && break
      jq --arg s "$sid" '.claude_session=$s' "$m" > "$m.t" 2>/dev/null && mv "$m.t" "$m"
      break
    done
  fi

  local state
  case "$event" in
    SessionStart)     state=idle ;;
    UserPromptSubmit) state=working ;;
    Notification)
      # Not every notification means "blocked on you".  Mapping all of them to
      # `waiting` made `prefix \`` jump to agents that were merely sitting idle
      # or already finished — the one keystroke the tool exists for, lying.
      case "$ntype" in
        idle_prompt|auth_success|elicitation_complete|elicitation_response)
          exit 0 ;;                       # says something about you, not the agent
        agent_completed)      state=done ;;
        quota_auto_resume_*)  state=throttled ;;
        # permission_prompt, agent_needs_input, elicitation_*dialog, and any
        # notification type added after this was written
        *)                    state=waiting ;;
      esac ;;
    Stop)             state=done ;;
    PreCompact)
      # Compaction happens mid-turn: the agent is still working, so do NOT
      # touch .state.  Just count it.  "This one has been squeezed three
      # times" is the signal context% cannot give you, because context% drops
      # back down after every compaction and looks healthy again.
      local rr mp
      rr="$(meta_by_wid "$wid" || true)"
      if [ -n "$rr" ]; then
        mp="${rr##*$'\t'}"
        jq '.compactions = ((.compactions // 0) + 1)' "$mp" > "$mp.t" 2>/dev/null \
          && mv -f "$mp.t" "$mp"
      fi
      exit 0 ;;
    PostCompact)
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    SessionEnd)
      rm -f "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
      paint_state "$wid" ''
      [ -n "$sid" ] && rm -f "$STASH_DIR/$sid"
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    *) exit 0 ;;
  esac
  local tmp
  tmp="$(mktemp "$STATE_DIR/.${wid#@}.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s %s %s\n' "$state" "$(date +%s)" "$ntext" > "$tmp"
  mv -f "$tmp" "$STATE_DIR/$wid.state"
  paint_state "$wid" "$(effective_state "$wid")"
  tmux refresh-client -S 2>/dev/null || true

  # Only on a transition *into* a notifying state, and only when you are not
  # already looking at it.  Without the transition test every repeat hook of
  # the same state re-notifies, which is how people learn to ignore them.
  [ "$state" = "$prev" ] && exit 0
  case " $KEL_NOTIFY " in
    *" $state "*)
      window_focused "$wid" && exit 0
      local wn; wn="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null || echo "$wid")"
      notify "kel: $wn" "${ntext:-$state}" ;;
  esac
}

# --------------------------------------------------------------------------
# kel  (no args)  — enter the workspace
# --------------------------------------------------------------------------
quickstart() {
  cat <<'EOF'

  kel new <name>     start an agent in the current repo
  kel restore        bring back a previous workspace (--list to choose)
  prefix `           jump to whichever agent is waiting on you
  prefix t           kel top — every agent, its state, context and cost

EOF
}

# attach to the workspace — or, with no terminal (scripts, the test suite),
# say how to and return, rather than fail on "open terminal failed"
attach_workspace() { # [wid]
  local s="$KEL_PREFIX"
  kel_sessions | grep -qxF "$KEL_PREFIX" || s="$(kel_sessions | head -1)"
  if [ -t 0 ] && [ -t 1 ]; then
    if [ -n "${1:-}" ]; then exec tmux attach -t "=$s" \; select-window -t "$1"
    else exec tmux attach -t "=$s"; fi
  fi
  say "workspace running — tmux attach -t $s"
}

cmd_attach() {
  need tmux
  prune_state
  if in_tmux; then
    [ -z "$(kel_windows)" ] && { echo "no agents yet."; quickstart; return 0; }
    cmd_ls; return
  fi

  # dir target, the way `claude` keys off the current directory:
  # KEL_GROUP, else .kel/group or the repo we're standing in.
  local want=''
  if [ -n "${KEL_GROUP:-}" ]; then want="$KEL_GROUP"
  elif git_root >/dev/null 2>&1; then want="$(group_for_cwd)"
  fi
  slug_ok "$want" || want=''

  # 1. a live workspace: go to it — at this repo's agent if it has one, or
  #    start one for this repo if it does not
  if [ -n "$(kel_sessions)" ]; then
    local wid=''
    [ -n "$want" ] && wid="$(kel_windows | awk -F'\t' -v g="$want" '$5==g {print $3; exit}')"
    if [ -n "$want" ] && [ -z "$wid" ]; then
      say "no agent for '$want' yet — starting one"
      exec "$SELF" new "$want"
    fi
    attach_workspace "$wid"
    return
  fi

  # 2. no live workspace.  Never ask (v0.10): until then this stopped on a
  #    rebuild prompt, every first `kel` after a reboot, whatever you came to
  #    do.  Put the old workspace somewhere a fresh start cannot overwrite it,
  #    say so in one line, and carry on.  `kel restore` brings it back.
  if [ -f "$SNAPSHOT" ]; then
    local n; n="$(snapshot_summary "$SNAPSHOT" | cut -f1)"
    archive_snapshot && say "previous workspace: ${n:-?} window(s) · kel restore"
  elif [ -n "$(dead_sessions)" ]; then
    say "agents from before can be brought back: kel restore   (kel prune discards them)"
  fi

  # 3. fresh start — dir-aware if we're in a repo
  if [ -n "$want" ]; then
    say "starting an agent for '$want'"
    exec "$SELF" new "$want"
  fi
  say "welcome to kel."
  quickstart
  if [ -t 0 ] && [ -t 1 ]; then exec tmux new-session -s "$KEL_PREFIX" -c "$HOME"; fi
  tmux new-session -d -s "$KEL_PREFIX" -c "$HOME"
  say "workspace started — tmux attach -t $KEL_PREFIX"
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    hook)         cmd_hook "$@" ;;                 # hot path — skip migrate
    new)          migrate_meta; cmd_new "$@" ;;
    kill)         migrate_meta; cmd_kill "$@" ;;
    ls|list)      migrate_meta; cmd_ls "$@" ;;
    rename)       migrate_meta; cmd_rename "$@" ;;
    restore)      migrate_meta; cmd_restore "$@" ;;
    relaunch)     migrate_meta; cmd_relaunch "$@" ;;
    top)          cmd_top "$@" ;;
    sweep)        migrate_meta; cmd_sweep "$@" ;;
    prune)        migrate_meta; cmd_prune "$@" ;;
    snapshot)     cmd_snapshot ;;
    doctor)       cmd_doctor "$@" ;;
    config)       cmd_config ;;
    update)       cmd_update "$@" ;;
    status-line)  cmd_status_line "$@" ;;
    _fleet)       fleet_json "$@" ;;
    _cfgdump)     printf 'ctx_warn=%s notify=%s group=%s\n' "${KEL_CTX_WARN:-}" "${KEL_NOTIFY:-}" "${KEL_GROUP:-}" ;;
    statusline)   cmd_statusline ;;                # hot path — skip migrate
    jump)         cmd_jump ;;
    ''|attach)    migrate_meta; cmd_attach ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd  (try: kel --help)" ;;
  esac
}
main "$@"
