#!/usr/bin/env bash
# kel — a terminal workspace for running several coding agents at once.
# tmux does the multiplexing; kel does the bookkeeping.
#
#   kel                        enter the workspace — in a repo, go to (or start)
#                              that repo's agent, like `claude` for a directory
#   kel new <name> [-w]        window + agent, inplace or in a git worktree
#         [--group G] [--agent CMD] [--no-agent]
#   kel kill <name> [-f]       close the window; remove the worktree; -f overrides
#                              the uncommitted / unpushed check
#   kel ls [--json]            list agents, grouped by repo
#   kel go [<group>]           switch to a group (no arg: list groups)
#   kel move [<group>]         put the current window in another group
#                              (no arg: the group for the current directory)
#   kel rename <newname>       rename the current window (keeps metadata in sync)
#   kel board                  fzf fleet browser — filter / preview / act
#                              (Ctrl+Space or prefix b; enter jumps, tab = actions)
#   kel restore [-c] [-s]      rebuild the workspace after a kill / reboot
#                              (-c resume conversations, -s force the snapshot)
#   kel prune [-f]             discard dead agent records
#   kel doctor                 capability probe, cached
#
# internal (wired by install.sh):
#   kel status-line [group]    render tmux status-left
#   kel jump                   jump to the next waiting agent, any group (prefix `)
#   kel snapshot               save the workspace shape (hooks call this)
#   kel cheat                  keybinding reference
#   kel hook <EVENT>           Claude Code state hook
set -uo pipefail

KEL_PREFIX="${KEL_SESSION:-kel}"          # tmux sessions are  <prefix>/<group>
KEL_AGENT="${KEL_AGENT:-claude}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
SESSIONS_DIR="$STATE_DIR/sessions"
STASH_DIR="$STATE_DIR/.stash"
DOCTOR_CACHE="$STATE_DIR/doctor.json"
LAST_GROUP_FILE="$STATE_DIR/last-group"
SNAPSHOT="$STATE_DIR/snapshot.json"
RESTORE_LOCK="$STATE_DIR/.restoring"
SELF="$(command -v kel 2>/dev/null || printf '%s' "$HOME/.local/bin/kel")"
# commands worth re-running per pane on restore (agents handled separately)
KEL_RESTORE_CMDS="${KEL_RESTORE_CMDS:-nvim vim hx nano lazygit lazydocker htop btop k9s}"

mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$STASH_DIR"

say()  { printf '\033[1;32mkel\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mkel\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mkel\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --------------------------------------------------------------------------
# groups & sessions
# --------------------------------------------------------------------------
# tmux session name for a group.  The bare prefix is the pre-v0.2 flat session.
sess() { case "$1" in "$KEL_PREFIX") printf '%s' "$KEL_PREFIX";; *) printf '%s/%s' "$KEL_PREFIX" "$1";; esac; }

slug_ok() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
git_root() { git rev-parse --show-toplevel 2>/dev/null; }
in_tmux()  { [ -n "${TMUX:-}" ]; }
has_remote() { [ -n "$(git -C "$1" remote 2>/dev/null)" ]; }

# derive the group for a new agent:
#   --group flag  >  $KEL_GROUP (force everything into one group)  >  repo basename  >  misc
group_for_cwd() {
  [ -n "${KEL_GROUP:-}" ] && { printf '%s' "$KEL_GROUP"; return; }
  local gr; gr="$(git_root 2>/dev/null || true)"
  if [ -n "$gr" ]; then basename "$gr"; else printf 'misc'; fi
}

# all kel group names that have a live tmux session
group_sessions() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null | awk -v p="$KEL_PREFIX" '
    $0==p            { print p; next }
    index($0,p"/")==1 { print substr($0, length(p)+2) }'
}

# every window in every kel session:  session<TAB>group<TAB>index<TAB>wid<TAB>name
kel_windows() {
  tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}' 2>/dev/null \
  | awk -F'\t' -v p="$KEL_PREFIX" '
      $1==p || index($1,p"/")==1 {
        g = ($1==p) ? p : substr($1, length(p)+2)
        print $1"\t"g"\t"$2"\t"$3"\t"$4
      }'
}

# the group the attached client is looking at, or empty if not in a kel session
current_group() {
  local s; s="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  case "$s" in
    "$KEL_PREFIX")   printf '%s' "$KEL_PREFIX" ;;
    "$KEL_PREFIX"/*) printf '%s' "${s#"$KEL_PREFIX"/}" ;;
  esac
}

set_last_group() { printf '%s' "$1" > "$LAST_GROUP_FILE" 2>/dev/null || true; }
get_last_group() { cat "$LAST_GROUP_FILE" 2>/dev/null || true; }

state_of() { # wid -> raw state from the hook, or empty
  [ -f "$STATE_DIR/$1.state" ] || return 0
  local s; read -r s _ < "$STATE_DIR/$1.state" || return 0
  printf '%s' "$s"
}

# effective_state: raw hook state, but "dead" if the agent process is gone
# (a crash/OOM fires no Stop/SessionEnd hook — the window just drops to a shell)
effective_state() { # wid
  local s; s="$(state_of "$1")"
  case "$s" in
    working|waiting)
      tmux list-panes -t "$1" -F '#{pane_current_command}' 2>/dev/null \
        | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' || { printf 'dead'; return; } ;;
  esac
  printf '%s' "$s"
}

# put kel's group-scoped status-left on a group session
# (set-option does NOT accept the "=" exact-match prefix; the full name is exact)
group_session_status() { # group session
  tmux set-option -t "$2" status-left-length 200 2>/dev/null || true
  tmux set-option -t "$2" status-left \
    "#[fg=colour245][$1]#[default] #($SELF status-line $1)" 2>/dev/null || true
}

# create the window in its group's session (making the session if needed); prints wid
open_window() { # name cwd group
  local name="$1" cwd="$2" group="$3" s; s="$(sess "$group")"
  if tmux has-session -t "=$s" 2>/dev/null; then
    tmux new-window -t "=$s" -n "$name" -c "$cwd" -P -F '#{window_id}'
  else
    local wid
    wid="$(tmux new-session -d -s "$s" -n "$name" -c "$cwd" -x 220 -y 50 -P -F '#{window_id}')"
    group_session_status "$group" "$s"
    printf '%s' "$wid"
  fi
}

# move the caller to a window, switching to its group session
goto_window() { # wid [group]
  local wid="$1" group="${2:-}" s=''
  [ -n "$group" ] && s="$(sess "$group")"
  if in_tmux; then
    [ -n "$s" ] && tmux switch-client -t "=$s" 2>/dev/null || true
    tmux select-window -t "$wid" 2>/dev/null || true
  elif [ -t 1 ]; then
    if [ -n "$s" ]; then tmux attach -t "=$s" \; select-window -t "$wid"
    else tmux attach \; select-window -t "$wid"; fi
  fi
  return 0
}

# --------------------------------------------------------------------------
# metadata
# --------------------------------------------------------------------------
# Records live at $SESSIONS_DIR/<group>/<name>.json — keyed by group *and*
# name, so two repos can each have an agent called "docs".
meta_path() { printf '%s/%s/%s.json' "$SESSIONS_DIR" "$1" "$2"; }   # group name

# every record on disk, as  group<TAB>name<TAB>path
all_metas() {
  local d g f nm
  for d in "$SESSIONS_DIR"/*/; do
    [ -d "$d" ] || continue
    g="$(basename "$d")"
    for f in "$d"*.json; do
      [ -e "$f" ] || continue
      nm="$(basename "$f" .json)"
      printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
    done
  done
}

# the record owning a tmux window id, as  group<TAB>name<TAB>path
meta_by_wid() { # wid
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    [ "$(jq -r '.window_id // ""' "$f" 2>/dev/null)" = "$1" ] || continue
    printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0
  done < <(all_metas)
  return 1
}

# resolve a user-typed agent to  group<TAB>name<TAB>path.
# accepts "name" or "group/name".  A bare name prefers the group you are
# standing in, then a unique match anywhere; exit 2 (candidates on stderr) when
# the same name exists in several groups.
resolve_agent() { # name [preferred-group]
  local want="$1" pref="${2:-}" g nm f hits
  case "$want" in
    */*) g="${want%%/*}"; nm="${want##*/}"; f="$(meta_path "$g" "$nm")"
         [ -f "$f" ] || return 1
         printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0 ;;
  esac
  [ -z "$pref" ] && pref="$(current_group)"
  if [ -n "$pref" ] && [ -f "$(meta_path "$pref" "$want")" ]; then
    printf '%s\t%s\t%s\n' "$pref" "$want" "$(meta_path "$pref" "$want")"; return 0
  fi
  hits="$(all_metas | awk -F'\t' -v n="$want" '$2==n')"
  case "$(printf '%s' "$hits" | grep -c .)" in
    0) return 1 ;;
    1) printf '%s\n' "$hits"; return 0 ;;
    *) printf '%s' "$hits" | awk -F'\t' '{printf "  %s/%s\n", $1, $2}' >&2; return 2 ;;
  esac
}

meta_write() { # name wid repo cwd isolation branch agent group
  mkdir -p "$SESSIONS_DIR/$8"
  jq -n \
    --arg name "$1" --arg wid "$2" --arg repo "$3" --arg cwd "$4" \
    --arg iso "$5" --arg branch "$6" --arg agent "$7" --arg group "$8" \
    --arg created "$(date -u +%FT%TZ)" \
    '{name:$name, window_id:$wid, repo:$repo, cwd:$cwd, isolation:$iso,
      branch:(if $branch=="" then null else $branch end),
      agent:$agent, group:$group, created_at:$created}' \
    > "$(meta_path "$8" "$1")"
}

# pre-v0.2 records have no .group (derive it from .repo); pre-v0.4.1 records
# sit flat in sessions/ (file them under sessions/<group>/).
migrate_meta() {
  local f nm repo grp dest
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    nm="$(basename "$f" .json)"
    grp="$(jq -r '.group // ""' "$f" 2>/dev/null)"
    if [ -z "$grp" ] || [ "$grp" = null ]; then
      repo="$(jq -r '.repo // ""' "$f" 2>/dev/null)"
      if [ -n "$repo" ]; then grp="$(basename "$repo")"; else grp="misc"; fi
      jq --arg g "$grp" '.group = $g' "$f" > "$f.m" 2>/dev/null && mv "$f.m" "$f"
    fi
    slug_ok "$grp" || grp=misc
    mkdir -p "$SESSIONS_DIR/$grp"
    dest="$(meta_path "$grp" "$nm")"
    if [ -e "$dest" ]; then
      warn "two records for '$grp/$nm' — keeping the newer"
      if [ "$f" -nt "$dest" ]; then mv -f "$f" "$dest"; else rm -f "$f"; fi
    else
      mv -f "$f" "$dest"
    fi
  done
}

# is a metadata record backed by a live window (same id + name) in any kel session?
meta_is_live() { # path name
  local wid; [ -f "$1" ] || return 1
  wid="$(jq -r '.window_id' "$1")"
  kel_windows | awk -F'\t' -v w="$wid" -v n="$2" '$4==w && $5==n {found=1} END{exit !found}'
}

# records with no live window, as  group<TAB>name<TAB>path
dead_sessions() {
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    meta_is_live "$f" "$nm" || printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
  done < <(all_metas)
}

prune_state() {
  local live f wid
  live="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)"
  [ -n "$live" ] || return 0
  for f in "$STATE_DIR"/*.state; do
    [ -e "$f" ] || continue
    wid="$(basename "$f" .state)"
    printf '%s\n' "$live" | grep -qxF "$wid" || rm -f "$f"
  done
}

# 0 (true) if the worktree has uncommitted changes or commits on no remote
worktree_unsafe() { # cwd
  [ -d "$1" ] || return 1
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null || true)" ] && return 0
  if has_remote "$1"; then
    [ -n "$(git -C "$1" log --oneline HEAD --not --remotes 2>/dev/null || true)" ] && return 0
  fi
  return 1
}

# --------------------------------------------------------------------------
# kel new
# --------------------------------------------------------------------------
cmd_new() {
  need tmux; need jq
  local name='' worktree=0 agent="$KEL_AGENT" start_agent=1 group_override=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -w|--worktree) worktree=1 ;;
      --group)       shift; group_override="${1:-}"; [ -n "$group_override" ] || die "--group needs a name" ;;
      --agent)       shift; agent="${1:-}"; [ -n "$agent" ] || die "--agent needs a command" ;;
      --no-agent)    start_agent=0 ;;
      -*)            die "kel new: unknown flag $1" ;;
      *)             [ -z "$name" ] || die "kel new: unexpected argument '$1'"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel new <name> [-w] [--group G] [--agent CMD] [--no-agent]"
  slug_ok "$name" || die "name must be a slug (A-Z a-z 0-9 . _ -)"

  local repo cwd branch='' isolation='inplace' group
  repo="$(git_root || true)"
  group="${group_override:-$(group_for_cwd)}"
  slug_ok "$group" || die "group '$group' is not a slug — pass --group"

  # names only have to be unique within their group
  if [ -f "$(meta_path "$group" "$name")" ]; then
    if meta_is_live "$(meta_path "$group" "$name")" "$name"; then
      die "agent '$group/$name' already exists (kel kill $group/$name first)"
    fi
    warn "reclaiming the record for '$group/$name' (its window is gone)"
    rm -f "$(meta_path "$group" "$name")"
  fi
  [ -z "$group_override" ] && [ -z "${KEL_GROUP:-}" ] && [ -z "$repo" ] && \
    warn "no git repo here → group 'misc'  (use --group NAME to name it)"

  if [ "$worktree" = 1 ]; then
    [ -n "$repo" ] || die "--worktree must be run inside a git repo"
    branch="$name"
    isolation='worktree'
    local wt_root="${KEL_WORKTREES:-$(dirname "$repo")/.kel-worktrees}"
    mkdir -p "$wt_root"
    cwd="$wt_root/$(basename "$repo")-$name"
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $cwd"; then
      say "reusing existing worktree  $cwd"
    elif [ -e "$cwd" ]; then
      die "path exists but isn't a registered worktree: $cwd"
    else
      say "creating worktree  $cwd  (branch $branch)"
      git -C "$repo" worktree add -b "$branch" "$cwd" >/dev/null \
        || git -C "$repo" worktree add "$cwd" "$branch" >/dev/null \
        || die "git worktree add failed"
      if [ -x "$repo/.kel/setup" ]; then
        say "running .kel/setup"
        if ! ( cd "$cwd" && KEL_REPO="$repo" KEL_WORKTREE="$cwd" "$repo/.kel/setup" ); then
          warn ".kel/setup exited non-zero — the worktree may be incomplete"
        fi
      fi
    fi
  else
    cwd="${repo:-$PWD}"
  fi

  local wid
  wid="$(open_window "$name" "$cwd" "$group")"
  [ -n "$wid" ] || die "failed to create tmux window"

  meta_write "$name" "$wid" "$repo" "$cwd" "$isolation" "$branch" "$agent" "$group"
  set_last_group "$group"
  [ "$start_agent" = 1 ] && tmux send-keys -t "$wid" "$agent" Enter

  say "new agent  $name  [$group]  ($isolation${branch:+, branch $branch})"
  goto_window "$wid" "$group"
  snapshot
}

# --------------------------------------------------------------------------
# kel kill
# --------------------------------------------------------------------------
cmd_kill() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel kill: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel kill <name> [--force]"
  local orig_name="$name"

  local meta='' wid iso='inplace' cwd='' branch='' repo='' group=''
  local bare="${orig_name##*/}" rr rc=0
  rr="$(resolve_agent "$name")" || rc=$?
  [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel kill <group>/<name>"
  if [ -n "$rr" ]; then
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    # no record under that name — the window may have been renamed since
    # `kel new`.  Find the record owning the window currently named $bare.
    local bw; bw="$(kel_windows | awk -F'\t' -v n="$bare" '$5==n {print $4; exit}')"
    if [ -n "$bw" ]; then
      rr="$(meta_by_wid "$bw" || true)"
      [ -n "$rr" ] && IFS=$'\t' read -r group name meta <<< "$rr"
    fi
  fi
  if [ -n "$meta" ] && [ -f "$meta" ]; then
    wid="$(jq -r '.window_id' "$meta")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    branch="$(jq -r '.branch // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    name="$(jq -r '.name // empty' "$meta")"; name="${name:-$orig_name}"
  else
    wid="$(kel_windows | awk -F'\t' -v n="$bare" '$5==n {print $4; exit}')"
    [ -n "$wid" ] || die "no agent '$orig_name'"
    name="$bare"
    warn "'$name' is an unmanaged window — closing it, no metadata to clean up"
  fi

  if [ "$iso" = "worktree" ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
    warn "refusing to kill '$name' — the worktree has work that isn't safe to lose:"
    local d; d="$(git -C "$cwd" status --short 2>/dev/null || true)"
    [ -n "$d" ] && { echo "  uncommitted changes:" >&2; echo "$d" | sed 's/^/    /' >&2; }
    local u; has_remote "$cwd" && u="$(git -C "$cwd" log --oneline HEAD --not --remotes 2>/dev/null || true)"
    [ -n "${u:-}" ] && { echo "  commits not on any remote:" >&2; echo "$u" | sed 's/^/    /' >&2; }
    die "commit & push, or run: kel kill $name --force"
  fi

  [ -n "$wid" ] && tmux kill-window -t "$wid" 2>/dev/null || true

  if [ "$iso" = "worktree" ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
    if git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null; then
      say "removed worktree $cwd  (branch $branch kept)"
    else
      warn "couldn't remove worktree — do it manually: git -C $repo worktree remove ${force:+--force} $cwd"
    fi
  fi

  rm -f "$meta" "$STATE_DIR/$wid.state"
  say "killed $name"
  snapshot
}

# --------------------------------------------------------------------------
# kel rename <newname>  — rename the current window and keep metadata in sync
# --------------------------------------------------------------------------
# rename a specific window by id + move its metadata record along with it
rename_agent() { # wid new
  local wid="$1" new="$2" old grp='' sn
  old="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)"
  [ -n "$old" ] || { warn "kel rename: window $wid is gone"; return 1; }
  [ "$old" = "$new" ] && return 0
  sn="$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null || true)"
  case "$sn" in
    "$KEL_PREFIX")   grp="$KEL_PREFIX" ;;
    "$KEL_PREFIX"/*) grp="${sn#"$KEL_PREFIX"/}" ;;
  esac
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$new")" ] && \
    { warn "an agent named '$new' already exists in [$grp]"; return 1; }

  tmux rename-window -t "$wid" "$new"

  # move the metadata record if this is a managed agent (by name, or by window id)
  local om='' rr
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$old")" ] && om="$(meta_path "$grp" "$old")"
  if [ -z "$om" ]; then
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] && { grp="${rr%%$'\t'*}"; om="${rr##*$'\t'}"; }
  fi
  if [ -n "$om" ] && [ -f "$om" ]; then
    mkdir -p "$SESSIONS_DIR/$grp"
    jq --arg n "$new" '.name=$n' "$om" > "$(meta_path "$grp" "$new")" && rm -f "$om"
  fi
  say "renamed '$old' -> '$new'"
  snapshot
}

cmd_rename() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel rename: run this from inside kel"
  local new="${1:-}"
  [ -n "$new" ] || die "usage: kel rename <newname>"
  slug_ok "$new" || die "name must be a slug (A-Z a-z 0-9 . _ -)"
  rename_agent "$(tmux display-message -p '#{window_id}')" "$new"
}

# --------------------------------------------------------------------------
# kel prune
# --------------------------------------------------------------------------
cmd_prune() {
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "kel prune: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "no dead agents"; return 0; }

  local g n meta iso cwd repo removed=0 kept=0
  while IFS=$'\t' read -r g n meta; do
    [ -z "$n" ] && continue
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    if [ "$iso" = worktree ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
      warn "kept '$g/$n' — worktree has unsaved work  (kel kill $g/$n -f)"
      kept=$((kept + 1)); continue
    fi
    if [ "$iso" = worktree ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
      git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null \
        || warn "left worktree $cwd (remove by hand)"
    fi
    rm -f "$meta"
    removed=$((removed + 1))
  done <<< "$names"

  say "pruned $removed dead agent(s)$([ "$kept" -gt 0 ] && printf ', kept %s' "$kept")"
}

# --------------------------------------------------------------------------
# kel ls
# --------------------------------------------------------------------------
# emits TSV: group idx wid name state iso branch dirty panes cwd   ('*' on idx = current)
gather_rows() {
  local cs cw
  cs="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  cw="$(tmux display-message -p '#{window_index}' 2>/dev/null || true)"
  local grp idx wid name state iso branch dirty panes cwd meta

  while IFS=$'\t' read -r sname grp idx wid name; do
    [ -z "${wid:-}" ] && continue
    state="$(effective_state "$wid")"; [ -z "$state" ] && state='-'
    iso='(unmanaged)'; branch='-'; dirty='-'; cwd=''
    meta="$(meta_path "$grp" "$name")"
    if [ -f "$meta" ]; then
      iso="$(jq -r '.isolation' "$meta")"
      branch="$(jq -r '.branch // "-"' "$meta")"
      cwd="$(jq -r '.cwd // ""' "$meta")"
    fi
    if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      dirty="$(git -C "$cwd" status --porcelain 2>/dev/null | grep -c . || true)"
    fi
    panes="$(tmux list-panes -t "$wid" -F '#{pane_current_command}' 2>/dev/null | paste -sd'|' -)"
    [ "$sname" = "$cs" ] && [ "$idx" = "$cw" ] && idx="${idx}*"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$grp" "$idx" "$wid" "$name" "$state" "$iso" "$branch" "$dirty" "${panes:--}" "$cwd"
  done < <(kel_windows | sort -t$'\t' -k2,2 -k3,3n)

  while IFS=$'\t' read -r grp name meta; do
    [ -z "$name" ] && continue
    iso="$(jq -r '.isolation' "$meta")"
    branch="$(jq -r '.branch // "-"' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    dirty='-'
    if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
      dirty="$(git -C "$cwd" status --porcelain 2>/dev/null | grep -c . || true)"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$grp" "-" "" "$name" "dead" "$iso" "$branch" "$dirty" "-" "$cwd"
  done < <(dead_sessions)
}

cmd_ls() {
  need tmux; need jq
  prune_state
  if [ -z "$(group_sessions)" ] && [ -z "$(dead_sessions)" ]; then
    echo "no agents yet — 'kel new <name>' to start one"
    return 0
  fi

  if [ "${1:-}" = "--json" ]; then
    printf '['
    local first=1
    gather_rows | while IFS=$'\t' read -r grp idx wid name state iso branch dirty panes cwd; do
      [ "$first" = 1 ] || printf ','
      first=0
      jq -nc --arg grp "$grp" --arg idx "${idx%\*}" --arg wid "$wid" --arg name "$name" \
             --arg state "$state" --arg iso "$iso" --arg branch "$branch" \
             --arg dirty "$dirty" --arg panes "$panes" --arg cwd "$cwd" \
        '{group:$grp, index:(($idx|tonumber?) // null), window_id:$wid, name:$name, state:$state,
          isolation:$iso, branch:(if $branch=="-" then null else $branch end),
          dirty:(($dirty|tonumber?) // null),
          panes:(if $panes=="-" then null else ($panes|split("|")) end), cwd:$cwd}'
    done
    printf ']\n'
    return 0
  fi

  gather_rows | awk -F'\t' '
    function pad(s,n){ while(length(s)<n) s=s" "; return s }
    { rows[NR]=$0 }
    END {
      lastg=""
      for (i=1;i<=NR;i++) {
        split(rows[i], f, "\t")
        g=f[1]; idx=f[2]; name=f[4]; st=f[5]; iso=f[6]; br=f[7]; pn=f[9]; cwd=f[10]
        gsub(ENVIRON["HOME"], "~", cwd)
        # show pane commands only when the window is split
        disp = name
        if (pn != "-" && index(pn, "|")) disp = name " (" pn ")"
        if (g!=lastg) { if (lastg!="") print ""; print g; lastg=g }
        printf "  %s %s %s %s %s  %s\n",
          pad(idx,4), pad(disp,24), pad(st,8), pad(iso,10), pad(br,12), cwd
      }
    }'
  [ -n "$(dead_sessions)" ] && echo && echo "  dead = window gone.  kel restore [-c] rebuilds  ·  kel prune discards"
  return 0
}

# --------------------------------------------------------------------------
# kel go
# --------------------------------------------------------------------------
cmd_go() {
  need tmux
  local g="${1:-}"
  if [ -z "$g" ]; then
    local gs; gs="$(group_sessions)"
    [ -n "$gs" ] || { echo "no groups yet"; return 0; }
    local cur; cur="$(current_group)"
    printf '%s\n' "$gs" | while read -r x; do
      [ "$x" = "$cur" ] && printf '* %s\n' "$x" || printf '  %s\n' "$x"
    done
    return 0
  fi
  local s; s="$(sess "$g")"
  tmux has-session -t "=$s" 2>/dev/null || die "no group '$g'  (kel go with no arg lists them)"
  set_last_group "$g"; snapshot
  if in_tmux; then tmux switch-client -t "=$s"
  elif [ -t 1 ]; then tmux attach -t "=$s"
  fi
}

# --------------------------------------------------------------------------
# kel move  — relocate the current window to another group
# --------------------------------------------------------------------------
cmd_move() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel move: run this from inside kel"

  local cur_wid cur_sess cur_group wname pcwd
  cur_wid="$(tmux display-message -p '#{window_id}')"
  cur_sess="$(tmux display-message -p '#{session_name}')"
  wname="$(tmux display-message -p '#{window_name}')"
  pcwd="$(tmux display-message -p '#{pane_current_path}')"
  case "$cur_sess" in "$KEL_PREFIX"|"$KEL_PREFIX"/*) ;; *) die "kel move: this window isn't in a kel group" ;; esac
  cur_group="$(current_group)"

  local target="${1:-}"
  if [ -z "$target" ]; then
    if [ -n "${KEL_GROUP:-}" ]; then target="$KEL_GROUP"
    else
      local gr; gr="$(cd "$pcwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
      if [ -n "$gr" ]; then target="$(basename "$gr")"
      else target="misc"; warn "no git repo here → group 'misc'  (kel move NAME to name it)"; fi
    fi
  fi
  slug_ok "$target" || die "group '$target' isn't a slug"
  [ "$target" = "$cur_group" ] && { say "already in group '$cur_group'"; return 0; }
  [ -f "$(meta_path "$target" "$wname")" ] && \
    die "[$target] already has an agent called '$wname' — kel rename it first"

  # warn if we're moving a worktree agent away from its repo's group
  local mv_meta; mv_meta="$(meta_path "$cur_group" "$wname")"
  if [ -f "$mv_meta" ] && [ "$(jq -r '.isolation' "$mv_meta")" = worktree ]; then
    local mr; mr="$(basename "$(jq -r '.repo // ""' "$mv_meta")")"
    [ -n "$mr" ] && [ "$mr" != "$target" ] && \
      warn "'$wname' works in $mr's worktree — moving it to [$target] is cosmetic only"
  fi

  local dst; dst="$(sess "$target")"
  if ! tmux has-session -t "=$dst" 2>/dev/null; then
    tmux new-session -d -s "$dst" -c "$HOME" -x 220 -y 50
    group_session_status "$target" "$dst"
    local ph; ph="$(tmux list-windows -t "=$dst" -F '#{window_id}' | head -1)"
    tmux move-window -s "$cur_wid" -t "$dst:"
    tmux kill-window -t "$ph" 2>/dev/null || true
  else
    tmux move-window -s "$cur_wid" -t "$dst:"
  fi

  local meta; meta="$(meta_path "$cur_group" "$wname")"
  if [ -f "$meta" ]; then
    mkdir -p "$SESSIONS_DIR/$target"
    jq --arg g "$target" '.group=$g' "$meta" > "$(meta_path "$target" "$wname")" && rm -f "$meta"
  else
    local repo; repo="$(cd "$pcwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
    meta_write "$wname" "$cur_wid" "$repo" "$pcwd" "inplace" "" "$KEL_AGENT" "$target"
    say "adopted '$wname' into kel"
  fi
  set_last_group "$target"

  tmux switch-client -t "=$dst" \; select-window -t "$cur_wid" 2>/dev/null || true

  # tidy: drop the old group session if it's now empty
  if [ -n "$cur_group" ] && ! tmux list-windows -t "=$(sess "$cur_group")" -F x 2>/dev/null | grep -q x; then
    tmux kill-session -t "=$(sess "$cur_group")" 2>/dev/null || true
  fi

  say "moved '$wname'  ->  [$target]"
  snapshot
}

# --------------------------------------------------------------------------
# kel board   (prefix b)  — fzf-driven fleet browser
# --------------------------------------------------------------------------
# rows for fzf:  group <T> name <T> state <T> dirty <T> path <T> wid
cmd_board_rows() {
  gather_rows | awk -F'\t' '
    {
      grp=$1; wid=$3; name=$4; st=$5; dirty=$8; cwd=$10
      if (wid=="") next                          # skip orphan-metadata rows (no window)
      c="\033[0m"
      if (st=="waiting") c="\033[1;33m"
      else if (st=="working") c="\033[1;36m"
      else if (st=="done")    c="\033[1;32m"
      else if (st=="dead")    c="\033[1;31m"
      else if (st=="idle")    c="\033[2m"
      sd = (dirty=="-" || dirty=="0") ? "" : dirty " dirty"
      printf "%s\t%s\t%s%s\033[0m\t%s\t%s\t%s\n", grp, name, c, (st=="-"?"idle":st), sd, cwd, wid
    }' | sort
}

cmd_board_preview() {   # name group
  local name="$1" group="$2" meta; meta="$(meta_path "$group" "$name")"
  if [ -f "$meta" ]; then
    jq -r '"group      \(.group)
agent      \(.agent)
isolation  \(.isolation)\(if .branch then "  (branch \(.branch))" else "" end)
directory  \(.cwd)
created    \(.created_at)"' "$meta"
  else
    printf 'group      %s\n(unmanaged window — no metadata)\n' "$group"
  fi
  local wid; wid="$(kel_windows | awk -F'\t' -v n="$name" -v g="$group" '$2==g && $5==n{print $4; exit}')"
  if [ -n "$wid" ]; then
    printf '\n\033[2m── recent ──\033[0m\n'
    tmux capture-pane -t "$wid" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8
  fi
  local cwd; cwd="$(jq -r '.cwd // ""' "$meta" 2>/dev/null)"
  if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
    local d; d="$(git -C "$cwd" status --short 2>/dev/null | head -10)"
    [ -n "$d" ] && printf '\n\033[2m── uncommitted ──\033[0m\n%s\n' "$d"
  fi
}

cmd_board_jump() {   # wid group
  [ -n "${1:-}" ] || return 0
  tmux switch-client -t "=$(sess "$2")" 2>/dev/null || true
  tmux select-window -t "$1" 2>/dev/null || true
  set_last_group "$2"
}

# ctrl-k wrapper: confirm before killing (in-place agents get no other friction)
cmd_board_kill() {   # group name
  [ -n "${2:-}" ] || return 0
  printf 'kill %s/%s? [y/N] ' "$1" "$2" > /dev/tty
  local a=''; read -r a < /dev/tty || a=n
  case "$a" in y|Y|yes) "$SELF" kill "$1/$2" ;; *) : ;; esac
}

# tab in the board: a labelled action menu for the highlighted agent.
# (the board closes behind it, same as pressing enter to jump)
# display-menu needs an explicit -c client here — invoked via fzf `become`, not
# from a key binding, tmux can't resolve the "current" client on its own.
cmd_board_actions() {   # wid name group cwd
  need tmux
  local wid="$1" name="$2" group="$3" cwd="$4" cl sn
  sn="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null || true)"
  cl="$(tmux list-clients ${sn:+-t "$sn"} -F '#{client_name}' 2>/dev/null | head -1)"
  [ -n "$cl" ] || cl="$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -1)"
  tmux display-menu ${cl:+-c $cl} -x C -y C -T " $name " -- \
    "jump to it"                j  "run-shell \"$SELF _board_jump '$wid' '$group'\"" \
    "new agent in its folder"   n  "command-prompt -p 'name:' { run-shell \"cd '$cwd' && $SELF new %%\" }" \
    "rename it"                  r  "command-prompt -p 'new name:' { run-shell \"$SELF _board_rename '$wid' %%\" }" \
    "go to its group"           g  "run-shell \"$SELF go '$group'\"" \
    "" \
    "kill it"                   k  "run-shell \"$SELF _board_kill '$group' '$name'\""
}

cmd_board_rename() {   # wid new
  need tmux; need jq
  slug_ok "${2:-}" || { warn "name must be a slug (A-Z a-z 0-9 . _ -)"; return 1; }
  rename_agent "$1" "$2"
}

cmd_board() {
  need tmux; need fzf; need jq
  [ -n "${TMUX:-}" ] || die "kel board runs inside tmux"
  [ -n "$(cmd_board_rows)" ] || { tmux display-message "kel: no agents"; return 0; }

  cmd_board_rows | SHELL=/bin/bash fzf \
    --ansi --delimiter '\t' --with-nth '1,2,3,4' --nth '1,2' \
    --layout reverse --info inline --height '100%' \
    --footer 'enter jump  ·  tab actions' \
    --preview "$SELF _board_preview {2} {1}" \
    --preview-window 'right,45%,wrap,border-left' \
    --bind "enter:become($SELF _board_jump {6} {1})" \
    --bind "tab:become($SELF _board_actions {6} {2} {1} {5})" \
    --bind "ctrl-g:become($SELF go {1})" \
    --bind "ctrl-r:reload($SELF _board_rows)" \
    --bind "ctrl-k:execute($SELF _board_kill {1} {2})+reload($SELF _board_rows)" \
    --bind "ctrl-n:become(tmux command-prompt -p 'new agent:' \"run-shell \\\"cd {5} && $SELF new %%\\\"\")" \
    --color 'footer:italic,border:8' \
    >/dev/null 2>&1 || true
}

# kel menu  —  deprecated alias for the board (kept one release for muscle memory)
cmd_menu() { cmd_board; }

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
agent_resume_cmd() { # agent cid  -> the shell string to resume/start an agent
  if [ -n "$2" ]; then printf '%s --resume %s || %s --continue || %s' "$1" "$2" "$1" "$1"
  else printf '%s --continue || %s' "$1" "$1"; fi
}

# --------------------------------------------------------------------------
# kel snapshot  — save the whole workspace shape (groups/windows/panes)
# --------------------------------------------------------------------------
snapshot() {   # silent; called by hooks and state-changing commands
  # A restore owns snapshot.json while it runs (see restore_from_snapshot).
  # This has to be a lockfile, not an env var: the tmux hooks that call us
  # spawn a fresh `kel` from the server, which inherits nothing.  A lock left
  # behind by a killed restore goes stale after five minutes.
  if [ -e "$RESTORE_LOCK" ]; then
    local lock_age=$(( $(date +%s) - $(stat -c %Y "$RESTORE_LOCK" 2>/dev/null || echo 0) ))
    [ "$lock_age" -lt 300 ] && return 0
    rm -f "$RESTORE_LOCK"
  fi
  command -v tmux >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  group_sessions | grep -q . || return 0
  local snap g s
  snap="$(jq -n --arg t "$(date -u +%FT%TZ)" --arg lg "$(current_group)" \
               --arg lw "$(tmux display-message -p '#{window_name}' 2>/dev/null || true)" \
               '{saved_at:$t, last_group:$lg, last_window:$lw, groups:{}}')"
  while read -r g; do
    [ -z "$g" ] && continue
    s="$(sess "$g")"
    local wins='[]' widx wname wlayout
    while IFS=$'\t' read -r widx wname wlayout; do
      [ -z "$widx" ] && continue
      local panes='[]' pcwd pcmd
      while IFS=$'\t' read -r pcwd pcmd; do
        panes="$(printf '%s' "$panes" | jq --arg c "$pcwd" --arg m "$pcmd" '.+[{cwd:$c,cmd:$m}]')"
      done < <(tmux list-panes -t "$s:$widx" -F '#{pane_current_path}	#{pane_current_command}' 2>/dev/null)
      wins="$(printf '%s' "$wins" | jq --arg n "$wname" --arg l "$wlayout" --argjson p "$panes" \
              '.+[{name:$n,layout:$l,panes:$p}]')"
    done < <(tmux list-windows -t "$s" -F '#{window_index}	#{window_name}	#{window_layout}' 2>/dev/null)
    snap="$(printf '%s' "$snap" | jq --arg g "$g" --argjson w "$wins" '.groups[$g]=$w')"
  done < <(group_sessions)
  local tmp; tmp="$(mktemp "$STATE_DIR/.snap.XXXXXX" 2>/dev/null)" || return 0
  [ -f "$SNAPSHOT" ] && cp -f "$SNAPSHOT" "$SNAPSHOT.prev" 2>/dev/null
  printf '%s' "$snap" > "$tmp" && mv -f "$tmp" "$SNAPSHOT"
}

cmd_snapshot() { need tmux; need jq; snapshot; say "snapshot -> ${SNAPSHOT/#$HOME/\~}"; }

# rebuild the workspace from snapshot.json (windows, splits, layout, agents)
restore_from_snapshot() {   # [-c]
  need tmux; need jq
  [ -f "$SNAPSHOT" ] || { warn "no snapshot to restore"; return 1; }
  local cont=0; [ "${1:-}" = "-c" ] && cont=1

  # Rebuilding the workspace fires tmux's own after-split-window / pane-exited
  # hooks, which run `kel snapshot` in the background — that would write the
  # half-rebuilt workspace over snapshot.json while we are still reading it,
  # truncating the restore and destroying the record of everything not yet
  # rebuilt.  Hold the lock so those writes stand down, and read from a private
  # copy so nothing can move underneath us either way.
  local src="$SNAPSHOT"
  : > "$RESTORE_LOCK"
  local SNAPSHOT
  SNAPSHOT="$(mktemp "$STATE_DIR/.snapin.XXXXXX" 2>/dev/null)" \
    || { rm -f "$RESTORE_LOCK"; warn "no scratch space to restore from"; return 1; }
  cp -f "$src" "$SNAPSHOT"
  local lg lw first_wid='' dest_wid=''
  lg="$(jq -r '.last_group // ""' "$SNAPSHOT")"
  lw="$(jq -r '.last_window // ""' "$SNAPSHOT")"

  local g wi nw
  while read -r g; do
    [ -z "$g" ] && continue
    nw="$(jq -r --arg g "$g" '.groups[$g] | length' "$SNAPSHOT")"
    for ((wi=0; wi<nw; wi++)); do
      local wname wlayout np
      wname="$(jq -r   --arg g "$g" --argjson i "$wi" '.groups[$g][$i].name'          "$SNAPSHOT")"
      wlayout="$(jq -r --arg g "$g" --argjson i "$wi" '.groups[$g][$i].layout // ""'  "$SNAPSHOT")"
      np="$(jq -r      --arg g "$g" --argjson i "$wi" '.groups[$g][$i].panes | length' "$SNAPSHOT")"

      # already live? leave it
      kel_windows | awk -F'\t' -v s="$(sess "$g")" -v n="$wname" '$1==s&&$5==n{f=1}END{exit !f}' && continue

      local p0; p0="$(jq -r --arg g "$g" --argjson i "$wi" '.groups[$g][$i].panes[0].cwd // ""' "$SNAPSHOT")"
      [ -d "$p0" ] || p0="$HOME"
      local wid; wid="$(open_window "$wname" "$p0" "$g")"
      [ -n "$wid" ] || continue
      [ -z "$first_wid" ] && first_wid="$wid"

      local -a pids; pids=( "$(tmux list-panes -t "$wid" -F '#{pane_id}' | head -1)" )
      local pj pc
      for ((pj=1; pj<np; pj++)); do
        pc="$(jq -r --arg g "$g" --argjson i "$wi" --argjson j "$pj" '.groups[$g][$i].panes[$j].cwd // ""' "$SNAPSHOT")"
        [ -d "$pc" ] || pc="$HOME"
        pids+=( "$(tmux split-window -t "$wid" -c "$pc" -P -F '#{pane_id}')" )
      done
      [ -n "$wlayout" ] && tmux select-layout -t "$wid" "$wlayout" 2>/dev/null || true

      local meta; meta="$(meta_path "$g" "$wname")"
      if [ -f "$meta" ]; then
        jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.t" && mv "$meta.t" "$meta"
        if [ "$cont" = 1 ]; then
          tmux send-keys -t "${pids[0]}" \
            "$(agent_resume_cmd "$(jq -r '.agent // "claude"' "$meta")" "$(jq -r '.claude_session // ""' "$meta")")" Enter
        fi
      fi
      for ((pj=1; pj<np; pj++)); do
        pc="$(jq -r --arg g "$g" --argjson i "$wi" --argjson j "$pj" '.groups[$g][$i].panes[$j].cmd // ""' "$SNAPSHOT")"
        case " $KEL_RESTORE_CMDS " in *" $pc "*) tmux send-keys -t "${pids[$pj]}" "$pc" Enter ;; esac
      done

      [ "$g" = "$lg" ] && [ "$wname" = "$lw" ] && dest_wid="$wid"
    done
  done < <(jq -r '.groups | keys[]' "$SNAPSHOT")

  [ -n "$lg" ] && set_last_group "$lg"
  local dest="${dest_wid:-$first_wid}"
  [ -n "$dest" ] && goto_window "$dest" "$lg"

  rm -f "$SNAPSHOT" "$RESTORE_LOCK"
  snapshot                     # release the lock, then record what we rebuilt
  say "workspace restored from snapshot"
}

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
cmd_restore() {
  need tmux; need jq
  local continue_agent=0 use_snap=auto
  while [ $# -gt 0 ]; do
    case "$1" in
      --continue|-c)  continue_agent=1 ;;
      --snapshot|-s)  use_snap=yes ;;
      --no-snapshot)  use_snap=no ;;
      *) die "kel restore: unknown arg $1" ;;
    esac
    shift
  done

  if [ "$use_snap" = yes ] || { [ "$use_snap" = auto ] && [ -f "$SNAPSHOT" ] && [ -z "$(group_sessions)" ]; }; then
    restore_from_snapshot "$([ "$continue_agent" = 1 ] && printf -- -c)"
    return
  fi

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "nothing to restore"; return 0; }

  local n meta cwd agent cid grp wid restored=0 lastgrp=''
  while IFS=$'\t' read -r grp n meta; do
    [ -z "$n" ] && continue
    cwd="$(jq -r '.cwd // ""' "$meta")"
    agent="$(jq -r '.agent // "claude"' "$meta")"
    cid="$(jq -r '.claude_session // ""' "$meta")"
    [ -d "$cwd" ] || { warn "skip $n — its directory is gone ($cwd)"; continue; }
    wid="$(open_window "$n" "$cwd" "$grp")"
    [ -n "$wid" ] || { warn "skip $n — couldn't open a window"; continue; }
    jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
    [ "$continue_agent" = 1 ] && tmux send-keys -t "$wid" "$(agent_resume_cmd "$agent" "$cid")" Enter
    lastgrp="$grp"; restored=$((restored+1))
  done <<< "$names"

  [ "$continue_agent" = 1 ] && say "restored $restored agent(s) — resuming" \
                            || say "restored $restored agent(s) — not started"
  [ -n "$lastgrp" ] && { set_last_group "$lastgrp"; goto_window "$wid" "$lastgrp"; }
  snapshot
}

# --------------------------------------------------------------------------
# kel doctor
# --------------------------------------------------------------------------
cmd_doctor() {
  need jq
  probe() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf '  \033[1;32m✓\033[0m %s\n' "$label" >&2; printf 'true'
    else
      printf '  \033[1;31m✗\033[0m %s\n' "$label" >&2; printf 'false'
    fi
  }
  echo "kel doctor" >&2
  local r_tmux r_ver r_popup r_wt r_jq r_node r_claude r_hooks r_pass
  r_tmux=$(probe   "tmux present"                     command -v tmux)
  r_ver=$(probe    "tmux >= 3.0"                      bash -c 't=$(tmux -V | grep -oE "[0-9]+\.[0-9]+"); [ -n "$t" ] && [ "$(printf "3.0\n%s\n" "$t" | sort -V | head -1)" = "3.0" ]')
  r_popup=$(probe  "display-popup available"          bash -c 'tmux list-commands 2>/dev/null | grep -q display-popup')
  r_wt=$(probe     "git worktree available"           bash -c 'git worktree -h 2>&1 | grep -q "add"')
  r_jq=$(probe     "jq present"                       command -v jq)
  r_fzf=$(probe    "fzf present (kel board)"           command -v fzf)
  r_node=$(probe   "node on PATH"                     command -v node)
  r_claude=$(probe "claude on PATH"                   command -v claude)
  r_hooks=$(probe  "kel hooks wired in settings.json" bash -c 'jq -e "[.hooks[]?[]?.hooks[]?.command // empty] | any(test(\"kel hook|kel-hook\"))" "$HOME/.claude/settings.json" >/dev/null')
  r_pass=$(probe   "tmux allow-passthrough on"        bash -c 'tmux start-server \; show -gv allow-passthrough 2>/dev/null | grep -qx on')

  jq -n --arg d "$(date -u +%FT%TZ)" \
    --argjson tmux "$r_tmux" --argjson ver "$r_ver" --argjson popup "$r_popup" \
    --argjson wt "$r_wt" --argjson jq "$r_jq" --argjson fzf "$r_fzf" --argjson node "$r_node" \
    --argjson claude "$r_claude" --argjson hooks "$r_hooks" --argjson pass "$r_pass" \
    '{checked_at:$d, tmux:$tmux, "tmux>=3.0":$ver, display_popup:$popup,
      git_worktree:$wt, jq:$jq, fzf:$fzf, node:$node, claude:$claude,
      hooks_wired:$hooks, allow_passthrough:$pass}' \
    > "$DOCTOR_CACHE"
  printf '  cached -> %s\n' "${DOCTOR_CACHE/#$HOME/\~}" >&2
  case "$r_tmux$r_ver$r_jq" in *false*) exit 1 ;; esac
}

# --------------------------------------------------------------------------
# kel status-line   (tmux status-left)
# --------------------------------------------------------------------------
cmd_status_line() {
  [ -n "${TMUX:-}" ] || exit 0
  local grp="${1:-}"
  [ -z "$grp" ] && grp="$(current_group)"

  # not in a kel session: compact global summary
  if [ -z "$grp" ]; then
    local total=0 waiting=0 st
    while IFS=$'\t' read -r _ _ _ wid _; do
      [ -z "${wid:-}" ] && continue
      total=$((total+1)); [ "$(effective_state "$wid")" = waiting ] && waiting=$((waiting+1))
    done < <(kel_windows)
    [ "$total" -eq 0 ] && exit 0
    if [ "$waiting" -gt 0 ]; then
      printf '#[fg=colour245][kel]#[default] #[fg=colour214,bold]%d agent%s · %d waiting#[default] ' \
        "$total" "$([ "$total" -ne 1 ] && echo s)" "$waiting"
    else
      printf '#[fg=colour245][kel] %d agents#[default] ' "$total"
    fi
    exit 0
  fi

  local sname; sname="$(sess "$grp")"
  local cur; cur="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
  local panes; panes="$(tmux list-windows -a -F '#{window_id} #{window_panes}' 2>/dev/null || true)"
  local out='' suffix colour pc

  # this group's windows, in full
  while IFS=$'\t' read -r _ _ idx wid name; do
    [ -z "${wid:-}" ] && continue
    suffix=''; colour=''
    case "$(effective_state "$wid")" in
      waiting) suffix='?'; colour='#[fg=colour214,bold]' ;;
      working) suffix='*'; colour='#[fg=colour111]' ;;
      done)    suffix='!'; colour='#[fg=colour114]' ;;
      dead)    suffix='x'; colour='#[fg=colour167,bold]' ;;
    esac
    pc="$(printf '%s\n' "$panes" | awk -v w="$wid" '$1==w{print $2}')"
    [ "${pc:-1}" -gt 1 ] 2>/dev/null && name="${name}#[fg=colour240]·${pc}#[default]${colour}"
    if [ "$wid" = "$cur" ]; then
      out="$out ${colour}[${idx}:${name}${suffix}]#[default]"
    else
      out="$out ${colour}${idx}:${name}${suffix}#[default]"
    fi
  done < <(kel_windows | awk -F'\t' -v s="$sname" '$1==s' | sort -t$'\t' -k3,3n)

  # waiting agents in OTHER kel groups
  local other=0
  while IFS=$'\t' read -r osn _ _ wid _; do
    [ -z "${wid:-}" ] && continue
    [ "$osn" = "$sname" ] && continue
    [ "$(effective_state "$wid")" = waiting ] && other=$((other+1))
  done < <(kel_windows)
  [ "$other" -gt 0 ] && out="$out  #[fg=colour214]⟨+${other} waiting⟩#[default]"

  printf '%s ' "$out"
}

# --------------------------------------------------------------------------
# kel jump   (prefix `)   — global, cycles across all groups
# --------------------------------------------------------------------------
cmd_jump() {
  [ -n "${TMUX:-}" ] || exit 0
  local cs cw
  cs="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  cw="$(tmux display-message -p '#{window_index}' 2>/dev/null || echo '')"

  local -a w=()
  while IFS=$'\t' read -r sname _ idx wid _; do
    [ -z "${wid:-}" ] && continue
    [ "$(effective_state "$wid")" = waiting ] || continue
    w+=( "$sname"$'\t'"$idx" )
  done < <(kel_windows | sort -t$'\t' -k2,2 -k3,3n)

  local n="${#w[@]}"
  [ "$n" -eq 0 ] && { tmux display-message "kel: nothing waiting"; exit 0; }

  local i pos=-1 es ei
  for ((i=0; i<n; i++)); do
    es="${w[$i]%%$'\t'*}"; ei="${w[$i]##*$'\t'}"
    [ "$es" = "$cs" ] && [ "$ei" = "$cw" ] && { pos=$i; break; }
  done

  local tgt
  if [ "$pos" -ge 0 ]; then
    tgt="${w[$(( (pos + 1) % n ))]}"
  else
    tgt="${w[0]}"
    for ((i=0; i<n; i++)); do
      es="${w[$i]%%$'\t'*}"; ei="${w[$i]##*$'\t'}"
      if [ "$es" \> "$cs" ] || { [ "$es" = "$cs" ] && [ -n "$cw" ] && [ "$ei" -gt "$cw" ]; }; then
        tgt="${w[$i]}"; break
      fi
    done
  fi
  local ts="${tgt%%$'\t'*}" ti="${tgt##*$'\t'}"
  tmux switch-client -t "=$ts" \; select-window -t "$ti"
}

# --------------------------------------------------------------------------
# kel cheat
# --------------------------------------------------------------------------
cmd_cheat() {
cat <<'EOF'

  kel keys              prefix = Ctrl+b   (press, release, then the key)
  ─────────────────────────────────────────────────────────────────────────

  THE MODEL
    window  = a tab, ONE per agent — shows on the bar as  1:name
    pane    = a split INSIDE one window (agent | editor) — not on the bar
    group   = one tmux session per repo — kel/<repo>
    copy text: hold SHIFT while you drag (mouse mode owns a plain drag)

  MOVE AROUND
    Ctrl+Space    the board — find any agent; enter jumps, TAB = act on it
    (prefix b)    the same board
    prefix `      jump to the next agent WAITING on you — any group
    prefix 1-9    window (agent) N in this group
    prefix n / p  next / previous window        prefix w   pick a window
    prefix g      pick a group                  prefix ( ) prev / next group

  ACT ON AN AGENT
    prefix m      manage THIS agent — rename / move / kill / new sibling
    (in the board) TAB on any row — the same menu, for that agent

  SCROLL an agent's conversation
    mouse wheel                (kel turns this into PageUp/PageDown for you)
    PgUp / PgDn                Claude Code's own scrollback
    prefix [                   tmux scroll mode for a plain shell pane
                               (↑↓ PgUp PgDn, / search, q leave)

  WINDOWS (agents)                 PANES (splits)
    prefix c   blank window          prefix | / -   split right / down
    prefix ,   rename (kel rename)   prefix ↑↓←→    focus a pane (or click it)
    prefix &   close (confirms)      prefix z       zoom a pane (toggle)
                                     prefix x       close a pane
    prefix k   "new to kel/tmux?" menu — the common moves, spelled out

  GROUP
    prefix d   detach — "exit kel". Agents keep running; snapshot is saved;
               `kel` brings you back to your last group.
    (killing a group, not detaching, ENDS its agents — but after a reboot
     `kel` offers to rebuild everything from the snapshot)

  ONE flat workspace instead of a group per repo?
    export KEL_GROUP=work   in ~/.bashrc  —  every `kel new` lands in kel/work,
    so `prefix 1-9` reaches every agent.  `kel new x --group foo` still splits.

  FROM A SHELL
    kel                in a repo: go to (or start) that repo's agent, like
                       `claude` for a dir. Elsewhere: your last group.
    kel new <name>     new window + agent   (-w = worktree, --group G)
    kel ls             list every agent, grouped
    kel board          fzf browser: filter, preview; enter jumps, tab acts
    kel go [group]     switch group
    kel move [group]   put THIS window in another group (cd first, then kel move)
    kel rename <new>   rename this window, keep metadata in sync
    kel kill <name>    close one      ·   kel prune  discard dead records
    kel restore [-c]   rebuild after a kill / reboot  (-c resumes conversations)

  STATUS BAR
    1:name*  working   1:name?  waiting-on-you   1:name!  done   1:name  idle
    1:namex  the agent process died (no clean exit) — kel kill or restart it
    [1:name] current window   1:name·3 = 3 panes   ⟨+N waiting⟩ in other groups

  prefix ?   tmux's full key list      prefix k   the beginner menu

EOF
}

# --------------------------------------------------------------------------
# kel hook <EVENT>
# --------------------------------------------------------------------------
cmd_hook() {
  local event="${1:-}"
  command -v tmux >/dev/null 2>&1 || exit 0
  local payload sid cwd
  payload="$(cat 2>/dev/null || true)"
  [ -z "$event" ] && event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
  cwd="$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null || true)"

  local pane="${TMUX_PANE:-}"
  if [ -z "$pane" ] && [ -n "$sid" ] && [ -f "$STASH_DIR/$sid" ]; then
    pane="$(cat "$STASH_DIR/$sid" 2>/dev/null || true)"
  fi
  if [ -z "$pane" ] && [ -n "$cwd" ]; then
    local match
    match="$(tmux list-panes -a -F '#{pane_id} #{pane_current_path}' 2>/dev/null | awk -v c="$cwd" '$2==c{print $1}')"
    [ "$(printf '%s\n' "$match" | grep -c .)" = 1 ] && pane="$match"
  fi
  if [ "$event" = "SessionStart" ] && [ -n "$pane" ] && [ -n "$sid" ]; then
    printf '%s' "$pane" > "$STASH_DIR/$sid"
  fi
  [ -z "$pane" ] && exit 0

  local wid; wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  [ -z "$wid" ] && exit 0

  if [ -n "$sid" ] && [ "$event" != SessionEnd ]; then
    local m
    for m in "$SESSIONS_DIR"/*/*.json; do
      [ -e "$m" ] || continue
      [ "$(jq -r '.window_id' "$m" 2>/dev/null)" = "$wid" ] || continue
      [ "$(jq -r '.claude_session // ""' "$m" 2>/dev/null)" = "$sid" ] && break
      jq --arg s "$sid" '.claude_session=$s' "$m" > "$m.t" 2>/dev/null && mv "$m.t" "$m"
      break
    done
  fi

  local state
  case "$event" in
    SessionStart)     state=idle ;;
    UserPromptSubmit) state=working ;;
    Notification)     state=waiting ;;
    Stop)             state=done ;;
    SessionEnd)
      rm -f "$STATE_DIR/$wid.state"
      [ -n "$sid" ] && rm -f "$STASH_DIR/$sid"
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    *) exit 0 ;;
  esac
  local tmp
  tmp="$(mktemp "$STATE_DIR/.${wid#@}.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s %s\n' "$state" "$(date +%s)" > "$tmp"
  mv -f "$tmp" "$STATE_DIR/$wid.state"
  tmux refresh-client -S 2>/dev/null || true
}

# --------------------------------------------------------------------------
# kel  (no args)  — enter the workspace
# --------------------------------------------------------------------------
quickstart() {
  cat <<'EOF'

  kel new <name>     start an agent in the current repo
  prefix `           jump to whichever agent is waiting on you
  Ctrl+Space         the board — find any agent (enter jumps, tab acts)
  prefix m           manage the agent you're on — rename / move / kill
  prefix k           new to tmux? the "what can I do here" menu

EOF
}

cmd_attach() {
  need tmux
  prune_state
  if in_tmux; then
    [ -z "$(kel_windows)" ] && { echo "no agents yet."; quickstart; return 0; }
    cmd_ls; return
  fi

  local groups; groups="$(group_sessions)"

  # dir target, the way `claude` keys off the current directory:
  # KEL_GROUP, else the repo we're standing in.
  local want=''
  if [ -n "${KEL_GROUP:-}" ]; then want="$KEL_GROUP"
  elif git_root >/dev/null 2>&1; then want="$(basename "$(git_root)")"
  fi
  slug_ok "$want" || want=''

  # 1. dir-aware attach — this repo's group is already live
  if [ -n "$want" ] && printf '%s\n' "$groups" | grep -qxF "$want"; then
    set_last_group "$want"
    exec tmux attach -t "=$(sess "$want")"
  fi

  # 2. live workspace, not in a repo — attach the last group you used
  if [ -n "$groups" ] && [ -z "$want" ]; then
    local last target; last="$(get_last_group)"
    if [ -n "$last" ] && printf '%s\n' "$groups" | grep -qxF "$last"; then
      target="$last"
    else
      target="$(printf '%s\n' "$groups" | head -1)"
    fi
    exec tmux attach -t "=$(sess "$target")"
  fi

  # 3. live workspace, in a repo with no group of its own yet — start its agent
  if [ -n "$groups" ] && [ -n "$want" ]; then
    say "no agent for '$want' yet — starting one"
    exec "$SELF" new "$want"
  fi

  # --- no live groups below this point ---

  # 4. server down but the workspace was snapshotted — offer to rebuild it
  if [ -f "$SNAPSHOT" ]; then
    local ng na
    ng="$(jq -r '.groups | length' "$SNAPSHOT" 2>/dev/null || echo '?')"
    na="$(jq -r '[.groups[][].name] | length' "$SNAPSHOT" 2>/dev/null || echo '?')"
    if [ -t 0 ] && [ -t 1 ]; then
      printf '\033[1;33mkel\033[0m rebuild your workspace? %s group(s), %s window(s)  [Y/n] ' "$ng" "$na"
      local ans=''; read -r ans || ans=n
      case "$ans" in
        n|N|no) say "ok — starting fresh here; 'kel restore' brings the old one back" ;;
        *)      restore_from_snapshot -c; return ;;
      esac
      # declined — fall through to a fresh start instead of dead-ending
    else
      say "workspace snapshot found ($ng groups, $na windows) — 'kel restore' to rebuild"
      return
    fi
  elif [ -n "$(dead_sessions)" ]; then
    warn "no live workspace, but these agents can be rebuilt:"
    cmd_ls
    echo "  kel restore [-c]  rebuild them   ·   kel prune  discard them"
    return
  fi

  # 5. fresh start — dir-aware if we're in a repo
  if [ -n "$want" ]; then
    say "starting an agent for '$want'"
    exec "$SELF" new "$want"
  fi
  say "welcome to kel."
  quickstart
  exec tmux new-session -s "$(sess misc)" -c "$HOME"
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

# --------------------------------------------------------------------------
main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    hook)         cmd_hook "$@" ;;                 # hot path — skip migrate
    new)          migrate_meta; cmd_new "$@" ;;
    kill)         migrate_meta; cmd_kill "$@" ;;
    ls|list)      migrate_meta; cmd_ls "$@" ;;
    go)           migrate_meta; cmd_go "$@" ;;
    move)         migrate_meta; cmd_move "$@" ;;
    rename)       migrate_meta; cmd_rename "$@" ;;
    board|menu)   migrate_meta; cmd_board ;;   # menu = deprecated alias
    _board_rows)     cmd_board_rows ;;
    _board_preview)  cmd_board_preview "$@" ;;
    _board_jump)     cmd_board_jump "$@" ;;
    _board_kill)     cmd_board_kill "$@" ;;
    _board_actions)  cmd_board_actions "$@" ;;
    _board_rename)   migrate_meta; cmd_board_rename "$@" ;;
    restore)      migrate_meta; cmd_restore "$@" ;;
    prune)        migrate_meta; cmd_prune "$@" ;;
    snapshot)     cmd_snapshot ;;
    doctor)       cmd_doctor "$@" ;;
    status-line)  cmd_status_line "$@" ;;
    jump)         cmd_jump ;;
    cheat)        cmd_cheat ;;
    ''|attach)    migrate_meta; cmd_attach ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd  (try: kel --help)" ;;
  esac
}
main "$@"
