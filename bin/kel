#!/usr/bin/env bash
# kel — a terminal workspace for running several coding agents at once.
# tmux does the multiplexing; kel does the bookkeeping.
#
#   kel                        enter the workspace — in a repo, go to (or start)
#                              that repo's agent, like `claude` for a directory
#   kel new <name> [-w]        window + agent, inplace or in a git worktree
#         [--group G] [--agent CMD] [--no-agent]
#   kel kill <name> [-f]       close the window; remove the worktree; -f overrides
#                              the uncommitted / unpushed check
#   kel ls [--json]            list agents, grouped by repo
#   kel go [<group>]           switch to a group (no arg: list groups)
#   kel move [<group>]         put the current window in another group
#                              (no arg: the group for the current directory)
#   kel rename <newname>       rename the current window (keeps metadata in sync)
#   kel board                  fzf fleet browser — filter / preview / act
#                              (Ctrl+Space or prefix b; enter jumps, tab = actions)
#   kel restore [-c] [-s]      rebuild the workspace after a kill / reboot
#                              (-c resume conversations, -s force the snapshot)
#   kel restart [name] [-f]    relaunch a crashed agent in its existing window
#   kel top                    the fleet dashboard (prefix t)
#   kel sweep [-n] [-f]        close out every finished agent that has landed
#   kel prune [-f]             discard dead agent records
#   kel doctor                 capability probe, cached
#
# internal (wired by install.sh):
#   kel status-line [group]    render tmux status-left
#   kel jump                   jump to the next waiting agent, any group (prefix `)
#   kel snapshot               save the workspace shape (hooks call this)
#   kel cheat                  keybinding reference
#   kel hook <EVENT>           Claude Code state hook
#   kel statusline             Claude Code statusLine — context % / cost
set -uo pipefail

KEL_PREFIX="${KEL_SESSION:-kel}"          # tmux sessions are  <prefix>/<group>
KEL_AGENT="${KEL_AGENT:-claude}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
SESSIONS_DIR="$STATE_DIR/sessions"
STASH_DIR="$STATE_DIR/.stash"
DOCTOR_CACHE="$STATE_DIR/doctor.json"
LAST_GROUP_FILE="$STATE_DIR/last-group"
SNAPSHOT="$STATE_DIR/snapshot.json"
RESTORE_LOCK="$STATE_DIR/.restoring"
KEL_FLEET_BIN="${KEL_FLEET_BIN:-$HOME/.local/bin/kel-fleet}"   # the Go seam (v0.6)
KEL_TOP_BIN="${KEL_TOP_BIN:-$HOME/.local/bin/kel-top}"
SNAPSHOT_DECLINED="$STATE_DIR/snapshot-declined"   # a snapshot you said no to
STATUSLINE_PREV="$HOME/.claude/statusline-prev"   # a statusLine kel displaced
KEL_CTX_WARN="${KEL_CTX_WARN:-70}"                # show context on the bar from here up
KEL_NOTIFY="${KEL_NOTIFY:-waiting}"               # states worth interrupting you for
# The running script's own absolute path, preferred over a PATH lookup: kel
# re-invokes itself (sweep, the board menus, tmux bindings) and resolving that
# through PATH breaks whenever kel is not installed — a fresh clone, or CI.
# That failed silently, because the re-invocation just did nothing.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")"
[ -x "$SELF" ] || SELF="$(command -v kel 2>/dev/null || printf '%s' "$HOME/.local/bin/kel")"
# commands worth re-running per pane on restore (agents handled separately)
KEL_RESTORE_CMDS="${KEL_RESTORE_CMDS:-nvim vim hx nano lazygit lazydocker htop btop k9s}"

# guarded: an unconditional mkdir -p of three existing dirs measured ~10ms,
# and every kel invocation — including each status-bar redraw — paid it
[ -d "$SESSIONS_DIR" ] && [ -d "$STASH_DIR" ] || mkdir -p "$STATE_DIR" "$SESSIONS_DIR" "$STASH_DIR"

humanize_secs() {   # 45 -> 45s   400 -> 6m   3900 -> 1h05m
  local s="${1:-0}"
  case "$s" in ''|*[!0-9]*) s=0 ;; esac
  if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%dm' $(( s / 60 ))
  else                         printf '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 )); fi
}

say()  { printf '\033[1;32mkel\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mkel\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mkel\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --------------------------------------------------------------------------
# groups & sessions
# --------------------------------------------------------------------------
# tmux session name for a group.  The bare prefix is the pre-v0.2 flat session.
sess() { case "$1" in "$KEL_PREFIX") printf '%s' "$KEL_PREFIX";; *) printf '%s/%s' "$KEL_PREFIX" "$1";; esac; }

slug_ok() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
git_root() { git rev-parse --show-toplevel 2>/dev/null; }
in_tmux()  { [ -n "${TMUX:-}" ]; }
has_remote() { [ -n "$(git -C "$1" remote 2>/dev/null)" ]; }

# derive the group for a new agent:
#   --group flag  >  $KEL_GROUP (force everything into one group)  >  repo basename  >  misc
# --group flag > $KEL_GROUP > .kel/group > repo basename > misc
group_for_cwd() {
  [ -n "${KEL_GROUP:-}" ] && { printf '%s' "$KEL_GROUP"; return; }
  local g; g="$(dir_group "$PWD")"
  [ -n "$g" ] && { printf '%s' "$g"; return; }
  local gr; gr="$(git_root 2>/dev/null || true)"
  if [ -n "$gr" ]; then basename "$gr"; else printf 'misc'; fi
}

# A `.kel/group` file pins a directory (and everything under it) to a group,
# for a monorepo that does not split cleanly on git root.  Searched upward from
# $1, stopping at the repo root so it cannot escape into a parent project.
dir_group() {   # dir -> group name, or empty
  local d="$1" root g
  root="$(cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
  while [ -n "$d" ] && [ "$d" != / ]; do
    if [ -f "$d/.kel/group" ]; then
      read -r g < "$d/.kel/group" 2>/dev/null || g=''
      g="${g%$'\r'}"                      # tolerate a CRLF checkout
      g="${g#"${g%%[![:space:]]*}"}"      # trim, but do NOT truncate: a file
      g="${g%"${g##*[![:space:]]}"}"      # saying "not a slug" is an error,
      if slug_ok "$g"; then                # not a request for the group "not"
        printf '%s' "$g"; return 0
      fi
      warn ".kel/group in $d is not a slug ('$g') — ignoring it"
      return 0
    fi
    [ "$d" = "$root" ] && break
    d="$(dirname "$d")"
  done
}

# all kel group names that have a live tmux session
group_sessions() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null | awk -v p="$KEL_PREFIX" '
    $0==p            { print p; next }
    index($0,p"/")==1 { print substr($0, length(p)+2) }'
}

# every window in every kel session:  session<TAB>group<TAB>index<TAB>wid<TAB>name
kel_windows() {
  tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}' 2>/dev/null \
  | awk -F'\t' -v p="$KEL_PREFIX" '
      $1==p || index($1,p"/")==1 {
        g = ($1==p) ? p : substr($1, length(p)+2)
        print $1"\t"g"\t"$2"\t"$3"\t"$4
      }'
}

# the group the attached client is looking at, or empty if not in a kel session
current_group() {
  local s; s="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  case "$s" in
    "$KEL_PREFIX")   printf '%s' "$KEL_PREFIX" ;;
    "$KEL_PREFIX"/*) printf '%s' "${s#"$KEL_PREFIX"/}" ;;
  esac
}

set_last_group() { printf '%s' "$1" > "$LAST_GROUP_FILE" 2>/dev/null || true; }
get_last_group() { cat "$LAST_GROUP_FILE" 2>/dev/null || true; }

state_note() { # wid -> the notification text the hook recorded, if any
  [ -f "$STATE_DIR/$1.state" ] || return 0
  local st ep rest
  read -r st ep rest < "$STATE_DIR/$1.state" 2>/dev/null || return 0
  printf '%s' "${rest:-}"
}

state_of() { # wid -> raw state from the hook, or empty
  [ -f "$STATE_DIR/$1.state" ] || return 0
  local s; read -r s _ < "$STATE_DIR/$1.state" || return 0
  printf '%s' "$s"
}

# effective_state: raw hook state, but "dead" if the agent process is gone
# (a crash/OOM fires no Stop/SessionEnd hook — the window just drops to a shell)
effective_state() { # wid
  local s; s="$(state_of "$1")"
  case "$s" in
    working|waiting|throttled)
      tmux list-panes -t "$1" -F '#{pane_current_command}' 2>/dev/null \
        | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' || { printf 'dead'; return; } ;;
  esac
  printf '%s' "$s"
}

# put kel's group-scoped status-left on a group session
# (set-option does NOT accept the "=" exact-match prefix; the full name is exact)
group_session_status() { # group session
  tmux set-option -t "$2" status-left-length 200 2>/dev/null || true
  tmux set-option -t "$2" status-left \
    "#[fg=colour245][$1]#[default] #($SELF status-line $1)" 2>/dev/null || true
}

# create the window in its group's session (making the session if needed); prints wid
open_window() { # name cwd group
  local name="$1" cwd="$2" group="$3" s; s="$(sess "$group")"
  if tmux has-session -t "=$s" 2>/dev/null; then
    tmux new-window -t "=$s" -n "$name" -c "$cwd" -P -F '#{window_id}'
  else
    local wid
    wid="$(tmux new-session -d -s "$s" -n "$name" -c "$cwd" -x 220 -y 50 -P -F '#{window_id}')"
    group_session_status "$group" "$s"
    printf '%s' "$wid"
  fi
}

# move the caller to a window, switching to its group session
goto_window() { # wid [group]
  local wid="$1" group="${2:-}" s=''
  [ -n "$group" ] && s="$(sess "$group")"
  if in_tmux; then
    [ -n "$s" ] && tmux switch-client -t "=$s" 2>/dev/null || true
    tmux select-window -t "$wid" 2>/dev/null || true
  elif [ -t 1 ]; then
    if [ -n "$s" ]; then tmux attach -t "=$s" \; select-window -t "$wid"
    else tmux attach \; select-window -t "$wid"; fi
  fi
  return 0
}

# --------------------------------------------------------------------------
# metadata
# --------------------------------------------------------------------------
# Records live at $SESSIONS_DIR/<group>/<name>.json — keyed by group *and*
# name, so two repos can each have an agent called "docs".
meta_path() { printf '%s/%s/%s.json' "$SESSIONS_DIR" "$1" "$2"; }   # group name

# every record on disk, as  group<TAB>name<TAB>path
all_metas() {
  local d g f nm
  for d in "$SESSIONS_DIR"/*/; do
    [ -d "$d" ] || continue
    g="$(basename "$d")"
    for f in "$d"*.json; do
      [ -e "$f" ] || continue
      nm="$(basename "$f" .json)"
      printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
    done
  done
}

# the record owning a tmux window id, as  group<TAB>name<TAB>path
meta_by_wid() { # wid
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    [ "$(jq -r '.window_id // ""' "$f" 2>/dev/null)" = "$1" ] || continue
    printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0
  done < <(all_metas)
  return 1
}

# resolve a user-typed agent to  group<TAB>name<TAB>path.
# accepts "name" or "group/name".  A bare name prefers the group you are
# standing in, then a unique match anywhere; exit 2 (candidates on stderr) when
# the same name exists in several groups.
resolve_agent() { # name [preferred-group]
  local want="$1" pref="${2:-}" g nm f hits
  case "$want" in
    */*) g="${want%%/*}"; nm="${want##*/}"; f="$(meta_path "$g" "$nm")"
         [ -f "$f" ] || return 1
         printf '%s\t%s\t%s\n' "$g" "$nm" "$f"; return 0 ;;
  esac
  [ -z "$pref" ] && pref="$(current_group)"
  if [ -n "$pref" ] && [ -f "$(meta_path "$pref" "$want")" ]; then
    printf '%s\t%s\t%s\n' "$pref" "$want" "$(meta_path "$pref" "$want")"; return 0
  fi
  hits="$(all_metas | awk -F'\t' -v n="$want" '$2==n')"
  case "$(printf '%s' "$hits" | grep -c .)" in
    0) return 1 ;;
    1) printf '%s\n' "$hits"; return 0 ;;
    *) printf '%s' "$hits" | awk -F'\t' '{printf "  %s/%s\n", $1, $2}' >&2; return 2 ;;
  esac
}

meta_write() { # name wid repo cwd isolation branch agent group
  mkdir -p "$SESSIONS_DIR/$8"
  jq -n \
    --arg name "$1" --arg wid "$2" --arg repo "$3" --arg cwd "$4" \
    --arg iso "$5" --arg branch "$6" --arg agent "$7" --arg group "$8" \
    --arg created "$(date -u +%FT%TZ)" \
    '{name:$name, window_id:$wid, repo:$repo, cwd:$cwd, isolation:$iso,
      branch:(if $branch=="" then null else $branch end),
      agent:$agent, group:$group, created_at:$created}' \
    > "$(meta_path "$8" "$1")"
}

# pre-v0.2 records have no .group (derive it from .repo); pre-v0.4.1 records
# sit flat in sessions/ (file them under sessions/<group>/).
migrate_meta() {
  local f nm repo grp dest
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    nm="$(basename "$f" .json)"
    grp="$(jq -r '.group // ""' "$f" 2>/dev/null)"
    if [ -z "$grp" ] || [ "$grp" = null ]; then
      repo="$(jq -r '.repo // ""' "$f" 2>/dev/null)"
      if [ -n "$repo" ]; then grp="$(basename "$repo")"; else grp="misc"; fi
      jq --arg g "$grp" '.group = $g' "$f" > "$f.m" 2>/dev/null && mv "$f.m" "$f"
    fi
    slug_ok "$grp" || grp=misc
    mkdir -p "$SESSIONS_DIR/$grp"
    dest="$(meta_path "$grp" "$nm")"
    if [ -e "$dest" ]; then
      warn "two records for '$grp/$nm' — keeping the newer"
      if [ "$f" -nt "$dest" ]; then mv -f "$f" "$dest"; else rm -f "$f"; fi
    else
      mv -f "$f" "$dest"
    fi
  done
}

# is a metadata record backed by a live window (same id + name) in any kel session?
meta_is_live() { # path name
  local wid; [ -f "$1" ] || return 1
  wid="$(jq -r '.window_id' "$1")"
  kel_windows | awk -F'\t' -v w="$wid" -v n="$2" '$4==w && $5==n {found=1} END{exit !found}'
}

# records with no live window, as  group<TAB>name<TAB>path
dead_sessions() {
  local g nm f
  while IFS=$'\t' read -r g nm f; do
    meta_is_live "$f" "$nm" || printf '%s\t%s\t%s\n' "$g" "$nm" "$f"
  done < <(all_metas)
}

prune_state() {
  local live f wid
  live="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null || true)"
  [ -n "$live" ] || return 0
  for f in "$STATE_DIR"/*.state "$STATE_DIR"/*.ctx; do
    [ -e "$f" ] || continue
    wid="${f##*/}"; wid="${wid%.state}"; wid="${wid%.ctx}"
    printf '%s\n' "$live" | grep -qxF "$wid" || rm -f "$f"
  done
}

# 0 (true) if the worktree has uncommitted changes or commits on no remote
worktree_unsafe() { # cwd
  [ -d "$1" ] || return 1
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null || true)" ] && return 0
  if has_remote "$1"; then
    [ -n "$(git -C "$1" log --oneline HEAD --not --remotes 2>/dev/null || true)" ] && return 0
  fi
  return 1
}

# --------------------------------------------------------------------------
# kel new
# --------------------------------------------------------------------------
cmd_new() {
  need tmux; need jq
  local name='' worktree=0 agent="$KEL_AGENT" start_agent=1 group_override=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -w|--worktree) worktree=1 ;;
      --group)       shift; group_override="${1:-}"; [ -n "$group_override" ] || die "--group needs a name" ;;
      --agent)       shift; agent="${1:-}"; [ -n "$agent" ] || die "--agent needs a command" ;;
      --no-agent)    start_agent=0 ;;
      -*)            die "kel new: unknown flag $1" ;;
      *)             [ -z "$name" ] || die "kel new: unexpected argument '$1'"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel new <name> [-w] [--group G] [--agent CMD] [--no-agent]"
  slug_ok "$name" || die "name must be a slug (A-Z a-z 0-9 . _ -)"

  local repo cwd branch='' isolation='inplace' group
  repo="$(git_root || true)"
  group="${group_override:-$(group_for_cwd)}"
  slug_ok "$group" || die "group '$group' is not a slug — pass --group"

  # names only have to be unique within their group
  if [ -f "$(meta_path "$group" "$name")" ]; then
    if meta_is_live "$(meta_path "$group" "$name")" "$name"; then
      die "agent '$group/$name' already exists (kel kill $group/$name first)"
    fi
    warn "reclaiming the record for '$group/$name' (its window is gone)"
    rm -f "$(meta_path "$group" "$name")"
  fi
  [ -z "$group_override" ] && [ -z "${KEL_GROUP:-}" ] && [ -z "$repo" ] && \
    warn "no git repo here → group 'misc'  (use --group NAME to name it)"

  if [ "$worktree" = 1 ]; then
    [ -n "$repo" ] || die "--worktree must be run inside a git repo"
    branch="$name"
    isolation='worktree'
    local wt_root="${KEL_WORKTREES:-$(dirname "$repo")/.kel-worktrees}"
    mkdir -p "$wt_root"
    cwd="$wt_root/$(basename "$repo")-$name"
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $cwd"; then
      say "reusing existing worktree  $cwd"
    elif [ -e "$cwd" ]; then
      die "path exists but isn't a registered worktree: $cwd"
    else
      say "creating worktree  $cwd  (branch $branch)"
      git -C "$repo" worktree add -b "$branch" "$cwd" >/dev/null \
        || git -C "$repo" worktree add "$cwd" "$branch" >/dev/null \
        || die "git worktree add failed"
      if [ -x "$repo/.kel/setup" ]; then
        say "running .kel/setup"
        if ! ( cd "$cwd" && KEL_REPO="$repo" KEL_WORKTREE="$cwd" "$repo/.kel/setup" ); then
          warn ".kel/setup exited non-zero — the worktree may be incomplete"
        fi
      fi
    fi
  else
    cwd="${repo:-$PWD}"
  fi

  local wid
  wid="$(open_window "$name" "$cwd" "$group")"
  [ -n "$wid" ] || die "failed to create tmux window"

  meta_write "$name" "$wid" "$repo" "$cwd" "$isolation" "$branch" "$agent" "$group"
  set_last_group "$group"
  [ "$start_agent" = 1 ] && tmux send-keys -t "$wid" "$agent" Enter

  say "new agent  $name  [$group]  ($isolation${branch:+, branch $branch})"
  goto_window "$wid" "$group"
  snapshot
}

# --------------------------------------------------------------------------
# kel kill
# --------------------------------------------------------------------------
cmd_kill() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel kill: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "usage: kel kill <name> [--force]"
  local orig_name="$name"

  local meta='' wid iso='inplace' cwd='' branch='' repo='' group=''
  local bare="${orig_name##*/}" rr rc=0
  rr="$(resolve_agent "$name")" || rc=$?
  [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel kill <group>/<name>"
  if [ -n "$rr" ]; then
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    # no record under that name — the window may have been renamed since
    # `kel new`.  Find the record owning the window currently named $bare.
    local bw; bw="$(kel_windows | awk -F'\t' -v n="$bare" '$5==n {print $4; exit}')"
    if [ -n "$bw" ]; then
      rr="$(meta_by_wid "$bw" || true)"
      [ -n "$rr" ] && IFS=$'\t' read -r group name meta <<< "$rr"
    fi
  fi
  if [ -n "$meta" ] && [ -f "$meta" ]; then
    wid="$(jq -r '.window_id' "$meta")"
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    branch="$(jq -r '.branch // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    name="$(jq -r '.name // empty' "$meta")"; name="${name:-$orig_name}"
  else
    wid="$(kel_windows | awk -F'\t' -v n="$bare" '$5==n {print $4; exit}')"
    [ -n "$wid" ] || die "no agent '$orig_name'"
    name="$bare"
    warn "'$name' is an unmanaged window — closing it, no metadata to clean up"
  fi

  if [ "$iso" = "worktree" ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
    warn "refusing to kill '$name' — the worktree has work that isn't safe to lose:"
    local d; d="$(git -C "$cwd" status --short 2>/dev/null || true)"
    [ -n "$d" ] && { echo "  uncommitted changes:" >&2; echo "$d" | sed 's/^/    /' >&2; }
    local u; has_remote "$cwd" && u="$(git -C "$cwd" log --oneline HEAD --not --remotes 2>/dev/null || true)"
    [ -n "${u:-}" ] && { echo "  commits not on any remote:" >&2; echo "$u" | sed 's/^/    /' >&2; }
    die "commit & push, or run: kel kill $name --force"
  fi

  [ -n "$wid" ] && tmux kill-window -t "$wid" 2>/dev/null || true

  if [ "$iso" = "worktree" ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
    if git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null; then
      say "removed worktree $cwd  (branch $branch kept)"
    else
      warn "couldn't remove worktree — do it manually: git -C $repo worktree remove ${force:+--force} $cwd"
    fi
  fi

  rm -f "$meta" "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
  say "killed $name"
  snapshot
}

# --------------------------------------------------------------------------
# kel rename <newname>  — rename the current window and keep metadata in sync
# --------------------------------------------------------------------------
# rename a specific window by id + move its metadata record along with it
rename_agent() { # wid new
  local wid="$1" new="$2" old grp='' sn
  old="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null)"
  [ -n "$old" ] || { warn "kel rename: window $wid is gone"; return 1; }
  [ "$old" = "$new" ] && return 0
  sn="$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null || true)"
  case "$sn" in
    "$KEL_PREFIX")   grp="$KEL_PREFIX" ;;
    "$KEL_PREFIX"/*) grp="${sn#"$KEL_PREFIX"/}" ;;
  esac
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$new")" ] && \
    { warn "an agent named '$new' already exists in [$grp]"; return 1; }

  tmux rename-window -t "$wid" "$new"

  # move the metadata record if this is a managed agent (by name, or by window id)
  local om='' rr
  [ -n "$grp" ] && [ -f "$(meta_path "$grp" "$old")" ] && om="$(meta_path "$grp" "$old")"
  if [ -z "$om" ]; then
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] && { grp="${rr%%$'\t'*}"; om="${rr##*$'\t'}"; }
  fi
  if [ -n "$om" ] && [ -f "$om" ]; then
    mkdir -p "$SESSIONS_DIR/$grp"
    jq --arg n "$new" '.name=$n' "$om" > "$(meta_path "$grp" "$new")" && rm -f "$om"
  fi
  say "renamed '$old' -> '$new'"
  snapshot
}

cmd_rename() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel rename: run this from inside kel"
  local new="${1:-}"
  [ -n "$new" ] || die "usage: kel rename <newname>"
  slug_ok "$new" || die "name must be a slug (A-Z a-z 0-9 . _ -)"
  rename_agent "$(tmux display-message -p '#{window_id}')" "$new"
}

# --------------------------------------------------------------------------
# kel prune
# --------------------------------------------------------------------------
cmd_prune() {
  need tmux; need jq
  local force=0
  case "${1:-}" in -f|--force) force=1 ;; '') ;; *) die "kel prune: unknown arg $1" ;; esac

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "no dead agents"; return 0; }

  local g n meta iso cwd repo removed=0 kept=0
  while IFS=$'\t' read -r g n meta; do
    [ -z "$n" ] && continue
    iso="$(jq -r '.isolation' "$meta")"
    cwd="$(jq -r '.cwd // ""' "$meta")"
    repo="$(jq -r '.repo // ""' "$meta")"
    if [ "$iso" = worktree ] && [ "$force" != 1 ] && worktree_unsafe "$cwd"; then
      warn "kept '$g/$n' — worktree has unsaved work  (kel kill $g/$n -f)"
      kept=$((kept + 1)); continue
    fi
    if [ "$iso" = worktree ] && [ -n "$repo" ] && [ -d "$cwd" ]; then
      git -C "$repo" worktree remove ${force:+--force} "$cwd" 2>/dev/null \
        || warn "left worktree $cwd (remove by hand)"
    fi
    rm -f "$meta"
    removed=$((removed + 1))
  done <<< "$names"

  say "pruned $removed dead agent(s)$([ "$kept" -gt 0 ] && printf ', kept %s' "$kept")"
}

# --------------------------------------------------------------------------
# kel ls
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# land state  —  "what would it take to land this branch?"  (#6)
# --------------------------------------------------------------------------
# One column, one verb per row.  ready/not-ready would collapse five different
# situations that each imply a different next action; naming the action is the
# whole point of a fleet glance.  It stops at *which* action — never what
# changed.  The moment you want the diff, that is lazygit (backlog R5).
#
# Precedence, most-blocking first:
#   dirty N    uncommitted work                 -> commit it
#   unpushed N commits only you have            -> push
#   merged     its PR landed                    -> sweepable
#   review     PR open                          -> wait, or nudge
#   behind N   base moved under you             -> rebase
#   no_pr      pushed, no PR                    -> open one
#   clean      nothing to say
#   unknown    gh could not answer the PR half
#
# The first two and `behind` are pure local git: no network, no token. Only the
# PR states need gh, so an expired token costs you those three and leaves the
# rest honest — the column degrades, it does not go dark.
base_ref() {   # repo-dir -> the branch this one is trying to land on
  local d="$1" b
  b="$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" && { printf '%s' "$b"; return; }
  for b in origin/main origin/master main master; do
    git -C "$d" rev-parse --verify --quiet "$b" >/dev/null 2>&1 && { printf '%s' "$b"; return; }
  done
}

land_of() {   # cwd [branch] [--pr]  ->  code	n
  local d="$1" br="${2:-}" want_pr="${3:-}" n
  [ -n "$d" ] && git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || { printf 'clean	'; return; }
  # an inplace agent has no recorded branch — ask the worktree
  [ -n "$br" ] && [ "$br" != "-" ] || br="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"

  n="$(git -C "$d" status --porcelain 2>/dev/null | grep -c . || true)"
  [ "${n:-0}" -gt 0 ] && { printf 'dirty	%s' "$n"; return; }

  if has_remote "$d"; then
    n="$(git -C "$d" log --oneline HEAD --not --remotes 2>/dev/null | grep -c . || true)"
    [ "${n:-0}" -gt 0 ] && { printf 'unpushed	%s' "$n"; return; }
  fi

  # "merged" outranks `behind`: it is sweepable regardless, and an open PR is
  # someone else's turn.  Ask git BEFORE gh — if HEAD is already an ancestor of
  # the base, the work is in, and that is true for a local remote, a non-GitHub
  # remote, and offline.  gh only adds the squash-merge case, where the commit
  # is rewritten and the ancestor test cannot see it.
  local base_m; base_m="$(base_ref "$d")"
  if [ -n "$base_m" ] && [ "$br" != "${base_m#origin/}" ]; then
    if git -C "$d" merge-base --is-ancestor HEAD "$base_m" 2>/dev/null; then
      printf 'merged	'; return
    fi
  fi

  local pr; pr="$(pr_state_of "$d" "$br" "$want_pr")"
  case "$pr" in
    merged) printf 'merged	';  return ;;
    open)   printf 'review	';  return ;;
  esac

  local base behind
  base="$(base_ref "$d")"
  # standing on the base branch itself: nothing to land, and "no PR" would be
  # suggesting an action that does not exist
  [ -n "$base" ] && [ "$br" = "${base#origin/}" ] && { printf 'clean\t'; return; }
  if [ -n "$base" ]; then
    behind="$(git -C "$d" rev-list --count "HEAD...$base" --right-only 2>/dev/null || true)"
    [ "${behind:-0}" -gt 0 ] && { printf 'behind	%s' "$behind"; return; }
    # nothing ahead of base means there is nothing to land: a freshly created
    # worktree branch should not nag you to open a PR for zero commits
    local ahead; ahead="$(git -C "$d" rev-list --count "$base...HEAD" --right-only 2>/dev/null || true)"
    [ "${ahead:-0}" -eq 0 ] 2>/dev/null && { printf 'clean	'; return; }
  fi

  case "$pr" in
    none)    printf 'no_pr	' ;;
    unknown) printf 'unknown	' ;;
    *)       printf 'clean	' ;;   # na, or nothing left to say
  esac
}

# --- the PR half: ONE gh call per repo, cached ------------------------------
# `gh pr status` costs ~2s and answers for one branch; `gh api .../pulls`
# costs ~0.6s and answers for all of them.  With six worktrees off one repo
# that is one request instead of six, and it is cached besides.  Nothing on a
# refresh path ever fetches: without --pr this reads the cache or says unknown.
PR_CACHE_DIR="$STATE_DIR/pr-cache"
PR_CACHE_TTL="${KEL_PR_TTL:-300}"

repo_slug() {   # cwd -> owner/repo, or empty when it isn't a GitHub remote
  local u; u="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 0
  case "$u" in
    *github.com[:/]*) ;;
    *) return 0 ;;
  esac
  u="${u##*github.com}"; u="${u#:}"; u="${u#/}"; u="${u%.git}"
  case "$u" in */*) printf '%s' "$u" ;; esac
}

pr_cache_file() { # cwd -> cache path, or empty
  local slug; slug="$(repo_slug "$1")"; [ -n "$slug" ] || return 0
  printf '%s/%s.json' "$PR_CACHE_DIR" "${slug//\//__}"
}

pr_refresh() {  # cwd — refetch when the cache is stale; silent on any failure
  local f slug age
  f="$(pr_cache_file "$1")"; [ -n "$f" ] || return 0
  slug="$(repo_slug "$1")"
  if [ -f "$f" ]; then
    local ts=0; read -r ts < "$f.at" 2>/dev/null || ts=0
    case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
    age=$(( $(date +%s) - ts ))
    [ "$age" -lt "$PR_CACHE_TTL" ] && return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0
  mkdir -p "$PR_CACHE_DIR"
  local tmp; tmp="$(mktemp "$PR_CACHE_DIR/.p.XXXXXX")" || return 0
  if gh api "repos/$slug/pulls?state=all&per_page=100" \
       --jq '[.[] | {branch: .head.ref, merged: (.merged_at != null), state: .state}]' \
       > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv -f "$tmp" "$f"; date +%s > "$f.at"
  else
    # an empty array is a legitimate answer (no PRs); a failure is not
    if [ -f "$tmp" ] && [ "$(cat "$tmp")" = "[]" ]; then
      printf '[]' > "$f"; date +%s > "$f.at"
    fi
    rm -f "$tmp"
  fi
}

pr_state_of() { # cwd branch [--pr] -> merged | open | none | unknown | na
  # `na` is not `unknown`: a repo with no GitHub remote has no PR question to
  # answer, so it should read clean rather than as a failure to find out.
  local d="$1" br="${2:-}" want="${3:-}" f
  [ -n "$(repo_slug "$d")" ] || { printf 'na'; return; }
  [ -n "$br" ] && [ "$br" != "-" ] || { printf 'unknown'; return; }
  [ "$want" = "--pr" ] && pr_refresh "$d"
  f="$(pr_cache_file "$d")"
  [ -n "$f" ] && [ -f "$f" ] || { printf 'unknown'; return; }
  jq -r --arg b "$br" '
    [.[] | select(.branch == $b)] as $m
    | if   ($m | length) == 0             then "none"
      elif ($m | any(.merged))            then "merged"
      elif ($m | any(.state == "open" or .state == "OPEN")) then "open"
      else "none" end' "$f" 2>/dev/null || printf 'unknown'
}
# --------------------------------------------------------------------------
# kel _fleet [--dirty]   —  ONE computed view of the whole fleet, as JSON
# --------------------------------------------------------------------------
# Every surface used to derive this for itself: gather_rows fed ls / --json /
# the board over 13 positional TSV fields, and cmd_status_line re-derived its
# own on every bar redraw.  They disagreed by construction, and the positional
# plumbing caused three separate bugs.  This is the single answer, and the
# contract the Go implementation has to match (spec.md 12).
#
# Cost discipline: the old path spent one `tmux list-panes` per window inside
# effective_state plus a `jq` per record.  This spends two tmux calls and two
# jq calls total, whatever the fleet size.  --dirty is opt-in because
# `git status` per worktree is the expensive part and the bar never shows it.
_fleet_bash() {
  command -v jq >/dev/null 2>&1 || { printf '{"agents":[]}\n'; return 0; }
  local want_dirty=0 want_land=0 want_pr=''
  for a in "$@"; do
    case "$a" in
      --dirty) want_dirty=1 ;;
      --land)  want_land=1; want_dirty=1 ;;
      --pr)    want_pr=--pr; want_land=1; want_dirty=1 ;;
    esac
  done

  local wins panes cur_sess='' cur_wid=
  wins="$(tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_id}	#{window_name}	#{window_activity}' 2>/dev/null || true)"
  panes="$(tmux list-panes -a -F '#{window_id}	#{pane_current_command}' 2>/dev/null || true)"
  IFS=' ' read -r cur_sess cur_wid < <(tmux display-message -p '#{client_session} #{window_id}' 2>/dev/null || true)

  # state + ctx with builtins only, no fork per file
  local states='' ctxs='' f wid st ep note line
  for f in "$STATE_DIR"/*.state; do
    [ -e "$f" ] || continue
    wid="${f##*/}"; wid="${wid%.state}"
    read -r st ep note < "$f" 2>/dev/null || continue
    states="$states$wid	$st	$ep	$note"$'\n'
  done
  for f in "$STATE_DIR"/*.ctx; do
    [ -e "$f" ] || continue
    wid="${f##*/}"; wid="${wid%.ctx}"
    IFS= read -r line < "$f" 2>/dev/null || continue
    ctxs="$ctxs$wid	$line"$'\n'
  done

  # every record in ONE slurp
  local -a rf=()
  for f in "$SESSIONS_DIR"/*/*.json; do [ -e "$f" ] && rf+=( "$f" ); done

  # dirty is keyed by cwd: it is a property of the directory, not the window
  local dirty=''
  if [ "$want_dirty" = 1 ]; then
    local cwd seen=''
    while IFS= read -r cwd; do
      [ -n "$cwd" ] || continue
      case "$seen" in *"|$cwd|"*) continue ;; esac
      seen="$seen|$cwd|"
      git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || continue
      dirty="$dirty$cwd	$(git -C "$cwd" status --porcelain 2>/dev/null | grep -c . || printf 0)"$'\n'
    done < <(cat "${rf[@]}" 2>/dev/null | jq -r '.cwd // empty')
  fi

  # land: one row per distinct worktree.  --pr may refresh the PR cache (one
  # gh call per repo); without it this is pure local git and never touches the
  # network, which is what keeps it safe on a refresh path.
  local land=''
  if [ "$want_land" = 1 ]; then
    local lcwd lbr seenl='' lres
    while IFS=$'	' read -r lcwd lbr; do
      [ -n "$lcwd" ] || continue
      case "$seenl" in *"|$lcwd|"*) continue ;; esac
      seenl="$seenl|$lcwd|"
      lres="$(land_of "$lcwd" "$lbr" $want_pr)"
      land="$land$lcwd	$lres"$'\n'
    done < <(cat "${rf[@]}" 2>/dev/null | jq -r '[.cwd // "", .branch // ""] | @tsv')
  fi

  jq -n --slurpfile records <(cat "${rf[@]}" 2>/dev/null) \
        --arg wins "$wins" --arg panes "$panes" --arg states "$states" \
        --arg ctxs "$ctxs" --arg dirtyraw "$dirty" --arg landraw "$land" \
        --arg prefix "$KEL_PREFIX" --arg cur_sess "$cur_sess" --arg cur_wid "$cur_wid" '
    def rows($s): ($s // "") | split("\n") | map(select(length > 0) | split("\t"));
    def num: (tonumber? // null);
    def isshell: . as $c | (["bash","zsh","fish","sh","dash","tmux"] | index($c)) != null;
    def groupof($s):
      if   $s == $prefix                    then $prefix
      elif ($s | startswith($prefix + "/")) then ($s[($prefix|length)+1:])
      else null end;

    rows($wins) as $W | rows($panes) as $P | rows($states) as $S
    | rows($ctxs) as $C | rows($dirtyraw) as $DR | rows($landraw) as $LR
    | (reduce $P[]  as $p ({}; .[$p[0]] += [$p[1]]))  as $panemap
    | (reduce $S[]  as $s ({}; .[$s[0]] = {state:$s[1], since:($s[2]|num),
        note:(if ($s[3] // "") == "" then null else $s[3] end)}))  as $statemap
    | (reduce $C[]  as $c ({}; .[$c[0]] = {pct:($c[1]|num), cost_usd:($c[2]|num),
        in_tokens:($c[3]|num), size:($c[4]|num),
        rate_5h:(($c[5]|num) | if . == -1 then null else . end),
        at:($c[6]|num), model:(if ($c[7] // "") == "" then null else $c[7] end)}))  as $ctxmap
    | (reduce $DR[] as $d ({}; .[$d[0]] = ($d[1]|num)))  as $dirtymap
    | (reduce $LR[] as $l ({}; .[$l[0]] = {code:$l[1], n:($l[2]|num)}))  as $landmap
    | (reduce $records[] as $r ({}; .[(($r.group // "misc") + " " + $r.name)] = $r))  as $recmap
    | [ $W[]
        | groupof(.[0]) as $g | select($g != null)
        | .[2] as $wid | .[3] as $nm
        | ($panemap[$wid] // [])            as $pl
        | ($statemap[$wid] // null)         as $stt
        | ($recmap[$g + " " + $nm] // null) as $rec
        | (($stt.state // null) as $raw
           | if ($raw == "working" or $raw == "waiting" or $raw == "throttled")
                and (([$pl[] | select(isshell | not)] | length) == 0)
             then "dead" else $raw end)     as $eff
        | { group:$g, name:$nm, window_id:$wid, index:(.[1]|num),
            current: (.[0] == $cur_sess and $wid == $cur_wid),
            managed: ($rec != null),
            state:$eff, state_since:($stt.since // null), note:($stt.note // null),
            isolation:($rec.isolation // null), branch:($rec.branch // null),
            repo:($rec.repo // null), cwd:($rec.cwd // null),
            agent:($rec.agent // null), claude_session:($rec.claude_session // null),
            compactions:($rec.compactions // null),
            dirty:($dirtymap[($rec.cwd // "")] // null),
            land:($landmap[($rec.cwd // "")] // null),
            panes:$pl, activity:(.[4]|num), context:($ctxmap[$wid] // null) } ]
      # records with no live window. Same liveness rule as meta_is_live: the
      # window must match BOTH the recorded id and the recorded name.
      + [ $records[] as $r
          | select([ $W[] | select(.[2] == $r.window_id and .[3] == $r.name) ] | length == 0)
          | { group:($r.group // "misc"), name:$r.name, window_id:null, index:null,
              current:false, managed:true,
              state:"dead", state_since:null, note:null,
              isolation:($r.isolation // null), branch:($r.branch // null),
              repo:($r.repo // null), cwd:($r.cwd // null),
              agent:($r.agent // null), claude_session:($r.claude_session // null),
              compactions:($r.compactions // null),
              dirty:($dirtymap[($r.cwd // "")] // null),
              land:($landmap[($r.cwd // "")] // null),
              panes:[], activity:null, context:null } ]
    | { generated_at:(now|todate),
        current:{ group:(if $cur_sess == "" then null else groupof($cur_sess) end),
                  window_id:(if $cur_wid == "" then null else $cur_wid end) },
        agents:. }'
}

# The seam: a Go kel-fleet takes over when installed, bash answers otherwise.
# Deliberately a stat of one known path, NOT `command -v`.  Looking up a binary
# that does not exist walks all of $PATH, and on WSL2 $PATH carries the Windows
# directories under /mnt/c — that miss measured 62ms, six times the cost of
# everything else this function does put together.
fleet_json() {
  # Fall back on ANY failure, not just a missing binary.  bin/kel updates the
  # moment you pull; kel-fleet only updates when you re-run install.sh, so a
  # stale binary that rejects a newly-added flag is the normal state of things
  # for a minute — and it must degrade to bash rather than break the command.
  if [ -x "$KEL_FLEET_BIN" ]; then
    local out
    if out="$("$KEL_FLEET_BIN" "$@" 2>/dev/null)" && [ -n "$out" ]; then
      printf '%s\n' "$out"; return 0
    fi
  fi
  _fleet_bash "$@"
}


cmd_ls() {
  need tmux; need jq
  prune_state
  local doc
  if [ "${1:-}" = "--json" ]; then doc="$(fleet_json --dirty)"; else doc="$(fleet_json)"; fi
  if [ "$(printf '%s' "$doc" | jq '.agents | length')" = 0 ]; then
    echo "no agents yet — 'kel new <name>' to start one"
    return 0
  fi

  if [ "${1:-}" = "--json" ]; then
    # v0.6: the whole document, not a bare array — .agents is the list
    printf '%s\n' "$doc" | jq .
    return 0
  fi

  printf '%s' "$doc" | jq -r --arg home "$HOME" '
    def money: (. * 100 | round) as $c | "\($c / 100 | floor).\((($c % 100) | tostring) | if length == 1 then "0" + . else . end)";
    def pad($n): (. // "-") | tostring | . + (" " * ($n - length)) | .[0:$n];
    .agents
    | sort_by(.group, (.index // 9999))
    | group_by(.group)[]
    | (.[0].group), ( .[] |
        ( (if .current then "\(.index)*" else (.index // "-" | tostring) end) | pad(4) ) as $ix
      | ( .name + (if (.panes | length) > 1 then " (" + (.panes | join("|")) + ")" else "" end) | pad(24) ) as $nm
      | ( (.state // "-") | pad(10) ) as $st
      | ( (if .context.pct == null then "-" else "\(.context.pct)%" end) | pad(5) ) as $cx
      | ( (if .managed then .isolation else "(unmanaged)" end) | pad(10) ) as $iso
      | ( (.branch // "-") | pad(12) ) as $br
      | ( (.cwd // "") | sub("^" + $home; "~") ) as $cw
      | ( if (.context.cost_usd // 0) > 0 then "  $" + (.context.cost_usd | money) else "" end ) as $cost
      | "  \($ix) \($nm) \($st) \($cx) \($iso) \($br)  \($cw)\($cost)" ),
      ""' | sed '$d'

  if [ -n "$(printf '%s' "$doc" | jq -r '.agents[] | select(.window_id == null) | .name')" ]; then
    echo "  dead = window gone.  kel restore [-c] rebuilds  ·  kel prune discards"
  fi
  return 0
}

# --------------------------------------------------------------------------
# kel go
# --------------------------------------------------------------------------
cmd_go() {
  need tmux
  local g="${1:-}"
  if [ -z "$g" ]; then
    local gs; gs="$(group_sessions)"
    [ -n "$gs" ] || { echo "no groups yet"; return 0; }
    local cur; cur="$(current_group)"
    printf '%s\n' "$gs" | while read -r x; do
      [ "$x" = "$cur" ] && printf '* %s\n' "$x" || printf '  %s\n' "$x"
    done
    return 0
  fi
  local s; s="$(sess "$g")"
  tmux has-session -t "=$s" 2>/dev/null || die "no group '$g'  (kel go with no arg lists them)"
  set_last_group "$g"; snapshot
  if in_tmux; then tmux switch-client -t "=$s"
  elif [ -t 1 ]; then tmux attach -t "=$s"
  fi
}

# --------------------------------------------------------------------------
# kel move  — relocate the current window to another group
# --------------------------------------------------------------------------
cmd_move() {
  need tmux; need jq
  [ -n "${TMUX:-}" ] || die "kel move: run this from inside kel"

  local cur_wid cur_sess cur_group wname pcwd
  cur_wid="$(tmux display-message -p '#{window_id}')"
  cur_sess="$(tmux display-message -p '#{session_name}')"
  wname="$(tmux display-message -p '#{window_name}')"
  pcwd="$(tmux display-message -p '#{pane_current_path}')"
  case "$cur_sess" in "$KEL_PREFIX"|"$KEL_PREFIX"/*) ;; *) die "kel move: this window isn't in a kel group" ;; esac
  cur_group="$(current_group)"

  local target="${1:-}"
  if [ -z "$target" ]; then
    if [ -n "${KEL_GROUP:-}" ]; then target="$KEL_GROUP"
    else
      local gr; gr="$(cd "$pcwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
      if [ -n "$gr" ]; then target="$(basename "$gr")"
      else target="misc"; warn "no git repo here → group 'misc'  (kel move NAME to name it)"; fi
    fi
  fi
  slug_ok "$target" || die "group '$target' isn't a slug"
  [ "$target" = "$cur_group" ] && { say "already in group '$cur_group'"; return 0; }
  [ -f "$(meta_path "$target" "$wname")" ] && \
    die "[$target] already has an agent called '$wname' — kel rename it first"

  # warn if we're moving a worktree agent away from its repo's group
  local mv_meta; mv_meta="$(meta_path "$cur_group" "$wname")"
  if [ -f "$mv_meta" ] && [ "$(jq -r '.isolation' "$mv_meta")" = worktree ]; then
    local mr; mr="$(basename "$(jq -r '.repo // ""' "$mv_meta")")"
    [ -n "$mr" ] && [ "$mr" != "$target" ] && \
      warn "'$wname' works in $mr's worktree — moving it to [$target] is cosmetic only"
  fi

  local dst; dst="$(sess "$target")"
  if ! tmux has-session -t "=$dst" 2>/dev/null; then
    tmux new-session -d -s "$dst" -c "$HOME" -x 220 -y 50
    group_session_status "$target" "$dst"
    local ph; ph="$(tmux list-windows -t "=$dst" -F '#{window_id}' | head -1)"
    tmux move-window -s "$cur_wid" -t "$dst:"
    tmux kill-window -t "$ph" 2>/dev/null || true
  else
    tmux move-window -s "$cur_wid" -t "$dst:"
  fi

  local meta; meta="$(meta_path "$cur_group" "$wname")"
  if [ -f "$meta" ]; then
    mkdir -p "$SESSIONS_DIR/$target"
    jq --arg g "$target" '.group=$g' "$meta" > "$(meta_path "$target" "$wname")" && rm -f "$meta"
  else
    local repo; repo="$(cd "$pcwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
    meta_write "$wname" "$cur_wid" "$repo" "$pcwd" "inplace" "" "$KEL_AGENT" "$target"
    say "adopted '$wname' into kel"
  fi
  set_last_group "$target"

  tmux switch-client -t "=$dst" \; select-window -t "$cur_wid" 2>/dev/null || true

  # tidy: drop the old group session if it's now empty
  if [ -n "$cur_group" ] && ! tmux list-windows -t "=$(sess "$cur_group")" -F x 2>/dev/null | grep -q x; then
    tmux kill-session -t "=$(sess "$cur_group")" 2>/dev/null || true
  fi

  say "moved '$wname'  ->  [$target]"
  snapshot
}

# --------------------------------------------------------------------------
# kel board   (prefix b)  — fzf-driven fleet browser
# --------------------------------------------------------------------------
# rows for fzf:  group <T> name <T> state <T> dirty <T> path <T> wid
cmd_board_rows() {
  fleet_json --dirty | jq -r '
    def colour:
      if   . == "waiting"   then "\u001b[1;33m"
      elif . == "working"   then "\u001b[1;36m"
      elif . == "done"      then "\u001b[1;32m"
      elif . == "throttled" then "\u001b[1;35m"
      elif . == "dead"      then "\u001b[1;31m"
      elif . == "idle"      then "\u001b[2m"
      else "\u001b[0m" end;
    .agents[]
    | select(.window_id != null)          # orphan-metadata rows have no window
    | (.state // "idle") as $st
    | [ .group, .name, ($st | colour) + $st + "\u001b[0m",
        (if (.dirty // 0) > 0 then "\(.dirty) dirty" else "" end),
        (.cwd // ""), .window_id ]
    | @tsv' | sort
}

cmd_board_preview() {   # name group
  local name="$1" group="$2"
  fleet_json | jq -r --arg n "$name" --arg g "$group" '
    def money: (. * 100 | round) as $c | "\($c / 100 | floor).\((($c % 100) | tostring) | if length == 1 then "0" + . else . end)";
    (.agents[] | select(.group == $g and .name == $n)) // empty
    | if .managed then
        "group      \(.group)",
        "agent      \(.agent // "-")",
        "isolation  \(.isolation)\(if .branch then "  (branch \(.branch))" else "" end)",
        "directory  \(.cwd // "-")"
      else
        "group      \(.group)", "(unmanaged window — no metadata)"
      end,
      (if .note        then "says       \(.note)" else empty end),
      (if .context     then "context    \(.context.pct)% of \((.context.size / 1000 | floor))k  (\(.context.in_tokens) tokens used)",
                            "cost       $\(.context.cost_usd | money)\(if .context.model then "   ·  \(.context.model)" else "" end)"
                       else empty end),
      (if (.compactions // 0) > 0 then "compacted  \(.compactions) time(s)" else empty end)'

  local wid; wid="$(kel_windows | awk -F'\t' -v n="$name" -v g="$group" '$2==g && $5==n{print $4; exit}')"
  if [ -n "$wid" ]; then
    printf '\n\033[2m── recent ──\033[0m\n'
    tmux capture-pane -t "$wid" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8
  fi
  local cwd; cwd="$(jq -r '.cwd // ""' "$(meta_path "$group" "$name")" 2>/dev/null)"
  if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
    local d; d="$(git -C "$cwd" status --short 2>/dev/null | head -10)"
    [ -n "$d" ] && printf '\n\033[2m── uncommitted ──\033[0m\n%s\n' "$d"
  fi
}

cmd_board_jump() {   # wid group
  [ -n "${1:-}" ] || return 0
  tmux switch-client -t "=$(sess "$2")" 2>/dev/null || true
  tmux select-window -t "$1" 2>/dev/null || true
  set_last_group "$2"
}

# ctrl-k wrapper: confirm before killing (in-place agents get no other friction)
cmd_board_kill() {   # group name
  [ -n "${2:-}" ] || return 0
  printf 'kill %s/%s? [y/N] ' "$1" "$2" > /dev/tty
  local a=''; read -r a < /dev/tty || a=n
  case "$a" in y|Y|yes) "$SELF" kill "$1/$2" ;; *) : ;; esac
}

# tab in the board: a labelled action menu for the highlighted agent.
# (the board closes behind it, same as pressing enter to jump)
# display-menu needs an explicit -c client here — invoked via fzf `become`, not
# from a key binding, tmux can't resolve the "current" client on its own.
cmd_board_actions() {   # wid name group cwd
  need tmux
  local wid="$1" name="$2" group="$3" cwd="$4" cl sn
  sn="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null || true)"
  cl="$(tmux list-clients ${sn:+-t "$sn"} -F '#{client_name}' 2>/dev/null | head -1)"
  [ -n "$cl" ] || cl="$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -1)"
  tmux display-menu ${cl:+-c $cl} -x C -y C -T " $name " -- \
    "jump to it"                j  "run-shell \"$SELF _board_jump '$wid' '$group'\"" \
    "new agent in its folder"   n  "command-prompt -p 'name:' { run-shell \"cd '$cwd' && $SELF new %%\" }" \
    "rename it"                  r  "command-prompt -p 'new name:' { run-shell \"$SELF _board_rename '$wid' %%\" }" \
    "go to its group"           g  "run-shell \"$SELF go '$group'\"" \
    "" \
    "kill it"                   k  "run-shell \"$SELF _board_kill '$group' '$name'\""
}

cmd_board_rename() {   # wid new
  need tmux; need jq
  slug_ok "${2:-}" || { warn "name must be a slug (A-Z a-z 0-9 . _ -)"; return 1; }
  rename_agent "$1" "$2"
}

cmd_board() {
  need tmux; need fzf; need jq
  [ -n "${TMUX:-}" ] || die "kel board runs inside tmux"
  [ -n "$(cmd_board_rows)" ] || { tmux display-message "kel: no agents"; return 0; }

  # The board always runs in a popup, and kel decides that here rather than in
  # kel.conf — so `kel board` typed at a shell looks exactly like Ctrl+Space
  # (it used to fill the pane inline), and the geometry lives in one place.
  #
  # It has to be tmux's display-popup, not fzf's own --popup: fzf --popup needs
  # a tty and a tmux key binding has none, so run-shell + fzf --popup dies with
  # "inappropriate ioctl for device" and the key silently does nothing.
  # A popup runs a fresh shell off the tmux *server's* environment, so any
  # KEL_* the calling shell had would vanish — carry them across with -e.
  if [ -z "${KEL_IN_POPUP:-}" ]; then
    local -a penv=( -e KEL_IN_POPUP=1 ) v
    for v in KEL_SESSION KEL_AGENT KEL_GROUP KEL_WORKTREES KEL_CTX_WARN XDG_STATE_HOME; do
      [ -n "${!v:-}" ] && penv+=( -e "$v=${!v}" )
    done
    exec tmux display-popup "${penv[@]}" \
      -w "${KEL_BOARD_W:-90%}" -h "${KEL_BOARD_H:-85%}" -T ' kel ' -E "'$SELF' board"
  fi

  cmd_board_rows | SHELL=/bin/bash fzf \
    --ansi --delimiter '\t' --with-nth '1,2,3,4' --nth '1,2' \
    --layout reverse --info inline --height '100%' \
    --border rounded --border-label ' kel ' \
    --footer 'enter jump  ·  tab actions' \
    --preview "$SELF _board_preview {2} {1}" \
    --preview-window 'right,45%,wrap,border-left' \
    --bind "enter:become($SELF _board_jump {6} {1})" \
    --bind "tab:become($SELF _board_actions {6} {2} {1} {5})" \
    --bind "ctrl-g:become($SELF go {1})" \
    --bind "ctrl-r:reload($SELF _board_rows)" \
    --bind "ctrl-k:execute($SELF _board_kill {1} {2})+reload($SELF _board_rows)" \
    --bind "ctrl-n:become(tmux command-prompt -p 'new agent:' \"run-shell \\\"cd {5} && $SELF new %%\\\"\")" \
    --color 'footer:italic,border:8' \
    >/dev/null 2>&1 || true
}

# kel menu  —  deprecated alias for the board (kept one release for muscle memory)
cmd_menu() { cmd_board; }

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
agent_resume_cmd() { # agent cid  -> the shell string to resume/start an agent
  if [ -n "$2" ]; then printf '%s --resume %s || %s --continue || %s' "$1" "$2" "$1" "$1"
  else printf '%s --continue || %s' "$1" "$1"; fi
}

# --------------------------------------------------------------------------
# kel snapshot  — save the whole workspace shape (groups/windows/panes)
# --------------------------------------------------------------------------
snapshot() {   # silent; called by hooks and state-changing commands
  # A restore owns snapshot.json while it runs (see restore_from_snapshot).
  # This has to be a lockfile, not an env var: the tmux hooks that call us
  # spawn a fresh `kel` from the server, which inherits nothing.  A lock left
  # behind by a killed restore goes stale after five minutes.
  if [ -e "$RESTORE_LOCK" ]; then
    # the lock carries the epoch the restore started — no stat(1), whose flag
    # for mtime differs between GNU (-c %Y) and BSD (-f %m)
    local lock_ts=''; read -r lock_ts < "$RESTORE_LOCK" 2>/dev/null || true
    case "${lock_ts:-}" in ''|*[!0-9]*) lock_ts=0 ;; esac
    [ $(( $(date +%s) - lock_ts )) -lt 300 ] && return 0
    rm -f "$RESTORE_LOCK"
  fi
  command -v tmux >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  group_sessions | grep -q . || return 0
  local snap g s
  snap="$(jq -n --arg t "$(date -u +%FT%TZ)" --arg lg "$(current_group)" \
               --arg lw "$(tmux display-message -p '#{window_name}' 2>/dev/null || true)" \
               '{saved_at:$t, last_group:$lg, last_window:$lw, groups:{}}')"
  while read -r g; do
    [ -z "$g" ] && continue
    s="$(sess "$g")"
    local wins='[]' widx wname wlayout
    while IFS=$'\t' read -r widx wname wlayout; do
      [ -z "$widx" ] && continue
      local panes='[]' pcwd pcmd
      while IFS=$'\t' read -r pcwd pcmd; do
        panes="$(printf '%s' "$panes" | jq --arg c "$pcwd" --arg m "$pcmd" '.+[{cwd:$c,cmd:$m}]')"
      done < <(tmux list-panes -t "$s:$widx" -F '#{pane_current_path}	#{pane_current_command}' 2>/dev/null)
      wins="$(printf '%s' "$wins" | jq --arg n "$wname" --arg l "$wlayout" --argjson p "$panes" \
              '.+[{name:$n,layout:$l,panes:$p}]')"
    done < <(tmux list-windows -t "$s" -F '#{window_index}	#{window_name}	#{window_layout}' 2>/dev/null)
    snap="$(printf '%s' "$snap" | jq --arg g "$g" --argjson w "$wins" '.groups[$g]=$w')"
  done < <(group_sessions)
  local tmp; tmp="$(mktemp "$STATE_DIR/.snap.XXXXXX" 2>/dev/null)" || return 0
  [ -f "$SNAPSHOT" ] && cp -f "$SNAPSHOT" "$SNAPSHOT.prev" 2>/dev/null
  printf '%s' "$snap" > "$tmp" && mv -f "$tmp" "$SNAPSHOT"
  rm -f "$SNAPSHOT_DECLINED"          # a new snapshot is a new question
}

cmd_snapshot() { need tmux; need jq; snapshot; say "snapshot -> ${SNAPSHOT/#$HOME/\~}"; }

# Saying "no" to the rebuild prompt used to last exactly one invocation, so a
# workspace you had finished with asked again every single time you ran `kel`.
# Remember the refusal against that snapshot's timestamp: a NEW snapshot is a
# new question and will ask again, the same one will not.
decline_snapshot() {
  jq -r '.saved_at // ""' "$SNAPSHOT" 2>/dev/null > "$SNAPSHOT_DECLINED" || true
}
snapshot_declined() {
  [ -f "$SNAPSHOT_DECLINED" ] || return 1
  local d s
  read -r d < "$SNAPSHOT_DECLINED" 2>/dev/null || return 1
  s="$(jq -r '.saved_at // ""' "$SNAPSHOT" 2>/dev/null)"
  [ -n "$d" ] && [ "$d" = "$s" ]
}

# rebuild the workspace from snapshot.json (windows, splits, layout, agents)
restore_from_snapshot() {   # [-c]
  need tmux; need jq
  [ -f "$SNAPSHOT" ] || { warn "no snapshot to restore"; return 1; }
  local cont=0; [ "${1:-}" = "-c" ] && cont=1

  # Rebuilding the workspace fires tmux's own after-split-window / pane-exited
  # hooks, which run `kel snapshot` in the background — that would write the
  # half-rebuilt workspace over snapshot.json while we are still reading it,
  # truncating the restore and destroying the record of everything not yet
  # rebuilt.  Hold the lock so those writes stand down, and read from a private
  # copy so nothing can move underneath us either way.
  local src="$SNAPSHOT"
  date +%s > "$RESTORE_LOCK"
  local SNAPSHOT
  SNAPSHOT="$(mktemp "$STATE_DIR/.snapin.XXXXXX" 2>/dev/null)" \
    || { rm -f "$RESTORE_LOCK"; warn "no scratch space to restore from"; return 1; }
  cp -f "$src" "$SNAPSHOT"
  local lg lw first_wid='' dest_wid=''
  lg="$(jq -r '.last_group // ""' "$SNAPSHOT")"
  lw="$(jq -r '.last_window // ""' "$SNAPSHOT")"

  local g wi nw
  while read -r g; do
    [ -z "$g" ] && continue
    nw="$(jq -r --arg g "$g" '.groups[$g] | length' "$SNAPSHOT")"
    for ((wi=0; wi<nw; wi++)); do
      local wname wlayout np
      wname="$(jq -r   --arg g "$g" --argjson i "$wi" '.groups[$g][$i].name'          "$SNAPSHOT")"
      wlayout="$(jq -r --arg g "$g" --argjson i "$wi" '.groups[$g][$i].layout // ""'  "$SNAPSHOT")"
      np="$(jq -r      --arg g "$g" --argjson i "$wi" '.groups[$g][$i].panes | length' "$SNAPSHOT")"

      # already live? leave it
      kel_windows | awk -F'\t' -v s="$(sess "$g")" -v n="$wname" '$1==s&&$5==n{f=1}END{exit !f}' && continue

      local p0; p0="$(jq -r --arg g "$g" --argjson i "$wi" '.groups[$g][$i].panes[0].cwd // ""' "$SNAPSHOT")"
      [ -d "$p0" ] || p0="$HOME"
      local wid; wid="$(open_window "$wname" "$p0" "$g")"
      [ -n "$wid" ] || continue
      [ -z "$first_wid" ] && first_wid="$wid"

      local -a pids; pids=( "$(tmux list-panes -t "$wid" -F '#{pane_id}' | head -1)" )
      local pj pc
      for ((pj=1; pj<np; pj++)); do
        pc="$(jq -r --arg g "$g" --argjson i "$wi" --argjson j "$pj" '.groups[$g][$i].panes[$j].cwd // ""' "$SNAPSHOT")"
        [ -d "$pc" ] || pc="$HOME"
        pids+=( "$(tmux split-window -t "$wid" -c "$pc" -P -F '#{pane_id}')" )
      done
      [ -n "$wlayout" ] && tmux select-layout -t "$wid" "$wlayout" 2>/dev/null || true

      local meta; meta="$(meta_path "$g" "$wname")"
      if [ -f "$meta" ]; then
        jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.t" && mv "$meta.t" "$meta"
        if [ "$cont" = 1 ]; then
          tmux send-keys -t "${pids[0]}" \
            "$(agent_resume_cmd "$(jq -r '.agent // "claude"' "$meta")" "$(jq -r '.claude_session // ""' "$meta")")" Enter
        fi
      fi
      for ((pj=1; pj<np; pj++)); do
        pc="$(jq -r --arg g "$g" --argjson i "$wi" --argjson j "$pj" '.groups[$g][$i].panes[$j].cmd // ""' "$SNAPSHOT")"
        case " $KEL_RESTORE_CMDS " in *" $pc "*) tmux send-keys -t "${pids[$pj]}" "$pc" Enter ;; esac
      done

      [ "$g" = "$lg" ] && [ "$wname" = "$lw" ] && dest_wid="$wid"
    done
  done < <(jq -r '.groups | keys[]' "$SNAPSHOT")

  [ -n "$lg" ] && set_last_group "$lg"
  local dest="${dest_wid:-$first_wid}"
  [ -n "$dest" ] && goto_window "$dest" "$lg"

  rm -f "$SNAPSHOT" "$RESTORE_LOCK"
  snapshot                     # release the lock, then record what we rebuilt
  say "workspace restored from snapshot"
}

# --------------------------------------------------------------------------
# kel restore
# --------------------------------------------------------------------------
cmd_restore() {
  need tmux; need jq
  local continue_agent=0 use_snap=auto
  while [ $# -gt 0 ]; do
    case "$1" in
      --continue|-c)  continue_agent=1 ;;
      --snapshot|-s)  use_snap=yes ;;
      --no-snapshot)  use_snap=no ;;
      *) die "kel restore: unknown arg $1" ;;
    esac
    shift
  done

  if [ "$use_snap" = yes ] || { [ "$use_snap" = auto ] && [ -f "$SNAPSHOT" ] && [ -z "$(group_sessions)" ]; }; then
    restore_from_snapshot "$([ "$continue_agent" = 1 ] && printf -- -c)"
    return
  fi

  local names; names="$(dead_sessions)"
  [ -n "$names" ] || { say "nothing to restore"; return 0; }

  local n meta cwd agent cid grp wid restored=0 lastgrp=''
  while IFS=$'\t' read -r grp n meta; do
    [ -z "$n" ] && continue
    cwd="$(jq -r '.cwd // ""' "$meta")"
    agent="$(jq -r '.agent // "claude"' "$meta")"
    cid="$(jq -r '.claude_session // ""' "$meta")"
    [ -d "$cwd" ] || { warn "skip $n — its directory is gone ($cwd)"; continue; }
    wid="$(open_window "$n" "$cwd" "$grp")"
    [ -n "$wid" ] || { warn "skip $n — couldn't open a window"; continue; }
    jq --arg w "$wid" '.window_id=$w' "$meta" > "$meta.tmp" && mv "$meta.tmp" "$meta"
    [ "$continue_agent" = 1 ] && tmux send-keys -t "$wid" "$(agent_resume_cmd "$agent" "$cid")" Enter
    lastgrp="$grp"; restored=$((restored+1))
  done <<< "$names"

  [ "$continue_agent" = 1 ] && say "restored $restored agent(s) — resuming" \
                            || say "restored $restored agent(s) — not started"
  [ -n "$lastgrp" ] && { set_last_group "$lastgrp"; goto_window "$wid" "$lastgrp"; }
  snapshot
}

# --------------------------------------------------------------------------
# kel restart [name] [-f]  — relaunch a crashed agent in its existing window
# --------------------------------------------------------------------------
# v0.4 made a crashed agent visible (`dead`) but gave no way out of it short of
# a workspace-wide `kel restore`.  This is the exit: same window, same worktree,
# same branch, same conversation — nothing else touched.
cmd_restart() {
  need tmux; need jq
  local name='' force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      -*)         die "kel restart: unknown flag $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done

  local group meta wid rr rc=0
  if [ -z "$name" ]; then
    [ -n "${TMUX:-}" ] || die "usage: kel restart <name>   (or run it from inside the agent's window)"
    wid="$(tmux display-message -p '#{window_id}' 2>/dev/null)"
    rr="$(meta_by_wid "$wid" || true)"
    [ -n "$rr" ] || die "this window isn't a managed agent"
    IFS=$'\t' read -r group name meta <<< "$rr"
  else
    rr="$(resolve_agent "$name")" || rc=$?
    [ "$rc" = 2 ] && die "'$name' is ambiguous — say which: kel restart <group>/<name>"
    [ -n "$rr" ] || die "no agent '$name'"
    IFS=$'\t' read -r group name meta <<< "$rr"
    wid="$(jq -r '.window_id' "$meta")"
  fi

  tmux list-windows -a -F '#{window_id}' 2>/dev/null | grep -qxF "$wid" \
    || die "'$group/$name' has no live window — 'kel restore' rebuilds it"

  # Relaunching a live agent would leave two of them fighting over one pane.
  # Ask the pane, not the state file: a freshly-started agent has no .state
  # yet, and trusting that would double-launch it.  Same shell list as
  # effective_state's dead check.
  local st alive=0
  st="$(effective_state "$wid")"
  tmux list-panes -t "$wid" -F '#{pane_current_command}' 2>/dev/null \
    | grep -qvxE 'bash|zsh|fish|sh|dash|tmux' && alive=1
  if [ "$alive" = 1 ] && [ "$force" != 1 ]; then
    die "'$group/$name' still has a live process (state: ${st:-unknown}) — kel restart $name -f to relaunch anyway"
  fi

  local agent cid pane
  agent="$(jq -r '.agent // "claude"' "$meta")"
  cid="$(jq -r '.claude_session // ""' "$meta")"
  pane="$(tmux list-panes -t "$wid" -F '#{pane_id}' 2>/dev/null | head -1)"
  [ -n "$pane" ] || die "'$group/$name' has no pane to restart in"

  # drop the stale reading; the relaunched agent's SessionStart sets it again
  rm -f "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
  tmux send-keys -t "$pane" "$(agent_resume_cmd "$agent" "$cid")" Enter
  tmux refresh-client -S 2>/dev/null || true
  say "restarting $group/$name${cid:+  (resuming $cid)}"
}

# --------------------------------------------------------------------------
# kel top   (prefix t)  — the fleet dashboard
# --------------------------------------------------------------------------
# Go-only, unlike the fleet read: this is a new surface rather than a port, so
# there is no bash version to fall back to.  Say so plainly instead of dying
# with "command not found".
cmd_top() {
  if [ ! -x "$KEL_TOP_BIN" ]; then
    warn "kel top needs the Go dashboard, which isn't built"
    if command -v go >/dev/null 2>&1; then
      die "run ./install.sh to build it"
    else
      die "install Go (install/20-user-tools.sh), then re-run ./install.sh"
    fi
  fi
  # in tmux, open in a popup the way the board does; outside, run inline
  if [ -n "${TMUX:-}" ] && [ -z "${KEL_IN_POPUP:-}" ]; then
    local -a penv=( -e KEL_IN_POPUP=1 ) v
    for v in KEL_SESSION KEL_CTX_WARN KEL_TOP_BIN XDG_STATE_HOME; do
      [ -n "${!v:-}" ] && penv+=( -e "$v=${!v}" )
    done
    exec tmux display-popup "${penv[@]}" \
      -w "${KEL_TOP_W:-90%}" -h "${KEL_TOP_H:-80%}" -T ' kel top ' -E "'$KEL_TOP_BIN'"
  fi
  exec "$KEL_TOP_BIN" "$@"
}

# --------------------------------------------------------------------------
# kel sweep [-n] [-f]   — close out everything that has actually landed
# --------------------------------------------------------------------------
# kel kill and kel prune are one-at-a-time.  Finish five worktree agents and
# kel top becomes a graveyard you clear one command at a time.
#
# Sweeps an agent only when it is finished AND its work is somewhere other than
# that worktree — `land` already computes exactly that, so `merged` IS the
# predicate.  Everything else is REPORTED, never touched: the rule from kel
# kill holds, and deleting an agent's only copy of real work is the one
# unforgivable bug in this category of tool.
cmd_sweep() {
  need tmux; need jq
  local dry=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -f|--force)   force=1 ;;
      -*)           die "kel sweep: unknown flag $1" ;;
      *)            die "kel sweep takes no arguments" ;;
    esac
    shift
  done

  local doc; doc="$(fleet_json --land --pr)"
  local swept=0 kept=0 g nm code st

  # eligible: finished, and its branch is merged (or -f, which still refuses
  # anything with uncommitted or unpushed work)
  while IFS=$'\t' read -r g nm st code; do
    [ -n "$nm" ] || continue
    if [ "$dry" = 1 ]; then
      say "would sweep  $g/$nm  ($st, $code)"
    else
      "$SELF" kill "$g/$nm" >/dev/null 2>&1 \
        && { say "swept  $g/$nm  ($code)"; } \
        || { warn "could not sweep $g/$nm"; kept=$((kept+1)); continue; }
    fi
    swept=$((swept+1))
  done < <(printf '%s' "$doc" | jq -r --argjson force "$([ "$force" = 1 ] && echo true || echo false)" '
    .agents[]
    | select(.managed)
    | select(.state == "done" or .state == "dead")
    | select((.land.code // "") as $c
             | $c == "merged" or ($force and ($c == "clean" or $c == "no_pr" or $c == "review")))
    | [.group, .name, (.state // "-"), (.land.code // "-")] | @tsv')

  # everything finished that is NOT safe to sweep, and why
  local why
  while IFS=$'\t' read -r g nm st code; do
    [ -n "$nm" ] || continue
    case "$code" in
      dirty)    why="uncommitted work" ;;
      unpushed) why="commits that are only here" ;;
      behind)   why="behind its base" ;;
      no_pr)    why="no PR — nothing has merged it" ;;
      review)   why="its PR is still open" ;;
      unknown)  why="gh could not say whether it merged" ;;
      *)        why="not merged" ;;
    esac
    warn "kept  $g/$nm  — $why"
    kept=$((kept+1))
  done < <(printf '%s' "$doc" | jq -r --argjson force "$([ "$force" = 1 ] && echo true || echo false)" '
    .agents[]
    | select(.managed)
    | select(.state == "done" or .state == "dead")
    | select((.land.code // "") as $c
             | ($c != "merged") and (($force | not) or ($c == "dirty" or $c == "unpushed" or $c == "unknown" or $c == "behind")))
    | [.group, .name, (.state // "-"), (.land.code // "-")] | @tsv')

  if [ "$swept" = 0 ] && [ "$kept" = 0 ]; then
    say "nothing finished to sweep"
  elif [ "$dry" = 1 ]; then
    say "$swept would be swept, $kept kept  (drop -n to do it)"
  else
    say "swept $swept, kept $kept"
  fi
}

# --------------------------------------------------------------------------
# kel doctor
# --------------------------------------------------------------------------
cmd_doctor() {
  need jq
  probe() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      printf '  \033[1;32m✓\033[0m %s\n' "$label" >&2; printf 'true'
    else
      printf '  \033[1;31m✗\033[0m %s\n' "$label" >&2; printf 'false'
    fi
  }
  echo "kel doctor" >&2
  local r_tmux r_ver r_popup r_wt r_jq r_node r_claude r_hooks r_sl r_pass r_go r_gh
  r_tmux=$(probe   "tmux present"                     command -v tmux)
  r_ver=$(probe    "tmux >= 3.0"                      bash -c 'v=$(tmux -V | grep -oE "[0-9]+\.[0-9]+" | head -1); [ -n "$v" ] || exit 1; [ "${v%%.*}" -gt 3 ] || { [ "${v%%.*}" -eq 3 ] && [ "${v#*.}" -ge 0 ]; }')
  r_popup=$(probe  "display-popup available"          bash -c 'tmux list-commands 2>/dev/null | grep -q display-popup')
  r_wt=$(probe     "git worktree available"           bash -c 'git worktree -h 2>&1 | grep -q "add"')
  r_jq=$(probe     "jq present"                       command -v jq)
  r_fzf=$(probe    "fzf present (kel board)"           command -v fzf)
  r_node=$(probe   "node on PATH"                     command -v node)
  r_claude=$(probe "claude on PATH"                   command -v claude)
  r_gh=$(probe     "gh authenticated (PR state in kel top)" gh auth status)
  r_hooks=$(probe  "kel hooks wired in settings.json" bash -c 'jq -e "[.hooks[]?[]?.hooks[]?.command // empty] | any(test(\"kel hook|kel-hook\"))" "$HOME/.claude/settings.json" >/dev/null')
  r_sl=$(probe     "kel statusLine wired (context %)"  bash -c 'jq -e ".statusLine.command // \"\" | test(\"kel statusline\")" "$HOME/.claude/settings.json" >/dev/null')
  if [ -x "$KEL_TOP_BIN" ]; then
    printf '  \033[1;32m✓\033[0m %s\n' "kel top available (Go dashboard)" >&2
  else
    printf '  \033[2m·\033[0m %s\n' "kel top not built (optional)" >&2
  fi
  if [ -x "$KEL_FLEET_BIN" ]; then
    printf '  \033[1;32m✓\033[0m %s\n' "fleet reader: kel-fleet (Go)" >&2; r_go=true
  else
    printf '  \033[2m·\033[0m %s\n' "fleet reader: bash (build kel-fleet for a faster one)" >&2; r_go=false
  fi
  r_pass=$(probe   "tmux allow-passthrough on"        bash -c 'tmux start-server \; show -gv allow-passthrough 2>/dev/null | grep -qx on')

  jq -n --arg d "$(date -u +%FT%TZ)" \
    --argjson tmux "$r_tmux" --argjson ver "$r_ver" --argjson popup "$r_popup" \
    --argjson wt "$r_wt" --argjson jq "$r_jq" --argjson fzf "$r_fzf" --argjson node "$r_node" \
    --argjson claude "$r_claude" --argjson hooks "$r_hooks" --argjson sl "$r_sl" \
    --argjson go "$r_go" --argjson gh "$r_gh" --argjson pass "$r_pass" \
    '{checked_at:$d, tmux:$tmux, "tmux>=3.0":$ver, display_popup:$popup,
      git_worktree:$wt, jq:$jq, fzf:$fzf, node:$node, claude:$claude,
      hooks_wired:$hooks, statusline_wired:$sl, go_fleet:$go, gh_auth:$gh,
      allow_passthrough:$pass}' \
    > "$DOCTOR_CACHE"
  printf '  cached -> %s\n' "${DOCTOR_CACHE/#$HOME/\~}" >&2
  case "$r_tmux$r_ver$r_jq" in *false*) exit 1 ;; esac
}

# --------------------------------------------------------------------------
# kel status-line   (tmux status-left)
# --------------------------------------------------------------------------
cmd_status_line() {
  [ -n "${TMUX:-}" ] || exit 0
  # One fleet_json, one jq.  This used to walk every window calling
  # effective_state (a tmux fork each) and then walk them all again to count
  # waiting agents elsewhere.  --dirty is deliberately NOT passed: the bar
  # never shows it and `git status` per worktree is the expensive part.
  fleet_json | jq -r --arg want "${1:-}" --argjson warn "${KEL_CTX_WARN:-70}" '
    def glyph:
      if   . == "waiting"   then {s:"?", c:"#[fg=colour214,bold]"}
      elif . == "working"   then {s:"*", c:"#[fg=colour111]"}
      elif . == "done"      then {s:"!", c:"#[fg=colour114]"}
      elif . == "throttled" then {s:"~", c:"#[fg=colour141]"}
      elif . == "dead"      then {s:"x", c:"#[fg=colour167,bold]"}
      else {s:"", c:""} end;

    (if $want == "" then (.current.group // "") else $want end) as $g
    | [.agents[] | select(.window_id != null)] as $live
    | if $g == "" then
        ($live | length) as $n
        | ([$live[] | select(.state == "waiting")] | length) as $w
        | if   $n == 0 then ""
          elif $w > 0  then "#[fg=colour245][kel]#[default] #[fg=colour214,bold]\($n) agent\(if $n == 1 then "" else "s" end) · \($w) waiting#[default] "
          else              "#[fg=colour245][kel] \($n) agents#[default] " end
      else
        ( [ $live[] | select(.group == $g) ] | sort_by(.index)
            | map(
                . as $a | ($a.state // "" | glyph) as $gl
                | ($a.panes | length) as $np
                | ($a.context.pct // null) as $pct
                | ( $a.name
                    + (if $np > 1 then "#[fg=colour240]·\($np)#[default]" + $gl.c else "" end)
                    + (if ($pct != null and $pct >= $warn)
                       then (if $pct >= 90 then "#[fg=colour167,bold]" else "#[fg=colour179]" end)
                            + "·\($pct)%#[default]" + $gl.c
                       else "" end) ) as $nm
                | $gl.c
                  + (if $a.current then "[\($a.index):\($nm)\($gl.s)]" else "\($a.index):\($nm)\($gl.s)" end)
                  + "#[default]" )
            | " " + join(" ") ) as $row
        | ( [ $live[] | select(.group != $g and .state == "waiting") | .group ]
            | group_by(.) | map({g:.[0], n:length}) | sort_by(-.n, .g) ) as $others
        | $row
          + ( if ($others | length) == 0 then ""
              else "  #[fg=colour214]⟨"
                   + ( ( $others[0:3] | map("\(.g)·\(.n)") | join(" ") )
                       + ( ($others[3:] | map(.n) | add) as $x
                           | if $x == null then "" else " +\($x)" end ) )
                   + "⟩#[default]" end )
          + " "
      end'
}

# --------------------------------------------------------------------------
# kel jump   (prefix `)   — global, cycles across all groups
# --------------------------------------------------------------------------
cmd_jump() {
  [ -n "${TMUX:-}" ] || exit 0
  local cs cw
  cs="$(tmux display-message -p '#{client_session}' 2>/dev/null || true)"
  cw="$(tmux display-message -p '#{window_index}' 2>/dev/null || echo '')"

  local -a w=()
  while IFS=$'\t' read -r sname _ idx wid _; do
    [ -z "${wid:-}" ] && continue
    [ "$(effective_state "$wid")" = waiting ] || continue
    w+=( "$sname"$'\t'"$idx"$'\t'"$wid" )
  done < <(kel_windows | sort -t$'\t' -k2,2 -k3,3n)

  local n="${#w[@]}"
  [ "$n" -eq 0 ] && { tmux display-message "kel: nothing waiting"; exit 0; }

  local i pos=-1 es ei
  for ((i=0; i<n; i++)); do
    IFS=$'\t' read -r es ei _ <<< "${w[$i]}"
    [ "$es" = "$cs" ] && [ "$ei" = "$cw" ] && { pos=$i; break; }
  done

  local tgt
  if [ "$pos" -ge 0 ]; then
    tgt="${w[$(( (pos + 1) % n ))]}"
  else
    tgt="${w[0]}"
    for ((i=0; i<n; i++)); do
      IFS=$'\t' read -r es ei _ <<< "${w[$i]}"
      if [ "$es" \> "$cs" ] || { [ "$es" = "$cs" ] && [ -n "$cw" ] && [ "$ei" -gt "$cw" ]; }; then
        tgt="${w[$i]}"; break
      fi
    done
  fi
  local ts ti tw
  IFS=$'\t' read -r ts ti tw <<< "$tgt"
  tmux switch-client -t "=$ts" \; select-window -t "$ti"

  # say where you landed and how long it has been sitting — the jump is
  # otherwise silent, and "which one was that?" is the next question
  local grp="$ts" nm ep
  case "$ts" in "$KEL_PREFIX") ;; "$KEL_PREFIX"/*) grp="${ts#"$KEL_PREFIX"/}" ;; esac
  nm="$(tmux display-message -p -t "$tw" '#{window_name}' 2>/dev/null || echo "$ti")"
  ep=''; [ -f "$STATE_DIR/$tw.state" ] && read -r _ ep _ < "$STATE_DIR/$tw.state" 2>/dev/null
  case "${ep:-}" in ''|*[!0-9]*) ep='' ;; esac
  if [ -n "$ep" ]; then
    tmux display-message "→ $grp/$nm  (waiting $(humanize_secs $(( $(date +%s) - ep ))))"
  else
    tmux display-message "→ $grp/$nm"
  fi
}

# --------------------------------------------------------------------------
# kel cheat
# --------------------------------------------------------------------------
cmd_cheat() {
cat <<'EOF'

  kel keys              prefix = Ctrl+b   (press, release, then the key)
  ─────────────────────────────────────────────────────────────────────────

  THE MODEL
    window  = a tab, ONE per agent — shows on the bar as  1:name
    pane    = a split INSIDE one window (agent | editor) — not on the bar
    group   = one tmux session per repo — kel/<repo>
    copy text: hold SHIFT while you drag (mouse mode owns a plain drag)

  MOVE AROUND
    Ctrl+Space    the board — find any agent; enter jumps, TAB = act on it
    (prefix b)    the same board
    prefix `      jump to the next agent WAITING on you — any group
    prefix 1-9    window (agent) N in this group
    prefix n / p  next / previous window        prefix w   pick a window
    prefix g      pick a group                  prefix ( ) prev / next group

  ACT ON AN AGENT
    prefix t      the fleet dashboard — every agent, sorted by who needs you
                  (j/k scroll · s sort: triage/ctx/cost · / filter · q quit)
    prefix m      manage THIS agent — rename / move / kill / new sibling
    (in the board) TAB on any row — the same menu, for that agent

  SCROLL an agent's conversation
    mouse wheel                (kel turns this into PageUp/PageDown for you)
    PgUp / PgDn                Claude Code's own scrollback
    prefix [                   tmux scroll mode for a plain shell pane
                               (↑↓ PgUp PgDn, / search, q leave)

  WINDOWS (agents)                 PANES (splits)
    prefix c   blank window          prefix | / -   split right / down
    prefix ,   rename (kel rename)   prefix ↑↓←→    focus a pane (or click it)
    prefix &   close (confirms)      prefix z       zoom a pane (toggle)
                                     prefix x       close a pane
    prefix k   "new to kel/tmux?" menu — the common moves, spelled out

  GROUP
    prefix d   detach — "exit kel". Agents keep running; snapshot is saved;
               `kel` brings you back to your last group.
    (killing a group, not detaching, ENDS its agents — but after a reboot
     `kel` offers to rebuild everything from the snapshot)

  ONE flat workspace instead of a group per repo?
    export KEL_GROUP=work   in ~/.bashrc  —  every `kel new` lands in kel/work,
    so `prefix 1-9` reaches every agent.  `kel new x --group foo` still splits.

  FROM A SHELL
    kel                in a repo: go to (or start) that repo's agent, like
                       `claude` for a dir. Elsewhere: your last group.
    kel new <name>     new window + agent   (-w = worktree, --group G)
    kel ls             list every agent, grouped
    kel board          fzf browser: filter, preview; enter jumps, tab acts
    kel go [group]     switch group
    kel move [group]   put THIS window in another group (cd first, then kel move)
    kel rename <new>   rename this window, keep metadata in sync
    kel kill <name>    close one      ·   kel prune  discard dead records
    kel top            the fleet dashboard — every agent, sorted by who needs
                       you  (prefix t; j/k scroll, s sort, / filter, q quit)
    kel restart [name] relaunch THIS agent after a crash (same window/worktree)
    kel restore [-c]   rebuild after a kill / reboot  (-c resumes conversations)

  STATUS BAR
    1:name*  working   1:name?  waiting-on-you   1:name!  done   1:name  idle
    1:name~  throttled — waiting on quota, not on you (it resumes itself)
    1:namex  the agent process died (no clean exit) — kel kill or restart it
    [1:name] current window   1:name·3 = 3 panes   ⟨+N waiting⟩ in other groups
    1:name·84%  context window used — only shown from KEL_CTX_WARN (70%) up.
                Claude Code's own row has the full picture: model, bar, cost.

  prefix ?   tmux's full key list      prefix k   the beginner menu

EOF
}

# --------------------------------------------------------------------------
# notifications  (#1)
# --------------------------------------------------------------------------
# The status line is a *pull* surface — it only helps while you are looking at
# it.  This is the push half, fired from the state hook.  It is never polled:
# a poller would be a background daemon, which is a hard non-goal.
#
# `notify` is the ONLY place delivery lives.  Teaching kel about
# powershell.exe (WSL), osascript (macOS) or notify-send (Linux desktop) later
# is a `command -v` ladder inside this one function and nowhere else; today it
# stays out, and setup.md carries paste-ready recipes for $KEL_NOTIFY_CMD.
notify() {   # title body
  tmux display-message "$1 — $2" 2>/dev/null || true
  [ -n "${KEL_NOTIFY_CMD:-}" ] || return 0
  # Backgrounded, and deliberately not with setsid — macOS has no setsid.  A
  # hook is synchronous: Claude Code waits for it, and a PowerShell toast
  # costs a third of a second before it has done anything useful.
  ( "$KEL_NOTIFY_CMD" "$1" "$2" >/dev/null 2>&1 & ) 2>/dev/null || true
}

# Is the user actually looking at this window?  Active in its session AND that
# session has a client attached.  Detached tmux => nobody is looking => notify.
window_focused() {   # wid
  local act att
  act="$(tmux display-message -p -t "$1" '#{window_active}'    2>/dev/null || echo 0)"
  att="$(tmux display-message -p -t "$1" '#{session_attached}' 2>/dev/null || echo 0)"
  case "${att:-0}" in ''|*[!0-9]*) att=0 ;; esac
  [ "${act:-0}" = 1 ] && [ "$att" -gt 0 ]
}

# --------------------------------------------------------------------------
# Claude Code -> kel:  which tmux pane is this session talking from?
# $TMUX_PANE when the agent passes it (it does), else the pane stashed by this
# session's SessionStart, else the one pane whose cwd matches the payload.
# --------------------------------------------------------------------------
resolve_pane() { # session-id cwd
  local sid="${1:-}" cwd="${2:-}" pane="${TMUX_PANE:-}" match
  if [ -z "$pane" ] && [ -n "$sid" ] && [ -f "$STASH_DIR/$sid" ]; then
    pane="$(cat "$STASH_DIR/$sid" 2>/dev/null || true)"
  fi
  if [ -z "$pane" ] && [ -n "$cwd" ]; then
    match="$(tmux list-panes -a -F '#{pane_id} #{pane_current_path}' 2>/dev/null | awk -v c="$cwd" '$2==c{print $1}')"
    [ "$(printf '%s\n' "$match" | grep -c .)" = 1 ] && pane="$match"
  fi
  printf '%s' "$pane"
}

# --------------------------------------------------------------------------
# context / cost, per agent      $STATE_DIR/<wid>.ctx
#   pct <T> cost_usd <T> in_tokens <T> ctx_size <T> rate5h <T> epoch <T> model
# Written by `kel statusline`; read by the bar, ls, --json and the board.
# --------------------------------------------------------------------------
ctx_field() { # wid n  -> field n of the .ctx line, or empty
  [ -f "$STATE_DIR/$1.ctx" ] || return 0
  cut -f"$2" "$STATE_DIR/$1.ctx" 2>/dev/null | head -1
}

# --------------------------------------------------------------------------
# kel statusline   —   Claude Code's own status row (wired by install.sh)
# --------------------------------------------------------------------------
# Claude Code pipes a JSON blob in on every conversation update: context window,
# cost, rate limits.  Updates are debounced to 300ms and an in-flight script is
# CANCELLED when the next one lands, so this stays cheap: one jq pass, one
# atomic write, and a tmux redraw only when the number the bar shows changed.
cmd_statusline() {
  local payload; payload="$(cat 2>/dev/null || true)"
  [ -n "$payload" ] || exit 0
  command -v jq >/dev/null 2>&1 || exit 0

  # One field per line, not @tsv: bash folds runs of tab (an IFS whitespace
  # character) into one delimiter, so a single empty field — an unset model
  # name, say — would silently shift every value after it.
  local sid cwd pct cost intok ctxsz rl5 model
  {
    read -r sid; read -r cwd; read -r pct;   read -r cost
    read -r intok; read -r ctxsz; read -r rl5; read -r model
  } < <(printf '%s' "$payload" | jq -r '[
      (.session_id // ""),
      (.workspace.current_dir // .cwd // ""),
      (.context_window.used_percentage // 0 | floor),
      (.cost.total_cost_usd // 0),
      (.context_window.total_input_tokens // 0),
      (.context_window.context_window_size // 0),
      (.rate_limits.five_hour.used_percentage // -1 | floor),
      (.model.display_name // "")
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)

  # never let a surprising payload reach arithmetic or a %f conversion
  case "${pct:-}"   in ''|*[!0-9]*)  pct=0 ;;   esac
  case "${intok:-}" in ''|*[!0-9]*)  intok=0 ;; esac
  case "${ctxsz:-}" in ''|*[!0-9]*)  ctxsz=0 ;; esac
  case "${rl5:-}"   in ''|-1|*[!0-9]*) rl5=-1 ;; esac
  case "${cost:-}"  in ''|*[!0-9.]*) cost=0 ;;  esac

  # record it against this agent's window, if we are inside one
  local wid=''
  if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}${TMUX_PANE:-}" ]; then
    local pane; pane="$(resolve_pane "$sid" "$cwd")"
    [ -n "$pane" ] && wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  fi
  if [ -n "$wid" ] && [ "$ctxsz" -gt 0 ]; then
    local old; old="$(ctx_field "$wid" 1)"
    local tmp; tmp="$(mktemp "$STATE_DIR/.${wid#@}.ctx.XXXXXX" 2>/dev/null)"
    if [ -n "${tmp:-}" ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$pct" "$cost" "$intok" "$ctxsz" "$rl5" "$(date +%s)" "$model" > "$tmp"
      mv -f "$tmp" "$STATE_DIR/$wid.ctx"
    fi
    # only redraw the tmux bar when the figure it renders actually moved —
    # #(kel status-line) is not free and this runs several times a second
    [ "$pct" != "$old" ] && tmux refresh-client -S 2>/dev/null
  fi

  # ---- render Claude Code's row ----
  local label=''
  if [ -n "$wid" ]; then
    local sn wn; sn="$(tmux display-message -p -t "$wid" '#{session_name}' 2>/dev/null || true)"
    wn="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null || true)"
    case "$sn" in
      "$KEL_PREFIX")   label="$wn" ;;
      "$KEL_PREFIX"/*) label="${sn#"$KEL_PREFIX"/}/$wn" ;;
    esac
  fi

  local bar='' i filled=$(( (${pct:-0} + 9) / 10 ))
  [ "$filled" -gt 10 ] && filled=10
  for ((i=0; i<10; i++)); do
    if [ "$i" -lt "$filled" ]; then bar="$bar█"; else bar="$bar░"; fi
  done
  local cc='\033[32m'                                  # green
  [ "${pct:-0}" -ge "$KEL_CTX_WARN" ] && cc='\033[33m'  # yellow
  [ "${pct:-0}" -ge 90 ]              && cc='\033[31m'  # red

  [ -n "$label" ] && printf '\033[2mkel\033[0m \033[36m%s\033[0m \033[2m·\033[0m ' "$label"
  [ -n "$model" ]  && printf '%s \033[2m·\033[0m ' "$model"
  printf '%b%s %s%%\033[0m \033[2mctx\033[0m' "$cc" "$bar" "${pct:-0}"
  [ -n "$cost" ] && [ "$cost" != "0" ] && printf ' \033[2m·\033[0m $%.2f' "$cost" 2>/dev/null
  [ "${rl5:--1}" -ge 50 ] 2>/dev/null && printf ' \033[2m·\033[0m \033[33m5h %s%%\033[0m' "$rl5"
  printf '\n'

  # a statusLine kel displaced at install time still gets its say
  if [ -x "$STATUSLINE_PREV" ] || [ -s "$STATUSLINE_PREV" ]; then
    printf '%s' "$payload" | sh "$STATUSLINE_PREV" 2>/dev/null || true
  fi
}

# --------------------------------------------------------------------------
# kel hook <EVENT>
# --------------------------------------------------------------------------
cmd_hook() {
  local event="${1:-}"
  command -v tmux >/dev/null 2>&1 || exit 0
  # one jq pass, one field per line — never `IFS=$'\t' read`, which folds runs
  # of tab into a single delimiter and shifts everything after an empty field
  local payload evt sid cwd ntype ntext
  payload="$(cat 2>/dev/null || true)"
  {
    read -r evt; read -r sid; read -r cwd; read -r ntype; read -r ntext
  } < <(printf '%s' "$payload" | jq -r '[
      (.hook_event_name  // ""), (.session_id       // ""), (.cwd // ""),
      (.notification_type // ""), (.notification_text // "")
    ] | .[] | tostring | gsub("[\n\t]"; " ")' 2>/dev/null)
  [ -n "$event" ] || event="$evt"

  local pane; pane="$(resolve_pane "$sid" "$cwd")"
  if [ "$event" = "SessionStart" ] && [ -n "$pane" ] && [ -n "$sid" ]; then
    printf '%s' "$pane" > "$STASH_DIR/$sid"
  fi
  [ -z "$pane" ] && exit 0

  local wid; wid="$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
  [ -z "$wid" ] && exit 0
  local prev; prev="$(state_of "$wid")"   # for the transition test below

  if [ -n "$sid" ] && [ "$event" != SessionEnd ]; then
    local m
    for m in "$SESSIONS_DIR"/*/*.json; do
      [ -e "$m" ] || continue
      [ "$(jq -r '.window_id' "$m" 2>/dev/null)" = "$wid" ] || continue
      [ "$(jq -r '.claude_session // ""' "$m" 2>/dev/null)" = "$sid" ] && break
      jq --arg s "$sid" '.claude_session=$s' "$m" > "$m.t" 2>/dev/null && mv "$m.t" "$m"
      break
    done
  fi

  local state
  case "$event" in
    SessionStart)     state=idle ;;
    UserPromptSubmit) state=working ;;
    Notification)
      # Not every notification means "blocked on you".  Mapping all of them to
      # `waiting` made `prefix \`` jump to agents that were merely sitting idle
      # or already finished — the one keystroke the tool exists for, lying.
      case "$ntype" in
        idle_prompt|auth_success|elicitation_complete|elicitation_response)
          exit 0 ;;                       # says something about you, not the agent
        agent_completed)      state=done ;;
        quota_auto_resume_*)  state=throttled ;;
        # permission_prompt, agent_needs_input, elicitation_*dialog, and any
        # notification type added after this was written
        *)                    state=waiting ;;
      esac ;;
    Stop)             state=done ;;
    PreCompact)
      # Compaction happens mid-turn: the agent is still working, so do NOT
      # touch .state.  Just count it.  "This one has been squeezed three
      # times" is the signal context% cannot give you, because context% drops
      # back down after every compaction and looks healthy again.
      local rr mp
      rr="$(meta_by_wid "$wid" || true)"
      if [ -n "$rr" ]; then
        mp="${rr##*$'\t'}"
        jq '.compactions = ((.compactions // 0) + 1)' "$mp" > "$mp.t" 2>/dev/null \
          && mv -f "$mp.t" "$mp"
      fi
      exit 0 ;;
    PostCompact)
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    SessionEnd)
      rm -f "$STATE_DIR/$wid.state" "$STATE_DIR/$wid.ctx"
      [ -n "$sid" ] && rm -f "$STASH_DIR/$sid"
      tmux refresh-client -S 2>/dev/null || true
      exit 0 ;;
    *) exit 0 ;;
  esac
  local tmp
  tmp="$(mktemp "$STATE_DIR/.${wid#@}.XXXXXX" 2>/dev/null)" || exit 0
  printf '%s %s %s\n' "$state" "$(date +%s)" "$ntext" > "$tmp"
  mv -f "$tmp" "$STATE_DIR/$wid.state"
  tmux refresh-client -S 2>/dev/null || true

  # Only on a transition *into* a notifying state, and only when you are not
  # already looking at it.  Without the transition test every repeat hook of
  # the same state re-notifies, which is how people learn to ignore them.
  [ "$state" = "$prev" ] && exit 0
  case " $KEL_NOTIFY " in
    *" $state "*)
      window_focused "$wid" && exit 0
      local wn; wn="$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null || echo "$wid")"
      notify "kel: $wn" "${ntext:-$state}" ;;
  esac
}

# --------------------------------------------------------------------------
# kel  (no args)  — enter the workspace
# --------------------------------------------------------------------------
quickstart() {
  cat <<'EOF'

  kel new <name>     start an agent in the current repo
  prefix `           jump to whichever agent is waiting on you
  Ctrl+Space         the board — find any agent (enter jumps, tab acts)
  prefix m           manage the agent you're on — rename / move / kill
  prefix k           new to tmux? the "what can I do here" menu

EOF
}

cmd_attach() {
  need tmux
  prune_state
  if in_tmux; then
    [ -z "$(kel_windows)" ] && { echo "no agents yet."; quickstart; return 0; }
    cmd_ls; return
  fi

  local groups; groups="$(group_sessions)"

  # dir target, the way `claude` keys off the current directory:
  # KEL_GROUP, else the repo we're standing in.
  local want=''
  if [ -n "${KEL_GROUP:-}" ]; then want="$KEL_GROUP"
  elif git_root >/dev/null 2>&1; then want="$(basename "$(git_root)")"
  fi
  slug_ok "$want" || want=''

  # 1. dir-aware attach — this repo's group is already live
  if [ -n "$want" ] && printf '%s\n' "$groups" | grep -qxF "$want"; then
    set_last_group "$want"
    exec tmux attach -t "=$(sess "$want")"
  fi

  # 2. live workspace, not in a repo — attach the last group you used
  if [ -n "$groups" ] && [ -z "$want" ]; then
    local last target; last="$(get_last_group)"
    if [ -n "$last" ] && printf '%s\n' "$groups" | grep -qxF "$last"; then
      target="$last"
    else
      target="$(printf '%s\n' "$groups" | head -1)"
    fi
    exec tmux attach -t "=$(sess "$target")"
  fi

  # 3. live workspace, in a repo with no group of its own yet — start its agent
  if [ -n "$groups" ] && [ -n "$want" ]; then
    say "no agent for '$want' yet — starting one"
    exec "$SELF" new "$want"
  fi

  # --- no live groups below this point ---

  # 4. server down but the workspace was snapshotted — offer to rebuild it
  if [ -f "$SNAPSHOT" ] && ! snapshot_declined; then
    local ng na
    ng="$(jq -r '.groups | length' "$SNAPSHOT" 2>/dev/null || echo '?')"
    na="$(jq -r '[.groups[][].name] | length' "$SNAPSHOT" 2>/dev/null || echo '?')"
    if [ -t 0 ] && [ -t 1 ]; then
      printf '\033[1;33mkel\033[0m rebuild your workspace? %s group(s), %s window(s)  [Y/n/d=discard] ' "$ng" "$na"
      local ans=''; read -r ans || ans=n
      case "$ans" in
        d|D|discard)
          rm -f "$SNAPSHOT" "$SNAPSHOT.prev" "$SNAPSHOT_DECLINED"
          say "discarded the saved workspace" ;;
        n|N|no)
          decline_snapshot
          say "ok — starting fresh; 'kel restore' still rebuilds it, and this won't ask again" ;;
        *) restore_from_snapshot -c; return ;;
      esac
      # declined — fall through to a fresh start instead of dead-ending
    else
      say "workspace snapshot found ($ng groups, $na windows) — 'kel restore' to rebuild"
      return
    fi
  elif [ -n "$(dead_sessions)" ]; then
    warn "no live workspace, but these agents can be rebuilt:"
    cmd_ls
    echo "  kel restore [-c]  rebuild them   ·   kel prune  discard them"
    return
  fi

  # 5. fresh start — dir-aware if we're in a repo
  if [ -n "$want" ]; then
    say "starting an agent for '$want'"
    exec "$SELF" new "$want"
  fi
  say "welcome to kel."
  quickstart
  exec tmux new-session -s "$(sess misc)" -c "$HOME"
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

# --------------------------------------------------------------------------
main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    hook)         cmd_hook "$@" ;;                 # hot path — skip migrate
    new)          migrate_meta; cmd_new "$@" ;;
    kill)         migrate_meta; cmd_kill "$@" ;;
    ls|list)      migrate_meta; cmd_ls "$@" ;;
    go)           migrate_meta; cmd_go "$@" ;;
    move)         migrate_meta; cmd_move "$@" ;;
    rename)       migrate_meta; cmd_rename "$@" ;;
    board|menu)   migrate_meta; cmd_board ;;   # menu = deprecated alias
    _board_rows)     cmd_board_rows ;;
    _board_preview)  cmd_board_preview "$@" ;;
    _board_jump)     cmd_board_jump "$@" ;;
    _board_kill)     cmd_board_kill "$@" ;;
    _board_actions)  cmd_board_actions "$@" ;;
    _board_rename)   migrate_meta; cmd_board_rename "$@" ;;
    restore)      migrate_meta; cmd_restore "$@" ;;
    restart)      migrate_meta; cmd_restart "$@" ;;
    top)          cmd_top "$@" ;;
    sweep)        migrate_meta; cmd_sweep "$@" ;;
    prune)        migrate_meta; cmd_prune "$@" ;;
    snapshot)     cmd_snapshot ;;
    doctor)       cmd_doctor "$@" ;;
    status-line)  cmd_status_line "$@" ;;
    _fleet)       fleet_json "$@" ;;
    _land)        land_of "$@"; echo ;;                # for tests
    _prstate)     pr_state_of "$@"; echo ;;            # for tests
    _slug)        repo_slug "$@"; echo ;;              # for tests
    statusline)   cmd_statusline ;;                # hot path — skip migrate
    jump)         cmd_jump ;;
    cheat)        cmd_cheat ;;
    ''|attach)    migrate_meta; cmd_attach ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd  (try: kel --help)" ;;
  esac
}
main "$@"
