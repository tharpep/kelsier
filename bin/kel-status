#!/usr/bin/env bash
# kel — render the tmux status-left fleet line.
#
#   [kel] 0:auth-fix? [1:rate-limit*] 2:docs!
#
#   ?  waiting on you   *  working   !  done   (bare)  idle / unknown
#   [ ] around the current window
#
# Called by tmux via  set -g status-left "#($HOME/.local/bin/kel-status)".
# Keyed by window id (see kel-hook.sh). kel.conf hides tmux's own window list
# so this is the one fleet view.
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kel"
[ -n "${TMUX:-}" ] || exit 0

cur="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"

out="#[fg=colour245][kel]#[default]"
while read -r wid idx name; do
  [ -z "$wid" ] && continue
  suffix="" ; colour=""
  f="$STATE_DIR/$wid.state"
  if [ -f "$f" ]; then
    read -r state _ < "$f" || state=""
    case "$state" in
      waiting) suffix="?" ; colour="#[fg=colour214,bold]" ;;
      working) suffix="*" ; colour="#[fg=colour111]" ;;
      done)    suffix="!" ; colour="#[fg=colour114]" ;;
      *)       suffix=""  ; colour="" ;;
    esac
  fi
  if [ "$wid" = "$cur" ]; then
    out="$out ${colour}[${idx}:${name}${suffix}]#[default]"
  else
    out="$out ${colour}${idx}:${name}${suffix}#[default]"
  fi
done < <(tmux list-windows -F '#{window_id} #{window_index} #{window_name}' 2>/dev/null)

printf '%s ' "$out"
